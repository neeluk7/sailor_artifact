val DecodeShift : list bitU -> ShiftType

let DecodeShift op =
   let b__0 = op in
   if ((eq_vec b__0 ([B0;B0]))) then ShiftType_LSL
   else if ((eq_vec b__0 ([B0;B1]))) then ShiftType_LSR
   else if ((eq_vec b__0 ([B1;B0]))) then ShiftType_ASR
   else ShiftType_ROR

val DecodeRegExtend : list bitU -> ExtendType

let DecodeRegExtend op =
   let b__0 = op in
   if ((eq_vec b__0 ([B0;B0;B0]))) then ExtendType_UXTB
   else if ((eq_vec b__0 ([B0;B0;B1]))) then ExtendType_UXTH
   else if ((eq_vec b__0 ([B0;B1;B0]))) then ExtendType_UXTW
   else if ((eq_vec b__0 ([B0;B1;B1]))) then ExtendType_UXTX
   else if ((eq_vec b__0 ([B1;B0;B0]))) then ExtendType_SXTB
   else if ((eq_vec b__0 ([B1;B0;B1]))) then ExtendType_SXTH
   else if ((eq_vec b__0 ([B1;B1;B0]))) then ExtendType_SXTW
   else ExtendType_SXTX

