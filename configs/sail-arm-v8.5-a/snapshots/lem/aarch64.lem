      read_reg TLBHits_ref >>= fun (w__2 : ii) ->
      let (_ : unit) = asl_prerr_int w__2 in
      let (_ : unit) = prerr "/" in
      read_reg TLBHits_ref >>= fun (w__3 : ii) ->
      read_reg TLBMisses_ref >>= fun (w__4 : ii) ->
      let (_ : unit) = asl_prerr_int ((integerAdd w__3 w__4)) in
      let (_ : unit) = prerr " == " in
      read_reg TLBHits_ref >>= fun (w__5 : ii) ->
      read_reg TLBHits_ref >>= fun (w__6 : ii) ->
      read_reg TLBMisses_ref >>= fun (w__7 : ii) ->
      let (_ : unit) =
        asl_prerr_int ((integerDiv ((integerMult (100:ii) w__5)) ((integerAdd w__6 w__7)))) in
      return ((println ()))
    else
      let (_ : unit) = prerr "TLB reset (no requests were made)" in
      return ((println ()))) >>
   write_reg TLBHits_ref (0:ii) >>
   write_reg TLBMisses_ref (0:ii) >>
   let loop_i_lower = (0:ii) in
   let loop_i_upper = integerMinus ((shl_int (1:ii) (10:ii))) (1:ii) in
   (foreachM (index_list loop_i_lower loop_i_upper (1:ii)) ()
     (fun i unit_var ->
       read_reg _TLB_ref >>= fun (w__8 : list TLBLine) ->
       let (__tc1 : TLBLine) = access_list_dec w__8 i in
       let __tc1 = <|__tc1 with TLBLine_valid_name = false|> in
       read_reg _TLB_ref >>= fun (w__9 : list TLBLine) ->
       write_reg _TLB_ref ((update_list_dec w__9 i __tc1))))

