val __IMPDEF_boolean_map : string -> M bool

let __IMPDEF_boolean_map x =
   catch_early_return
     (match () with
     | () ->
        if ((eq x "Reserved Control Space Supported")) then (early_return true : MR bool bool)
        else if ((eq x "Reserved Control Space Traps Supported")) then
          (early_return true : MR bool bool)
        else if ((eq x "Reserved Control Space EL0 Trapped")) then
          (early_return true : MR bool bool)
        else if ((eq x "Illegal Execution State on return to AArch32")) then
          (early_return true : MR bool bool)
        else if ((eq x "Floating-Point Traps Support")) then (early_return true : MR bool bool)
        else if ((eq x "Floating-Point Traps Information")) then (early_return true : MR bool bool)
        else if ((eq x "Condition valid for trapped T32")) then (early_return false : MR bool bool)
        else if ((eq x "Translation fault on misprogrammed contiguous bit")) then
          (early_return false : MR bool bool)
        else if ((eq x "Virtual SError syndrome valid")) then (early_return false : MR bool bool)
        else if ((eq x "Have CRC extension")) then (early_return true : MR bool bool)
        else if ((eq x "Report I-cache maintenance fault in IFSR")) then
          (early_return false : MR bool bool)
        else if ((eq x "UNDEF unallocated CP15 access at EL0")) then
          (early_return true : MR bool bool)
        else if ((eq x "Align PC on illegal exception return")) then
          (early_return true : MR bool bool)
        else if ((eq x "EL from SPSR on illegal exception return")) then
          (early_return false : MR bool bool)
        else if ((eq x "Has AES Crypto instructions")) then
          (early_return ((or_bool ((eq __crypto_aes_implemented (1:ii)))
                            ((eq __crypto_aes_implemented (2:ii))))) :
            MR bool bool)
        else if ((eq x "Has SHA1 Crypto instructions")) then
          (early_return __crypto_sha1_implemented : MR bool bool)
        else if ((eq x "Has SHA256 Crypto instructions")) then
          (early_return __crypto_sha256_implemented : MR bool bool)
        else if ((eq x "Has 128-bit form of PMULL instructions")) then
          (early_return ((eq __crypto_aes_implemented (2:ii))) : MR bool bool)
        else if ((eq x "vector instructions set TFV to 1")) then (early_return true : MR bool bool)
        else if ((eq x "Has accumulate FP16 product into FP32 extension")) then
          (early_return true : MR bool bool)
        else if ((eq x "Has RAS extension")) then (early_return true : MR bool bool)
        else if ((eq x "Has Implicit Error Synchronization Barrier")) then
          (early_return true : MR bool bool)
        else if ((eq x "Implicit Error Synchronization Barrier before Exception")) then
          (early_return true : MR bool bool)
        else if ((eq x "Has Dot Product extension")) then (early_return true : MR bool bool)
        else if ((eq x "Has SHA512 Crypto instructions")) then
          (early_return __crypto_sha512_implemented : MR bool bool)
        else if ((eq x "Has SHA3 Crypto instructions")) then
          (early_return __crypto_sha3_implemented : MR bool bool)
        else if ((eq x "Has SM3 Crypto instructions")) then
          (early_return __crypto_sm3_implemented : MR bool bool)
        else if ((eq x "Has SM4 Crypto instructions")) then
          (early_return __crypto_sm4_implemented : MR bool bool)
        else if ((eq x "Has MPAM extension")) then (early_return __mpam_implemented : MR bool bool)
        else if ((eq x "Has MTE extension")) then (early_return __mte_implemented : MR bool bool)
        else if ((eq x "Has Small Page Table extension")) then (early_return true : MR bool bool)
        else if ((eq x "Secure-only implementation")) then (early_return true : MR bool bool)
        else if ((eq x "OS Double Lock is implemented")) then (early_return false : MR bool bool)
        else
          liftR (throw (Error_Implementation_Defined "Unrecognized IMPLEMENTATION_DEFINED boolean"))
     end)

val __IMPDEF_boolean : string -> M bool

let __IMPDEF_boolean x = __IMPDEF_boolean_map x

