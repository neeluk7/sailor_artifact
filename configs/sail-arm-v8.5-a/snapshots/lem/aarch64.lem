val RBankSelect : list bitU -> integer -> integer -> integer -> integer -> integer -> integer -> integer -> integer

let RBankSelect mode usr fiq irq svc abt und hyp =
   let _pat_ = mode in
   if ((eq_vec _pat_ M32_User)) then usr
   else if ((eq_vec _pat_ M32_FIQ)) then fiq
   else if ((eq_vec _pat_ M32_IRQ)) then irq
   else if ((eq_vec _pat_ M32_Svc)) then svc
   else if ((eq_vec _pat_ M32_Abort)) then abt
   else if ((eq_vec _pat_ M32_Hyp)) then hyp
   else if ((eq_vec _pat_ M32_Undef)) then und
   else usr

