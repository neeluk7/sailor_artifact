function decode_rmif_aarch64_instrs_integer_flags_rmif (mask, Rn, imm6, sf) = {
    if not_bool(HaveFlagManipulateExt()) | sf != 0b1 then {
        throw(Error_Undefined())
    };
    let 'lsb = UInt(imm6);
    let 'n = UInt(Rn);
    execute_aarch64_instrs_integer_flags_rmif(lsb, mask, n)
}

