function clause __DecodeA64 ((pc, ([bitone, bitzero, bitone, bitzero, bitzero, bitzero, bitzero, bitzero, bitone, bitzero, bitone, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, bitzero, bitzero, bitzero, _, _] as __opcode)) if SEE < 10) = {
    SEE = 10;
    let u0 = Slice(__opcode, 24, 1);
    let u1 = Slice(__opcode, 21, 1);
    let Zm = Slice(__opcode, 16, 5);
    let Pm = Slice(__opcode, 13, 3);
    let Pn = Slice(__opcode, 10, 3);
    let Zn = Slice(__opcode, 5, 5);
    let S = Slice(__opcode, 4, 1);
    let ZAda = Slice(__opcode, 0, 2);
    decode_SUMOPA_ZA_PP_ZZ_32(u0, u1, Zm, Pm, Pn, Zn, S, ZAda)
}

val execute_USMOPA_ZA_PP_ZZ_32 : forall 'PL 'VL 'a 'b 'da 'dim_mul_mul 'esize 'm 'n ('op1_unsigned : Bool) ('op2_unsigned : Bool) ('sub_op : Bool),
  (0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 'esize == 32 & 'da in {0, 1, 2, 3} & 'b in {0, 1, 2, 3, 4, 5, 6, 7} & 'a in {0, 1, 2, 3, 4, 5, 6, 7} & is_VL('VL) & is_PL('PL) & 'dim_mul_mul == div('VL, 'esize) * (div('VL, 'esize) * 'esize)).
  (int('VL), int('PL), int('dim_mul_mul), int('a), int('b), int('da), int('esize), int('m), int('n), bool('op1_unsigned), bool('op2_unsigned), bool('sub_op)) -> unit

function execute_USMOPA_ZA_PP_ZZ_32 (VL, PL, dim_mul_mul, a, b, da, esize, m, n, op1_unsigned, op2_unsigned, sub_op) = {
    CheckStreamingSVEAndZAEnabled();
    let 'dim = DIV(VL, esize);
    let mask1 : bits('PL) = P_read(PL, a);
    let mask2 : bits('PL) = P_read(PL, b);
    let operand1 : bits('VL) = Z_read(VL, n);
    let operand2 : bits('VL) = Z_read(VL, m);
    let operand3 : bits('dim_mul_mul) = ZAtile_read(dim_mul_mul, VL, da, esize);
    result : bits('dim_mul_mul) = undefined;
    prod : int = undefined;
    foreach (row from 0 to (dim - 1) by 1 in inc) {
        foreach (col from 0 to (dim - 1) by 1 in inc) {
            sum : bits('esize) = Elem_read(operand3, row * dim + col, esize);
            foreach (k from 0 to 3 by 1 in inc) {
                if ElemP_read(mask1, 4 * row + k, DIV(esize, 4)) == 0b1 & ElemP_read(mask2, 4 * col + k, DIV(esize, 4)) == 0b1 then {
                    prod = asl_Int(Elem_read(operand1, 4 * row + k, DIV(esize, 4)), op1_unsigned) * asl_Int(Elem_read(operand2, 4 * col + k, DIV(esize, 4)), op2_unsigned);
                    if sub_op then {
                        prod = negate(prod)
                    };
                    sum = sum + prod
                };
                ()
            };
            result = Elem_set(result, row * dim + col, esize, sum)
        }
    };
    ZAtile_set(dim_mul_mul, VL, da, esize) = result
}

val decode_USMOPA_ZA_PP_ZZ_32 : (bits(1), bits(1), bits(5), bits(3), bits(3), bits(5), bits(1), bits(2)) -> unit

