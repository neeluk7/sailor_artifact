    let mask1 : bits('PL) = P_read(PL, a);
    let mask2 : bits('PL) = P_read(PL, b);
    let operand1 : bits('VL) = Z_read(VL, n);
    let operand2 : bits('VL) = Z_read(VL, m);
    let operand3 : bits('dim_mul_mul) = ZAtile_read(dim_mul_mul, VL, da, esize);
    result : bits('dim_mul_mul) = undefined;
    prod : int = undefined;
    foreach (row from 0 to (dim - 1) by 1 in inc) {
        foreach (col from 0 to (dim - 1) by 1 in inc) {
            sum : bits('esize) = Elem_read(operand3, row * dim + col, esize);
            foreach (k from 0 to 3 by 1 in inc) {
                if ElemP_read(mask1, 4 * row + k, DIV(esize, 4)) == 0b1 & ElemP_read(mask2, 4 * col + k, DIV(esize, 4)) == 0b1 then {
