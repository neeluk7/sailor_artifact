            let 'element2 = asl_Int(Elem_read(operand2, e, esize), is_unsigned);
            match op {
              Cmp_EQ => {
                  cond = element1 == element2
              },
              Cmp_NE => {
                  cond = element1 != element2
              },
              Cmp_GE => {
                  cond = element1 >= element2
              },
              Cmp_LT => {
                  cond = element1 < element2
              },
              Cmp_GT => {
                  cond = element1 > element2
              },
              Cmp_LE => {
                  cond = element1 <= element2
              },
              _ => ()
            };
            result = ElemP_set(result, e, esize, if cond then 0b1 else 0b0)
        } else {
            result = ElemP_set(result, e, esize, 0b0)
        }
    };
    (PSTATE.N @ PSTATE.Z @ PSTATE.C @ PSTATE.V) = PredTest(mask, result, esize);
    P_set(PL, d) = result
}

