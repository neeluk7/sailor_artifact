        result = Elem_set(result, 2 * p + 0, esize, Elem_read(operand1, base + p, esize));
        result = Elem_set(result, 2 * p + 1, esize, Elem_read(operand2, base + p, esize))
    };
    V_set(datasize, d) = result
}

