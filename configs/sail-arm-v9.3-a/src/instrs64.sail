val execute_ST2H_Z_P_BR_Contiguous : forall 'PL 'VL 'esize 'g 'm 'n 'nreg 't,
  (0 <= 't & 't <= 31 & 'nreg == 2 & 0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize == 16 & is_VL('VL) & is_PL('PL)).
