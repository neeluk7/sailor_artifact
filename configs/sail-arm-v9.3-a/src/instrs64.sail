        let iswrite : bool = true;
        let secondstage : bool = false;
        AArch64_Abort(address, AlignmentFault(AccType_NORMAL, iswrite, secondstage))
    };
    Mem_set(address, 8, AccType_NORMAL) = data1;
    Mem_set(address + 8, 8, AccType_NORMAL) = data2;
    AArch64_MemTag_set(address, AccType_NORMAL) = AArch64_AllocationTagFromAddress(address);
    if writeback then {
        if postindex then {
            address = address + offset
        };
        if n == 31 then {
            SP_set(64) = address
        } else {
            X_set(64, n) = address
        }
    };
    ()
}

