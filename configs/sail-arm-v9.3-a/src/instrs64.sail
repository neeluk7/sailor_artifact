    let 'd = UInt(Rd);
    let 'n = UInt(Rn);
    let 'm = UInt(Rm);
    let 'datasize = if Q == 0b1 then 128 else 64;
    let 'elements = DIV(datasize, 8);
    let 'regs = UInt(len) + 1;
    let is_tbl : bool = op == 0b0;
    execute_aarch64_instrs_vector_transfer_vector_table(d, datasize, elements, is_tbl, m, n, regs)
}

