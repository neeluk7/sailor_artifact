function execute_LD1ROD_Z_P_BI_U64 (VL, PL, VL_div_256, VL_mul_256_div_256, esize, g, n, offset, t) = {
    CheckNonStreamingSVEEnabled();
    if VL < 256 then {
        throw(Error_Undefined())
    };
    let 'elements = DIV(256, esize);
    base : bits(64) = undefined;
    let mask : bits('PL) = P_read(PL, g);
    result : bits(256) = undefined;
    let 'mbytes = DIV(esize, 8);
    if HaveMTEExt() then {
        SetTagCheckedInstruction(n != 31)
    };
    if not_bool(AnyActiveElement(mask, esize)) then {
        if n == 31 & ConstrainUnpredictableBool(Unpredictable_CHECKSPNONEACTIVE) then {
            CheckSPAlignment()
        };
        ()
    } else {
        if n == 31 then {
            CheckSPAlignment()
        };
        base = if n == 31 then SP_read(64) else X_read(64, n)
    };
