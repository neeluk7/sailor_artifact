function decode_sm4e_advsimd_aarch64_instrs_vector_crypto_sm4_sm4enc (Rd, Rn) = {
    if not_bool(HaveSM4Ext()) then {
        throw(Error_Undefined())
    };
    let 'd = UInt(Rd);
    let 'n = UInt(Rn);
    execute_aarch64_instrs_vector_crypto_sm4_sm4enc(d, n)
}

