      },
      1024 => {
          execute_ST1Q_ZA_P_RRR__(1024, 128, esize, g, imm, m, n, s, t, vertical)
      },
      1152 => {
          execute_ST1Q_ZA_P_RRR__(1152, 144, esize, g, imm, m, n, s, t, vertical)
      },
      1280 => {
          execute_ST1Q_ZA_P_RRR__(1280, 160, esize, g, imm, m, n, s, t, vertical)
      },
      1408 => {
          execute_ST1Q_ZA_P_RRR__(1408, 176, esize, g, imm, m, n, s, t, vertical)
      },
      1536 => {
          execute_ST1Q_ZA_P_RRR__(1536, 192, esize, g, imm, m, n, s, t, vertical)
      },
      1664 => {
