val execute_SQABS_Z_P_Z__ : forall 'PL 'VL 'd 'esize 'g 'n,
  (0 <= 'n & 'n <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize in {8, 16, 32, 64} & 0 <= 'd & 'd <= 31 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('d), int('esize), int('g), int('n)) -> unit

function execute_SQABS_Z_P_Z__ (VL, PL, d, esize, g, n) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    let operand : bits('VL) = if AnyActiveElement(mask, esize) then
      Z_read(VL, n)
    else
      Zeros();
    result : bits('VL) = Z_read(VL, d);
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        if ElemP_read(mask, e, esize) == 0b1 then {
            element : int = SInt(Elem_read(operand, e, esize));
            let 'element = Abs(element);
            result = Elem_set(result, e, esize, SignedSat(element, esize))
        };
        ()
    };
    Z_set(VL, d) = result
}

val decode_SQABS_Z_P_Z__ : (bits(2), bits(1), bits(3), bits(5), bits(5)) -> unit

function decode_SQABS_Z_P_Z__ (size, Q, Pg, Zn, Zd) = {
    let 'VL = VL_read();
    if not_bool(HaveSVE2()) & not_bool(HaveSME()) then {
        throw(Error_Undefined())
    };
    let 'esize = (8 << UInt(size));
    let 'g = UInt(Pg);
    let 'n = UInt(Zn);
    let 'd = UInt(Zd);
    match VL {
      128 => {
          execute_SQABS_Z_P_Z__(128, 16, d, esize, g, n)
      },
      256 => {
          execute_SQABS_Z_P_Z__(256, 32, d, esize, g, n)
