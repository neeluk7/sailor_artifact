val execute_aarch64_instrs_integer_tags_mcsettagpairpost : forall 'n ('postindex : Bool) 't ('writeback : Bool) ('zero_data : Bool),
  (0 <= 't & 't <= 31 & 0 <= 'n & 'n <= 31).
  (int('n), bits(64), bool('postindex), int('t), bool('writeback), bool('zero_data)) -> unit

function execute_aarch64_instrs_integer_tags_mcsettagpairpost (n, offset, postindex, t, writeback, zero_data) = {
    address : bits(64) = undefined;
    let data : bits(64) = if t == 31 then SP_read(64) else X_read(64, t);
    let tag : bits(4) = AArch64_AllocationTagFromAddress(data);
    SetTagCheckedInstruction(false);
    if n == 31 then {
        CheckSPAlignment();
        address = SP_read(64)
    } else {
        address = X_read(64, n)
    };
    if not_bool(postindex) then {
        address = address + offset
    };
    if zero_data then {
        if address != Align(address, TAG_GRANULE) then {
            AArch64_Abort(address, AlignmentFault(AccType_NORMAL, true, false))
        };
        Mem_set(address, TAG_GRANULE, AccType_NORMAL) = Zeros(TAG_GRANULE * 8);
        Mem_set(address + TAG_GRANULE, TAG_GRANULE, AccType_NORMAL) = Zeros(TAG_GRANULE * 8)
    };
    AArch64_MemTag_set(address, AccType_NORMAL) = tag;
    AArch64_MemTag_set(address + TAG_GRANULE, AccType_NORMAL) = tag;
    if writeback then {
        if postindex then {
            address = address + offset
        };
        if n == 31 then {
            SP_set(64) = address
        } else {
            X_set(64, n) = address
        }
    };
    ()
}

