val execute_aarch64_instrs_system_exceptions_runtime_hvc : bits(16) -> unit

function execute_aarch64_instrs_system_exceptions_runtime_hvc imm = {
    if (not_bool(HaveEL(EL2)) | PSTATE.EL == EL0) | PSTATE.EL == EL1 & not_bool(IsSecureEL2Enabled()) & IsSecure() then {
        throw(Error_Undefined())
    };
    let hvc_enable : bits(1) = if HaveEL(EL3) then Slice(SCR_EL3, 8, 1) else
      not_vec(Slice(HCR_EL2, 29, 1));
    if hvc_enable == 0b0 then {
        throw(Error_Undefined())
    } else {
        AArch64_CallHypervisor(imm)
    }
}

