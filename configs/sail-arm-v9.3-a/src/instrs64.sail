        if sub_r then {
            result = Elem_set(result, 2 * p + 0, esize, elt3_r - product_r)
        } else {
            result = Elem_set(result, 2 * p + 0, esize, elt3_r + product_r)
        };
        if sub_i then {
            result = Elem_set(result, 2 * p + 1, esize, elt3_i - product_i)
