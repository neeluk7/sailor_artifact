    let opcode = Slice(__opcode, 16, 3);
    let rmode = Slice(__opcode, 19, 2);
    let ftype = Slice(__opcode, 22, 2);
    let sf = Slice(__opcode, 31, 1);
    decode_fcvtmu_float_aarch64_instrs_float_convert_int(Rd, Rn, opcode, rmode, ftype, sf)
}

