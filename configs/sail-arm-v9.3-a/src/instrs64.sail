                let 'e2 = eltspersegment * b + i;
                let element2 : bits('esize) = Elem_read(operand2, e2, esize);
                if element1 == element2 then {
                    count = count + 1
                };
                ()
            };
            let 'count = count;
            result = Elem_set(result, e, esize, count[esize - 1 .. 0])
        }
    };
    Z_set(VL, d) = result
