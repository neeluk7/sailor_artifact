val execute_SCVTF_Z_P_Z_X2D : forall 'PL 'VL 'd 'd_esize 'esize 'g ('is_unsigned : Bool) 'n 's_esize,
  ('s_esize == 64 & 0 <= 'n & 'n <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize == 64 & 'd_esize == 64 & 0 <= 'd & 'd <= 31 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('d), int('d_esize), int('esize), int('g), int('n), FPRounding, int('s_esize), bool('is_unsigned)) -> unit

function execute_SCVTF_Z_P_Z_X2D (VL, PL, d, d_esize, esize, g, n, rounding, s_esize, is_unsigned) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    let operand : bits('VL) = if AnyActiveElement(mask, esize) then
      Z_read(VL, n)
    else
      Zeros();
    result : bits('VL) = Z_read(VL, d);
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        if ElemP_read(mask, e, esize) == 0b1 then {
            let element : bits('esize) = Elem_read(operand, e, esize);
            let fpval : bits('d_esize) = FixedToFP(d_esize, element[s_esize - 1 .. 0], 0, is_unsigned, FPCR_read(), rounding);
            result = Elem_set(result, e, esize, ZeroExtend(fpval))
        };
        ()
    };
    Z_set(VL, d) = result
}

