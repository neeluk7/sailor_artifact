      },
      1024 => {
          execute_FCMLA_Z_ZZZi_S(1024, da, esize, index, m, n, neg_i, neg_r, sel_a, sel_b)
      },
      1152 => {
          execute_FCMLA_Z_ZZZi_S(1152, da, esize, index, m, n, neg_i, neg_r, sel_a, sel_b)
