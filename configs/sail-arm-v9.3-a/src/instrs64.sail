    };
    let 'esize = (8 << 3);
    let 'datasize = esize;
    let 'elements = 1;
    let 'shift = esize * 2 - UInt(immh @ immb);
    execute_aarch64_instrs_vector_shift_right_insert_sisd(d, datasize, elements, esize, n, shift)
}

