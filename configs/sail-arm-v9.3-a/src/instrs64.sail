val execute_CLASTB_Z_P_ZZ__ : forall 'PL 'VL 'dn 'esize 'g ('isBefore : Bool) 'm,
  (0 <= 'm & 'm <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize in {8, 16, 32, 64} & 0 <= 'dn & 'dn <= 31 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('dn), int('esize), int('g), bool('isBefore), int('m)) -> unit

function execute_CLASTB_Z_P_ZZ__ (VL, PL, dn, esize, g, isBefore, m) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    let operand1 : bits('VL) = Z_read(VL, dn);
    let operand2 : bits('VL) = Z_read(VL, m);
    result : bits('VL) = undefined;
    last : int = LastActiveElement(mask, esize);
    if last < 0 then {
        result = operand1
    } else {
        if not_bool(isBefore) then {
            last = last + 1;
            if last >= elements then {
                last = 0
            };
            ()
        };
        let 'last = last;
        foreach (e from 0 to (elements - 1) by 1 in inc) {
            result = Elem_set(result, e, esize, Elem_read(operand2, last, esize))
        }
    };
    Z_set(VL, dn) = result
}

