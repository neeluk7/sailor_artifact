    foreach (e from 0 to (elements - 1) by 1 in inc) {
        let element : bits('esize) = Elem_read(operand, 2 * e + 0, esize);
        let 'shifted_value = (SInt(element) << shift);
        result = Elem_set(result, e, 2 * esize, shifted_value[2 * esize - 1 .. 0])
    };
    Z_set(VL, d) = result
}

