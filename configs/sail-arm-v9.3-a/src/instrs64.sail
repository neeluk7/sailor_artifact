    let 'm = UInt(Rm);
    let 'esize = 8;
    let 'datasize = if Q == 0b1 then 128 else 64;
    let 'elements = DIV(datasize, esize);
    op : VBitOp = undefined;
    match opc2 {
      0b00 => {
          op = VBitOp_VEOR
      },
      0b01 => {
          op = VBitOp_VBSL
      },
      0b10 => {
          op = VBitOp_VBIT
      },
      0b11 => {
          op = VBitOp_VBIF
      }
    };
    let op = op;
    execute_aarch64_instrs_vector_arithmetic_binary_uniform_logical_bsl_eor(d, datasize, m, n, op)
}

