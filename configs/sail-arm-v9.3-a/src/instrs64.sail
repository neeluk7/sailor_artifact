val execute_FMOPA_ZA_PP_ZZ_32 : forall 'PL 'VL 'a 'b 'da 'dim_mul_mul 'esize 'm 'n ('sub_op : Bool),
  (0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 'esize == 32 & 'da in {0, 1, 2, 3} & 'b in {0, 1, 2, 3, 4, 5, 6, 7} & 'a in {0, 1, 2, 3, 4, 5, 6, 7} & is_VL('VL) & is_PL('PL) & 'dim_mul_mul == div('VL, 'esize) * (div('VL, 'esize) * 'esize)).
  (int('VL), int('PL), int('dim_mul_mul), int('a), int('b), int('da), int('esize), int('m), int('n), bool('sub_op)) -> unit

function execute_FMOPA_ZA_PP_ZZ_32 (VL, PL, dim_mul_mul, a, b, da, esize, m, n, sub_op) = {
    CheckStreamingSVEAndZAEnabled();
    let 'dim = DIV(VL, esize);
    let mask1 : bits('PL) = P_read(PL, a);
    let mask2 : bits('PL) = P_read(PL, b);
    let operand1 : bits('VL) = Z_read(VL, n);
    let operand2 : bits('VL) = Z_read(VL, m);
    let operand3 : bits('dim_mul_mul) = ZAtile_read(dim_mul_mul, VL, da, esize);
    result : bits('dim_mul_mul) = undefined;
    foreach (row from 0 to (dim - 1) by 1 in inc) {
        foreach (col from 0 to (dim - 1) by 1 in inc) {
            element1 : bits('esize) = Elem_read(operand1, row, esize);
            let element2 : bits('esize) = Elem_read(operand2, col, esize);
            let element3 : bits('esize) = Elem_read(operand3, row * dim + col, esize);
            if ElemP_read(mask1, row, esize) == 0b1 & ElemP_read(mask2, col, esize) == 0b1 then {
                if sub_op then {
                    element1 = FPNeg(element1)
                };
                result = Elem_set(result, row * dim + col, esize, FPMulAdd_ZA(element3, element1, element2, FPCR_read()))
            } else {
                result = Elem_set(result, row * dim + col, esize, element3)
            }
        }
    };
    ZAtile_set(dim_mul_mul, VL, da, esize) = result
}

val decode_FMOPA_ZA_PP_ZZ_32 : (bits(5), bits(3), bits(3), bits(5), bits(1), bits(2)) -> unit

function decode_FMOPA_ZA_PP_ZZ_32 (Zm, Pm, Pn, Zn, S, ZAda) = {
    let 'VL = VL_read();
    if not_bool(HaveSME()) then {
        throw(Error_Undefined())
    };
    let 'esize = 32;
    let 'a = UInt(Pn);
    let 'b = UInt(Pm);
    let 'n = UInt(Zn);
    let 'm = UInt(Zm);
    let 'da = UInt(ZAda);
    let sub_op : bool = false;
    match VL {
      128 => {
          execute_FMOPA_ZA_PP_ZZ_32(128, 16, DIV(128, esize) * DIV(128, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      256 => {
          execute_FMOPA_ZA_PP_ZZ_32(256, 32, DIV(256, esize) * DIV(256, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      384 => {
          execute_FMOPA_ZA_PP_ZZ_32(384, 48, DIV(384, esize) * DIV(384, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      512 => {
          execute_FMOPA_ZA_PP_ZZ_32(512, 64, DIV(512, esize) * DIV(512, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      640 => {
          execute_FMOPA_ZA_PP_ZZ_32(640, 80, DIV(640, esize) * DIV(640, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      768 => {
          execute_FMOPA_ZA_PP_ZZ_32(768, 96, DIV(768, esize) * DIV(768, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      896 => {
          execute_FMOPA_ZA_PP_ZZ_32(896, 112, DIV(896, esize) * DIV(896, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1024 => {
          execute_FMOPA_ZA_PP_ZZ_32(1024, 128, DIV(1024, esize) * DIV(1024, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1152 => {
          execute_FMOPA_ZA_PP_ZZ_32(1152, 144, DIV(1152, esize) * DIV(1152, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1280 => {
          execute_FMOPA_ZA_PP_ZZ_32(1280, 160, DIV(1280, esize) * DIV(1280, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1408 => {
          execute_FMOPA_ZA_PP_ZZ_32(1408, 176, DIV(1408, esize) * DIV(1408, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1536 => {
          execute_FMOPA_ZA_PP_ZZ_32(1536, 192, DIV(1536, esize) * DIV(1536, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1664 => {
          execute_FMOPA_ZA_PP_ZZ_32(1664, 208, DIV(1664, esize) * DIV(1664, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1792 => {
          execute_FMOPA_ZA_PP_ZZ_32(1792, 224, DIV(1792, esize) * DIV(1792, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1920 => {
          execute_FMOPA_ZA_PP_ZZ_32(1920, 240, DIV(1920, esize) * DIV(1920, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      2048 => {
          execute_FMOPA_ZA_PP_ZZ_32(2048, 256, DIV(2048, esize) * DIV(2048, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      _ => ()
    }
}

function clause __DecodeA64 ((pc, ([bitone, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, bitone, bitzero, bitzero, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, bitzero, bitzero, bitzero, _, _] as __opcode)) if SEE < 1) = {
    SEE = 1;
    let Zm = Slice(__opcode, 16, 5);
    let Pm = Slice(__opcode, 13, 3);
    let Pn = Slice(__opcode, 10, 3);
    let Zn = Slice(__opcode, 5, 5);
    let S = Slice(__opcode, 4, 1);
    let ZAda = Slice(__opcode, 0, 2);
    decode_FMOPA_ZA_PP_ZZ_32(Zm, Pm, Pn, Zn, S, ZAda)
}

val execute_FMOPS_ZA_PP_ZZ_32 : forall 'PL 'VL 'a 'b 'da 'dim_mul_mul 'esize 'm 'n ('sub_op : Bool),
  (0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 'esize == 32 & 'da in {0, 1, 2, 3} & 'b in {0, 1, 2, 3, 4, 5, 6, 7} & 'a in {0, 1, 2, 3, 4, 5, 6, 7} & is_VL('VL) & is_PL('PL) & 'dim_mul_mul == div('VL, 'esize) * (div('VL, 'esize) * 'esize)).
  (int('VL), int('PL), int('dim_mul_mul), int('a), int('b), int('da), int('esize), int('m), int('n), bool('sub_op)) -> unit

function execute_FMOPS_ZA_PP_ZZ_32 (VL, PL, dim_mul_mul, a, b, da, esize, m, n, sub_op) = {
    CheckStreamingSVEAndZAEnabled();
    let 'dim = DIV(VL, esize);
    let mask1 : bits('PL) = P_read(PL, a);
    let mask2 : bits('PL) = P_read(PL, b);
    let operand1 : bits('VL) = Z_read(VL, n);
    let operand2 : bits('VL) = Z_read(VL, m);
    let operand3 : bits('dim_mul_mul) = ZAtile_read(dim_mul_mul, VL, da, esize);
    result : bits('dim_mul_mul) = undefined;
    foreach (row from 0 to (dim - 1) by 1 in inc) {
        foreach (col from 0 to (dim - 1) by 1 in inc) {
            element1 : bits('esize) = Elem_read(operand1, row, esize);
            let element2 : bits('esize) = Elem_read(operand2, col, esize);
            let element3 : bits('esize) = Elem_read(operand3, row * dim + col, esize);
            if ElemP_read(mask1, row, esize) == 0b1 & ElemP_read(mask2, col, esize) == 0b1 then {
                if sub_op then {
                    element1 = FPNeg(element1)
                };
                result = Elem_set(result, row * dim + col, esize, FPMulAdd_ZA(element3, element1, element2, FPCR_read()))
            } else {
                result = Elem_set(result, row * dim + col, esize, element3)
            }
        }
    };
    ZAtile_set(dim_mul_mul, VL, da, esize) = result
}

val decode_FMOPS_ZA_PP_ZZ_32 : (bits(5), bits(3), bits(3), bits(5), bits(1), bits(2)) -> unit

function decode_FMOPS_ZA_PP_ZZ_32 (Zm, Pm, Pn, Zn, S, ZAda) = {
    let 'VL = VL_read();
    if not_bool(HaveSME()) then {
        throw(Error_Undefined())
    };
    let 'esize = 32;
    let 'a = UInt(Pn);
    let 'b = UInt(Pm);
    let 'n = UInt(Zn);
    let 'm = UInt(Zm);
    let 'da = UInt(ZAda);
    let sub_op : bool = true;
    match VL {
      128 => {
          execute_FMOPS_ZA_PP_ZZ_32(128, 16, DIV(128, esize) * DIV(128, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      256 => {
          execute_FMOPS_ZA_PP_ZZ_32(256, 32, DIV(256, esize) * DIV(256, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      384 => {
          execute_FMOPS_ZA_PP_ZZ_32(384, 48, DIV(384, esize) * DIV(384, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      512 => {
          execute_FMOPS_ZA_PP_ZZ_32(512, 64, DIV(512, esize) * DIV(512, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      640 => {
          execute_FMOPS_ZA_PP_ZZ_32(640, 80, DIV(640, esize) * DIV(640, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      768 => {
          execute_FMOPS_ZA_PP_ZZ_32(768, 96, DIV(768, esize) * DIV(768, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      896 => {
          execute_FMOPS_ZA_PP_ZZ_32(896, 112, DIV(896, esize) * DIV(896, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1024 => {
          execute_FMOPS_ZA_PP_ZZ_32(1024, 128, DIV(1024, esize) * DIV(1024, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1152 => {
          execute_FMOPS_ZA_PP_ZZ_32(1152, 144, DIV(1152, esize) * DIV(1152, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1280 => {
          execute_FMOPS_ZA_PP_ZZ_32(1280, 160, DIV(1280, esize) * DIV(1280, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1408 => {
          execute_FMOPS_ZA_PP_ZZ_32(1408, 176, DIV(1408, esize) * DIV(1408, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1536 => {
          execute_FMOPS_ZA_PP_ZZ_32(1536, 192, DIV(1536, esize) * DIV(1536, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1664 => {
          execute_FMOPS_ZA_PP_ZZ_32(1664, 208, DIV(1664, esize) * DIV(1664, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1792 => {
          execute_FMOPS_ZA_PP_ZZ_32(1792, 224, DIV(1792, esize) * DIV(1792, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1920 => {
          execute_FMOPS_ZA_PP_ZZ_32(1920, 240, DIV(1920, esize) * DIV(1920, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      2048 => {
          execute_FMOPS_ZA_PP_ZZ_32(2048, 256, DIV(2048, esize) * DIV(2048, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      _ => ()
    }
}

function clause __DecodeA64 ((pc, ([bitone, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, bitone, bitzero, bitzero, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, bitone, bitzero, bitzero, _, _] as __opcode)) if SEE < 2) = {
    SEE = 2;
    let Zm = Slice(__opcode, 16, 5);
    let Pm = Slice(__opcode, 13, 3);
    let Pn = Slice(__opcode, 10, 3);
    let Zn = Slice(__opcode, 5, 5);
    let S = Slice(__opcode, 4, 1);
    let ZAda = Slice(__opcode, 0, 2);
    decode_FMOPS_ZA_PP_ZZ_32(Zm, Pm, Pn, Zn, S, ZAda)
}

val execute_FMOPA_ZA_PP_ZZ_64 : forall 'PL 'VL 'a 'b 'da 'dim_mul_mul 'esize 'm 'n ('sub_op : Bool),
  (0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 'esize == 64 & 'da in {0, 1, 2, 3, 4, 5, 6, 7} & 'b in {0, 1, 2, 3, 4, 5, 6, 7} & 'a in {0, 1, 2, 3, 4, 5, 6, 7} & is_VL('VL) & is_PL('PL) & 'dim_mul_mul == div('VL, 'esize) * (div('VL, 'esize) * 'esize)).
  (int('VL), int('PL), int('dim_mul_mul), int('a), int('b), int('da), int('esize), int('m), int('n), bool('sub_op)) -> unit

function execute_FMOPA_ZA_PP_ZZ_64 (VL, PL, dim_mul_mul, a, b, da, esize, m, n, sub_op) = {
    CheckStreamingSVEAndZAEnabled();
    let 'dim = DIV(VL, esize);
    let mask1 : bits('PL) = P_read(PL, a);
    let mask2 : bits('PL) = P_read(PL, b);
    let operand1 : bits('VL) = Z_read(VL, n);
    let operand2 : bits('VL) = Z_read(VL, m);
    let operand3 : bits('dim_mul_mul) = ZAtile_read(dim_mul_mul, VL, da, esize);
    result : bits('dim_mul_mul) = undefined;
    foreach (row from 0 to (dim - 1) by 1 in inc) {
        foreach (col from 0 to (dim - 1) by 1 in inc) {
            element1 : bits('esize) = Elem_read(operand1, row, esize);
            let element2 : bits('esize) = Elem_read(operand2, col, esize);
            let element3 : bits('esize) = Elem_read(operand3, row * dim + col, esize);
            if ElemP_read(mask1, row, esize) == 0b1 & ElemP_read(mask2, col, esize) == 0b1 then {
                if sub_op then {
                    element1 = FPNeg(element1)
                };
                result = Elem_set(result, row * dim + col, esize, FPMulAdd_ZA(element3, element1, element2, FPCR_read()))
            } else {
                result = Elem_set(result, row * dim + col, esize, element3)
            }
        }
    };
    ZAtile_set(dim_mul_mul, VL, da, esize) = result
}

val decode_FMOPA_ZA_PP_ZZ_64 : (bits(5), bits(3), bits(3), bits(5), bits(1), bits(3)) -> unit

function decode_FMOPA_ZA_PP_ZZ_64 (Zm, Pm, Pn, Zn, S, ZAda) = {
    let 'VL = VL_read();
    if not_bool(HaveSMEF64F64()) then {
