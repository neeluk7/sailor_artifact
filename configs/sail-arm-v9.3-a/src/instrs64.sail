val execute_aarch64_instrs_integer_tags_mcinsertrandomtag : forall 'd 'm 'n,
  (0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 0 <= 'd & 'd <= 31).
  (int('d), int('m), int('n)) -> unit

function execute_aarch64_instrs_integer_tags_mcinsertrandomtag (d, m, n) = {
    let operand : bits(64) = if n == 31 then SP_read(64) else X_read(64, n);
    let exclude_reg : bits(64) = X_read(64, m);
    let exclude : bits(16) = exclude_reg[15 .. 0] | Slice(GCR_EL1, 0, 16);
    rtag : bits(4) = undefined;
    if AArch64_AllocationTagAccessIsEnabled(AccType_NORMAL) then {
        if Slice(GCR_EL1, 16, 1) == 0b1 then {
            RGSR_EL1 = __UNKNOWN_bits(64);
            if IsOnes(exclude) then {
                rtag = 0b0000
            } else {
                rtag = ChooseRandomNonExcludedTag(exclude)
            }
        } else {
            let start : bits(4) = Slice(RGSR_EL1, 0, 4);
            let offset : bits(4) = AArch64_RandomTag();
            rtag = AArch64_ChooseNonExcludedTag(start, offset, exclude);
            RGSR_EL1 = SetSlice(4, RGSR_EL1, 0, rtag)
        }
    } else {
        rtag = 0b0000
    };
    let result : bits(64) = AArch64_AddressWithAllocationTag(operand, AccType_NORMAL, rtag);
    if d == 31 then {
        SP_set(64) = result
    } else {
        X_set(64, d) = result
    }
}

