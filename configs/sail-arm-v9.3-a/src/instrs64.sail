val execute_aarch64_instrs_memory_atomicops_ld_acc : forall 'n 't ('tag_checked : Bool),
  (0 <= 't & 't <= 31 & 0 <= 'n & 'n <= 31).
  (bits(2), int('n), int('t), bool('tag_checked)) -> unit

function execute_aarch64_instrs_memory_atomicops_ld_acc (lst, n, t, tag_checked) = {
    CheckLDST64BEnabled();
    address : bits(64) = undefined;
    value_name : bits(64) = undefined;
    let acctype : AccType = AccType_ATOMICLS64;
    if HaveMTE2Ext() then {
        SetTagCheckedInstruction(tag_checked)
    };
    if n == 31 then {
        CheckSPAlignment();
        address = SP_read(64)
    } else {
        address = X_read(64, n)
    };
    SetLoadStoreType(lst);
    AArch64_SetLSInstructionSyndrome(64, false, t, true, false);
    let data : bits(512) = MemLoad64B(address, acctype);
    foreach (i from 0 to 7 by 1 in inc) {
        value_name = data[63 + 64 * i .. 64 * i];
        if BigEndian(acctype) then {
            value_name = BigEndianReverse(value_name)
        };
        X_set(64, t + i) = value_name
    }
}

val decode_ld64b_aarch64_instrs_memory_atomicops_ld_acc : (bits(5), bits(5)) -> unit

function decode_ld64b_aarch64_instrs_memory_atomicops_ld_acc (Rt, Rn) = {
    if not_bool(HaveFeatLS64()) then {
        throw(Error_Undefined())
    };
    if Rt[4 .. 3] == 0b11 | [Rt[0]] == 0b1 then {
        throw(Error_Undefined())
    };
    let 'n = UInt(Rn);
    let 't = UInt(Rt);
    let tag_checked : bool = n != 31;
    let lst : bits(2) = lst_64b;
    execute_aarch64_instrs_memory_atomicops_ld_acc(lst, n, t, tag_checked)
}

