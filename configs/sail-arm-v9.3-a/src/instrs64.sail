        if ElemP_read(mask, e, esize) == 0b1 then {
            let 'eoff = offset * elements + e;
            let addr : bits(64) = base + eoff * mbytes;
            result = Elem_set(result, e, esize, Mem_read(addr, mbytes, AccType_SVE))
        } else {
            result = Elem_set(result, e, esize, Zeros())
        }
    };
    Z_set(VL, t) = ZeroExtend(Replicate(result, VL_div_256), VL)
}

