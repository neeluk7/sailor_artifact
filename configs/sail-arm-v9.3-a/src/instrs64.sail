    if not_bool(HaveMTEExt()) then {
        throw(Error_Undefined())
    };
    let 'd = UInt(Xd);
    let 'n = UInt(Xn);
    let 'm = UInt(Xm);
    execute_aarch64_instrs_integer_tags_mcinsertrandomtag(d, m, n)
}

