    source_is_sp : bool = false;
    let 'd = UInt(Rd);
    let 'n = UInt(Rn);
    if not_bool(HavePACExt()) then {
        throw(Error_Undefined())
    };
    if Z == 0b0 then {
        if n == 31 then {
            source_is_sp = true
        };
        ()
    } else {
        if n != 31 then {
            throw(Error_Undefined())
        };
        ()
    };
    execute_aarch64_instrs_integer_pac_pacia_dp_1src(d, n, source_is_sp)
}

