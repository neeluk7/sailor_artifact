      },
      1280 => {
          execute_FMOPA_ZA_PP_ZZ_64(1280, 160, DIV(1280, esize) * DIV(1280, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1408 => {
          execute_FMOPA_ZA_PP_ZZ_64(1408, 176, DIV(1408, esize) * DIV(1408, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1536 => {
          execute_FMOPA_ZA_PP_ZZ_64(1536, 192, DIV(1536, esize) * DIV(1536, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1664 => {
          execute_FMOPA_ZA_PP_ZZ_64(1664, 208, DIV(1664, esize) * DIV(1664, esize) * esize, a, b, da, esize, m, n, sub_op)
      },
      1792 => {
          execute_FMOPA_ZA_PP_ZZ_64(1792, 224, DIV(1792, esize) * DIV(1792, esize) * esize, a, b, da, esize, m, n, sub_op)
