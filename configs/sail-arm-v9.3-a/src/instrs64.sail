val execute_aarch64_instrs_integer_flags_axflag : unit -> unit

function execute_aarch64_instrs_integer_flags_axflag () = {
    let N : bits(1) = 0b0;
    let Z : bits(1) = PSTATE.Z | PSTATE.V;
    let C : bits(1) = PSTATE.C & not_vec(PSTATE.V);
    let V : bits(1) = 0b0;
    PSTATE.N = N;
    PSTATE.Z = Z;
    PSTATE.C = C;
