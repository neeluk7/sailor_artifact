function decode_ldarb_aarch64_instrs_memory_ordered (Rt, Rn, Rt2, o0, Rs, L, size) = {
    let 'n = UInt(Rn);
    let 't = UInt(Rt);
    let 't2 = UInt(Rt2);
    let 's = UInt(Rs);
    let acctype : AccType = if o0 == 0b0 then AccType_LIMITEDORDERED else
      AccType_ORDERED;
    let memop : MemOp = if L == 0b1 then MemOp_LOAD else MemOp_STORE;
    let 'elsize = (8 << UInt(size));
    let 'regsize = if elsize == 64 then 64 else 32;
    let 'datasize = elsize;
    let tag_checked : bool = n != 31;
    execute_aarch64_instrs_memory_ordered(acctype, datasize, memop, n, regsize, t, tag_checked)
}

