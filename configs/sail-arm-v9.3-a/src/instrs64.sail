    let tag : bits(4) = AArch64_AllocationTagFromAddress(data);
    AArch64_MemTag_set(address, AccType_NORMAL) = tag;
    if writeback then {
        if postindex then {
            address = address + offset
        };
        if n == 31 then {
            SP_set(64) = address
        } else {
            X_set(64, n) = address
        }
    };
    ()
}

