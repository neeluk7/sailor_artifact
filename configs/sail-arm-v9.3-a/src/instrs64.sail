    if not_bool(HaveSM3Ext()) then {
        throw(Error_Undefined())
    };
    let 'd = UInt(Rd);
    let 'n = UInt(Rn);
    let 'm = UInt(Rm);
    execute_aarch64_instrs_vector_crypto_sm3_sm3partw1(d, m, n)
}

