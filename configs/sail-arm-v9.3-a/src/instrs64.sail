val execute_LASTA_R_P_Z__ : forall 'PL 'VL 'd 'esize 'g ('isBefore : Bool) 'n 'rsize,
  ('rsize in {32, 64} & 0 <= 'n & 'n <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize in {8, 16, 32, 64} & 0 <= 'd & 'd <= 31 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('d), int('esize), int('g), bool('isBefore), int('n), int('rsize)) -> unit

function execute_LASTA_R_P_Z__ (VL, PL, d, esize, g, isBefore, n, rsize) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    let operand : bits('VL) = Z_read(VL, n);
    last : int = LastActiveElement(mask, esize);
    if isBefore then {
        if last < 0 then {
            last = elements - 1
        };
        ()
    } else {
        last = last + 1;
        if last >= elements then {
            last = 0
        };
        ()
    };
    let 'last = last;
    assert(constraint('rsize >= 'esize));
    let result : bits('rsize) = ZeroExtend(Elem_read(operand, last, esize));
    X_set(rsize, d) = result
}

val decode_LASTA_R_P_Z__ : (bits(2), bits(1), bits(3), bits(5), bits(5)) -> unit

function decode_LASTA_R_P_Z__ (size, B, Pg, Zn, Rd) = {
    let 'VL = VL_read();
    if not_bool(HaveSVE()) & not_bool(HaveSME()) then {
        throw(Error_Undefined())
