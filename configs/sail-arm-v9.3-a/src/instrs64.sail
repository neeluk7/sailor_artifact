val decode_shl_advsimd_aarch64_instrs_vector_shift_left_simd : (bits(5), bits(5), bits(3), bits(4), bits(1)) -> unit

function decode_shl_advsimd_aarch64_instrs_vector_shift_left_simd (Rd, Rn, immb, immh, Q) = {
    let 'd = UInt(Rd);
