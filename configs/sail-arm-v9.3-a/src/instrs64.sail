  (0 <= 't & 't <= 31 & 'scale == 2 & 'offs_size == 32 & 0 <= 'n & 'n <= 31 & 'msize == 32 & 0 <= 'm & 'm <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize == 64 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('esize), int('g), int('m), int('msize), int('n), int('offs_size), bool('offs_unsigned), int('scale), int('t), bool('is_unsigned)) -> unit

function execute_LDFF1SW_Z_P_BZ_D_x32_scaled (VL, PL, esize, g, m, msize, n, offs_size, offs_unsigned, scale, t, is_unsigned) = {
    CheckNonStreamingSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    base : bits(64) = undefined;
    offset : bits('VL) = undefined;
    result : bits('VL) = undefined;
    let orig : bits('VL) = Z_read(VL, t);
    data : bits('msize) = undefined;
    let 'mbytes = DIV(msize, 8);
    first : bool = true;
    fault : bool = false;
    faulted : bool = false;
    unknown : bool = false;
    if HaveMTEExt() then {
        SetTagCheckedInstruction(true)
    };
    if not_bool(AnyActiveElement(mask, esize)) then {
        if n == 31 & ConstrainUnpredictableBool(Unpredictable_CHECKSPNONEACTIVE) then {
            CheckSPAlignment()
        };
        ()
    } else {
        if n == 31 then {
            CheckSPAlignment()
        };
        base = if n == 31 then SP_read(64) else X_read(64, n);
        offset = Z_read(VL, m)
    };
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        if ElemP_read(mask, e, esize) == 0b1 then {
            let 'off = asl_Int(Elem_read(offset, e, esize)[offs_size - 1 .. 0], offs_unsigned);
            let addr : bits(64) = base + (off << scale);
            if first then {
                data = Mem_read(addr, mbytes, AccType_SVE);
                first = false
            } else {
                (data, fault) = MemNF_read(addr, mbytes, AccType_NONFAULT)
            }
        } else {
            (data, fault) = (Zeros(msize), false)
        };
        faulted = faulted | fault;
        if faulted then {
            ElemFFR_set(e, esize) = 0b0
        };
        unknown = unknown | ElemFFR_read(e, esize) == 0b0;
        if unknown then {
            if not_bool(fault) & ConstrainUnpredictableBool(Unpredictable_SVELDNFDATA) then {
                result = Elem_set(result, e, esize, Extend(data, esize, is_unsigned))
            } else if ConstrainUnpredictableBool(Unpredictable_SVELDNFZERO) then {
                result = Elem_set(result, e, esize, Zeros())
            } else {
                result = Elem_set(result, e, esize, Elem_read(orig, e, esize))
            }
        } else {
            result = Elem_set(result, e, esize, Extend(data, esize, is_unsigned))
        }
    };
    Z_set(VL, t) = result
}

