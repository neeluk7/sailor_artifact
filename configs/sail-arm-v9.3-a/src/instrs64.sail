val execute_EXT_Z_ZI_Con : forall 'VL 'VL_mul_2 'dst 'esize 'position 's1 's2,
  (0 <= 's1 & 's1 <= 31 & 0 <= 'position & 'position <= 255 & 'esize == 8 & 0 <= 'dst & 'dst <= 31 & is_VL('VL) & 'VL_mul_2 == 'VL * 2).
  (int('VL), int('VL_mul_2), int('dst), int('esize), int('position), int('s1), int('s2)) -> unit

function execute_EXT_Z_ZI_Con (VL, VL_mul_2, dst, esize, position__arg, s1, s2) = {
    position : int = position__arg;
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let operand1 : bits('VL) = Z_read(VL, s1);
    let operand2 : bits('VL) = Z_read(VL, s2);
    if position >= elements then {
        position = 0
    };
    let 'position = (position << 3);
    let concat : bits('VL_mul_2) = operand2 @ operand1;
    assert(constraint((0 <= 'position & 'position + 'VL - 1 < 'VL_mul_2)));
    let result : bits('VL) = concat[position + VL - 1 .. position];
    Z_set(VL, dst) = result
}

