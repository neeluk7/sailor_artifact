function execute_PFIRST_P_P_P__ (VL, PL, dn, esize, g) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    result : bits('PL) = P_read(PL, dn);
    first : int = negate(1);
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        if ElemP_read(mask, e, esize) == 0b1 & first == negate(1) then {
            first = e
        };
        ()
    };
    let 'first = first;
    if first >= 0 then {
        result = ElemP_set(result, first, esize, 0b1)
    };
    (PSTATE.N @ PSTATE.Z @ PSTATE.C @ PSTATE.V) = PredTest(mask, result, esize);
    P_set(PL, dn) = result
}

