  ('scale == 0 & 'offs_size == 32 & 0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 'level in {0, 1, 2, 3} & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize == 64 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('esize), int('g), int('level), int('m), int('n), int('offs_size), bool('offs_unsigned), PrefetchHint, int('scale), bool('stream)) -> unit

function execute_PRFB_I_P_BZ_D_x32_scaled (VL, PL, esize, g, level, m, n, offs_size, offs_unsigned, pref_hint, scale, stream) = {
