    let 'elements = DIV(datasize, esize);
    let is_unsigned : bool = U == 0b1;
    let accumulate : bool = ac == 0b1;
    execute_aarch64_instrs_vector_arithmetic_binary_uniform_diff(accumulate, d, datasize, elements, esize, m, n, is_unsigned)
}

