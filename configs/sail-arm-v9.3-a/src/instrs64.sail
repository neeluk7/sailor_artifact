val execute_ADDVA_ZA_PP_Z_64 : forall 'PL 'VL 'a 'b 'da 'dim_mul_mul 'esize 'n,
  (0 <= 'n & 'n <= 31 & 'esize == 64 & 'da in {0, 1, 2, 3, 4, 5, 6, 7} & 'b in {0, 1, 2, 3, 4, 5, 6, 7} & 'a in {0, 1, 2, 3, 4, 5, 6, 7} & is_VL('VL) & is_PL('PL) & 'dim_mul_mul == div('VL, 'esize) * (div('VL, 'esize) * 'esize)).
  (int('VL), int('PL), int('dim_mul_mul), int('a), int('b), int('da), int('esize), int('n)) -> unit

function execute_ADDVA_ZA_PP_Z_64 (VL, PL, dim_mul_mul, a, b, da, esize, n) = {
    CheckStreamingSVEAndZAEnabled();
    let 'dim = DIV(VL, esize);
    let mask1 : bits('PL) = P_read(PL, a);
    let mask2 : bits('PL) = P_read(PL, b);
    let operand_src : bits('VL) = Z_read(VL, n);
    let operand_acc : bits('dim_mul_mul) = ZAtile_read(dim_mul_mul, VL, da, esize);
    result : bits('dim_mul_mul) = undefined;
    foreach (row from 0 to (dim - 1) by 1 in inc) {
        let element : bits('esize) = Elem_read(operand_src, row, esize);
        foreach (col from 0 to (dim - 1) by 1 in inc) {
            res : bits('esize) = Elem_read(operand_acc, row * dim + col, esize);
            if ElemP_read(mask1, row, esize) == 0b1 & ElemP_read(mask2, col, esize) == 0b1 then {
                res = res + element
            };
            result = Elem_set(result, row * dim + col, esize, res)
        }
    };
    ZAtile_set(dim_mul_mul, VL, da, esize) = result
}

val decode_ADDVA_ZA_PP_Z_64 : (bits(1), bits(3), bits(3), bits(5), bits(3)) -> unit

function decode_ADDVA_ZA_PP_Z_64 (V, Pm, Pn, Zn, ZAda) = {
    let 'VL = VL_read();
    if not_bool(HaveSMEI16I64()) then {
        throw(Error_Undefined())
    };
    let 'esize = 64;
    let 'a = UInt(Pn);
    let 'b = UInt(Pm);
    let 'n = UInt(Zn);
    let 'da = UInt(ZAda);
    match VL {
      128 => {
          execute_ADDVA_ZA_PP_Z_64(128, 16, DIV(128, esize) * DIV(128, esize) * esize, a, b, da, esize, n)
      },
      256 => {
          execute_ADDVA_ZA_PP_Z_64(256, 32, DIV(256, esize) * DIV(256, esize) * esize, a, b, da, esize, n)
      },
      384 => {
          execute_ADDVA_ZA_PP_Z_64(384, 48, DIV(384, esize) * DIV(384, esize) * esize, a, b, da, esize, n)
      },
      512 => {
          execute_ADDVA_ZA_PP_Z_64(512, 64, DIV(512, esize) * DIV(512, esize) * esize, a, b, da, esize, n)
      },
      640 => {
          execute_ADDVA_ZA_PP_Z_64(640, 80, DIV(640, esize) * DIV(640, esize) * esize, a, b, da, esize, n)
      },
      768 => {
          execute_ADDVA_ZA_PP_Z_64(768, 96, DIV(768, esize) * DIV(768, esize) * esize, a, b, da, esize, n)
      },
      896 => {
          execute_ADDVA_ZA_PP_Z_64(896, 112, DIV(896, esize) * DIV(896, esize) * esize, a, b, da, esize, n)
      },
      1024 => {
          execute_ADDVA_ZA_PP_Z_64(1024, 128, DIV(1024, esize) * DIV(1024, esize) * esize, a, b, da, esize, n)
      },
      1152 => {
          execute_ADDVA_ZA_PP_Z_64(1152, 144, DIV(1152, esize) * DIV(1152, esize) * esize, a, b, da, esize, n)
      },
      1280 => {
          execute_ADDVA_ZA_PP_Z_64(1280, 160, DIV(1280, esize) * DIV(1280, esize) * esize, a, b, da, esize, n)
      },
      1408 => {
          execute_ADDVA_ZA_PP_Z_64(1408, 176, DIV(1408, esize) * DIV(1408, esize) * esize, a, b, da, esize, n)
      },
      1536 => {
          execute_ADDVA_ZA_PP_Z_64(1536, 192, DIV(1536, esize) * DIV(1536, esize) * esize, a, b, da, esize, n)
      },
      1664 => {
          execute_ADDVA_ZA_PP_Z_64(1664, 208, DIV(1664, esize) * DIV(1664, esize) * esize, a, b, da, esize, n)
      },
      1792 => {
          execute_ADDVA_ZA_PP_Z_64(1792, 224, DIV(1792, esize) * DIV(1792, esize) * esize, a, b, da, esize, n)
      },
      1920 => {
          execute_ADDVA_ZA_PP_Z_64(1920, 240, DIV(1920, esize) * DIV(1920, esize) * esize, a, b, da, esize, n)
      },
      2048 => {
          execute_ADDVA_ZA_PP_Z_64(2048, 256, DIV(2048, esize) * DIV(2048, esize) * esize, a, b, da, esize, n)
      },
      _ => ()
    }
}

function clause __DecodeA64 ((pc, ([bitone, bitone, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, bitone, bitone, bitzero, bitone, bitzero, bitzero, bitzero, bitone, _, _, _, _, _, _, _, _, _, _, _, bitzero, bitzero, _, _, _] as __opcode)) if SEE < 50) = {
