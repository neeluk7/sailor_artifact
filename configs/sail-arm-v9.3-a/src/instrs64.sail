      _ => ()
    }
}

function clause __DecodeA64 ((pc, ([bitone, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, bitone, bitone, bitzero, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, bitone, bitzero, _, _, _] as __opcode)) if SEE < 4) = {
    SEE = 4;
    let Zm = Slice(__opcode, 16, 5);
    let Pm = Slice(__opcode, 13, 3);
    let Pn = Slice(__opcode, 10, 3);
    let Zn = Slice(__opcode, 5, 5);
    let S = Slice(__opcode, 4, 1);
    let ZAda = Slice(__opcode, 0, 3);
    decode_FMOPS_ZA_PP_ZZ_64(Zm, Pm, Pn, Zn, S, ZAda)
}

val execute_BFMOPA_ZA32_PP_ZZ__ : forall 'PL 'VL 'VL_div_32 'a 'b 'da 'dim_mul_mul 'm 'n ('sub_op : Bool),
  (0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 'da in {0, 1, 2, 3} & 'b in {0, 1, 2, 3, 4, 5, 6, 7} & 'a in {0, 1, 2, 3, 4, 5, 6, 7} & is_VL('VL) & is_PL('PL) & 'VL_div_32 == div('VL, 32) & 'dim_mul_mul == div('VL, 32) * (div('VL, 32) * 32)).
  (int('VL), int('PL), int('VL_div_32), int('dim_mul_mul), int('a), int('b), int('da), int('m), int('n), bool('sub_op)) -> unit

function execute_BFMOPA_ZA32_PP_ZZ__ (VL, PL, VL_div_32, dim_mul_mul, a, b, da, m, n, sub_op) = {
    CheckStreamingSVEAndZAEnabled();
    let 'dim = VL_div_32;
    let mask1 : bits('PL) = P_read(PL, a);
    let mask2 : bits('PL) = P_read(PL, b);
    let operand1 : bits('VL) = Z_read(VL, n);
    let operand2 : bits('VL) = Z_read(VL, m);
    let operand3 : bits('dim_mul_mul) = ZAtile_read(dim_mul_mul, VL, da, 32);
    result : bits('dim_mul_mul) = undefined;
    foreach (row from 0 to (dim - 1) by 1 in inc) {
        foreach (col from 0 to (dim - 1) by 1 in inc) {
            let prow_0 : bool = ElemP_read(mask1, 2 * row + 0, 16) == 0b1;
            let prow_1 : bool = ElemP_read(mask1, 2 * row + 1, 16) == 0b1;
            let pcol_0 : bool = ElemP_read(mask2, 2 * col + 0, 16) == 0b1;
            let pcol_1 : bool = ElemP_read(mask2, 2 * col + 1, 16) == 0b1;
            sum : bits(32) = Elem_read(operand3, row * dim + col, 32);
            if prow_0 & pcol_0 | prow_1 & pcol_1 then {
                erow_0 : bits(16) = if prow_0 then
                  Elem_read(operand1, 2 * row + 0, 16)
                else
                  FPZero(16, 0b0);
                erow_1 : bits(16) = if prow_1 then
                  Elem_read(operand1, 2 * row + 1, 16)
                else
                  FPZero(16, 0b0);
                let ecol_0 : bits(16) = if pcol_0 then
                  Elem_read(operand2, 2 * col + 0, 16)
                else
                  FPZero(16, 0b0);
                let ecol_1 : bits(16) = if pcol_1 then
                  Elem_read(operand2, 2 * col + 1, 16)
                else
                  FPZero(16, 0b0);
                if sub_op then {
                    if prow_0 then {
                        erow_0 = BFNeg(erow_0)
                    };
                    if prow_1 then {
                        erow_1 = BFNeg(erow_1)
                    };
                    ()
                };
                sum = BFDotAdd(sum, erow_0, erow_1, ecol_0, ecol_1, FPCR_read())
            };
            result = Elem_set(result, row * dim + col, 32, sum)
        }
    };
    ZAtile_set(dim_mul_mul, VL, da, 32) = result
}

