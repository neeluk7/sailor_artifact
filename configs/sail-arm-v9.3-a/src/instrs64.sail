            AArch64_Abort(address, AlignmentFault(AccType_NORMAL, true, false))
        };
        Mem_set(address, TAG_GRANULE, AccType_NORMAL) = Zeros(TAG_GRANULE * 8);
        Mem_set(address + TAG_GRANULE, TAG_GRANULE, AccType_NORMAL) = Zeros(TAG_GRANULE * 8)
    };
    AArch64_MemTag_set(address, AccType_NORMAL) = tag;
    AArch64_MemTag_set(address + TAG_GRANULE, AccType_NORMAL) = tag;
    if writeback then {
        if postindex then {
            address = address + offset
        };
        if n == 31 then {
            SP_set(64) = address
        } else {
            X_set(64, n) = address
        }
    };
    ()
}

