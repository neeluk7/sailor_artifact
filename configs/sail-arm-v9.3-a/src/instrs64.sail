  (0 <= 't & 't <= 31 & 'scale == 1 & 'offs_size == 64 & 0 <= 'n & 'n <= 31 & 'msize == 16 & 0 <= 'm & 'm <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize == 64 & is_VL('VL) & is_PL('PL)).
