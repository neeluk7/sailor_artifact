function clause __DecodeA64 ((pc, ([bitzero, bitone, bitzero, bitzero, bitzero, bitone, bitzero, bitone, _, _, bitzero, _, _, _, _, _, bitone, bitone, bitone, bitzero, bitone, bitzero, _, _, _, _, _, _, _, _, _, _] as __opcode)) if SEE < 745) = {
