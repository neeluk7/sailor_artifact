  (0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 0 <= 'g & 'g <= 15 & 'esize in {8, 16, 32, 64} & 0 <= 'd & 'd <= 31 & is_VL('VL) & is_PL('PL)).
