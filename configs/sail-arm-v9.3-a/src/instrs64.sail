function execute_aarch64_instrs_vector_crypto_sha3op_sha1_hash_choose (d, m, n) = {
    AArch64_CheckFPAdvSIMDEnabled();
    X : bits(128) = V_read(128, d);
    Y : bits(32) = V_read(32, n);
    let W : bits(128) = V_read(128, m);
    t : bits(32) = undefined;
