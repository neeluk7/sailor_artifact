function clause __DecodeA64 ((pc, ([bitone, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, bitone, bitone, bitzero, bitone, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, bitzero, bitzero, bitzero, _, _] as __opcode)) if SEE < 7) = {
    SEE = 7;
    let Zm = Slice(__opcode, 16, 5);
    let Pm = Slice(__opcode, 13, 3);
    let Pn = Slice(__opcode, 10, 3);
    let Zn = Slice(__opcode, 5, 5);
    let S = Slice(__opcode, 4, 1);
    let ZAda = Slice(__opcode, 0, 2);
    decode_FMOPA_ZA32_PP_ZZ_16(Zm, Pm, Pn, Zn, S, ZAda)
}

val execute_FMOPS_ZA32_PP_ZZ_16 : forall 'PL 'VL 'VL_div_32 'a 'b 'da 'dim_mul_mul 'm 'n ('sub_op : Bool),
  (0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 'da in {0, 1, 2, 3} & 'b in {0, 1, 2, 3, 4, 5, 6, 7} & 'a in {0, 1, 2, 3, 4, 5, 6, 7} & is_VL('VL) & is_PL('PL) & 'VL_div_32 == div('VL, 32) & 'dim_mul_mul == div('VL, 32) * (div('VL, 32) * 32)).
  (int('VL), int('PL), int('VL_div_32), int('dim_mul_mul), int('a), int('b), int('da), int('m), int('n), bool('sub_op)) -> unit

function execute_FMOPS_ZA32_PP_ZZ_16 (VL, PL, VL_div_32, dim_mul_mul, a, b, da, m, n, sub_op) = {
    CheckStreamingSVEAndZAEnabled();
    let 'dim = VL_div_32;
    let mask1 : bits('PL) = P_read(PL, a);
    let mask2 : bits('PL) = P_read(PL, b);
    let operand1 : bits('VL) = Z_read(VL, n);
    let operand2 : bits('VL) = Z_read(VL, m);
    let operand3 : bits('dim_mul_mul) = ZAtile_read(dim_mul_mul, VL, da, 32);
    result : bits('dim_mul_mul) = undefined;
    foreach (row from 0 to (dim - 1) by 1 in inc) {
        foreach (col from 0 to (dim - 1) by 1 in inc) {
            let prow_0 : bool = ElemP_read(mask1, 2 * row + 0, 16) == 0b1;
            let prow_1 : bool = ElemP_read(mask1, 2 * row + 1, 16) == 0b1;
            let pcol_0 : bool = ElemP_read(mask2, 2 * col + 0, 16) == 0b1;
            let pcol_1 : bool = ElemP_read(mask2, 2 * col + 1, 16) == 0b1;
            sum : bits(32) = Elem_read(operand3, row * dim + col, 32);
            if prow_0 & pcol_0 | prow_1 & pcol_1 then {
                erow_0 : bits(16) = if prow_0 then
                  Elem_read(operand1, 2 * row + 0, 16)
                else
                  FPZero(16, 0b0);
                erow_1 : bits(16) = if prow_1 then
                  Elem_read(operand1, 2 * row + 1, 16)
                else
                  FPZero(16, 0b0);
                let ecol_0 : bits(16) = if pcol_0 then
                  Elem_read(operand2, 2 * col + 0, 16)
                else
                  FPZero(16, 0b0);
                let ecol_1 : bits(16) = if pcol_1 then
                  Elem_read(operand2, 2 * col + 1, 16)
                else
                  FPZero(16, 0b0);
                if sub_op then {
                    if prow_0 then {
                        erow_0 = FPNeg(erow_0)
                    };
                    if prow_1 then {
                        erow_1 = FPNeg(erow_1)
                    };
                    ()
                };
                sum = FPDotAdd_ZA(sum, erow_0, erow_1, ecol_0, ecol_1, FPCR_read())
            };
            result = Elem_set(result, row * dim + col, 32, sum)
        }
    };
    ZAtile_set(dim_mul_mul, VL, da, 32) = result
}

val decode_FMOPS_ZA32_PP_ZZ_16 : (bits(5), bits(3), bits(3), bits(5), bits(1), bits(2)) -> unit

function decode_FMOPS_ZA32_PP_ZZ_16 (Zm, Pm, Pn, Zn, S, ZAda) = {
    let 'VL = VL_read();
    if not_bool(HaveSME()) then {
        throw(Error_Undefined())
    };
    let 'a = UInt(Pn);
    let 'b = UInt(Pm);
    let 'n = UInt(Zn);
    let 'm = UInt(Zm);
    let 'da = UInt(ZAda);
    let sub_op : bool = true;
    match VL {
      128 => {
          execute_FMOPS_ZA32_PP_ZZ_16(128, 16, DIV(128, 32), DIV(128, 32) * DIV(128, 32) * 32, a, b, da, m, n, sub_op)
      },
      256 => {
          execute_FMOPS_ZA32_PP_ZZ_16(256, 32, DIV(256, 32), DIV(256, 32) * DIV(256, 32) * 32, a, b, da, m, n, sub_op)
      },
      384 => {
          execute_FMOPS_ZA32_PP_ZZ_16(384, 48, DIV(384, 32), DIV(384, 32) * DIV(384, 32) * 32, a, b, da, m, n, sub_op)
      },
      512 => {
          execute_FMOPS_ZA32_PP_ZZ_16(512, 64, DIV(512, 32), DIV(512, 32) * DIV(512, 32) * 32, a, b, da, m, n, sub_op)
      },
      640 => {
          execute_FMOPS_ZA32_PP_ZZ_16(640, 80, DIV(640, 32), DIV(640, 32) * DIV(640, 32) * 32, a, b, da, m, n, sub_op)
      },
      768 => {
          execute_FMOPS_ZA32_PP_ZZ_16(768, 96, DIV(768, 32), DIV(768, 32) * DIV(768, 32) * 32, a, b, da, m, n, sub_op)
      },
      896 => {
          execute_FMOPS_ZA32_PP_ZZ_16(896, 112, DIV(896, 32), DIV(896, 32) * DIV(896, 32) * 32, a, b, da, m, n, sub_op)
      },
      1024 => {
          execute_FMOPS_ZA32_PP_ZZ_16(1024, 128, DIV(1024, 32), DIV(1024, 32) * DIV(1024, 32) * 32, a, b, da, m, n, sub_op)
      },
      1152 => {
          execute_FMOPS_ZA32_PP_ZZ_16(1152, 144, DIV(1152, 32), DIV(1152, 32) * DIV(1152, 32) * 32, a, b, da, m, n, sub_op)
      },
      1280 => {
          execute_FMOPS_ZA32_PP_ZZ_16(1280, 160, DIV(1280, 32), DIV(1280, 32) * DIV(1280, 32) * 32, a, b, da, m, n, sub_op)
      },
      1408 => {
          execute_FMOPS_ZA32_PP_ZZ_16(1408, 176, DIV(1408, 32), DIV(1408, 32) * DIV(1408, 32) * 32, a, b, da, m, n, sub_op)
      },
      1536 => {
          execute_FMOPS_ZA32_PP_ZZ_16(1536, 192, DIV(1536, 32), DIV(1536, 32) * DIV(1536, 32) * 32, a, b, da, m, n, sub_op)
      },
      1664 => {
          execute_FMOPS_ZA32_PP_ZZ_16(1664, 208, DIV(1664, 32), DIV(1664, 32) * DIV(1664, 32) * 32, a, b, da, m, n, sub_op)
      },
      1792 => {
          execute_FMOPS_ZA32_PP_ZZ_16(1792, 224, DIV(1792, 32), DIV(1792, 32) * DIV(1792, 32) * 32, a, b, da, m, n, sub_op)
      },
      1920 => {
          execute_FMOPS_ZA32_PP_ZZ_16(1920, 240, DIV(1920, 32), DIV(1920, 32) * DIV(1920, 32) * 32, a, b, da, m, n, sub_op)
      },
      2048 => {
          execute_FMOPS_ZA32_PP_ZZ_16(2048, 256, DIV(2048, 32), DIV(2048, 32) * DIV(2048, 32) * 32, a, b, da, m, n, sub_op)
      },
      _ => ()
    }
}

function clause __DecodeA64 ((pc, ([bitone, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, bitone, bitone, bitzero, bitone, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, bitone, bitzero, bitzero, _, _] as __opcode)) if SEE < 8) = {
    SEE = 8;
    let Zm = Slice(__opcode, 16, 5);
