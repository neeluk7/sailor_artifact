function decode_ADD_Z_ZI__ (size, sh, imm8, Zdn) = {
    let 'VL = VL_read();
    if not_bool(HaveSVE()) & not_bool(HaveSME()) then {
        throw(Error_Undefined())
    };
    if (size @ sh) == 0b001 then {
        throw(Error_Undefined())
    };
    let 'esize = (8 << UInt(size));
    let 'dn = UInt(Zdn);
    imm : int = UInt(imm8);
    if sh == 0b1 then {
        imm = (imm << 8)
    };
    let 'imm = imm;
    match VL {
      128 => {
          execute_ADD_Z_ZI__(128, dn, esize, imm)
      },
      256 => {
          execute_ADD_Z_ZI__(256, dn, esize, imm)
      },
      384 => {
          execute_ADD_Z_ZI__(384, dn, esize, imm)
      },
      512 => {
          execute_ADD_Z_ZI__(512, dn, esize, imm)
      },
      640 => {
          execute_ADD_Z_ZI__(640, dn, esize, imm)
      },
      768 => {
          execute_ADD_Z_ZI__(768, dn, esize, imm)
      },
      896 => {
          execute_ADD_Z_ZI__(896, dn, esize, imm)
      },
      1024 => {
          execute_ADD_Z_ZI__(1024, dn, esize, imm)
      },
      1152 => {
          execute_ADD_Z_ZI__(1152, dn, esize, imm)
      },
      1280 => {
          execute_ADD_Z_ZI__(1280, dn, esize, imm)
      },
      1408 => {
          execute_ADD_Z_ZI__(1408, dn, esize, imm)
      },
      1536 => {
