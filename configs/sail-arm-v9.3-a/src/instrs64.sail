    let 'datasize = if Q == 0b1 then 128 else 64;
    let 'elements = DIV(datasize, 32);
    execute_aarch64_instrs_vector_arithmetic_binary_uniform_mat_mul_int_usdot(d, datasize, elements, m, n)
}

