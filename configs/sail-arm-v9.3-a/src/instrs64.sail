val execute_LD4D_Z_P_BI_Contiguous : forall 'PL 'VL 'esize 'g 'n 'nreg 'offset 't,
  (0 <= 't & 't <= 31 & 'nreg == 4 & 0 <= 'n & 'n <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize == 64 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('esize), int('g), int('n), int('nreg), int('offset), int('t)) -> unit

function execute_LD4D_Z_P_BI_Contiguous (VL, PL, esize, g, n, nreg, offset, t) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    base : bits(64) = undefined;
    let mask : bits('PL) = P_read(PL, g);
    let 'mbytes = DIV(esize, 8);
    values_name : vector(4, inc, bits('VL)) = undefined;
    if HaveMTEExt() then {
        SetTagCheckedInstruction(n != 31)
    };
    if not_bool(AnyActiveElement(mask, esize)) then {
        if n == 31 & ConstrainUnpredictableBool(Unpredictable_CHECKSPNONEACTIVE) then {
            CheckSPAlignment()
        };
        ()
    } else {
        if n == 31 then {
            CheckSPAlignment()
        };
        base = if n == 31 then SP_read(64) else X_read(64, n)
    };
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        foreach (r from 0 to (nreg - 1) by 1 in inc) {
            if ElemP_read(mask, e, esize) == 0b1 then {
                let 'eoff = offset * elements * nreg + e * nreg + r;
                let addr : bits(64) = base + eoff * mbytes;
                values_name[r] = Elem_set(values_name[r], e, esize, Mem_read(addr, mbytes, AccType_SVE))
            } else {
                values_name[r] = Elem_set(values_name[r], e, esize, Zeros())
            }
        }
    };
    foreach (r from 0 to (nreg - 1) by 1 in inc) {
        Z_set(VL, MOD(t + r, 32)) = values_name[r]
    }
}

