val execute_ZERO_ZA_I__ : forall 'SVL 'dim_mul_mul 'esize,
  ('esize == 64 & is_VL('SVL) & 'dim_mul_mul == div('SVL, 'esize) * (div('SVL, 'esize) * 'esize)).
  (int('SVL), int('dim_mul_mul), int('esize), bits(8)) -> unit

function execute_ZERO_ZA_I__ (SVL, dim_mul_mul, esize, mask) = {
    CheckSMEAndZAEnabled();
    let 'dim = DIV(SVL, esize);
    let result : bits('dim_mul_mul) = Zeros();
    if HaveTME() & TSTATE.depth > 0 then {
        FailTransaction(TMFailure_ERR, false)
    };
    foreach (i from 0 to 7 by 1 in inc) {
        if [mask[i]] == 0b1 then {
            ZAtile_set(dim_mul_mul, SVL, i, esize) = result
        };
        ()
    }
}

