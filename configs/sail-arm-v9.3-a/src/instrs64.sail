          execute_ZERO_ZA_I__(640, DIV(640, esize) * DIV(640, esize) * esize, esize, mask)
      },
      768 => {
          execute_ZERO_ZA_I__(768, DIV(768, esize) * DIV(768, esize) * esize, esize, mask)
      },
      896 => {
          execute_ZERO_ZA_I__(896, DIV(896, esize) * DIV(896, esize) * esize, esize, mask)
      },
      1024 => {
          execute_ZERO_ZA_I__(1024, DIV(1024, esize) * DIV(1024, esize) * esize, esize, mask)
      },
      1152 => {
          execute_ZERO_ZA_I__(1152, DIV(1152, esize) * DIV(1152, esize) * esize, esize, mask)
      },
      1280 => {
          execute_ZERO_ZA_I__(1280, DIV(1280, esize) * DIV(1280, esize) * esize, esize, mask)
      },
      1408 => {
          execute_ZERO_ZA_I__(1408, DIV(1408, esize) * DIV(1408, esize) * esize, esize, mask)
