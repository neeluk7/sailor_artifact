        t = SHAchoose(X[63 .. 32], X[95 .. 64], X[127 .. 96]);
        Y = Y + ROL(X[31 .. 0], 5) + t + Elem_read(W, e, 32);
        X[63 .. 32] = ROL(X[63 .. 32], 30);
        (Y @ X) = ROL(Y @ X, 32)
    };
    V_set(128, d) = X
}

