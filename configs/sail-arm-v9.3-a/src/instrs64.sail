val execute_LDR_ZA_RI__ : forall 'SVL 'SVL_div_8 'imm 'n 'v,
  (0 <= 'v & 'v <= 31 & 0 <= 'n & 'n <= 31 & 0 <= 'imm & 'imm <= 15 & is_VL('SVL) & 'SVL_div_8 == div('SVL, 8)).
  (int('SVL), int('SVL_div_8), int('imm), int('n), int('v)) -> unit

function execute_LDR_ZA_RI__ (SVL, SVL_div_8, imm, n, v) = {
    CheckSMEAndZAEnabled();
    let 'dim = SVL_div_8;
    base : bits(64) = undefined;
    offset : int = imm * dim;
    result : bits('SVL) = undefined;
    let idx : bits(32) = X_read(32, v);
    let 'vec = MOD(UInt(idx) + imm, dim);
    if HaveTME() & TSTATE.depth > 0 then {
        FailTransaction(TMFailure_ERR, false)
    };
    if n == 31 then {
        if HaveMTEExt() then {
            SetTagCheckedInstruction(false)
        };
        CheckSPAlignment();
        base = SP_read(64)
    } else {
        if HaveMTEExt() then {
            SetTagCheckedInstruction(true)
        };
        base = X_read(64, n)
    };
    let aligned : bool = AArch64_CheckAlignment(base + offset, 16, AccType_SME, false);
    foreach (e from 0 to (dim - 1) by 1 in inc) {
        let 'offset = offset in
          {
              result = Elem_set(result, e, 8, AArch64_MemSingle_read(base + offset, 1, AccType_SME, aligned))
          };
        offset = offset + 1
    };
    ZAvector_set(SVL, vec) = result
}

