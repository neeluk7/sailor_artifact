    let 'regsize = datasize;
    let ldacctype : AccType = if L == 0b1 then AccType_ORDEREDATOMICRW else
      AccType_ATOMICRW;
    let stacctype : AccType = if o0 == 0b1 then AccType_ORDEREDATOMICRW else
      AccType_ATOMICRW;
