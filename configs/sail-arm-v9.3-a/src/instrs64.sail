    let 'n = UInt(Rn);
    let 'm = UInt(Rm);
    let 'esize = (8 << UInt(size));
    let 'datasize = if Q == 0b1 then 128 else 64;
    let 'elements = DIV(datasize, esize);
    execute_aarch64_instrs_vector_arithmetic_binary_uniform_mul_int_dotp(d, datasize, elements, esize, m, n, is_signed)
}

