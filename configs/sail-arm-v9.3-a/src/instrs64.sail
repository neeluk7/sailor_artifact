        throw(Error_Undefined())
    };
    let 'd = UInt(Rd);
    let 'n = UInt(Rn);
    let 'm = UInt(Rm);
    let 'esize = 16;
    let 'datasize = esize;
    let 'elements = 1;
    execute_aarch64_instrs_vector_arithmetic_binary_uniform_recps_fp16_sisd(d, datasize, elements, esize, m, n)
}

