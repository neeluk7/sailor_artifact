    if not_bool(HaveSHA512Ext()) then {
        throw(Error_Undefined())
    };
    let 'd = UInt(Rd);
    let 'n = UInt(Rn);
    let 'm = UInt(Rm);
    execute_aarch64_instrs_vector_crypto_sha512_sha512h2(d, m, n)
}

