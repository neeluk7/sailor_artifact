val execute_aarch64_instrs_memory_vector_single_no_wb : forall 'datasize 'esize 'index 'm 'n ('replicate : Bool) 'selem 't ('tag_checked : Bool) ('wback : Bool),
  ('esize in {8, 16, 32, 64} & 0 <= 't & 't <= 31 & 'selem in {1, 2, 3, 4} & 0 <= 'n & 'n <= 31 & 'datasize in {64, 128}).
  (int('datasize), int('esize), int('index), int('m), MemOp, int('n), bool('replicate), int('selem), int('t), bool('tag_checked), bool('wback)) -> unit

val execute_aarch64_instrs_memory_vector_single_no_wb : forall 'datasize 'esize 'index 'm 'n ('replicate : Bool) 'selem 't ('tag_checked : Bool) ('wback : Bool),
  (0 <= 't & 't <= 31 & 'selem in {1, 2, 3, 4} & 0 <= 'n & 'n <= 31 & 'datasize in {64, 128}).
  (int('datasize), int('esize), int('index), int('m), MemOp, int('n), bool('replicate), int('selem), int('t), bool('tag_checked), bool('wback)) -> unit

function execute_aarch64_instrs_memory_vector_single_no_wb (datasize, esize, index, m, memop, n, replicate, selem, t__arg, tag_checked, wback) = {
    t : int = t__arg;
    if HaveMTE2Ext() then {
        SetTagCheckedInstruction(tag_checked)
    };
    CheckFPAdvSIMDEnabled64();
    address : bits(64) = undefined;
    rval : bits(128) = undefined;
    element : bits('esize) = undefined;
    let 'ebytes = DIV(esize, 8);
    if n == 31 then {
        CheckSPAlignment();
        address = SP_read(64)
    } else {
        address = X_read(64, n)
    };
    offs : bits(64) = Zeros();
    if replicate then {
        foreach (s from 0 to (selem - 1) by 1 in inc) {
            element = Mem_read(address + offs, ebytes, AccType_VEC);
            V_set(esize * DIV(datasize, esize), t) = Replicate(element, DIV(datasize, esize));
            offs = offs + ebytes;
            t = MOD(t + 1, 32)
        }
    } else {
        foreach (s from 0 to (selem - 1) by 1 in inc) {
            rval = V_read(128, t);
            if memop == MemOp_LOAD then {
                rval = Elem_set(rval, index, esize, Mem_read(address + offs, ebytes, AccType_VEC));
                V_set(128, t) = rval
            } else {
                Mem_set(address + offs, ebytes, AccType_VEC) = Elem_read(rval, index, esize)
            };
            offs = offs + ebytes;
            t = MOD(t + 1, 32)
        }
    };
    if wback then {
        if m != 31 then {
            offs = X_read(64, m)
        };
        if n == 31 then {
            SP_set(64) = address + offs
        } else {
            X_set(64, n) = address + offs
        }
    };
    ()
}

val decode_ld1_advsimd_sngl_aarch64_instrs_memory_vector_single_no_wb : (bits(5), bits(5), bits(2), bits(1), bits(3), bits(1), bits(1), bits(1)) -> unit

function decode_ld1_advsimd_sngl_aarch64_instrs_memory_vector_single_no_wb (Rt, Rn, size, S, opcode, R, L, Q) = {
    let 't = UInt(Rt);
    let 'n = UInt(Rn);
    let 'm = __UNKNOWN_integer();
    let wback : bool = false;
    let tag_checked : bool = wback | n != 31;
    let 'init_scale = UInt(opcode[2 .. 1]);
    scale : int = init_scale;
    let 'selem = UInt([opcode[0]] @ R) + 1;
    replicate : bool = false;
    index : int = undefined;
    match scale {
      3 => {
          if L == 0b0 | S == 0b1 then {
              throw(Error_Undefined())
          };
          scale = UInt(size);
          replicate = true
      },
      0 => {
          index = UInt((Q @ S) @ size)
      },
      1 => {
          if [size[0]] == 0b1 then {
              throw(Error_Undefined())
          };
          index = UInt((Q @ S) @ [size[1]])
      },
      2 => {
          if [size[1]] == 0b1 then {
              throw(Error_Undefined())
          };
          if [size[0]] == 0b0 then {
              index = UInt(Q @ S)
          } else {
              if S == 0b1 then {
                  throw(Error_Undefined())
              };
              index = UInt(Q);
              scale = 3
          }
      },
      _ => ()
    };
    let 'scale = scale;
    let 'index = index;
    let memop : MemOp = if L == 0b1 then MemOp_LOAD else MemOp_STORE;
    let 'datasize = if Q == 0b1 then 128 else 64;
    let 'esize = (8 << scale);
    assert(constraint('esize in {8, 16, 32, 64}));
    execute_aarch64_instrs_memory_vector_single_no_wb(datasize, esize, index, m, memop, n, replicate, selem, t, tag_checked, wback)
}

function clause __DecodeA64 ((pc, ([bitzero, _, bitzero, bitzero, bitone, bitone, bitzero, bitone, bitzero, bitone, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, _, _, bitzero, _, _, _, _, _, _, _, _, _, _, _, _, _] as __opcode)) if SEE < 1511) = {
    SEE = 1511;
