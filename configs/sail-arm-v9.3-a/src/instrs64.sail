val execute_TBL_Z_ZZ_1 : forall 'VL 'VL_mul_2 'd ('double_table : Bool) 'esize 'm 'n,
  (0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 'esize in {8, 16, 32, 64} & 0 <= 'd & 'd <= 31 & is_VL('VL) & 'VL_mul_2 == 'VL * 2).
  (int('VL), int('VL_mul_2), int('d), bool('double_table), int('esize), int('m), int('n)) -> unit

function execute_TBL_Z_ZZ_1 (VL, VL_mul_2, d, double_table, esize, m, n) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let indexes : bits('VL) = Z_read(VL, m);
    result : bits('VL) = undefined;
    let 'table_size = if double_table then VL_mul_2 else VL;
    let 'table_elems = DIV(table_size, esize);
    table : bits('table_size) = undefined;
    if double_table then {
        let top : bits('VL) = Z_read(VL, MOD(n + 1, 32));
        let bottom : bits('VL) = Z_read(VL, n);
        table = (top @ bottom)[table_size - 1 .. 0]
    } else {
        assert(constraint((0 <= 'table_size - 1 & 'table_size - 1 < 2048 | not(('n >= 0 & 'n <= 31)) | 'double_table)));
        table = Z_read(table_size, n)
    };
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        let 'idx = UInt(Elem_read(indexes, e, esize));
        result = Elem_set(result, e, esize, if idx < table_elems then
          Elem_read(table, idx, esize)
        else
          Zeros())
    };
    Z_set(VL, d) = result
}

