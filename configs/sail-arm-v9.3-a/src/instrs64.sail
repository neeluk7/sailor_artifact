function execute_CMPEQ_P_P_ZI__ (VL, PL, d, esize, g, imm, n, op, is_unsigned) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    let operand1 : bits('VL) = if AnyActiveElement(mask, esize) then
      Z_read(VL, n)
    else
      Zeros();
    result : bits('PL) = undefined;
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        let 'element1 = asl_Int(Elem_read(operand1, e, esize), is_unsigned);
        if ElemP_read(mask, e, esize) == 0b1 then {
            cond : bool = undefined;
            match op {
              Cmp_EQ => {
                  cond = element1 == imm
              },
              Cmp_NE => {
