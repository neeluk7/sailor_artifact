val execute_aarch64_instrs_memory_atomicops_st_acc_st64bv0 : forall 'n 's 't ('tag_checked : Bool),
  (0 <= 't & 't <= 31 & 0 <= 's & 's <= 31 & 0 <= 'n & 'n <= 31).
  (bits(5), bits(2), int('n), int('s), int('t), bool('tag_checked)) -> unit

function execute_aarch64_instrs_memory_atomicops_st_acc_st64bv0 (Rs, lst, n, s, t, tag_checked) = {
    CheckST64BV0Enabled();
    data : bits(512) = undefined;
    address : bits(64) = undefined;
    value_name : bits(64) = undefined;
    let acctype : AccType = AccType_ATOMICLS64;
    if HaveMTE2Ext() then {
        SetTagCheckedInstruction(tag_checked)
    };
    let Xt : bits(64) = X_read(64, t);
    value_name[31 .. 0] = ACCDATA_EL1[31 .. 0];
    value_name[63 .. 32] = Xt[63 .. 32];
    if BigEndian(acctype) then {
        value_name = BigEndianReverse(value_name)
    };
    data[63 .. 0] = value_name;
    foreach (i from 1 to 7 by 1 in inc) {
        value_name = X_read(64, t + i);
        if BigEndian(acctype) then {
            value_name = BigEndianReverse(value_name)
        };
        data[63 + 64 * i .. 64 * i] = value_name
    };
    if n == 31 then {
        CheckSPAlignment();
        address = SP_read(64)
    } else {
        address = X_read(64, n)
    };
    SetLoadStoreType(lst);
    AArch64_SetLSInstructionSyndrome(64, false, t, true, false);
    SetIss2(Rs);
    let status : bits(64) = MemStore64BWithRet(address, data, acctype);
    if s != 31 then {
        X_set(64, s) = status
    };
    ()
}

