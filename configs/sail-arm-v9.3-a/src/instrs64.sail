    let 'd = UInt(Rd);
    let 'n = UInt(Rn);
    if not_bool(HaveAESExt()) then {
        throw(Error_Undefined())
    };
    let decrypt : bool = D == 0b1;
    execute_aarch64_instrs_vector_crypto_aes_round(d, decrypt, n)
}

