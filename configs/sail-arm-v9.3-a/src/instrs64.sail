val execute_ST1Q_ZA_P_RRR__ : forall 'PL 'VL 'esize 'g 'imm 'm 'n 's 't ('vertical : Bool),
  (0 <= 't & 't <= 15 & 0 <= 's & 's <= 31 & 0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 'imm == 0 & 0 <= 'g & 'g <= 15 & 'esize == 128 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('esize), int('g), int('imm), int('m), int('n), int('s), int('t), bool('vertical)) -> unit

function execute_ST1Q_ZA_P_RRR__ (VL, PL, esize, g, imm, m, n, s, t, vertical) = {
    CheckStreamingSVEAndZAEnabled();
    let 'dim = DIV(VL, esize);
    base : bits(64) = undefined;
    addr : bits(64) = undefined;
    let mask : bits('PL) = P_read(PL, g);
    offset : bits(64) = X_read(64, m);
    let index : bits(32) = X_read(32, s);
    let 'slice_name = MOD(UInt(index) + imm, dim);
    let 'mbytes = DIV(esize, 8);
    if HaveMTEExt() then {
        SetTagCheckedInstruction(true)
    };
    if n == 31 then {
        if AnyActiveElement(mask, esize) | ConstrainUnpredictableBool(Unpredictable_CHECKSPNONEACTIVE) then {
            CheckSPAlignment()
        };
        base = SP_read(64)
    } else {
        base = X_read(64, n)
    };
    let src : bits('VL) = ZAslice_read(VL, t, esize, vertical, slice_name);
    foreach (e from 0 to (dim - 1) by 1 in inc) {
        addr = base + UInt(offset) * mbytes;
        if ElemP_read(mask, e, esize) == 0b1 then {
            Mem_set(addr, mbytes, AccType_SME) = Elem_read(src, e, esize)
        };
        offset = offset + 1
    }
}

val decode_ST1Q_ZA_P_RRR__ : (bits(5), bits(1), bits(2), bits(3), bits(5), bits(4)) -> unit

function decode_ST1Q_ZA_P_RRR__ (Rm, V, Rs, Pg, Rn, ZAt) = {
    let 'VL = VL_read();
    if not_bool(HaveSME()) then {
        throw(Error_Undefined())
    };
    let 'n = UInt(Rn);
    let 'm = UInt(Rm);
    let 'g = UInt(0b0 @ Pg);
    let 's = UInt(0b011 @ Rs);
    let 't = UInt(ZAt);
    let 'imm = 0;
    let 'esize = 128;
    let vertical : bool = V == 0b1;
    match VL {
      128 => {
          execute_ST1Q_ZA_P_RRR__(128, 16, esize, g, imm, m, n, s, t, vertical)
      },
      256 => {
          execute_ST1Q_ZA_P_RRR__(256, 32, esize, g, imm, m, n, s, t, vertical)
      },
