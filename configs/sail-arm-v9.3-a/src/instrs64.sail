        throw(Error_Undefined())
    };
    let 'd = UInt(Rd);
    let 'n = UInt(Rn);
    let 'm = UInt(Rm);
    let 'esize = 16;
    let 'datasize = if Q == 0b1 then 128 else 64;
    let 'elements = DIV(datasize, esize);
    let pair : bool = U == 0b1;
    execute_aarch64_instrs_vector_arithmetic_binary_uniform_add_fp16(d, datasize, elements, esize, m, n, pair)
}

