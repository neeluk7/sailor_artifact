    foreach (e from 0 to (elements - 1) by 1 in inc) {
        element1 = Elem_read(operand1, e, esize);
        element2 = Elem_read(operand2, e, esize);
        result = Elem_set(result, e, esize, FPRSqrtStepFused(element1, element2))
    };
    V_set(128, d) = result
}

