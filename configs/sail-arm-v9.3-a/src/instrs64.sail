val execute_ADDP_Z_P_ZZ__ : forall 'PL 'VL 'dn 'esize 'g 'm,
  (0 <= 'm & 'm <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize in {8, 16, 32, 64} & 0 <= 'dn & 'dn <= 31 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('dn), int('esize), int('g), int('m)) -> unit

function execute_ADDP_Z_P_ZZ__ (VL, PL, dn, esize, g, m) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    let operand1 : bits('VL) = Z_read(VL, dn);
    let operand2 : bits('VL) = if AnyActiveElement(mask, esize) then
      Z_read(VL, m)
    else
      Zeros();
    result : bits('VL) = undefined;
    element1 : int = undefined;
    element2 : int = undefined;
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        if ElemP_read(mask, e, esize) == 0b0 then {
            result = Elem_set(result, e, esize, Elem_read(operand1, e, esize))
        } else {
            if IsEven(e) then {
                element1 = UInt(Elem_read(operand1, e + 0, esize));
