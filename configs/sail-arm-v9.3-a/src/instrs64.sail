    let 'datasize = if Q == 0b1 then 128 else 64;
    let 'elements = DIV(datasize, esize);
    execute_aarch64_instrs_vector_arithmetic_binary_uniform_add_wrapping_pair(d, datasize, elements, esize, m, n)
}

