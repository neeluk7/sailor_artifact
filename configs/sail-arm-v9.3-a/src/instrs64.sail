val execute_CPY_Z_P_R__ : forall 'PL 'VL 'd 'esize 'g 'n,
  (0 <= 'n & 'n <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize in {8, 16, 32, 64} & 0 <= 'd & 'd <= 31 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('d), int('esize), int('g), int('n)) -> unit

function execute_CPY_Z_P_R__ (VL, PL, d, esize, g, n) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    result : bits('VL) = Z_read(VL, d);
    if AnyActiveElement(mask, esize) then {
        operand1 : bits(64) = undefined;
        if n == 31 then {
            operand1 = SP_read(64)
        } else {
            operand1 = X_read(64, n)
        };
        foreach (e from 0 to (elements - 1) by 1 in inc) {
            if ElemP_read(mask, e, esize) == 0b1 then {
                result = Elem_set(result, e, esize, operand1[esize - 1 .. 0])
            };
            ()
        }
    };
    Z_set(VL, d) = result
}

