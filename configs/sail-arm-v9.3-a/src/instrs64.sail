  (0 <= 'v & 'v <= 31 & 0 <= 'n & 'n <= 15 & 0 <= 'm & 'm <= 15 & 0 <= 'imm & 'imm <= 15 & 'esize in {8, 16, 32, 64} & 0 <= 'd & 'd <= 15 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('d), int('esize), int('imm), int('m), int('n), int('v)) -> unit

function execute_PSEL_P_PPi__ (VL, PL, d, esize, imm, m, n, v) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let operand1 : bits('PL) = P_read(PL, n);
    let operand2 : bits('PL) = P_read(PL, m);
    let idx : bits(32) = X_read(32, v);
    let 'element = MOD(UInt(idx) + imm, elements);
    result : bits('PL) = undefined;
    if ElemP_read(operand2, element, esize) == 0b1 then {
        result = operand1
    } else {
        result = Zeros()
    };
    P_set(PL, d) = result
}

val decode_PSEL_P_PPi__ : (bits(1), bits(1), bits(3), bits(2), bits(4), bits(1), bits(4), bits(4)) -> unit

function decode_PSEL_P_PPi__ (i1, tszh, tszl, Rv, Pn, S, Pm, Pd) = {
    let 'VL = VL_read();
    if not_bool(HaveSME()) then {
        throw(Error_Undefined())
    };
    let imm5 : bits(5) = (i1 @ tszh) @ tszl;
    esize : {|8, 16, 32, 64|} = 8;
    imm : range(0, 15) = undefined;
    match tszh @ tszl {
      0b0000 => {
          throw(Error_Undefined())
      },
      0b1000 => {
          esize = 64;
          imm = UInt([imm5[4]])
      },
      [_, bitone, bitzero, bitzero] => {
          esize = 32;
          imm = UInt(imm5[4 .. 3])
      },
      [_, _, bitone, bitzero] => {
          esize = 16;
          imm = UInt(imm5[4 .. 2])
      },
      [_, _, _, bitone] => {
          esize = 8;
          imm = UInt(imm5[4 .. 1])
      }
    };
    let 'imm = imm;
    let 'esize = esize;
    let 'n = UInt(Pn);
    let 'm = UInt(Pm);
    let 'd = UInt(Pd);
    let 'v = UInt(0b011 @ Rv);
    match VL {
      128 => {
          execute_PSEL_P_PPi__(128, 16, d, esize, imm, m, n, v)
      },
      256 => {
          execute_PSEL_P_PPi__(256, 32, d, esize, imm, m, n, v)
      },
      384 => {
          execute_PSEL_P_PPi__(384, 48, d, esize, imm, m, n, v)
      },
      512 => {
          execute_PSEL_P_PPi__(512, 64, d, esize, imm, m, n, v)
      },
      640 => {
          execute_PSEL_P_PPi__(640, 80, d, esize, imm, m, n, v)
      },
      768 => {
          execute_PSEL_P_PPi__(768, 96, d, esize, imm, m, n, v)
      },
      896 => {
          execute_PSEL_P_PPi__(896, 112, d, esize, imm, m, n, v)
      },
      1024 => {
          execute_PSEL_P_PPi__(1024, 128, d, esize, imm, m, n, v)
      },
      1152 => {
          execute_PSEL_P_PPi__(1152, 144, d, esize, imm, m, n, v)
      },
      1280 => {
          execute_PSEL_P_PPi__(1280, 160, d, esize, imm, m, n, v)
      },
      1408 => {
          execute_PSEL_P_PPi__(1408, 176, d, esize, imm, m, n, v)
      },
      1536 => {
          execute_PSEL_P_PPi__(1536, 192, d, esize, imm, m, n, v)
      },
      1664 => {
          execute_PSEL_P_PPi__(1664, 208, d, esize, imm, m, n, v)
      },
      1792 => {
          execute_PSEL_P_PPi__(1792, 224, d, esize, imm, m, n, v)
      },
      1920 => {
          execute_PSEL_P_PPi__(1920, 240, d, esize, imm, m, n, v)
      },
      2048 => {
          execute_PSEL_P_PPi__(2048, 256, d, esize, imm, m, n, v)
      },
      _ => ()
    }
}

