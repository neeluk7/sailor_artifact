        values_name[r] = Z_read(VL, MOD(t + r, 32))
    };
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        foreach (r from 0 to (nreg - 1) by 1 in inc) {
            if ElemP_read(mask, e, esize) == 0b1 then {
                let 'eoff = UInt(offset) + e * nreg + r;
