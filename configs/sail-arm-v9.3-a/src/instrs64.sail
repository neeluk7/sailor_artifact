    if not_bool(HaveSM3Ext()) then {
        throw(Error_Undefined())
    };
    let 'd = UInt(Rd);
    let 'n = UInt(Rn);
    let 'm = UInt(Rm);
    let 'i = UInt(imm2);
    execute_aarch64_instrs_vector_crypto_sm3_sm3tt1a(d, i, m, n)
}

