  (int('VL), int('PL), int('esize), int('g), int('m), int('msize), int('n), int('offs_size), bool('offs_unsigned), int('scale), int('t), bool('is_unsigned)) -> unit

function execute_LD1W_Z_P_BZ_S_x32_scaled (VL, PL, esize, g, m, msize, n, offs_size, offs_unsigned, scale, t, is_unsigned) = {
    CheckNonStreamingSVEEnabled();
    let 'elements = DIV(VL, esize);
    base : bits(64) = undefined;
    let mask : bits('PL) = P_read(PL, g);
    offset : bits('VL) = undefined;
    result : bits('VL) = undefined;
    data : bits('msize) = undefined;
    let 'mbytes = DIV(msize, 8);
    if HaveMTEExt() then {
        SetTagCheckedInstruction(true)
    };
    if not_bool(AnyActiveElement(mask, esize)) then {
        if n == 31 & ConstrainUnpredictableBool(Unpredictable_CHECKSPNONEACTIVE) then {
            CheckSPAlignment()
        };
        ()
    } else {
        if n == 31 then {
            CheckSPAlignment()
        };
        base = if n == 31 then SP_read(64) else X_read(64, n);
        offset = Z_read(VL, m)
    };
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        if ElemP_read(mask, e, esize) == 0b1 then {
            let 'off = asl_Int(Elem_read(offset, e, esize)[offs_size - 1 .. 0], offs_unsigned);
            let addr : bits(64) = base + (off << scale);
            data = Mem_read(addr, mbytes, AccType_SVE);
            result = Elem_set(result, e, esize, Extend(data, esize, is_unsigned))
        } else {
            result = Elem_set(result, e, esize, Zeros())
        }
    };
    Z_set(VL, t) = result
