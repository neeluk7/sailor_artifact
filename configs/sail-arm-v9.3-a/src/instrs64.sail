val execute_URECPE_Z_P_Z__ : forall 'PL 'VL 'd 'esize 'g 'n,
  (0 <= 'n & 'n <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize == 32 & 0 <= 'd & 'd <= 31 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('d), int('esize), int('g), int('n)) -> unit

function execute_URECPE_Z_P_Z__ (VL, PL, d, esize, g, n) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    let operand : bits('VL) = if AnyActiveElement(mask, esize) then
      Z_read(VL, n)
    else
      Zeros();
    result : bits('VL) = Z_read(VL, d);
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        if ElemP_read(mask, e, esize) == 0b1 then {
            let element : bits('esize) = Elem_read(operand, e, esize);
            result = Elem_set(result, e, esize, UnsignedRecipEstimate(element))
        };
        ()
    };
    Z_set(VL, d) = result
}

