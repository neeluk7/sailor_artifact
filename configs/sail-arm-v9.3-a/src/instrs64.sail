val execute_SQSHLU_Z_P_ZI__ : forall 'PL 'VL 'dn 'esize 'g 'shift,
  ('g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize in {8, 16, 32, 64} & 0 <= 'dn & 'dn <= 31 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('dn), int('esize), int('g), int('shift)) -> unit

function execute_SQSHLU_Z_P_ZI__ (VL, PL, dn, esize, g, shift) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let operand1 : bits('VL) = Z_read(VL, dn);
    let mask : bits('PL) = P_read(PL, g);
    result : bits('VL) = undefined;
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        let 'element1 = SInt(Elem_read(operand1, e, esize));
        if ElemP_read(mask, e, esize) == 0b1 then {
            let 'res = (element1 << shift);
            result = Elem_set(result, e, esize, UnsignedSat(res, esize))
        } else {
            result = Elem_set(result, e, esize, Elem_read(operand1, e, esize))
        }
    };
    Z_set(VL, dn) = result
}

