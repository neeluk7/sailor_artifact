    let 'd = UInt(Rd);
    let 'n = UInt(Rn);
    let 'm = UInt(Rmhi @ Rm);
    let 'esize = (8 << UInt(size));
    let 'datasize = esize;
    let 'elements = 1;
    let rounding : bool = true;
    let sub_op : bool = S == 0b1;
    execute_aarch64_instrs_vector_arithmetic_binary_element_mul_acc_high_sisd(d, datasize, elements, esize, idxdsize, index, m, n, rounding, sub_op)
}

