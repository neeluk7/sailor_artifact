function execute_aarch64_instrs_system_tme_tcommit () = {
    CheckTMEEnabled();
    if TSTATE.depth == 0 then {
        throw(Error_Undefined())
    };
    if TSTATE.depth == 1 then {
        CommitTransactionalWrites();
        ClearExclusiveLocal(ProcessorID())
    };
    TSTATE.depth = TSTATE.depth - 1
}

