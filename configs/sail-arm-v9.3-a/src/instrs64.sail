  (0 <= 's & 's <= 31 & 0 <= 'n & 'n <= 31 & 0 <= 'imm & 'imm <= 15 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize == 8 & 'd == 0 & is_VL('VL) & is_PL('PL)).
