    let 'm = UInt(Rm);
    if Q == 0b0 & [imm4[3]] == 0b1 then {
        throw(Error_Undefined())
    };
    let 'datasize = if Q == 0b1 then 128 else 64;
    let 'position = (UInt(imm4) << 3);
    execute_aarch64_instrs_vector_transfer_vector_extract(d, datasize, m, n, position)
}

