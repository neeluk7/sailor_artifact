function execute_PNEXT_P_P_P__ (VL, PL, dn, esize, g) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    let operand : bits('PL) = P_read(PL, dn);
    next : int = LastActiveElement(operand, esize) + 1;
    while next < elements & ElemP_read(mask, next, esize) == 0b0 do {
        next = next + 1
    };
    let 'next = next;
    result : bits('PL) = Zeros();
    if next < elements then {
        result = ElemP_set(result, next, esize, 0b1)
    };
    (PSTATE.N @ PSTATE.Z @ PSTATE.C @ PSTATE.V) = PredTest(mask, result, esize);
    P_set(PL, dn) = result
}

