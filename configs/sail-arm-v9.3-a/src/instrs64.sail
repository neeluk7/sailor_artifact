function execute_SQDECP_Z_P_Z__ (VL, PL, dn, esize, m, is_unsigned) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let operand1 : bits('VL) = Z_read(VL, dn);
    let operand2 : bits('PL) = P_read(PL, m);
