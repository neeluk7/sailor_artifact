  (0 <= 'n & 'n <= 31 & 0 <= 'd & 'd <= 31 & is_VL('SVL) & 'SVL_div_64 == div('SVL, 64)).
  (int('SVL), int('SVL_div_64), int('d), int('imm), int('n)) -> unit

function execute_ADDSPL_R_RI__ (SVL, SVL_div_64, d, imm, n) = {
    CheckSMEEnabled();
    let 'len = imm * SVL_div_64;
    let operand1 : bits(64) = if n == 31 then SP_read(64) else X_read(64, n);
    let result : bits(64) = operand1 + len;
    if d == 31 then {
        SP_set(64) = result
    } else {
        X_set(64, d) = result
    }
}

