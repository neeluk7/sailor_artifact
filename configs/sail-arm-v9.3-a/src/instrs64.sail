function execute_aarch64_instrs_vector_crypto_sha512_sha512su0 (d, n) = {
    AArch64_CheckFPAdvSIMDEnabled();
    Vtmp : bits(128) = undefined;
    let X : bits(128) = V_read(128, n);
    let W : bits(128) = V_read(128, d);
