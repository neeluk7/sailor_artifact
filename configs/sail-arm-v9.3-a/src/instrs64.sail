    if not_bool(HaveMTE2Ext()) then {
        throw(Error_Undefined())
    };
    let 't = UInt(Xt);
    let 'n = UInt(Xn);
    execute_aarch64_instrs_integer_tags_mcsettagarray(n, t)
}

