    let sf = Slice(__opcode, 31, 1);
    decode_rmif_aarch64_instrs_integer_flags_rmif(mask, Rn, imm6, sf)
}

val execute_aarch64_instrs_system_tme_tstart : forall 'PL 'VL 't,
  (0 <= 't & 't <= 31 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('t)) -> unit

function execute_aarch64_instrs_system_tme_tstart (VL, PL, t) = {
    CheckTMEEnabled();
    IsEL1Regime : bool = undefined;
    tme : bits(1) = undefined;
    tmt : bits(1) = undefined;
    match PSTATE.EL {
      ? if ? == EL0 => {
          let IsEL1Regime : bool = S1TranslationRegime__1() == EL1;
          if IsEL1Regime then {
              tme = Slice(SCTLR_EL1, 52, 1);
              tmt = Slice(SCTLR_EL1, 50, 1)
          } else {
              tme = Slice(SCTLR_EL2, 52, 1);
              tmt = Slice(SCTLR_EL2, 50, 1)
          }
      },
      ? if ? == EL1 => {
          tme = Slice(SCTLR_EL1, 53, 1);
          tmt = Slice(SCTLR_EL1, 51, 1)
      },
      ? if ? == EL2 => {
          tme = Slice(SCTLR_EL2, 53, 1);
          tmt = Slice(SCTLR_EL2, 51, 1)
      },
      ? if ? == EL3 => {
          tme = Slice(SCTLR_EL3, 53, 1);
          tmt = Slice(SCTLR_EL3, 51, 1)
      },
      _ => {
          Unreachable()
      }
    };
    let enable : bool = tme == 0b1;
    let trivial : bool = tmt == 0b1;
    if not_bool(enable) then {
        TransactionStartTrap(t)
    } else if trivial then {
        TSTATE.nPC = NextInstrAddr(64);
        TSTATE.Rt = t;
        FailTransaction(TMFailure_TRIVIAL, false)
    } else if HaveSME() & PSTATE.SM == 0b1 then {
        FailTransaction(TMFailure_ERR, false)
    } else if TSTATE.depth == 255 then {
        FailTransaction(TMFailure_NEST, false)
    } else if TSTATE.depth == 0 then {
        TSTATE.nPC = NextInstrAddr(64);
        TSTATE.Rt = t;
        ClearExclusiveLocal(ProcessorID());
        TakeTransactionCheckpoint(VL, PL);
        StartTrackingTransactionalReadsWrites()
    } else ();
    TSTATE.depth = TSTATE.depth + 1;
    X_set(64, t) = Zeros(64)
}

val decode_tstart_aarch64_instrs_system_tme_tstart : bits(5) -> unit

function decode_tstart_aarch64_instrs_system_tme_tstart Rt = {
    let 'VL = VL_read();
    if not_bool(HaveTME()) then {
        throw(Error_Undefined())
    };
    let 't = UInt(Rt);
    match VL {
      128 => {
          execute_aarch64_instrs_system_tme_tstart(128, 16, t)
      },
      256 => {
          execute_aarch64_instrs_system_tme_tstart(256, 32, t)
      },
      384 => {
          execute_aarch64_instrs_system_tme_tstart(384, 48, t)
      },
      512 => {
          execute_aarch64_instrs_system_tme_tstart(512, 64, t)
      },
      640 => {
          execute_aarch64_instrs_system_tme_tstart(640, 80, t)
      },
      768 => {
          execute_aarch64_instrs_system_tme_tstart(768, 96, t)
      },
      896 => {
          execute_aarch64_instrs_system_tme_tstart(896, 112, t)
      },
      1024 => {
          execute_aarch64_instrs_system_tme_tstart(1024, 128, t)
      },
      1152 => {
          execute_aarch64_instrs_system_tme_tstart(1152, 144, t)
      },
      1280 => {
          execute_aarch64_instrs_system_tme_tstart(1280, 160, t)
      },
      1408 => {
          execute_aarch64_instrs_system_tme_tstart(1408, 176, t)
      },
      1536 => {
          execute_aarch64_instrs_system_tme_tstart(1536, 192, t)
      },
      1664 => {
          execute_aarch64_instrs_system_tme_tstart(1664, 208, t)
      },
      1792 => {
          execute_aarch64_instrs_system_tme_tstart(1792, 224, t)
      },
      1920 => {
          execute_aarch64_instrs_system_tme_tstart(1920, 240, t)
      },
      2048 => {
          execute_aarch64_instrs_system_tme_tstart(2048, 256, t)
      },
      _ => ()
    }
}

