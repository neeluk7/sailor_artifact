val execute_ST1B_Z_P_BR__ : forall 'PL 'VL 'esize 'g 'm 'msize 'n 't,
  (0 <= 't & 't <= 31 & 0 <= 'n & 'n <= 31 & 'msize == 8 & 0 <= 'm & 'm <= 31 & 'g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize in {8, 16, 32, 64} & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('esize), int('g), int('m), int('msize), int('n), int('t)) -> unit

function execute_ST1B_Z_P_BR__ (VL, PL, esize, g, m, msize, n, t) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    base : bits(64) = undefined;
    let mask : bits('PL) = P_read(PL, g);
    offset : bits(64) = undefined;
    src : bits('VL) = undefined;
    let 'mbytes = DIV(msize, 8);
    if HaveMTEExt() then {
        SetTagCheckedInstruction(true)
    };
    if not_bool(AnyActiveElement(mask, esize)) then {
        if n == 31 & ConstrainUnpredictableBool(Unpredictable_CHECKSPNONEACTIVE) then {
            CheckSPAlignment()
        };
        ()
    } else {
        if n == 31 then {
            CheckSPAlignment()
        };
        base = if n == 31 then SP_read(64) else X_read(64, n);
        offset = X_read(64, m);
        src = Z_read(VL, t)
    };
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        if ElemP_read(mask, e, esize) == 0b1 then {
            let addr : bits(64) = base + (UInt(offset) + e) * mbytes;
            Mem_set(addr, mbytes, AccType_SVE) = Elem_read(src, e, esize)[msize - 1 .. 0]
        };
        ()
    }
}

