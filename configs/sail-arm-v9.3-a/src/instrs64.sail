val execute_FADD_Z_P_ZS__ : forall 'PL 'VL 'dn 'esize 'g,
  ('g in {0, 1, 2, 3, 4, 5, 6, 7} & 'esize in {8, 16, 32, 64} & 0 <= 'dn & 'dn <= 31 & is_VL('VL) & is_PL('PL)).
  (int('VL), int('PL), int('dn), int('esize), int('g), bits('esize)) -> unit

function execute_FADD_Z_P_ZS__ (VL, PL, dn, esize, g, imm) = {
    CheckSVEEnabled();
    let 'elements = DIV(VL, esize);
    let mask : bits('PL) = P_read(PL, g);
    let operand1 : bits('VL) = Z_read(VL, dn);
    result : bits('VL) = undefined;
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        let element1 : bits('esize) = Elem_read(operand1, e, esize);
        if ElemP_read(mask, e, esize) == 0b1 then {
            assert(constraint('esize in {16, 32, 64}));
            result = Elem_set(result, e, esize, FPAdd(element1, imm, FPCR_read()))
        } else {
            result = Elem_set(result, e, esize, element1)
        }
    };
    Z_set(VL, dn) = result
}

val decode_FADD_Z_P_ZS__ : (bits(2), bits(3), bits(1), bits(5)) -> unit

function decode_FADD_Z_P_ZS__ (size, Pg, i1, Zdn) = {
    let 'VL = VL_read();
    if not_bool(HaveSVE()) & not_bool(HaveSME()) then {
        throw(Error_Undefined())
    };
    if size == 0b00 then {
        throw(Error_Undefined())
    };
    let 'esize = (8 << UInt(size));
    let 'g = UInt(Pg);
    let 'dn = UInt(Zdn);
    assert(constraint('esize in {16, 32, 64}));
    let imm : bits('esize) = if i1 == 0b0 then FPPointFive(esize, 0b0) else
      FPOne(esize, 0b0);
    match VL {
      128 => {
          execute_FADD_Z_P_ZS__(128, 16, dn, esize, g, imm)
      },
      256 => {
          execute_FADD_Z_P_ZS__(256, 32, dn, esize, g, imm)
      },
