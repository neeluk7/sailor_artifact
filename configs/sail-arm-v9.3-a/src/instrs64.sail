      },
      _ => ()
    }
}

function clause __DecodeA64 ((pc, ([bitone, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, bitzero, bitone, bitone, bitzero, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, bitzero, bitzero, _, _, _] as __opcode)) if SEE < 3) = {
    SEE = 3;
    let Zm = Slice(__opcode, 16, 5);
    let Pm = Slice(__opcode, 13, 3);
    let Pn = Slice(__opcode, 10, 3);
    let Zn = Slice(__opcode, 5, 5);
    let S = Slice(__opcode, 4, 1);
    let ZAda = Slice(__opcode, 0, 3);
    decode_FMOPA_ZA_PP_ZZ_64(Zm, Pm, Pn, Zn, S, ZAda)
}

val execute_FMOPS_ZA_PP_ZZ_64 : forall 'PL 'VL 'a 'b 'da 'dim_mul_mul 'esize 'm 'n ('sub_op : Bool),
  (0 <= 'n & 'n <= 31 & 0 <= 'm & 'm <= 31 & 'esize == 64 & 'da in {0, 1, 2, 3, 4, 5, 6, 7} & 'b in {0, 1, 2, 3, 4, 5, 6, 7} & 'a in {0, 1, 2, 3, 4, 5, 6, 7} & is_VL('VL) & is_PL('PL) & 'dim_mul_mul == div('VL, 'esize) * (div('VL, 'esize) * 'esize)).
  (int('VL), int('PL), int('dim_mul_mul), int('a), int('b), int('da), int('esize), int('m), int('n), bool('sub_op)) -> unit

function execute_FMOPS_ZA_PP_ZZ_64 (VL, PL, dim_mul_mul, a, b, da, esize, m, n, sub_op) = {
