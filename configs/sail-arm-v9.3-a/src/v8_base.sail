val AArch32_ClearEventCounters : unit -> unit

function AArch32_ClearEventCounters () = {
    if HaveAArch64() then {
        AArch64_ClearEventCounters();
        return()
    };
    let 'counters = AArch32_GetNumEventCountersAccessible();
    if counters != 0 then {
        foreach (idx from 0 to (counters - 1) by 1 in inc) {
            assert(constraint('loop_idx < 31));
            PMEVCNTR_set(idx) = Zeros()
        }
    };
    ()
}

val AArch32_PMUSwIncrement : bits(32) -> unit

function AArch32_PMUSwIncrement sw_incr = {
    if Slice(PMCR_read(), 0, 1) == 0b0 & Slice(HDCR_read(), 7, 1) == 0b0 then {
        return()
    };
    let 'counters = AArch32_GetNumEventCountersAccessible();
    if counters != 0 then {
        foreach (idx from 0 to (counters - 1) by 1 in inc) {
            assert(constraint('loop_idx < 32));
            if [sw_incr[idx]] == 0b1 then {
                PMUEvent__2(PMU_EVENT_SW_INCR, 1, idx)
            };
            ()
        }
    };
    ()
}

val MIDR_write : bits(32) -> unit

function MIDR_write val_name = {
    let r : bits(32) = val_name;
    MIDR_EL1 = SetSlice(32, MIDR_EL1, 0, Slice(r, 0, 32));
    return()
}

val AArch32_SysRegWrite : forall 'cp_num 't.
  (int('cp_num), bits(32), int('t)) -> unit

function AArch32_SysRegWrite (cp_num, instr, t) = {
    el : bits(2) = undefined;
    temprt : bits(32) = R_read(t);
    let (_, __tup_1 : bits(2)) = ELFromM32(PSTATE.M) in
      {
          el = __tup_1
      };
    let opc1 : bits(3) = Slice(instr, 21, 3);
    let CRn : bits(4) = Slice(instr, 16, 4);
    let CRm : bits(4) = Slice(instr, 0, 4);
    let opc2 : bits(3) = Slice(instr, 5, 3);
    if ((cp_num == 14 & opc1 == 0b000) & CRn == 0b0000) & opc2 == 0b101 then {
        temprt[8] = Bit([temprt[7]]);
        temprt[6] = Bit([temprt[5]])
    };
    if (((cp_num == 15 & opc1 == 0b000) & CRn == 0b0001) & CRm == 0b0000) & opc2 == 0b010 then {
        if ((not_bool(IsSecure()) & HaveEL(EL3)) & ELUsingAArch32(EL3)) & Slice(NSACR, 10, 1) == 0b0 then {
            temprt[23 .. 22] = Slice(CPACR_read__1(), 22, 2);
            temprt[21 .. 20] = Slice(CPACR_read__1(), 20, 2)
        };
        ()
    };
    if (((cp_num == 15 & opc1 == 0b000) & CRn == 0b1001) & (CRm == 0b1100 | CRm == 0b1110)) & (opc2 == 0b001 | opc2 == 0b010 | opc2 == 0b011) then {
        let mask : bits(32) = PMUCounterMask();
        if opc2 == 0b011 & CRm == 0b1100 then {
            temprt = PMOVSSET_read() & not_vec(temprt & mask)
        };
        if opc2 == 0b011 & CRm == 0b1110 then {
            temprt = PMOVSSET_read() | temprt & mask
        };
        if opc2 == 0b010 & CRm == 0b1100 then {
            temprt = PMCNTENSET_read() & not_vec(temprt & mask)
        };
        if opc2 == 0b001 & CRm == 0b1100 then {
            temprt = PMCNTENSET_read() | temprt & mask
        };
        if opc2 == 0b010 & CRm == 0b1110 then {
