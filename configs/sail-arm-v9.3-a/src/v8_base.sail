val AArch32_SysRegRead : forall 'cp_num 't.
  (int('cp_num), bits(32), int('t)) -> unit

function AArch32_SysRegRead (cp_num, instr, t) = {
    el : bits(2) = undefined;
    index : int = undefined;
    n : int = undefined;
    let (_, __tup_1 : bits(2)) = ELFromM32(PSTATE.M) in
      {
          el = __tup_1
      };
    let opc1 : bits(3) = Slice(instr, 21, 3);
    let CRn : bits(4) = Slice(instr, 16, 4);
    let CRm : bits(4) = Slice(instr, 0, 4);
    opc2 : bits(3) = Slice(instr, 5, 3);
    if (((cp_num == 15 & opc1 == 0b000) & (opc2 == 0b100 | opc2 == 0b111)) & CRn == 0b0000) & CRm == 0b0000 then {
        opc2 = 0b000
    };
    if (cp_num == 15 & opc1 == 0b000) & CRn == 0b1101 then {
        let 'n = UInt([CRm[0]] @ opc2);
        if CRm[3 .. 1] == 0b011 then {
            if n >= UInt(Slice(AMCGCR_read(), 0, 8)) then {
                throw(Error_Undefined())
            };
            ()
        };
        if CRm[3 .. 1] == 0b111 then {
            if n >= UInt(Slice(AMCGCR_read(), 8, 8)) then {
                throw(Error_Undefined())
            };
            ()
        };
        ()
    };
    if (((cp_num == 15 & opc1 == 0b000) & CRn == 0b1110) & (CRm[3 .. 2] == 0b10 | CRm[3 .. 2] == 0b11)) & (CRm[1 .. 0] @ opc2[2 .. 0]) != 0b11111 then {
        if UInt(CRm[1 .. 0] @ opc2[2 .. 0]) > GetNumEventCounters() - 1 | (EL2Enabled() & (PSTATE.EL == EL1 | PSTATE.EL == EL0 & (CRm[3 .. 2] == 0b10 & (Slice(PMUSERENR_EL0, 3, 1) @ Slice(PMUSERENR_EL0, 0, 1)) != 0b00 | CRm[3 .. 2] == 0b11 & Slice(PMUSERENR_EL0, 0, 1) == 0b1))) & UInt(CRm[1 .. 0] @ opc2[2 .. 0]) > AArch32_GetNumEventCountersAccessible() - 1 then {
            if UInt(CRm[1 .. 0] @ opc2[2 .. 0]) > GetNumEventCounters() - 1 then {
                throw(Error_Undefined())
            } else if ELUsingAArch32(EL2) then {
                AArch32_TakeHypTrapException(UInt(0x03))
            } else {
                AArch64_AArch32SystemAccessTrap(EL2, UInt(0x03))
            }
        };
        ()
    };
    if ((((cp_num == 15 & opc1 == 0b000) & CRn == 0b1001) & CRm == 0b1101) & (opc2 == 0b001 | opc2 == 0b010)) & Slice(PMSELR_EL0, 0, 5) != 0b11111 then {
        if UInt(Slice(PMSELR_EL0, 0, 5)) > GetNumEventCounters() - 1 | (EL2Enabled() & (PSTATE.EL == EL1 | PSTATE.EL == EL0 & (opc2 == 0b010 & (Slice(PMUSERENR_EL0, 3, 1) @ Slice(PMUSERENR_EL0, 0, 1)) != 0b00 | opc2 == 0b001 & Slice(PMUSERENR_EL0, 0, 1) == 0b1))) & UInt(Slice(PMSELR_read(), 0, 5)) > AArch32_GetNumEventCountersAccessible() - 1 then {
            if UInt(Slice(PMSELR_read(), 0, 5)) > GetNumEventCounters() - 1 then {
                throw(Error_Undefined())
            } else if ELUsingAArch32(EL2) then {
                AArch32_TakeHypTrapException(UInt(0x03))
            } else {
                AArch64_AArch32SystemAccessTrap(EL2, UInt(0x03))
            }
        };
        ()
    };
    let temp : bits(32) = R_read(t);
    AArch32_AutoGen_SysRegRead32(el, cp_num[3 .. 0], opc1, CRn, opc2, CRm, t);
    if (((cp_num == 15 & opc1 == 0b000) & CRn == 0b1001) & (CRm == 0b1100 | CRm == 0b1110)) & (opc2 == 0b001 | opc2 == 0b010 | opc2 == 0b011) then {
        let mask : bits(32) = PMUCounterMask();
        R_set(t) = R_read(t) & mask
    };
    if (((cp_num == 15 & opc1 == 0b000) & CRn == 0b1001) & CRm == 0b1101) & (opc2 == 0b001 | opc2 == 0b010) then {
        if opc2 == 0b001 then {
            let 'pmselr = UInt(Slice(PMSELR_read(), 0, 5));
            if ((EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & Slice(PMSELR_read(), 0, 5) != 0b11111) & UInt(Slice(PMSELR_read(), 0, 5)) > AArch32_GetNumEventCountersAccessible() - 1 then {
                if UInt(Slice(PMSELR_read(), 0, 5)) > GetNumEventCounters() - 1 then {
                    R_set(t) = temp;
                    throw(Error_Undefined())
                } else if ELUsingAArch32(EL2) then {
                    R_set(t) = temp;
                    AArch32_TakeHypTrapException(UInt(0x03))
                } else {
                    R_set(t) = temp;
                    AArch64_AArch32SystemAccessTrap(EL2, UInt(0x03))
                }
            } else if pmselr == 31 then {
                R_set(t) = PMCCFILTR_read()
            } else {
                R_set(t) = PMEVTYPER_read(pmselr)
            }
        };
        if opc2 == 0b010 then {
            if UInt(Slice(PMSELR_read(), 0, 5)) > GetNumEventCounters() - 1 | (EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & UInt(Slice(PMSELR_read(), 0, 5)) > AArch32_GetNumEventCountersAccessible() - 1 then {
                if UInt(Slice(PMSELR_read(), 0, 5)) > GetNumEventCounters() - 1 then {
                    R_set(t) = temp;
                    throw(Error_Undefined())
                } else if ELUsingAArch32(EL2) then {
                    R_set(t) = temp;
                    AArch32_TakeHypTrapException(UInt(0x03))
                } else {
                    R_set(t) = temp;
                    AArch64_AArch32SystemAccessTrap(EL2, UInt(0x03))
                }
            } else {
                let 'pmselr = UInt(Slice(PMSELR_read(), 0, 5));
                assert(pmselr < 31);
                R_set(t) = PMEVCNTR_read(pmselr)[31 .. 0]
            }
        };
        ()
    };
    if (((cp_num == 15 & opc1 == 0b000) & opc2 == 0b000) & CRn == 0b1001) & CRm == 0b1100 then {
        R_set(t) = [R_read(t) with 15 .. 11 = AArch32_GetNumEventCountersAccessible()[4 .. 0]]
    };
    if ((cp_num == 15 & opc1 == 0b000) & CRn == 0b1110) & (CRm[3 .. 2] == 0b10 | CRm[3 .. 2] == 0b11 & (CRm[1 .. 0] @ opc2[2 .. 0]) != 0b11111) then {
        if UInt(CRm[1 .. 0] @ opc2[2 .. 0]) > GetNumEventCounters() - 1 | (EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & UInt(CRm[1 .. 0] @ opc2[2 .. 0]) > AArch32_GetNumEventCountersAccessible() - 1 then {
            if UInt(CRm[1 .. 0] @ opc2[2 .. 0]) > GetNumEventCounters() - 1 then {
                R_set(t) = temp;
                throw(Error_Undefined())
            } else if ELUsingAArch32(EL2) then {
                R_set(t) = temp;
                AArch32_TakeHypTrapException(UInt(0x03))
            } else {
                R_set(t) = temp;
                AArch64_AArch32SystemAccessTrap(EL2, UInt(0x03))
            }
        };
        ()
    };
    if ((cp_num == 14 & opc1 == 0b000) & opc2 == 0b110) & CRn == 0b0111 then {
        if CRm == 0b1000 then {
            R_set(t) = [R_read(t) with 7 .. 0 = 0b11111111]
        };
        if CRm == 0b1001 then {
            R_set(t) = [R_read(t) with 7 .. 0 = __claim_tags]
        };
        return()
    };
    if (((cp_num == 14 & opc1 == 0b000) & opc2 == 0b010) & CRn == 0b0000) & CRm == 0b0010 then {
        R_set(t) = [R_read(t) with 18 .. 18 = if not_bool(IsSecure()) then 0b1
        else
          0b0];
        if HaveEL(EL3) then {
            if ELUsingAArch32(EL3) & Slice(SDCR, 17, 1) == 0b1 then {
                R_set(t) = [R_read(t) with 17 .. 17 = 0b0]
            } else if not_bool(ELUsingAArch32(EL3)) & Slice(MDCR_EL3, 17, 1) == 0b1 then {
                R_set(t) = [R_read(t) with 17 .. 17 = 0b0]
            } else {
                R_set(t) = [R_read(t) with 17 .. 17 = 0b1]
            }
        };
        return()
    };
    if (((cp_num == 15 & opc1 == 0b000) & opc2 == 0b000) & CRn == 0b1100) & CRm == 0b0001 then {
        R_set(t) = getISR();
        return()
    } else if (((cp_num == 15 & opc1 == 0b001) & (opc2 == 0b000 | opc2 == 0b010)) & CRn == 0b0000) & CRm == 0b0000 then {
        if opc2 == 0b000 then {
            R_set(t) = CacheConfigRead(CSSELR_read()[3 .. 0])[31 .. 0];
            return()
        } else {
            R_set(t) = CacheConfigRead(CSSELR_read()[3 .. 0])[63 .. 32];
            return()
        }
    } else ();
    if (((cp_num == 15 & opc1 == 0b000) & CRn == 0b0101) & CRm == 0b0100) & (opc2 == 0b000 | opc2 == 0b100) then {
        if UInt(Slice(ERRIDR_read(), 0, 16)) == UInt(0x0) | UInt(Slice(ERRSELR_read(), 0, 16)) >= UInt(Slice(ERRIDR_read(), 0, 16)) then {
            R_set(t) = Zeros()
        } else {
            let 'index = UInt(Slice(ERRSELR_read(), 0, 16));
            if opc2 == 0b000 then {
                assert(constraint('index < 4));
                R_set(t) = ERRnFR[index][31 .. 0]
            } else {
                assert(constraint('index < 4));
                R_set(t) = ERRnFR[index][63 .. 32]
            }
        }
    };
    if (((cp_num == 14 & opc1 == 0b000) & CRn == 0b0000) & CRm == 0b0101) & opc2 == 0b000 then {
        DBGDSCRint_write() = SetSlice(1, DBGDSCRint_read(), 30, 0b0);
        MDCCSR_EL0 = SetSlice(1, MDCCSR_EL0, 30, 0b0);
        DBGDSCRext_write() = SetSlice(1, DBGDSCRext_read(), 30, 0b0);
        EDSCR_write() = SetSlice(1, EDSCR_read(), 30, 0b0)
    };
    if (((cp_num == 15 & opc1 == 0b000) & CRn == 0b0001) & CRm == 0b0000) & opc2 == 0b010 then {
        if ((not_bool(IsSecure()) & HaveEL(EL3)) & ELUsingAArch32(EL3)) & Slice(NSACR, 10, 1) == 0b0 then {
            R_set(t) = [R_read(t) with 23 .. 20 = 0b0000]
        };
        ()
    };
    return()
}

