val EDECCR_write : bits(32) -> unit

function EDECCR_write val_name = {
    let r : bits(32) = val_name;
    OSECCR_EL1 = SetSlice(32, OSECCR_EL1, 0, Slice(r, 0, 32));
    return()
}

