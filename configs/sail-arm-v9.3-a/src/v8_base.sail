function TTBCR_NS_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(TCR_EL1, 0, 32));
    return(r)
}

register TTBCR_S : bits(32)

val TTBCR_read : unit -> bits(32)

function TTBCR_read () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = TTBCR_S
    } else {
        r = TTBCR_NS_read()
    };
    return(r)
}

val AArch32_ReportDataAbort : forall ('route_to_monitor : Bool).
  (bool('route_to_monitor), FaultRecord, bits(32)) -> unit

function AArch32_ReportDataAbort (route_to_monitor, fault, vaddress) = {
    long_format : bool = false;
    if route_to_monitor & not_bool(IsSecure()) then {
        long_format = Slice(TTBCR_S, 31, 1) == 0b1 | IsExternalSyncAbort__1(fault) & ((PSTATE.EL == EL2 | Slice(TTBCR_read(), 31, 1) == 0b1) | fault.secondstage & __IMPDEF_boolean("Stage 2 synchronous external abort reports using Long-descriptor format when TTBCR_S.EAE is 0b0"))
    } else {
        long_format = Slice(TTBCR_read(), 31, 1) == 0b1
    };
    let d_side : bool = true;
    syndrome : bits(32) = undefined;
    if long_format then {
        syndrome = AArch32_FaultStatusLD(d_side, fault)
    } else {
        syndrome = AArch32_FaultStatusSD(d_side, fault)
    };
    if fault.acctype == AccType_IC then {
        i_syndrome : bits(32) = undefined;
        if not_bool(long_format) & __IMPDEF_boolean("Report I-cache maintenance fault in IFSR") then {
            i_syndrome = syndrome;
            (syndrome[10 .. 10] @ syndrome[3 .. 0]) = EncodeSDFSC(Fault_ICacheMaint, 1)
        } else {
            i_syndrome = __UNKNOWN_bits(32)
        };
        if route_to_monitor then {
            IFSR_S = i_syndrome
        } else {
            IFSR_write() = i_syndrome
        }
    };
    if route_to_monitor then {
        DFSR_S = syndrome;
        DFAR_S_write() = vaddress
    } else {
        DFSR_write() = syndrome;
        DFAR_write() = vaddress
    };
    return()
}

register MDSCR_EL1 : bits(64)

register _DBGDSCRint_16_28 : bits(13)

val DBGDSCRint_read : unit -> bits(32)

function DBGDSCRint_read () = {
    r : bits(32) = undefined;
    r = SetSlice(2, r, 29, Slice(MDCCSR_EL0, 29, 2));
    r = SetSlice(1, r, 15, Slice(MDSCR_EL1, 15, 1));
    r = SetSlice(1, r, 12, Slice(MDSCR_EL1, 12, 1));
    r = SetSlice(4, r, 2, Slice(MDSCR_EL1, 2, 4));
    r = SetSlice(13, r, 16, _DBGDSCRint_16_28);
    return(r)
}

val DBGDSCRext_read : unit -> bits(32)

function DBGDSCRext_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(MDSCR_EL1, 0, 32));
    r = SetSlice(1, r, 15, Slice(DBGDSCRint_read(), 15, 1));
    r = SetSlice(1, r, 12, Slice(DBGDSCRint_read(), 12, 1));
    r = SetSlice(4, r, 2, Slice(DBGDSCRint_read(), 2, 4));
    return(r)
}

val DBGDSCRint_write : bits(32) -> unit

function DBGDSCRint_write val_name = {
    let r : bits(32) = val_name;
    MDCCSR_EL0 = SetSlice(2, MDCCSR_EL0, 29, Slice(r, 29, 2));
    MDSCR_EL1 = SetSlice(1, MDSCR_EL1, 15, Slice(r, 15, 1));
    MDSCR_EL1 = SetSlice(1, MDSCR_EL1, 12, Slice(r, 12, 1));
    MDSCR_EL1 = SetSlice(4, MDSCR_EL1, 2, Slice(r, 2, 4));
    _DBGDSCRint_16_28 = Slice(r, 16, 13);
    return()
}

val DBGDSCRext_write : bits(32) -> unit

function DBGDSCRext_write val_name = {
    let r : bits(32) = val_name;
    MDSCR_EL1 = SetSlice(32, MDSCR_EL1, 0, Slice(r, 0, 32));
    DBGDSCRint_write() = SetSlice(1, DBGDSCRint_read(), 15, Slice(r, 15, 1));
    DBGDSCRint_write() = SetSlice(1, DBGDSCRint_read(), 12, Slice(r, 12, 1));
    DBGDSCRint_write() = SetSlice(4, DBGDSCRint_read(), 2, Slice(r, 2, 4));
    return()
}

val HCR_read : unit -> bits(32)

function HCR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(HCR_EL2, 0, 32));
    return(r)
}

val HCR2_read : unit -> bits(32)

function HCR2_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(HCR_EL2, 32, 32));
    return(r)
}

val HDCR_read : unit -> bits(32)

function HDCR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(MDCR_EL2, 0, 32));
    return(r)
}

val AArch32_DataAbort : (bits(32), FaultRecord) -> unit

function AArch32_DataAbort (vaddress, fault) = {
    exception : ExceptionRecord = undefined;
    let route_to_monitor : bool = (HaveEL(EL3) & Slice(SCR, 3, 1) == 0b1) & IsExternalAbort__1(fault);
    let route_to_hyp : bool = (EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & (((Slice(HCR_read(), 27, 1) == 0b1 | (HaveRASExt() & Slice(HCR2_read(), 5, 1) == 0b1) & IsExternalAbort__1(fault)) | IsDebugException(fault) & Slice(HDCR_read(), 8, 1) == 0b1) | IsSecondStage(fault));
    let preferred_exception_return : bits(32) = ThisInstrAddr(32);
    let 'vect_offset = UInt(0x10);
    let 'lr_offset = 8;
    if IsDebugException(fault) then {
        DBGDSCRext_write() = SetSlice(4, DBGDSCRext_read(), 2, fault.debugmoe)
    };
    if route_to_monitor then {
        AArch32_ReportDataAbort(route_to_monitor, fault, vaddress);
        AArch32_EnterMonitorMode(preferred_exception_return, lr_offset, vect_offset)
    } else if PSTATE.EL == EL2 | route_to_hyp then {
        let exception : ExceptionRecord = AArch32_AbortSyndrome(Exception_DataAbort, fault, vaddress);
        if PSTATE.EL == EL2 then {
            AArch32_EnterHypMode(exception, preferred_exception_return, vect_offset)
        } else {
            AArch32_EnterHypMode(exception, preferred_exception_return, UInt(0x14))
        }
    } else {
        AArch32_ReportDataAbort(route_to_monitor, fault, vaddress);
        AArch32_EnterMode(M32_Abort, preferred_exception_return, lr_offset, vect_offset)
    }
}

val IFAR_NS_write : bits(32) -> unit

function IFAR_NS_write val_name = {
    let r : bits(32) = val_name;
    FAR_EL1 = SetSlice(32, FAR_EL1, 32, Slice(r, 0, 32));
    return()
}

val HIFAR_read : unit -> bits(32)

function HIFAR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(FAR_EL2, 32, 32));
    return(r)
}

val IFAR_S_write : bits(32) -> unit

function IFAR_S_write val_name = {
    let r : bits(32) = val_name;
    if HaveEL(EL2) then {
        FAR_EL2 = SetSlice(32, FAR_EL2, 32, Slice(r, 0, 32))
    } else {
        HIFAR_write() = SetSlice(32, HIFAR_read(), 0, Slice(r, 0, 32))
    };
    return()
}

val IFAR_write : bits(32) -> unit

function IFAR_write val_name = {
    let r : bits(32) = val_name;
    if ELUsingAArch32(EL3) & IsSecure() then {
        IFAR_S_write() = r
    } else {
        IFAR_NS_write() = r
    };
    return()
}

val AArch32_ReportPrefetchAbort : forall ('route_to_monitor : Bool).
  (bool('route_to_monitor), FaultRecord, bits(32)) -> unit

function AArch32_ReportPrefetchAbort (route_to_monitor, fault, vaddress) = {
    long_format : bool = false;
    if route_to_monitor & not_bool(IsSecure()) then {
        long_format = (Slice(TTBCR_S, 31, 1) == 0b1 | PSTATE.EL == EL2) | Slice(TTBCR_read(), 31, 1) == 0b1
    } else {
        long_format = Slice(TTBCR_read(), 31, 1) == 0b1
    };
    let d_side : bool = false;
    fsr : bits(32) = undefined;
    if long_format then {
        fsr = AArch32_FaultStatusLD(d_side, fault)
    } else {
        fsr = AArch32_FaultStatusSD(d_side, fault)
    };
    if route_to_monitor then {
        IFSR_S = fsr;
        IFAR_S_write() = vaddress
    } else {
        IFSR_write() = fsr;
        IFAR_write() = vaddress
    };
    return()
}

val AArch32_InstructionAbort : (bits(32), FaultRecord) -> unit

function AArch32_InstructionAbort (vaddress, fault) = {
    let route_to_monitor : bool = (HaveEL(EL3) & Slice(SCR, 3, 1) == 0b1) & IsExternalAbort__1(fault);
    let route_to_hyp : bool = (EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & (((Slice(HCR_read(), 27, 1) == 0b1 | (HaveRASExt() & Slice(HCR2_read(), 5, 1) == 0b1) & IsExternalAbort__1(fault)) | IsDebugException(fault) & Slice(HDCR_read(), 8, 1) == 0b1) | IsSecondStage(fault));
    exception : ExceptionRecord = undefined;
    let preferred_exception_return : bits(32) = ThisInstrAddr(32);
    let 'vect_offset = UInt(0x0C);
    let 'lr_offset = 4;
    if IsDebugException(fault) then {
        DBGDSCRext_write() = SetSlice(4, DBGDSCRext_read(), 2, fault.debugmoe)
    };
    if route_to_monitor then {
        AArch32_ReportPrefetchAbort(route_to_monitor, fault, vaddress);
        AArch32_EnterMonitorMode(preferred_exception_return, lr_offset, vect_offset)
    } else if PSTATE.EL == EL2 | route_to_hyp then {
        if fault.statuscode == Fault_Alignment then {
            exception = ExceptionSyndrome(Exception_PCAlignment);
            exception.vaddress = ThisInstrAddr(64)
        } else {
            exception = AArch32_AbortSyndrome(Exception_InstructionAbort, fault, vaddress)
        };
        if PSTATE.EL == EL2 then {
            AArch32_EnterHypMode(exception, preferred_exception_return, vect_offset)
        } else {
            AArch32_EnterHypMode(exception, preferred_exception_return, UInt(0x14))
        }
    } else {
        AArch32_ReportPrefetchAbort(route_to_monitor, fault, vaddress);
        AArch32_EnterMode(M32_Abort, preferred_exception_return, lr_offset, vect_offset)
    }
}

val AArch32_Abort : (bits(32), FaultRecord) -> unit

function AArch32_Abort (vaddress, fault) = {
    route_to_aarch64 : bool = PSTATE.EL == EL0 & not_bool(ELUsingAArch32(EL1));
    if (not_bool(route_to_aarch64) & EL2Enabled()) & not_bool(ELUsingAArch32(EL2)) then {
        route_to_aarch64 = ((Slice(HCR_EL2, 27, 1) == 0b1 | IsSecondStage(fault)) | (HaveRASExt() & Slice(HCR_EL2, 37, 1) == 0b1) & IsExternalAbort__1(fault)) | IsDebugException(fault) & Slice(MDCR_EL2, 8, 1) == 0b1
    };
    if (not_bool(route_to_aarch64) & HaveEL(EL3)) & not_bool(ELUsingAArch32(EL3)) then {
        route_to_aarch64 = Slice(SCR_EL3, 3, 1) == 0b1 & IsExternalAbort__1(fault)
    };
    if route_to_aarch64 then {
        AArch64_Abort(ZeroExtend(vaddress), fault)
    } else if fault.acctype == AccType_IFETCH then {
        AArch32_InstructionAbort(vaddress, fault)
    } else {
        AArch32_DataAbort(vaddress, fault)
    }
}

struct PhysMemRetStatus = {
  statuscode : Fault,
  extflag : bits(1),
  errortype : bits(2),
  store64bstatus : bits(64),
  acctype : AccType
}

val IsExternalAbortTakenSynchronously : forall ('iswrite : Bool) 'size.
  (PhysMemRetStatus, bool('iswrite), AddressDescriptor, int('size), AccessDescriptor) -> bool

val GPCNoFault : unit -> GPCFRecord

function GPCNoFault () = {
    result : GPCFRecord = undefined;
    result.gpf = GPCF_None;
    return(result)
}

val NoFault : unit -> FaultRecord

function NoFault () = {
    fault : FaultRecord = undefined;
    fault.statuscode = Fault_None;
    fault.acctype = AccType_NORMAL;
    fault.secondstage = false;
    fault.s2fs1walk = false;
    fault.gpcfs2walk = false;
    fault.gpcf = GPCNoFault();
    return(fault)
}

val PEErrorState : PhysMemRetStatus -> bits(2)

val PendSErrorInterrupt : FaultRecord -> unit

val HandleExternalAbort : forall ('iswrite : Bool) 'size.
  (PhysMemRetStatus, bool('iswrite), AddressDescriptor, int('size), AccessDescriptor) -> unit

function HandleExternalAbort (memretstatus, iswrite, memaddrdesc, size, accdesc) = {
    assert((memretstatus.statuscode == Fault_SyncExternal | memretstatus.statuscode == Fault_AsyncExternal) | not_bool(HaveRASExt()) & (memretstatus.statuscode == Fault_SyncParity | memretstatus.statuscode == Fault_AsyncParity));
    fault : FaultRecord = NoFault();
    fault.statuscode = memretstatus.statuscode;
    fault.write = iswrite;
    fault.extflag = memretstatus.extflag;
    fault.acctype = memretstatus.acctype;
    if IsExternalSyncAbort__1(fault) & not_bool(IsExternalAbortTakenSynchronously(memretstatus, iswrite, memaddrdesc, size, accdesc)) then {
        if fault.statuscode == Fault_SyncParity then {
            fault.statuscode = Fault_AsyncParity
        } else {
            fault.statuscode = Fault_AsyncExternal
        }
    };
    if HaveRASExt() then {
        fault.errortype = PEErrorState(memretstatus)
    } else {
        fault.errortype = __UNKNOWN_bits(2)
    };
    if IsExternalSyncAbort__1(fault) then {
        if UsingAArch32() then {
            AArch32_Abort(memaddrdesc.vaddress[31 .. 0], fault)
        } else {
            AArch64_Abort(memaddrdesc.vaddress, fault)
        }
    } else {
        PendSErrorInterrupt(fault)
    }
}

val HandleExternalReadAbort : forall 'size.
  (PhysMemRetStatus, AddressDescriptor, int('size), AccessDescriptor) -> unit

function HandleExternalReadAbort (memstatus, memaddrdesc, size, accdesc) = {
    let iswrite : bool = false;
    HandleExternalAbort(memstatus, iswrite, memaddrdesc, size, accdesc)
}

val IsFault : AddressDescriptor -> bool

val IsFault__1 : Fault -> bool

val IsFault__2 : PhysMemRetStatus -> bool

function IsFault addrdesc = {
    return(addrdesc.fault.statuscode != Fault_None)
}

function IsFault__1 fault = {
    return(fault != Fault_None)
}

function IsFault__2 retstatus = {
    return(retstatus.statuscode != Fault_None)
}

val PhysMemTagRead : (AddressDescriptor, AccessDescriptor) -> (PhysMemRetStatus, bits(4))

val AArch64_CheckTag : forall ('write : Bool).
  (AddressDescriptor, AccessDescriptor, bits(4), bool('write)) -> bool

function AArch64_CheckTag (memaddrdesc, accdesc, ptag, write) = {
    memstatus : PhysMemRetStatus = undefined;
    readtag : bits(4) = undefined;
    if memaddrdesc.memattrs.tagged then {
        (memstatus, readtag) = PhysMemTagRead(memaddrdesc, accdesc);
        if IsFault__2(memstatus) then {
            HandleExternalReadAbort(memstatus, memaddrdesc, 1, accdesc)
        };
        return(ptag == readtag)
    } else {
        return(true)
    }
}

val AArch64_PhysicalTag : bits(64) -> bits(4)

function AArch64_PhysicalTag vaddr = {
    return(vaddr[59 .. 56])
}

val ConstrainUnpredictableBits : forall 'width, 'width >= 0.
  (implicit('width), Unpredictable) -> (Constraint, bits('width))

function ConstrainUnpredictableBits (width, which) = {
    let c : Constraint = ConstrainUnpredictable(which);
    if c == Constraint_UNKNOWN then {
        return((c, Zeros(width)))
    } else if c == Constraint_PMSCR_PCT_VIRT then {
        return((c, Zeros(width)))
    } else {
        return((c, __UNKNOWN_bits(width)))
    }
}

val HaveMTE3Ext : unit -> bool

function HaveMTE3Ext () = {
    return(HasArchVersion(ARMv8p7) & HaveMTE2Ext() | HasArchVersion(ARMv8p5) & __IMPDEF_boolean("Has MTE3 extension"))
}

val AArch64_EffectiveTCF : AccType -> bits(2)

function AArch64_EffectiveTCF acctype = {
    tcf : bits(2) = undefined;
    let el : bits(2) = S1TranslationRegime__1();
    if el == EL3 then {
        tcf = Slice(SCTLR_EL3, 40, 2)
    } else if el == EL2 then {
        if AArch64_AccessUsesEL(acctype) == EL0 then {
            tcf = Slice(SCTLR_EL2, 38, 2)
        } else {
            tcf = Slice(SCTLR_EL2, 40, 2)
        }
    } else if el == EL1 then {
        if AArch64_AccessUsesEL(acctype) == EL0 then {
            tcf = Slice(SCTLR_EL1, 38, 2)
        } else {
            tcf = Slice(SCTLR_EL1, 40, 2)
        }
    } else ();
    if tcf == 0b11 then {
        if not_bool(HaveMTE3Ext()) then {
            let (_, __tup_1 : bits(2)) = ConstrainUnpredictableBits(2, Unpredictable_RESTCF);
            tcf = __tup_1
        };
        ()
    };
    return(tcf)
}

val AArch64_RaiseTagCheckFault : forall ('write : Bool).
  (bits(64), bool('write)) -> unit

function AArch64_RaiseTagCheckFault (va, write) = {
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    exception : ExceptionRecord = ExceptionSyndrome(Exception_DataAbort);
    exception.syndrome[5 .. 0] = 0b010001;
    if write then {
        exception.syndrome[6 .. 6] = 0b1
    };
    exception.vaddress = __UNKNOWN_bits(4) @ va[59 .. 0];
    target_el : bits(2) = EL1;
    if UInt(PSTATE.EL) > UInt(EL1) then {
        target_el = PSTATE.EL
    } else if (PSTATE.EL == EL0 & EL2Enabled()) & Slice(HCR_EL2, 27, 1) == 0b1 then {
        target_el = EL2
    } else ();
    AArch64_TakeException(target_el, exception, preferred_exception_return, vect_offset)
}

register TFSRE0_EL1 : bits(64)

register TFSR_EL1 : bits(64)

register TFSR_EL2 : bits(64)

register TFSR_EL3 : bits(64)

val AArch64_ReportTagCheckFault : (bits(2), bits(1)) -> unit

function AArch64_ReportTagCheckFault (el, ttbr) = {
    if el == EL3 then {
        assert(ttbr == 0b0);
        TFSR_EL3 = SetSlice(1, TFSR_EL3, 0, 0b1)
    } else if el == EL2 then {
        if ttbr == 0b0 then {
            TFSR_EL2 = SetSlice(1, TFSR_EL2, 0, 0b1)
        } else {
            TFSR_EL2 = SetSlice(1, TFSR_EL2, 1, 0b1)
        }
    } else if el == EL1 then {
        if ttbr == 0b0 then {
            TFSR_EL1 = SetSlice(1, TFSR_EL1, 0, 0b1)
        } else {
            TFSR_EL1 = SetSlice(1, TFSR_EL1, 1, 0b1)
        }
    } else if el == EL0 then {
        if ttbr == 0b0 then {
            TFSRE0_EL1 = SetSlice(1, TFSRE0_EL1, 0, 0b1)
        } else {
            TFSRE0_EL1 = SetSlice(1, TFSRE0_EL1, 1, 0b1)
        }
    } else ()
}

val AArch64_TagCheckFault : forall ('iswrite : Bool).
  (bits(64), AccType, bool('iswrite)) -> unit

function AArch64_TagCheckFault (vaddress, acctype, iswrite) = {
    readwrite : bool = undefined;
    let el : bits(2) = AArch64_AccessUsesEL(acctype);
    let tcf : bits(2) = AArch64_EffectiveTCF(acctype);
    match tcf {
      0b00 => {
          return()
      },
      0b01 => {
          AArch64_RaiseTagCheckFault(vaddress, iswrite)
      },
      0b10 => {
          AArch64_ReportTagCheckFault(el, [vaddress[55]])
      },
      0b11 => {
          let readwrite : bool = acctype == AccType_ATOMICRW | acctype == AccType_ORDEREDATOMICRW | acctype == AccType_ORDEREDRW;
          if not_bool(iswrite) | readwrite then {
              AArch64_RaiseTagCheckFault(vaddress, iswrite)
          } else {
              AArch64_ReportTagCheckFault(PSTATE.EL, [vaddress[55]])
          }
      }
    }
}

val AArch64_VAMax : unit -> int

function AArch64_VAMax () = {
    return(__IMPDEF_integer("Maximum Virtual Address Size"))
}

register CONTEXTIDR_EL1 : bits(64)

register CONTEXTIDR_EL2 : bits(64)

val ConstrainUnpredictableInteger : forall 'high 'low.
  (int('low), int('high), Unpredictable) -> (Constraint, int)

function ConstrainUnpredictableInteger (low, high, which) = {
    let c : Constraint = ConstrainUnpredictable(which);
    if c == Constraint_UNKNOWN then {
        return((c, low))
    } else {
        return((c, __UNKNOWN_integer()))
    }
}

register DBGBCR_EL1 : vector(16, inc, bits(64))

register DBGBVR_EL1 : vector(16, inc, bits(64))

val Have16bitVMID : unit -> bool

function Have16bitVMID () = {
    return((HasArchVersion(ARMv8p1) & HaveEL(EL2)) & __IMPDEF_boolean("Has 16-bit VMID"))
}

val HaveV82Debug : unit -> bool

function HaveV82Debug () = {
    return(HasArchVersion(ARMv8p2))
}

val NumBreakpointsImplemented : unit -> int

function NumBreakpointsImplemented () = {
    return(__IMPDEF_integer("Number of breakpoints"))
}

val NumContextAwareBreakpointsImplemented : unit -> int

function NumContextAwareBreakpointsImplemented () = {
    return(__IMPDEF_integer("Number of context-aware breakpoints"))
}

register VTCR_EL2 : bits(64)

register VTTBR_EL2 : bits(64)

val AArch64_BreakpointValueMatch : forall ('linked_to : Bool) 'n_in.
  (int('n_in), bits(64), bool('linked_to)) -> bool

function AArch64_BreakpointValueMatch (n_in, vaddress, linked_to) = {
    byte : int = undefined;
    c : Constraint = undefined;
    n : int = n_in;
    if n >= NumBreakpointsImplemented() then {
        c : Constraint = undefined;
        (c, n) = ConstrainUnpredictableInteger(0, NumBreakpointsImplemented() - 1, Unpredictable_BPNOTIMPL);
        assert(c == Constraint_DISABLED | c == Constraint_UNKNOWN);
        if c == Constraint_DISABLED then {
            return(false)
        };
        ()
    };
    let 'n = n;
    assert(constraint((0 <= 'n & 'n < 16)));
    if Slice(DBGBCR_EL1[n], 0, 1) == 0b0 then {
        return(false)
    };
    let context_aware : bool = n >= NumBreakpointsImplemented() - NumContextAwareBreakpointsImplemented();
    dbgtype : bits(4) = Slice(DBGBCR_EL1[n], 20, 4);
    if ((((match dbgtype {
      [bitzero, bitone, bitone, _] => true,
      [bitone, bitone, _, _] => true,
      _ => false
    }) : bool & not_bool(HaveVirtHostExt())) & not_bool(HaveV82Debug()) | (match dbgtype {
      [bitzero, bitone, bitzero, _] => true,
      _ => false
    }) : bool) | not_bool((match dbgtype {
      [bitzero, _, bitzero, _] => true,
      _ => false
    }) : bool) & not_bool(context_aware)) | (match dbgtype {
      [bitone, _, _, _] => true,
      _ => false
    }) : bool & not_bool(HaveEL(EL2)) then {
        (c, dbgtype) = ConstrainUnpredictableBits(0 + 4, Unpredictable_RESBPTYPE);
        assert(c == Constraint_DISABLED | c == Constraint_UNKNOWN);
        if c == Constraint_DISABLED then {
            return(false)
        };
        ()
    };
    let match_addr : bool = (match dbgtype {
      [bitzero, _, bitzero, _] => true,
      _ => false
    }) : bool;
    let match_vmid : bool = (match dbgtype {
      [bitone, bitzero, _, _] => true,
      _ => false
    }) : bool;
    let match_cid : bool = (match dbgtype {
      [bitzero, bitzero, bitone, _] => true,
      _ => false
    }) : bool;
    let match_cid1 : bool = (match dbgtype {
      [bitone, bitzero, bitone, _] => true,
      [_, bitone, bitone, _] => true,
      _ => false
    }) : bool;
    let match_cid2 : bool = (match dbgtype {
      [bitone, bitone, _, _] => true,
      _ => false
    }) : bool;
    let linked : bool = (match dbgtype {
      [_, _, _, bitone] => true,
      _ => false
    }) : bool;
    if linked_to & (not_bool(linked) | match_addr) then {
        return(false)
    };
    if (not_bool(linked_to) & linked) & not_bool(match_addr) then {
        return(false)
    };
    BVR_match : bool = undefined;
    if match_addr then {
        byte_select_match : bool = undefined;
        let 'byte = UInt(vaddress[1 .. 0]);
        if HaveAArch32() then {
            assert(byte == 0 | byte == 2);
            byte_select_match = [Slice(DBGBCR_EL1[n], 5, 4)[byte]] == 0b1
        } else {
            assert(byte == 0);
            byte_select_match = true
        };
        top : int = AArch64_VAMax();
        if not_bool(is_ones_subrange(DBGBVR_EL1[n], 63, top)) & not_bool(is_zero_subrange(DBGBVR_EL1[n], 63, top)) then {
            if ConstrainUnpredictableBool(Unpredictable_DBGxVR_RESS) then {
                top = 63
            };
            ()
        };
        let 'top = top;
        assert(constraint((2 <= 'top & 'top < 64)));
        BVR_match = vaddress[top .. 2] == DBGBVR_EL1[n][top .. 2] & byte_select_match
    } else if match_cid then {
        if IsInHost() then {
            BVR_match = CONTEXTIDR_EL2[31 .. 0] == DBGBVR_EL1[n][31 .. 0]
        } else {
            BVR_match = (PSTATE.EL == EL0 | PSTATE.EL == EL1) & CONTEXTIDR_EL1[31 .. 0] == DBGBVR_EL1[n][31 .. 0]
        }
    } else if match_cid1 then {
        BVR_match = ((PSTATE.EL == EL0 | PSTATE.EL == EL1) & not_bool(IsInHost())) & CONTEXTIDR_EL1[31 .. 0] == DBGBVR_EL1[n][31 .. 0]
    } else ();
    BXVR_match : bool = undefined;
    if match_vmid then {
        vmid : bits(16) = undefined;
        bvr_vmid : bits(16) = undefined;
        if not_bool(Have16bitVMID()) | Slice(VTCR_EL2, 19, 1) == 0b0 then {
            vmid = ZeroExtend(Slice(VTTBR_EL2, 48, 16)[7 .. 0], 16);
            bvr_vmid = ZeroExtend(DBGBVR_EL1[n][39 .. 32], 16)
        } else {
            vmid = Slice(VTTBR_EL2, 48, 16);
            bvr_vmid = DBGBVR_EL1[n][47 .. 32]
        };
        BXVR_match = (((PSTATE.EL == EL0 | PSTATE.EL == EL1) & EL2Enabled()) & not_bool(IsInHost())) & vmid == bvr_vmid
    } else if match_cid2 then {
        BXVR_match = ((PSTATE.EL != EL3 & (HaveVirtHostExt() | HaveV82Debug())) & EL2Enabled()) & DBGBVR_EL1[n][63 .. 32] == CONTEXTIDR_EL2[31 .. 0]
    } else ();
    let bvr_match_valid : bool = (match_addr | match_cid) | match_cid1;
    let bxvr_match_valid : bool = match_vmid | match_cid2;
    let val_match : bool = (not_bool(bxvr_match_valid) | BXVR_match) & (not_bool(bvr_match_valid) | BVR_match);
    return(val_match)
}

val CheckValidStateMatch : forall ('isbreakpnt : Bool).
  (bits(2), bits(1), bits(1), bits(2), bool('isbreakpnt)) -> (Constraint, bits(2), bits(1), bits(1), bits(2))

function CheckValidStateMatch (SSC_in, SSCE_in, HMC_in, PxC_in, isbreakpnt) = {
    if not_bool(HaveRME()) then {
        assert(SSCE_in == 0b0)
    };
    reserved : bool = false;
    SSC : bits(2) = SSC_in;
    SSCE : bits(1) = SSCE_in;
    HMC : bits(1) = HMC_in;
    PxC : bits(2) = PxC_in;
    match ((HMC @ SSCE) @ SSC) @ PxC {
      0b001110 => {
          reserved = true
      },
      [bitone, bitzero, bitzero, bitzero, _, bitzero] => {
          reserved = true
      },
      0b100110 => {
          reserved = true
      },
      [bitone, bitzero, bitone, _, bitone, bitzero] => {
          reserved = true
      },
      [_, bitone, _, _, _, _] => {
          reserved = SSC != 0b01 | (HMC @ PxC) == 0b000 | (HMC @ PxC) == 0b110
      },
      _ => {
          reserved = false
      }
    };
    if ((not_bool(isbreakpnt) | not_bool(HaveAArch32EL(EL1))) & (HMC @ PxC) == 0b000) & SSC != 0b11 then {
        reserved = true
    };
    if (not_bool(HaveEL(EL3)) & not_bool(HaveEL(EL2))) & (HMC != 0b0 | SSC != 0b00) then {
        reserved = true
    };
    if (not_bool(HaveEL(EL3)) & (SSC == 0b01 | SSC == 0b10)) & ((HMC @ SSC) @ PxC) != 0b10100 then {
        reserved = true
    };
    if (not_bool(HaveEL(EL3)) | not_bool(HaveAArch64())) & ((HMC @ SSC) @ PxC) == 0b11000 then {
        reserved = true
    };
    if not_bool(HaveEL(EL2)) & ((HMC @ SSC) @ PxC) == 0b11100 then {
        reserved = true
    };
    if not_bool(HaveSecureEL2Ext()) & (match (HMC @ SSC) @ PxC {
      0b01100 => true,
      0b10100 => true,
      [_, bitone, bitone, _, bitone] => true,
      _ => false
    }) : bool then {
        reserved = true
    };
    if reserved then {
        c : Constraint = undefined;
        (c, (HMC @ SSC @ SSCE @ PxC)) = ConstrainUnpredictableBits(0 + 1 + 2 + 1 + 2, Unpredictable_RESBPWPCTRL);
        assert(c == Constraint_DISABLED | c == Constraint_UNKNOWN);
        if c == Constraint_DISABLED then {
            return((c, __UNKNOWN_bits(2), __UNKNOWN_bits(1), __UNKNOWN_bits(1), __UNKNOWN_bits(2)))
        };
        ()
    };
    return((Constraint_NONE, SSC, SSCE, HMC, PxC))
}

val CurrentSecurityState : unit -> SecurityState

function CurrentSecurityState () = {
    return(SecurityStateAtEL(PSTATE.EL))
}

val AArch64_StateMatch : forall ('isbreakpnt : Bool) ('ispriv : Bool) ('linked_in : Bool).
  (bits(2), bits(1), bits(1), bits(2), bool('linked_in), bits(4), bool('isbreakpnt), AccType, bool('ispriv)) -> bool

function AArch64_StateMatch (SSC_in, SSCE_in, HMC_in, PxC_in, linked_in, LBN, isbreakpnt, acctype, ispriv) = {
    first_ctx_cmp : int = undefined;
    last_ctx_cmp : int = undefined;
    linked_to : bool = undefined;
    vaddress : bits(64) = undefined;
    if not_bool(HaveRME()) then {
        assert(SSCE_in == 0b0)
    };
    SSC : bits(2) = SSC_in;
    SSCE : bits(1) = SSCE_in;
    HMC : bits(1) = HMC_in;
    PxC : bits(2) = PxC_in;
    linked : bool = linked_in;
    c : Constraint = undefined;
    (c, SSC, SSCE, HMC, PxC) = CheckValidStateMatch(SSC, SSCE, HMC, PxC, isbreakpnt);
    if c == Constraint_DISABLED then {
        return(false)
    };
    let EL3_match : bool = (HaveEL(EL3) & HMC == 0b1) & [SSC[0]] == 0b0;
    let EL2_match : bool = HaveEL(EL2) & (HMC == 0b1 & (SSC @ PxC) != 0b1000 | SSC == 0b11);
    let EL1_match : bool = [PxC[0]] == 0b1;
    let EL0_match : bool = [PxC[1]] == 0b1;
    priv_match : bool = undefined;
    if (HaveNV2Ext() & acctype == AccType_NV2REGISTER) & not_bool(isbreakpnt) then {
        priv_match = EL2_match
    } else if not_bool(ispriv) & not_bool(isbreakpnt) then {
        priv_match = EL0_match
    } else {
        match PSTATE.EL {
          ? if ? == EL3 => {
              priv_match = EL3_match
          },
          ? if ? == EL2 => {
              priv_match = EL2_match
          },
          ? if ? == EL1 => {
              priv_match = EL1_match
          },
          ? if ? == EL0 => {
              priv_match = EL0_match
          },
          _ => ()
        }
    };
    security_state_match : bool = undefined;
    let ss : SecurityState = CurrentSecurityState();
    match SSCE @ SSC {
      0b000 => {
          security_state_match = HMC == 0b1 | ss != SS_Root
      },
      0b001 => {
          security_state_match = ss == SS_NonSecure
      },
      0b010 => {
          security_state_match = HMC == 0b1 & ss == SS_Root | ss == SS_Secure
      },
      0b011 => {
          security_state_match = HMC == 0b1 & ss != SS_Root | ss == SS_Secure
      },
      0b101 => {
          security_state_match = ss == SS_Realm
      },
      _ => ()
    };
    lbn : int = undefined;
    if linked then {
        lbn = UInt(LBN);
        let 'first_ctx_cmp = NumBreakpointsImplemented() - NumContextAwareBreakpointsImplemented();
        let 'last_ctx_cmp = NumBreakpointsImplemented() - 1;
        if lbn < first_ctx_cmp | lbn > last_ctx_cmp then {
            (c, lbn) = ConstrainUnpredictableInteger(first_ctx_cmp, last_ctx_cmp, Unpredictable_BPNOTCTXCMP);
            assert(c == Constraint_DISABLED | c == Constraint_NONE | c == Constraint_UNKNOWN);
            match c {
              Constraint_DISABLED => {
                  return(false)
              },
              Constraint_NONE => {
                  linked = false
              },
              _ => ()
            }
        };
        ()
    };
    let 'lbn = lbn;
    linked_match : bool = undefined;
    if linked then {
        let vaddress : bits(64) = __UNKNOWN_bits(64);
        let linked_to : bool = true;
        linked_match = AArch64_BreakpointValueMatch(lbn, vaddress, linked_to)
    };
    return((priv_match & security_state_match) & (not_bool(linked) | linked_match))
}

val AArch64_BreakpointMatch : forall 'n 'size, (0 <= 'n & 'n < 16).
  (int('n), bits(64), AccType, int('size)) -> bool

function AArch64_BreakpointMatch (n, vaddress, acctype, size) = {
    match_i : bool = undefined;
    assert(not_bool(ELUsingAArch32(S1TranslationRegime__1())));
    assert(n < NumBreakpointsImplemented());
    let enabled : bool = Slice(DBGBCR_EL1[n], 0, 1) == 0b1;
    let ispriv : bool = PSTATE.EL != EL0;
    let linked : bool = (match Slice(DBGBCR_EL1[n], 20, 4) {
      [bitzero, _, bitzero, bitone] => true,
      _ => false
    }) : bool;
    let isbreakpnt : bool = true;
    let linked_to : bool = false;
    let ssce : bits(1) = if HaveRME() then Slice(DBGBCR_EL1[n], 29, 1) else 0b0;
    let state_match : bool = AArch64_StateMatch(Slice(DBGBCR_EL1[n], 14, 2), ssce, Slice(DBGBCR_EL1[n], 13, 1), Slice(DBGBCR_EL1[n], 1, 2), linked, Slice(DBGBCR_EL1[n], 16, 4), isbreakpnt, acctype, ispriv);
    value_match_name : bool = AArch64_BreakpointValueMatch(n, vaddress, linked_to);
    if HaveAArch32() & size == 4 then {
        let match_i : bool = AArch64_BreakpointValueMatch(n, vaddress + 2, linked_to);
        if not_bool(value_match_name) & match_i then {
            value_match_name = ConstrainUnpredictableBool(Unpredictable_BPMATCHHALF)
        };
        ()
    };
    if [vaddress[1]] == 0b1 & Slice(DBGBCR_EL1[n], 5, 4) == 0b1111 then {
        if value_match_name then {
            value_match_name = ConstrainUnpredictableBool(Unpredictable_BPMATCHHALF)
        };
        ()
    };
    let val_match : bool = (value_match_name & state_match) & enabled;
    return(val_match)
}

val AArch64_DebugFault : forall ('iswrite : Bool).
  (AccType, bool('iswrite)) -> FaultRecord

function AArch64_DebugFault (acctype, iswrite) = {
    fault : FaultRecord = undefined;
    fault.statuscode = Fault_Debug;
    fault.acctype = acctype;
    fault.write = iswrite;
    fault.secondstage = false;
    fault.s2fs1walk = false;
    return(fault)
}

register OSLSR_EL1 : bits(64)

val HaltOnBreakpointOrWatchpoint : unit -> bool

function HaltOnBreakpointOrWatchpoint () = {
    return((HaltingAllowed() & Slice(EDSCR_read(), 14, 1) == 0b1) & Slice(OSLSR_EL1, 1, 1) == 0b0)
}

val AArch64_CheckBreakpoint : forall 'size.
  (bits(64), AccType, int('size)) -> FaultRecord

function AArch64_CheckBreakpoint (vaddress, acctype_in, size) = {
    iswrite : bool = undefined;
    match_i : bool = undefined;
    reason : bits(6) = undefined;
    assert(not_bool(ELUsingAArch32(S1TranslationRegime__1())));
    assert(UsingAArch32() & (size == 2 | size == 4) | size == 4);
    acctype : AccType = acctype_in;
    val_match : bool = false;
    foreach (i from 0 to (NumBreakpointsImplemented() - 1) by 1 in inc) {
        assert(constraint(('loop_i < 16 | not('size in {2, 4, 4}))));
        match_i = AArch64_BreakpointMatch(i, vaddress, acctype, size);
        val_match = val_match | match_i
    };
    if val_match & HaltOnBreakpointOrWatchpoint() then {
        let reason : bits(6) = DebugHalt_Breakpoint;
        Halt(reason);
        return(undefined : FaultRecord)
    } else if val_match then {
        let acctype : AccType = AccType_IFETCH;
        let iswrite : bool = false;
        return(AArch64_DebugFault(acctype, iswrite))
    } else {
        return(NoFault())
    }
}

register DBGWCR_EL1 : vector(16, inc, bits(64))

register DBGWVR_EL1 : vector(16, inc, bits(64))

val AArch64_WatchpointByteMatch : forall 'n, (0 <= 'n & 'n < 16).
  (int('n), AccType, bits(64)) -> bool

function AArch64_WatchpointByteMatch (n, acctype, vaddress) = {
    LSB : bits(8) = undefined;
    MSB : bits(8) = undefined;
    top : int = AArch64_VAMax();
    bottom : {|2, 3|} = if [DBGWVR_EL1[n][2]] == 0b1 then 2 else 3;
    byte_select_match : bool = let 'bottom = bottom in
      {
          [Slice(DBGWCR_EL1[n], 5, 8)[UInt(vaddress[bottom - 1 .. 0])]] != 0b0
      };
    mask : int = UInt(Slice(DBGWCR_EL1[n], 24, 5));
    if mask > 0 & not_bool(IsOnes(Slice(DBGWCR_EL1[n], 5, 8))) then {
        byte_select_match = ConstrainUnpredictableBool(Unpredictable_WPMASKANDBAS)
    } else {
        let LSB : bits(8) = Slice(DBGWCR_EL1[n], 5, 8) & not_vec(Slice(DBGWCR_EL1[n], 5, 8) - 1);
        let MSB : bits(8) = Slice(DBGWCR_EL1[n], 5, 8) + LSB;
        if not_bool(IsZero(MSB & MSB - 1)) then {
            byte_select_match = ConstrainUnpredictableBool(Unpredictable_WPBASCONTIGUOUS);
            bottom = 3
        };
        ()
    };
    let 'bottom = bottom;
    if mask > 0 & mask <= 2 then {
        c : Constraint = undefined;
        (c, mask) = ConstrainUnpredictableInteger(3, 31, Unpredictable_RESWPMASK);
        assert(c == Constraint_DISABLED | c == Constraint_NONE | c == Constraint_UNKNOWN);
        match c {
          Constraint_DISABLED => {
              return(false)
          },
          Constraint_NONE => {
              mask = 0
          },
          _ => ()
        }
    };
    let 'mask = mask;
    WVR_match : bool = undefined;
    if mask > bottom then {
        if not_bool(is_ones_subrange(DBGBVR_EL1[n], 63, top)) & not_bool(is_zero_subrange(DBGBVR_EL1[n], 63, top)) then {
            if ConstrainUnpredictableBool(Unpredictable_DBGxVR_RESS) then {
                top = 63
            };
            ()
        };
        let 'top = top;
        assert(constraint(('mask <= 'top & 'top < 64)));
        WVR_match = vaddress[top .. mask] == DBGWVR_EL1[n][top .. mask];
        if WVR_match & not_bool(is_zero_subrange(DBGWVR_EL1[n], mask - 1, bottom)) then {
            WVR_match = ConstrainUnpredictableBool(Unpredictable_WPMASKEDBITS)
        };
        ()
    } else {
        let 'top = top in
          {
              assert(constraint(('bottom <= 'top & 'top < 64)));
              WVR_match = vaddress[top .. bottom] == DBGWVR_EL1[n][top .. bottom]
          };
        ()
    };
    return(WVR_match & byte_select_match)
}

val NumWatchpointsImplemented : unit -> int

function NumWatchpointsImplemented () = {
    return(__IMPDEF_integer("Number of watchpoints"))
}

val AArch64_WatchpointMatch : forall ('ispriv : Bool) ('iswrite : Bool) 'n 'size,
  (0 <= 'n & 'n < 16).
  (int('n), bits(64), int('size), bool('ispriv), AccType, bool('iswrite)) -> bool

function AArch64_WatchpointMatch (n, vaddress, size, ispriv, acctype, iswrite) = {
    assert(not_bool(ELUsingAArch32(S1TranslationRegime__1())));
    assert(n < NumWatchpointsImplemented());
    let enabled : bool = Slice(DBGWCR_EL1[n], 0, 1) == 0b1;
    let linked : bool = Slice(DBGWCR_EL1[n], 20, 1) == 0b1;
    let isbreakpnt : bool = false;
    let ssce : bits(1) = if HaveRME() then Slice(DBGWCR_EL1[n], 29, 1) else 0b0;
    let state_match : bool = AArch64_StateMatch(Slice(DBGWCR_EL1[n], 14, 2), ssce, Slice(DBGWCR_EL1[n], 13, 1), Slice(DBGWCR_EL1[n], 1, 2), linked, Slice(DBGWCR_EL1[n], 16, 4), isbreakpnt, acctype, ispriv);
    ls_match : bool = false;
    if acctype == AccType_ATOMICRW then {
        ls_match = Slice(DBGWCR_EL1[n], 3, 2) != 0b00
    } else {
        ls_match = [Slice(DBGWCR_EL1[n], 3, 2)[if iswrite then 1 else 0]] == 0b1
    };
    value_match_name : bool = false;
    foreach (byte from 0 to (size - 1) by 1 in inc) {
        value_match_name = value_match_name | AArch64_WatchpointByteMatch(n, acctype, vaddress + byte)
    };
    return(((value_match_name & state_match) & ls_match) & enabled)
}

let DebugHalt_Watchpoint : bits(6) = 0b101011

register EDWAR : bits(64)

val AArch64_CheckWatchpoint : forall ('iswrite_in : Bool) 'size.
  (bits(64), AccType, bool('iswrite_in), int('size)) -> FaultRecord

function AArch64_CheckWatchpoint (vaddress, acctype, iswrite_in, size) = {
    reason : bits(6) = undefined;
    assert(not_bool(ELUsingAArch32(S1TranslationRegime__1())));
    iswrite : bool = iswrite_in;
    if acctype == AccType_TTW | acctype == AccType_IC | acctype == AccType_AT | acctype == AccType_ATPAN then {
        return(NoFault())
    };
    if acctype == AccType_DC then {
        if not_bool(iswrite) then {
            return(NoFault())
        };
        ()
    };
    val_match : bool = false;
    match_on_read : bool = false;
    let ispriv : bool = AArch64_AccessUsesEL(acctype) != EL0;
    foreach (i from 0 to (NumWatchpointsImplemented() - 1) by 1 in inc) {
        assert(constraint('loop_i < 16));
        if AArch64_WatchpointMatch(i, vaddress, size, ispriv, acctype, iswrite) then {
            val_match = true;
            if [Slice(DBGWCR_EL1[i], 3, 2)[0]] == 0b1 then {
                match_on_read = true
            };
            ()
        };
        ()
    };
    if val_match & acctype == AccType_ATOMICRW then {
        iswrite = not_bool(match_on_read)
    };
    if val_match & HaltOnBreakpointOrWatchpoint() then {
        if acctype != AccType_NONFAULT & acctype != AccType_CNOTFIRST then {
            let reason : bits(6) = DebugHalt_Watchpoint;
            EDWAR = vaddress;
            Halt(reason);
            return(undefined : FaultRecord)
        } else {
            return(AArch64_DebugFault(acctype, iswrite))
        }
    } else if val_match then {
        return(AArch64_DebugFault(acctype, iswrite))
    } else {
        return(NoFault())
    }
}

register SDER32_EL2 : bits(64)

val SDER32_EL3_read : unit -> bits(64)

function SDER32_EL3_read () = {
    r : bits(64) = undefined;
    r = SetSlice(64, r, 0, Slice(SDER32_EL2, 0, 64));
    return(r)
}

val AArch64_GenerateDebugExceptionsFrom : forall ('secure : Bool).
  (bits(2), bool('secure), bits(1)) -> bool

function AArch64_GenerateDebugExceptionsFrom (from, secure, mask) = {
    if (Slice(OSLSR_EL1, 1, 1) == 0b1 | DoubleLockStatus()) | Halted() then {
        return(false)
    };
    let route_to_el2 : bool = (HaveEL(EL2) & (not_bool(secure) | IsSecureEL2Enabled())) & (Slice(HCR_EL2, 27, 1) == 0b1 | Slice(MDCR_EL2, 8, 1) == 0b1);
    let target : bits(2) = if route_to_el2 then EL2 else EL1;
    enabled : bool = undefined;
    if HaveEL(EL3) & secure then {
        enabled = Slice(MDCR_EL3, 16, 1) == 0b0;
        if from == EL0 & ELUsingAArch32(EL1) then {
            enabled = enabled | Slice(SDER32_EL3_read(), 0, 1) == 0b1
        };
        ()
    } else {
        enabled = true
    };
    if from == target then {
        enabled = (enabled & Slice(MDSCR_EL1, 13, 1) == 0b1) & mask == 0b0
    } else {
        enabled = enabled & UInt(target) > UInt(from)
    };
    return(enabled)
}

val AArch64_GenerateDebugExceptions : unit -> bool

function AArch64_GenerateDebugExceptions () = {
    return(AArch64_GenerateDebugExceptionsFrom(PSTATE.EL, IsSecure(), PSTATE.D))
}

val AArch64_CheckDebug : forall ('iswrite : Bool) 'size.
  (bits(64), AccType, bool('iswrite), int('size)) -> FaultRecord

function AArch64_CheckDebug (vaddress, acctype, iswrite, size) = {
    mask : bits(1) = undefined;
    fault : FaultRecord = NoFault();
    generate_exception : bool = undefined;
    let d_side : bool = acctype != AccType_IFETCH;
    if HaveNV2Ext() & acctype == AccType_NV2REGISTER then {
        let mask : bits(1) = 0b0;
        generate_exception = AArch64_GenerateDebugExceptionsFrom(EL2, IsSecure(), mask) & Slice(MDSCR_EL1, 15, 1) == 0b1
    } else {
        generate_exception = AArch64_GenerateDebugExceptions() & Slice(MDSCR_EL1, 15, 1) == 0b1
    };
    let halt : bool = HaltOnBreakpointOrWatchpoint();
    if generate_exception | halt then {
        if d_side then {
            fault = AArch64_CheckWatchpoint(vaddress, acctype, iswrite, size)
        } else {
            fault = AArch64_CheckBreakpoint(vaddress, acctype, size)
        }
    };
    return(fault)
}

val AArch64_FaultAllowsSetAccessFlag : FaultRecord -> bool

function AArch64_FaultAllowsSetAccessFlag fault = {
    if fault.statuscode == Fault_None then {
        return(true)
    } else if fault.statuscode == Fault_Alignment | fault.statuscode == Fault_Permission then {
        return(ConstrainUnpredictable(Unpredictable_AFUPDATE) == Constraint_TRUE)
    } else {
        return(false)
    }
}

enum VARange = {VARange_LOWER, VARange_UPPER}

val __UNKNOWN_VARange : unit -> VARange

function __UNKNOWN_VARange () = undefined

val AArch64_GetVARange : bits(64) -> VARange

function AArch64_GetVARange va = {
    if [va[55]] == 0b0 then {
        return(VARange_LOWER)
    } else {
        return(VARange_UPPER)
    }
}

val HaveSmallTranslationTableExt : unit -> bool

function HaveSmallTranslationTableExt () = {
    return(HasArchVersion(ARMv8p4) & __IMPDEF_boolean("Has Small Translation Table extension"))
}

val AArch64_MaxTxSZ : TGx -> int

function AArch64_MaxTxSZ tgx = {
    if HaveSmallTranslationTableExt() & not_bool(UsingAArch32()) then {
        match tgx {
          TGx_4KB => {
              return(48)
          },
          TGx_16KB => {
              return(48)
          },
          TGx_64KB => {
              return(47)
          }
        }
    };
    return(39)
}

val AArch64_S1MinTxSZ : (bits(1), TGx) -> int

function AArch64_S1MinTxSZ (ds, tgx) = {
    if Have52BitVAExt() & tgx == TGx_64KB | ds == 0b1 then {
        return(12)
    };
    return(16)
}

val AArch64_DecodeTG0 : bits(2) -> TGx

function AArch64_DecodeTG0 tg0_in = {
    tg0 : bits(2) = tg0_in;
    if tg0 == 0b11 then {
        tg0 = __IMPDEF_bits(2, "Reserved TG0 encoding granule size")
    };
    match tg0 {
      0b00 => {
          return(TGx_4KB)
      },
      0b01 => {
          return(TGx_64KB)
      },
      0b10 => {
          return(TGx_16KB)
      },
      _ => {
          return(undefined : TGx)
      }
    }
}

val AArch64_DecodeTG1 : bits(2) -> TGx

function AArch64_DecodeTG1 tg1_in = {
    tg1 : bits(2) = tg1_in;
    if tg1 == 0b00 then {
        tg1 = __IMPDEF_bits(2, "Reserved TG1 encoding granule size")
    };
    match tg1 {
      0b10 => {
          return(TGx_4KB)
      },
      0b11 => {
          return(TGx_64KB)
      },
      0b01 => {
          return(TGx_16KB)
      },
      _ => {
          return(undefined : TGx)
      }
    }
}

val AArch64_HaveHPDExt : unit -> bool

function AArch64_HaveHPDExt () = {
    return(HasArchVersion(ARMv8p1))
}

val HaveE0PDExt : unit -> bool

function HaveE0PDExt () = {
    return(HasArchVersion(ARMv8p5))
}

val HaveFeatCMOW : unit -> bool

function HaveFeatCMOW () = {
    return(HasArchVersion(ARMv8p8))
}

val HavePAN3Ext : unit -> bool

function HavePAN3Ext () = {
    return(HasArchVersion(ARMv8p7) | HasArchVersion(ARMv8p1) & __IMPDEF_boolean("Has PAN3 extension"))
}

val HaveTrapLoadStoreMultipleDeviceExt : unit -> bool

function HaveTrapLoadStoreMultipleDeviceExt () = {
    return(HasArchVersion(ARMv8p2))
}

register MAIR_EL1 : bits(64)

struct S1TTWParams = {
  ha : bits(1),
  hd : bits(1),
  tbi : bits(1),
  tbid : bits(1),
  nfd : bits(1),
  e0pd : bits(1),
  ds : bits(1),
  ps : bits(3),
  txsz : bits(6),
  epan : bits(1),
  dct : bits(1),
  nv1 : bits(1),
  cmow : bits(1),
  t0sz : bits(3),
  t1sz : bits(3),
  uwxn : bits(1),
  tgx : TGx,
  irgn : bits(2),
  orgn : bits(2),
  sh : bits(2),
  hpd : bits(1),
  ee : bits(1),
  wxn : bits(1),
  ntlsmd : bits(1),
  dc : bits(1),
  sif : bits(1),
  mair : bits(64)
}

val AArch64_S1TTWParamsEL10 : VARange -> S1TTWParams

function AArch64_S1TTWParamsEL10 varange = {
    walkparams : S1TTWParams = undefined;
    if varange == VARange_LOWER then {
        walkparams.tgx = AArch64_DecodeTG0(Slice(TCR_EL1, 14, 2));
        walkparams.txsz = Slice(TCR_EL1, 0, 6);
        walkparams.irgn = Slice(TCR_EL1, 8, 2);
        walkparams.orgn = Slice(TCR_EL1, 10, 2);
        walkparams.sh = Slice(TCR_EL1, 12, 2);
        walkparams.tbi = Slice(TCR_EL1, 37, 1);
        walkparams.nfd = if HaveSVE() | HaveTME() then Slice(TCR_EL1, 53, 1)
        else
          0b0;
        walkparams.tbid = if HavePACExt() then Slice(TCR_EL1, 51, 1) else 0b0;
        walkparams.e0pd = if HaveE0PDExt() then Slice(TCR_EL1, 55, 1) else 0b0;
        walkparams.hpd = if AArch64_HaveHPDExt() then Slice(TCR_EL1, 41, 1) else
          0b0
    } else {
        walkparams.tgx = AArch64_DecodeTG1(Slice(TCR_EL1, 30, 2));
        walkparams.txsz = Slice(TCR_EL1, 16, 6);
        walkparams.irgn = Slice(TCR_EL1, 24, 2);
        walkparams.orgn = Slice(TCR_EL1, 26, 2);
        walkparams.sh = Slice(TCR_EL1, 28, 2);
        walkparams.tbi = Slice(TCR_EL1, 38, 1);
        walkparams.nfd = if HaveSVE() | HaveTME() then Slice(TCR_EL1, 54, 1)
        else
          0b0;
        walkparams.tbid = if HavePACExt() then Slice(TCR_EL1, 52, 1) else 0b0;
        walkparams.e0pd = if HaveE0PDExt() then Slice(TCR_EL1, 56, 1) else 0b0;
        walkparams.hpd = if AArch64_HaveHPDExt() then Slice(TCR_EL1, 42, 1) else
          0b0
    };
    walkparams.mair = MAIR_EL1;
    walkparams.wxn = Slice(SCTLR_EL1, 19, 1);
    walkparams.ps = Slice(TCR_EL1, 32, 3);
    walkparams.ee = Slice(SCTLR_EL1, 25, 1);
    walkparams.sif = Slice(SCR_EL3, 9, 1);
    if EL2Enabled() then {
        walkparams.dc = Slice(HCR_EL2, 12, 1);
        walkparams.dct = if HaveMTE2Ext() then Slice(HCR_EL2, 57, 1) else 0b0
    };
    if HaveTrapLoadStoreMultipleDeviceExt() then {
        walkparams.ntlsmd = Slice(SCTLR_EL1, 28, 1)
    } else {
        walkparams.ntlsmd = 0b1
    };
    if EL2Enabled() then {
        if (Slice(HCR_EL2, 42, 1) @ Slice(HCR_EL2, 43, 1)) == 0b01 then {
            match ConstrainUnpredictable(Unpredictable_NVNV1) {
              Constraint_NVNV1_00 => {
                  walkparams.nv1 = 0b0
              },
              Constraint_NVNV1_01 => {
                  walkparams.nv1 = 0b1
              },
              Constraint_NVNV1_11 => {
                  walkparams.nv1 = 0b1
              },
              _ => ()
            }
        } else {
            walkparams.nv1 = Slice(HCR_EL2, 43, 1)
        }
    } else {
        walkparams.nv1 = 0b0
    };
    walkparams.epan = if HavePAN3Ext() then Slice(SCTLR_EL1, 57, 1) else 0b0;
    walkparams.cmow = if HaveFeatCMOW() then Slice(SCTLR_EL1, 32, 1) else 0b0;
    walkparams.ha = if HaveAccessFlagUpdateExt() then Slice(TCR_EL1, 39, 1) else
      0b0;
    walkparams.hd = if HaveDirtyBitModifierExt() then Slice(TCR_EL1, 40, 1) else
      0b0;
    if (walkparams.tgx == TGx_4KB | walkparams.tgx == TGx_16KB) & Have52BitIPAAndPASpaceExt() then {
        walkparams.ds = Slice(TCR_EL1, 59, 1)
    } else {
        walkparams.ds = 0b0
    };
    return(walkparams)
}

register MAIR_EL2 : bits(64)

val AArch64_S1TTWParamsEL2 : unit -> S1TTWParams

function AArch64_S1TTWParamsEL2 () = {
    walkparams : S1TTWParams = undefined;
    walkparams.tgx = AArch64_DecodeTG0(Slice(TCR_EL2, 14, 2));
    walkparams.txsz = Slice(TCR_EL2, 0, 6);
    walkparams.ps = Slice(TCR_EL2, 16, 3);
    walkparams.irgn = Slice(TCR_EL2, 8, 2);
    walkparams.orgn = Slice(TCR_EL2, 10, 2);
    walkparams.sh = Slice(TCR_EL2, 12, 2);
    walkparams.tbi = Slice(TCR_EL2, 20, 1);
    walkparams.mair = MAIR_EL2;
    walkparams.wxn = Slice(SCTLR_EL2, 19, 1);
    walkparams.ee = Slice(SCTLR_EL2, 25, 1);
    walkparams.sif = Slice(SCR_EL3, 9, 1);
    walkparams.tbid = if HavePACExt() then Slice(TCR_EL2, 29, 1) else 0b0;
    walkparams.hpd = if AArch64_HaveHPDExt() then Slice(TCR_EL2, 24, 1) else 0b0;
    walkparams.ha = if HaveAccessFlagUpdateExt() then
      Slice(TCR_EL2, if Slice(HCR_EL2, 34, 1) == 0b0 then 21 else 39, 1)
    else
      0b0;
    walkparams.hd = if HaveDirtyBitModifierExt() then
      Slice(TCR_EL2, if Slice(HCR_EL2, 34, 1) == 0b0 then 22 else 40, 1)
    else
      0b0;
    if (walkparams.tgx == TGx_4KB | walkparams.tgx == TGx_16KB) & Have52BitIPAAndPASpaceExt() then {
        walkparams.ds = Slice(TCR_EL2, if Slice(HCR_EL2, 34, 1) == 0b0 then 32
        else
          59, 1)
    } else {
        walkparams.ds = 0b0
    };
    return(walkparams)
}

val AArch64_S1TTWParamsEL20 : VARange -> S1TTWParams

function AArch64_S1TTWParamsEL20 varange = {
    walkparams : S1TTWParams = undefined;
    if varange == VARange_LOWER then {
        walkparams.tgx = AArch64_DecodeTG0(Slice(TCR_EL2, 14, 2));
        walkparams.txsz = Slice(TCR_EL2, 0, 6);
        walkparams.irgn = Slice(TCR_EL2, 8, 2);
        walkparams.orgn = Slice(TCR_EL2, 10, 2);
        walkparams.sh = Slice(TCR_EL2, 12, 2);
        walkparams.tbi = Slice(TCR_EL2, 37, 1);
        walkparams.nfd = if HaveSVE() | HaveTME() then Slice(TCR_EL2, 53, 1)
        else
          0b0;
        walkparams.tbid = if HavePACExt() then Slice(TCR_EL2, 51, 1) else 0b0;
        walkparams.e0pd = if HaveE0PDExt() then Slice(TCR_EL2, 55, 1) else 0b0;
        walkparams.hpd = if AArch64_HaveHPDExt() then Slice(TCR_EL2, 41, 1) else
          0b0
    } else {
        walkparams.tgx = AArch64_DecodeTG1(Slice(TCR_EL2, 30, 2));
        walkparams.txsz = Slice(TCR_EL2, 16, 6);
        walkparams.irgn = Slice(TCR_EL2, 24, 2);
        walkparams.orgn = Slice(TCR_EL2, 26, 2);
        walkparams.sh = Slice(TCR_EL2, 28, 2);
        walkparams.tbi = Slice(TCR_EL2, 38, 1);
        walkparams.nfd = if HaveSVE() | HaveTME() then Slice(TCR_EL2, 54, 1)
        else
          0b0;
        walkparams.tbid = if HavePACExt() then Slice(TCR_EL2, 52, 1) else 0b0;
        walkparams.e0pd = if HaveE0PDExt() then Slice(TCR_EL2, 56, 1) else 0b0;
        walkparams.hpd = if AArch64_HaveHPDExt() then Slice(TCR_EL2, 42, 1) else
          0b0
    };
    walkparams.mair = MAIR_EL2;
    walkparams.wxn = Slice(SCTLR_EL2, 19, 1);
    walkparams.ps = Slice(TCR_EL2, 32, 3);
    walkparams.ee = Slice(SCTLR_EL2, 25, 1);
    walkparams.sif = Slice(SCR_EL3, 9, 1);
    if HaveTrapLoadStoreMultipleDeviceExt() then {
        walkparams.ntlsmd = Slice(SCTLR_EL2, 28, 1)
    } else {
        walkparams.ntlsmd = 0b1
    };
    walkparams.epan = if HavePAN3Ext() then Slice(SCTLR_EL2, 57, 1) else 0b0;
    walkparams.cmow = if HaveFeatCMOW() then Slice(SCTLR_EL2, 32, 1) else 0b0;
    walkparams.ha = if HaveAccessFlagUpdateExt() then
      Slice(TCR_EL2, if Slice(HCR_EL2, 34, 1) == 0b0 then 21 else 39, 1)
    else
      0b0;
    walkparams.hd = if HaveDirtyBitModifierExt() then
      Slice(TCR_EL2, if Slice(HCR_EL2, 34, 1) == 0b0 then 22 else 40, 1)
    else
      0b0;
    if (walkparams.tgx == TGx_4KB | walkparams.tgx == TGx_16KB) & Have52BitIPAAndPASpaceExt() then {
        walkparams.ds = Slice(TCR_EL2, if Slice(HCR_EL2, 34, 1) == 0b0 then 32
        else
          59, 1)
    } else {
        walkparams.ds = 0b0
    };
    return(walkparams)
}

register MAIR_EL3 : bits(64)

val AArch64_S1TTWParamsEL3 : unit -> S1TTWParams

function AArch64_S1TTWParamsEL3 () = {
    walkparams : S1TTWParams = undefined;
    walkparams.tgx = AArch64_DecodeTG0(Slice(TCR_EL3, 14, 2));
    walkparams.txsz = Slice(TCR_EL3, 0, 6);
    walkparams.ps = Slice(TCR_EL3, 16, 3);
    walkparams.irgn = Slice(TCR_EL3, 8, 2);
    walkparams.orgn = Slice(TCR_EL3, 10, 2);
    walkparams.sh = Slice(TCR_EL3, 12, 2);
    walkparams.tbi = Slice(TCR_EL3, 20, 1);
    walkparams.mair = MAIR_EL3;
    walkparams.wxn = Slice(SCTLR_EL3, 19, 1);
    walkparams.ee = Slice(SCTLR_EL3, 25, 1);
    walkparams.sif = Slice(SCR_EL3, 9, 1);
    walkparams.tbid = if HavePACExt() then Slice(TCR_EL3, 29, 1) else 0b0;
    walkparams.hpd = if AArch64_HaveHPDExt() then Slice(TCR_EL3, 24, 1) else 0b0;
    walkparams.ha = if HaveAccessFlagUpdateExt() then Slice(TCR_EL3, 21, 1) else
      0b0;
    walkparams.hd = if HaveDirtyBitModifierExt() then Slice(TCR_EL3, 22, 1) else
      0b0;
    if (walkparams.tgx == TGx_4KB | walkparams.tgx == TGx_16KB) & Have52BitIPAAndPASpaceExt() then {
        walkparams.ds = Slice(TCR_EL3, 32, 1)
    } else {
        walkparams.ds = 0b0
    };
    return(walkparams)
}

val AArch64_GetS1TTWParams : (Regime, bits(64)) -> S1TTWParams

function AArch64_GetS1TTWParams (regime, va) = {
    walkparams : S1TTWParams = undefined;
    let varange : VARange = AArch64_GetVARange(va);
    match regime {
      Regime_EL3 => {
          walkparams = AArch64_S1TTWParamsEL3()
      },
      Regime_EL2 => {
          walkparams = AArch64_S1TTWParamsEL2()
      },
      Regime_EL20 => {
          walkparams = AArch64_S1TTWParamsEL20(varange)
      },
      Regime_EL10 => {
          walkparams = AArch64_S1TTWParamsEL10(varange)
      },
      _ => ()
    };
    let 'maxtxsz = AArch64_MaxTxSZ(walkparams.tgx);
    let 'mintxsz = AArch64_S1MinTxSZ(walkparams.ds, walkparams.tgx);
    if UInt(walkparams.txsz) > maxtxsz then {
        if not_bool(__IMPDEF_boolean("Fault on TxSZ value above maximum")) then {
            walkparams.txsz = maxtxsz[5 .. 0]
        };
        ()
    } else if not_bool(Have52BitVAExt()) & UInt(walkparams.txsz) < mintxsz then {
        if not_bool(__IMPDEF_boolean("Fault on TxSZ value below minimum")) then {
            walkparams.txsz = mintxsz[5 .. 0]
        };
        ()
    } else ();
    return(walkparams)
}

overload BigEndianReverse = {reverse_endianness}

let PIdSpace_NonSecure : bits(2) = 0b01

register MPAM3_EL3 : bits(64)

register _MPAM2_EL2_0_62 : bits(63)

val MPAM2_EL2_read : unit -> bits(64)

function MPAM2_EL2_read () = {
    r : bits(64) = undefined;
    r = SetSlice(1, r, 63, Slice(MPAM3_EL3, 63, 1));
    r = SetSlice(63, r, 0, _MPAM2_EL2_0_62);
    return(r)
}

val UsePrimarySpaceEL10 : unit -> bool

function UsePrimarySpaceEL10 () = {
    let hen3 : bool = Slice(MPAM3_EL3, 57, 1) == 0b1;
    return(not_bool(hen3) & Slice(MPAM3_EL3, 56, 1) == 0b0 | hen3 & Slice(MPAM2_EL2_read(), 56, 1) == 0b0)
}

val UsePrimarySpaceEL2 : unit -> bool

function UsePrimarySpaceEL2 () = {
    let hen3 : bool = Slice(MPAM3_EL3, 57, 1) == 0b1;
    return(not_bool(hen3) & Slice(MPAM3_EL3, 56, 1) == 0b0 | hen3 & Slice(MPAM2_EL2_read(), 55, 1) == 0b0)
}

val AltPIdRealm : (bits(2), bits(2)) -> bits(2)

function AltPIdRealm (el, primaryPIdSpace) = {
    PIdSpace : bits(2) = primaryPIdSpace;
    match el {
      ? if ? == EL0 => {
          if ELIsInHost(EL0) then {
              if not_bool(UsePrimarySpaceEL2()) then {
                  PIdSpace = PIdSpace_NonSecure
              };
              ()
          } else if not_bool(UsePrimarySpaceEL10()) then {
              PIdSpace = PIdSpace_NonSecure
          } else ()
      },
      ? if ? == EL1 => {
          if not_bool(UsePrimarySpaceEL10()) then {
              PIdSpace = PIdSpace_NonSecure
          };
          ()
      },
      ? if ? == EL2 => {
          if not_bool(UsePrimarySpaceEL2()) then {
              PIdSpace = PIdSpace_NonSecure
          };
          ()
      },
      _ => {
          Unreachable()
      }
    };
    return(PIdSpace)
}

val AltPIdSecure : (bits(2), bits(2)) -> bits(2)

function AltPIdSecure (el, primaryPIdSpace) = {
    PIdSpace : bits(2) = primaryPIdSpace;
    let el2en : bool = EL2Enabled();
    match el {
      ? if ? == EL0 => {
          if el2en then {
              if ELIsInHost(EL0) then {
                  if not_bool(UsePrimarySpaceEL2()) then {
                      PIdSpace = PIdSpace_NonSecure
                  };
                  ()
              } else if not_bool(UsePrimarySpaceEL10()) then {
                  PIdSpace = PIdSpace_NonSecure
              } else ()
          } else if Slice(MPAM3_EL3, 57, 1) == 0b0 & Slice(MPAM3_EL3, 56, 1) == 0b1 then {
              PIdSpace = PIdSpace_NonSecure
          } else ()
      },
      ? if ? == EL1 => {
          if el2en then {
              if not_bool(UsePrimarySpaceEL10()) then {
                  PIdSpace = PIdSpace_NonSecure
              };
              ()
          } else if Slice(MPAM3_EL3, 57, 1) == 0b0 & Slice(MPAM3_EL3, 56, 1) == 0b1 then {
              PIdSpace = PIdSpace_NonSecure
          } else ()
      },
      ? if ? == EL2 => {
          if not_bool(UsePrimarySpaceEL2()) then {
              PIdSpace = PIdSpace_NonSecure
          };
          ()
      },
      _ => {
          Unreachable()
      }
    };
    return(PIdSpace)
}

let PIdSpace_Secure : bits(2) = 0b00

val AltPARTIDspace : (bits(2), SecurityState, bits(2)) -> bits(2)

function AltPARTIDspace (el, security, primaryPIdSpace) = {
    match security {
      SS_NonSecure => {
          assert(el != EL3);
          return(primaryPIdSpace)
      },
      SS_Secure => {
          assert(el != EL3);
          if primaryPIdSpace == PIdSpace_NonSecure then {
              return(primaryPIdSpace)
          };
          return(AltPIdSecure(el, primaryPIdSpace))
      },
      SS_Root => {
          assert(el == EL3);
          if Slice(MPAM3_EL3, 55, 1) == 0b1 then {
              if Slice(MPAM3_EL3, 52, 1) == 0b1 then {
                  return(PIdSpace_NonSecure)
              } else {
                  return(PIdSpace_Secure)
              }
          } else {
              return(primaryPIdSpace)
          }
      },
      SS_Realm => {
          assert(el != EL3);
          return(AltPIdRealm(el, primaryPIdSpace))
      },
      _ => {
          Unreachable();
          return(undefined : bits(2))
      }
    }
}

let DefaultPARTID : bits(16) = 0[15 .. 0]

let DefaultPMG : bits(8) = 0[7 .. 0]

val DefaultMPAMinfo : bits(2) -> MPAMinfo

function DefaultMPAMinfo partidspace = {
    DefaultInfo : MPAMinfo = undefined;
    DefaultInfo.mpam_sp = partidspace;
    DefaultInfo.partid = DefaultPARTID;
    DefaultInfo.pmg = DefaultPMG;
    return(DefaultInfo)
}

val HaveMPAMExt : unit -> bool

function HaveMPAMExt () = {
    return(HasArchVersion(ARMv8p2) & __IMPDEF_boolean("Has MPAM extension"))
}

val HaveEMPAMExt : unit -> bool

function HaveEMPAMExt () = {
    return((HasArchVersion(ARMv8p6) & HaveMPAMExt()) & __IMPDEF_boolean("Has enhanced MPAM extension"))
}

register MPAMIDR_EL1 : bits(64)

val HighestEL : unit -> bits(2)

function HighestEL () = {
    if HaveEL(EL3) then {
        return(EL3)
    } else if HaveEL(EL2) then {
        return(EL2)
    } else {
        return(EL1)
    }
}

register _MPAM1_EL1_0_62 : bits(63)

val MPAM1_EL1_read : unit -> bits(64)

function MPAM1_EL1_read () = {
    r : bits(64) = undefined;
    if HaveEL(EL3) then {
        r = SetSlice(1, r, 63, Slice(MPAM3_EL3, 63, 1))
    } else {
        r = SetSlice(1, r, 63, Slice(MPAM2_EL2_read(), 63, 1))
    };
    r = SetSlice(63, r, 0, _MPAM1_EL1_0_62);
    return(r)
}

val MPAMisEnabled : unit -> bool

function MPAMisEnabled () = {
    let el : bits(2) = HighestEL();
    match el {
      ? if ? == EL3 => {
          return(Slice(MPAM3_EL3, 63, 1) == 0b1)
      },
      ? if ? == EL2 => {
          return(Slice(MPAM2_EL2_read(), 63, 1) == 0b1)
      },
      ? if ? == EL1 => {
          return(Slice(MPAM1_EL1_read(), 63, 1) == 0b1)
      },
      _ => {
          return(undefined : bool)
      }
    }
}

let PIdSpace_Realm : bits(2) = 0b11

let PIdSpace_Root : bits(2) = 0b10

val PARTIDspaceFromSS : SecurityState -> bits(2)

function PARTIDspaceFromSS security = {
    match security {
      SS_NonSecure => {
          return(PIdSpace_NonSecure)
      },
      SS_Root => {
          return(PIdSpace_Root)
      },
      SS_Realm => {
          return(PIdSpace_Realm)
      },
      SS_Secure => {
          return(PIdSpace_Secure)
      },
      _ => {
          Unreachable();
          return(undefined : bits(2))
      }
    }
}

register MPAMHCR_EL2 : bits(64)

register MPAMVPM0_EL2 : bits(64)

register MPAMVPMV_EL2 : bits(64)

register MPAMVPM1_EL2 : bits(64)

register MPAMVPM2_EL2 : bits(64)

register MPAMVPM3_EL2 : bits(64)

register MPAMVPM4_EL2 : bits(64)

register MPAMVPM5_EL2 : bits(64)

register MPAMVPM6_EL2 : bits(64)

register MPAMVPM7_EL2 : bits(64)

val mapvpmw : forall 'vpartid. int('vpartid) -> bits(16)

function mapvpmw vpartid = {
    vpmw : bits(64) = undefined;
    let 'wd = DIV(vpartid, 4);
    match wd {
      0 => {
          vpmw = MPAMVPM0_EL2
      },
      1 => {
          vpmw = MPAMVPM1_EL2
      },
      2 => {
          vpmw = MPAMVPM2_EL2
      },
      3 => {
          vpmw = MPAMVPM3_EL2
      },
      4 => {
          vpmw = MPAMVPM4_EL2
      },
      5 => {
          vpmw = MPAMVPM5_EL2
      },
      6 => {
          vpmw = MPAMVPM6_EL2
      },
      7 => {
          vpmw = MPAMVPM7_EL2
      },
      _ => {
          vpmw = Zeros(64)
      }
    };
    let vpmw = vpmw;
    let 'vpme_lsb = MOD(vpartid, 4) * 16;
    return(Slice(vpmw, vpme_lsb, 16))
}

val MAP_vPARTID : bits(16) -> (bits(16), bool)

function MAP_vPARTID vpartid = {
    ret : bits(16) = undefined;
    err : bool = undefined;
    virt : int = UInt(vpartid);
    let 'vpmrmax = UInt(Slice(MPAMIDR_EL1, 18, 3));
    let 'vpartid_max = (vpmrmax << 2) + 3;
    if UInt(vpartid) > vpartid_max then {
        virt = MOD(virt, vpartid_max + 1)
    };
    let 'virt = virt;
    assert(constraint((0 <= 'virt & 'virt < 64)));
    if [MPAMVPMV_EL2[virt]] == 0b1 then {
        ret = mapvpmw(virt);
        err = false
    } else if [MPAMVPMV_EL2[0]] == 0b1 then {
        ret = Slice(MPAMVPM0_EL2, 0, 16);
        err = false
    } else {
        ret = DefaultPARTID;
        err = true
    };
    let 'partid_max = UInt(Slice(MPAMIDR_EL1, 0, 16));
    if UInt(ret) > partid_max then {
        ret = DefaultPARTID;
        err = true
    };
    let err = err;
    let ret = ret;
    return((ret, err))
}

val MPAMisVirtual : bits(2) -> bool

function MPAMisVirtual el = {
    return((Slice(MPAMIDR_EL1, 17, 1) == 0b1 & EL2Enabled()) & ((el == EL0 & Slice(MPAMHCR_EL2, 0, 1) == 0b1) & (Slice(HCR_EL2, 34, 1) == 0b0 | Slice(HCR_EL2, 27, 1) == 0b0) | el == EL1 & Slice(MPAMHCR_EL2, 1, 1) == 0b1))
}

register MPAM0_EL1 : bits(64)

register MPAMSM_EL1 : bits(64)

val getMPAM_PARTID : forall ('InD : Bool) ('InSM : Bool).
  (bits(2), bool('InD), bool('InSM)) -> bits(16)

function getMPAM_PARTID (MPAMn, InD, InSM) = {
    partid : bits(16) = undefined;
    let el2avail : bool = EL2Enabled();
    if InSM then {
        partid = Slice(MPAMSM_EL1, 16, 16);
        return(partid)
    };
    if InD then {
        match MPAMn {
          0b11 => {
              partid = Slice(MPAM3_EL3, 0, 16)
          },
          0b10 => {
              partid = if el2avail then Slice(MPAM2_EL2_read(), 0, 16) else
                Zeros()
          },
          0b01 => {
              partid = Slice(MPAM1_EL1_read(), 0, 16)
          },
          0b00 => {
              partid = Slice(MPAM0_EL1, 0, 16)
          },
          _ => {
              partid = __UNKNOWN_bits(16)
          }
        }
    } else {
        match MPAMn {
          0b11 => {
              partid = Slice(MPAM3_EL3, 16, 16)
          },
          0b10 => {
              partid = if el2avail then Slice(MPAM2_EL2_read(), 16, 16) else
                Zeros()
          },
          0b01 => {
              partid = Slice(MPAM1_EL1_read(), 16, 16)
          },
          0b00 => {
              partid = Slice(MPAM0_EL1, 16, 16)
          },
          _ => {
              partid = __UNKNOWN_bits(16)
          }
        }
    };
    return(partid)
}

val genPARTID : forall ('InD : Bool) ('InSM : Bool).
  (bits(2), bool('InD), bool('InSM)) -> (bits(16), bool)

function genPARTID (el, InD, InSM) = {
    let partidel : bits(16) = getMPAM_PARTID(el, InD, InSM);
    let partid_max : bits(16) = Slice(MPAMIDR_EL1, 0, 16);
    if UInt(partidel) > UInt(partid_max) then {
        return((DefaultPARTID, true))
    };
    if MPAMisVirtual(el) then {
        return(MAP_vPARTID(partidel))
    } else {
        return((partidel, false))
    }
}

val getMPAM_PMG : forall ('InD : Bool) ('InSM : Bool).
  (bits(2), bool('InD), bool('InSM)) -> bits(8)

function getMPAM_PMG (MPAMn, InD, InSM) = {
    pmg : bits(8) = undefined;
    let el2avail : bool = EL2Enabled();
    if InSM then {
        pmg = Slice(MPAMSM_EL1, 40, 8);
        return(pmg)
    };
    if InD then {
        match MPAMn {
          0b11 => {
              pmg = Slice(MPAM3_EL3, 32, 8)
          },
          0b10 => {
              pmg = if el2avail then Slice(MPAM2_EL2_read(), 32, 8) else Zeros()
          },
          0b01 => {
              pmg = Slice(MPAM1_EL1_read(), 32, 8)
          },
          0b00 => {
              pmg = Slice(MPAM0_EL1, 32, 8)
          },
          _ => {
              pmg = __UNKNOWN_bits(8)
          }
        }
    } else {
        match MPAMn {
          0b11 => {
              pmg = Slice(MPAM3_EL3, 40, 8)
          },
          0b10 => {
              pmg = if el2avail then Slice(MPAM2_EL2_read(), 40, 8) else Zeros()
          },
          0b01 => {
              pmg = Slice(MPAM1_EL1_read(), 40, 8)
          },
          0b00 => {
              pmg = Slice(MPAM0_EL1, 40, 8)
          },
          _ => {
              pmg = __UNKNOWN_bits(8)
          }
        }
    };
    return(pmg)
}

val genPMG : forall ('InD : Bool) ('InSM : Bool) ('partid_err : Bool).
  (bits(2), bool('InD), bool('InSM), bool('partid_err)) -> bits(8)

function genPMG (el, InD, InSM, partid_err) = {
    let 'pmg_max = UInt(Slice(MPAMIDR_EL1, 32, 8));
    if partid_err then {
        return(DefaultPMG)
    };
    let groupel : bits(8) = getMPAM_PMG(el, InD, InSM);
    if UInt(groupel) <= pmg_max then {
        return(groupel)
    };
    return(DefaultPMG)
}

val genMPAM : forall ('InD : Bool) ('InSM : Bool).
  (bits(2), bool('InD), bool('InSM), bits(2)) -> MPAMinfo

function genMPAM (el, InD, InSM, pspace) = {
    returninfo : MPAMinfo = undefined;
    partidel : bits(16) = undefined;
    perr : bool = undefined;
    let gstplk : bool = ((el == EL0 & EL2Enabled()) & Slice(MPAMHCR_EL2, 8, 1) == 0b1) & Slice(HCR_EL2, 27, 1) == 0b0;
    let eff_el : bits(2) = if gstplk then EL1 else el;
    (partidel, perr) = genPARTID(eff_el, InD, InSM);
    let groupel : bits(8) = genPMG(eff_el, InD, InSM, perr);
    returninfo.mpam_sp = pspace;
    returninfo.partid = partidel;
    returninfo.pmg = groupel;
    return(returninfo)
}

val GenMPAMcurEL : AccType -> MPAMinfo

function GenMPAMcurEL acctype = {
    mpamEL : bits(2) = undefined;
    validEL_name : bool = false;
    let security : SecurityState = CurrentSecurityState();
    InD : bool = false;
    InSM : bool = false;
    pspace : bits(2) = PARTIDspaceFromSS(security);
    if pspace == PIdSpace_NonSecure & not_bool(MPAMisEnabled()) then {
        return(DefaultMPAMinfo(pspace))
    };
    if UsingAArch32() then {
        (validEL_name, mpamEL) = ELFromM32(PSTATE.M)
    } else {
        mpamEL = if acctype == AccType_NV2REGISTER then EL2 else PSTATE.EL;
        validEL_name = true
    };
    match acctype {
      AccType_IFETCH => {
          InD = true
      },
      AccType_IC => {
          InD = true
      },
      AccType_SME => {
          InSM = __IMPDEF_boolean("Shared SMCU") | __IMPDEF_boolean("MPAMSM_EL1 label precedence")
      },
      AccType_SMESTREAM => {
          InSM = __IMPDEF_boolean("Shared SMCU") | __IMPDEF_boolean("MPAMSM_EL1 label precedence")
      },
      AccType_VEC => {
          InSM = (HaveSME() & PSTATE.SM == 0b1) & (__IMPDEF_boolean("Shared SMCU") | __IMPDEF_boolean("MPAMSM_EL1 label precedence"))
      },
      AccType_VECSTREAM => {
          InSM = (HaveSME() & PSTATE.SM == 0b1) & (__IMPDEF_boolean("Shared SMCU") | __IMPDEF_boolean("MPAMSM_EL1 label precedence"))
      },
      AccType_SVE => {
          InSM = (HaveSME() & PSTATE.SM == 0b1) & (__IMPDEF_boolean("Shared SMCU") | __IMPDEF_boolean("MPAMSM_EL1 label precedence"))
      },
      AccType_SVESTREAM => {
          InSM = (HaveSME() & PSTATE.SM == 0b1) & (__IMPDEF_boolean("Shared SMCU") | __IMPDEF_boolean("MPAMSM_EL1 label precedence"))
      },
      AccType_NONFAULT => {
          InSM = (HaveSME() & PSTATE.SM == 0b1) & (__IMPDEF_boolean("Shared SMCU") | __IMPDEF_boolean("MPAMSM_EL1 label precedence"))
      },
      AccType_CNOTFIRST => {
          InSM = (HaveSME() & PSTATE.SM == 0b1) & (__IMPDEF_boolean("Shared SMCU") | __IMPDEF_boolean("MPAMSM_EL1 label precedence"))
      },
      _ => {
          InD = false
      }
    };
    if not_bool(validEL_name) then {
        return(DefaultMPAMinfo(pspace))
    } else if Slice(MPAMIDR_EL1, 57, 1) == 0b1 then {
        pspace = AltPARTIDspace(mpamEL, security, pspace)
    } else ();
    if HaveEMPAMExt() & security == SS_Secure then {
        if Slice(MPAM3_EL3, 60, 1) == 0b1 then {
            pspace = PIdSpace_NonSecure
        };
        if Slice(MPAM3_EL3, 61, 1) == 0b1 then {
            return(DefaultMPAMinfo(pspace))
        };
        ()
    };
    if not_bool(MPAMisEnabled()) then {
        return(DefaultMPAMinfo(pspace))
    } else {
        return(genMPAM(mpamEL, InD, InSM, pspace))
    }
}

val CreateAccessDescriptor : AccType -> AccessDescriptor

function CreateAccessDescriptor acctype = {
    accdesc : AccessDescriptor = undefined;
    accdesc.acctype = acctype;
    accdesc.transactional = false;
    accdesc.mpam = GenMPAMcurEL(acctype);
    return(accdesc)
}

register GPCCR_EL3 : bits(64)

val DecodePPS : unit -> int

function DecodePPS () = {
    match Slice(GPCCR_EL3, 0, 3) {
      0b000 => {
          return(32)
      },
      0b001 => {
          return(36)
      },
      0b010 => {
          return(40)
      },
      0b011 => {
          return(42)
      },
      0b100 => {
          return(44)
      },
      0b101 => {
          return(48)
      },
      0b110 => {
          return(52)
      },
      _ => {
          Unreachable();
          return(undefined : int)
      }
    }
}

val AbovePPS : bits(52) -> bool

function AbovePPS address = {
    let 'pps = DecodePPS();
    if pps == 52 then {
        return(false)
    };
    return(not_bool(is_zero_subrange(address, 51, pps)))
}

val GPCFault : forall 'level. (GPCF, int('level)) -> GPCFRecord

function GPCFault (gpf, level) = {
    fault : GPCFRecord = undefined;
    fault.gpf = gpf;
    fault.level = level;
    return(fault)
}

val GPCRegistersConsistent : unit -> bool

function GPCRegistersConsistent () = {
    if Slice(GPCCR_EL3, 0, 3) == 0b111 | DecodePPS() > AArch64_PAMax() then {
        return(false)
    };
    if Slice(GPCCR_EL3, 14, 2) == 0b11 then {
        return(false)
    };
    if Slice(GPCCR_EL3, 12, 2) == 0b01 then {
        return(false)
    };
    if (Slice(GPCCR_EL3, 10, 2) @ Slice(GPCCR_EL3, 8, 2)) == 0b0000 & Slice(GPCCR_EL3, 12, 2) != 0b10 then {
        return(false)
    };
    return(true)
}

let GPT_Any : bits(4) = 0b1111

let GPT_NoAccess : bits(4) = 0b0000

let GPT_NonSecure : bits(4) = 0b1001

let GPT_Realm : bits(4) = 0b1011

let GPT_Root : bits(4) = 0b1010

let GPT_Secure : bits(4) = 0b1000

val GPICheck : (PASpace, bits(4)) -> bool

function GPICheck (paspace, gpi) = {
    match gpi {
      ? if ? == GPT_NoAccess => {
          return(false)
      },
      ? if ? == GPT_Secure => {
          return(paspace == PAS_Secure)
      },
      ? if ? == GPT_NonSecure => {
          return(paspace == PAS_NonSecure)
      },
      ? if ? == GPT_Root => {
          return(paspace == PAS_Root)
      },
      ? if ? == GPT_Realm => {
          return(paspace == PAS_Realm)
      },
      ? if ? == GPT_Any => {
          return(true)
      },
      _ => {
          Unreachable();
          return(undefined : bool)
      }
    }
}

register GPTBR_EL3 : bits(64)

struct GPTEntry = {gpi : bits(4), size : int, contig_size : int, level : int}

val __UNKNOWN_GPTEntry : unit -> GPTEntry

function __UNKNOWN_GPTEntry () = undefined

val GPIValid : bits(4) -> bool

function GPIValid gpi = {
    return(gpi == GPT_NoAccess | gpi == GPT_Secure | gpi == GPT_NonSecure | gpi == GPT_Root | gpi == GPT_Realm | gpi == GPT_Any)
}

let GPTRange_16GB : int(34) = 34

let GPTRange_1GB : int(30) = 30

let GPTRange_512GB : int(39) = 39

let GPTRange_64GB : int(36) = 36

val GPTL0Size : unit -> int

function GPTL0Size () = {
    match Slice(GPCCR_EL3, 20, 4) {
      0b0000 => {
          return(GPTRange_1GB)
      },
      0b0100 => {
          return(GPTRange_16GB)
      },
      0b0110 => {
          return(GPTRange_64GB)
      },
      0b1001 => {
          return(GPTRange_512GB)
      },
      _ => {
          Unreachable()
      }
    };
    return(30)
}

let GPTRange_16KB : int(14) = 14

let GPTRange_4KB : int(12) = 12

let GPTRange_64KB : int(16) = 16

let GPT_Block : bits(4) = 0b0001

enum PGSe = {PGS_4KB, PGS_16KB, PGS_64KB}

val DecodeGPTBlock : (PGSe, bits(64)) -> (GPCF, GPTEntry)

function DecodeGPTBlock (pgs, entry) = {
    assert(entry[3 .. 0] == GPT_Block);
    result : GPTEntry = undefined;
    if not_bool(IsZero(entry[63 .. 8])) then {
        return((GPCF_Walk, __UNKNOWN_GPTEntry()))
    };
    if not_bool(GPIValid(entry[7 .. 4])) then {
        return((GPCF_Walk, __UNKNOWN_GPTEntry()))
    };
    result.gpi = entry[7 .. 4];
    result.level = 0;
    match pgs {
      PGS_4KB => {
          result.size = GPTRange_4KB
      },
      PGS_16KB => {
          result.size = GPTRange_16KB
      },
      PGS_64KB => {
          result.size = GPTRange_64KB
      },
      _ => {
          Unreachable()
      }
    };
    result.contig_size = GPTL0Size();
    return((GPCF_None, result))
}

let GPTRange_2MB : int(21) = 21

let GPTRange_32MB : int(25) = 25

let GPTRange_512MB : int(29) = 29

let GPT_Contig : bits(4) = 0b0001

val DecodeGPTContiguous : (PGSe, bits(64)) -> (GPCF, GPTEntry)

function DecodeGPTContiguous (pgs, entry) = {
    assert(entry[3 .. 0] == GPT_Contig);
    result : GPTEntry = undefined;
    if not_bool(IsZero(entry[63 .. 10])) then {
        return((GPCF_Walk, result))
    };
    result.gpi = entry[7 .. 4];
    if not_bool(GPIValid(result.gpi)) then {
        return((GPCF_Walk, result))
    };
    match pgs {
      PGS_4KB => {
          result.size = GPTRange_4KB
      },
      PGS_16KB => {
          result.size = GPTRange_16KB
      },
      PGS_64KB => {
          result.size = GPTRange_64KB
      },
      _ => {
          Unreachable()
      }
    };
    match entry[9 .. 8] {
      0b01 => {
          result.contig_size = GPTRange_2MB
      },
      0b10 => {
          result.contig_size = GPTRange_32MB
      },
      0b11 => {
          result.contig_size = GPTRange_512MB
      },
      _ => {
          return((GPCF_Walk, __UNKNOWN_GPTEntry()))
      }
    };
    result.level = 1;
    return((GPCF_None, result))
}

val DecodeGPTGranules : forall 'index.
  (PGSe, int('index), bits(64)) -> (GPCF, GPTEntry)

function DecodeGPTGranules (pgs, index, entry) = {
    result : GPTEntry = undefined;
    foreach (i from 0 to 15 by 1 in inc) {
        if not_bool(GPIValid(Slice(entry, i * 4, 4))) then {
            return((GPCF_Walk, result))
        };
        ()
    };
    result.gpi = Slice(entry, index * 4, 4);
    match pgs {
      PGS_4KB => {
          result.size = GPTRange_4KB
      },
      PGS_16KB => {
          result.size = GPTRange_16KB
      },
      PGS_64KB => {
          result.size = GPTRange_64KB
      },
      _ => {
          Unreachable()
      }
    };
    result.contig_size = result.size;
    result.level = 1;
    return((GPCF_None, result))
}

struct GPTTable = {address : bits(52)}

val __UNKNOWN_GPTTable : unit -> GPTTable

function __UNKNOWN_GPTTable () = undefined

let GPT_Table : bits(4) = 0b0011

val DecodeGPTTable : (PGSe, bits(64)) -> (GPCF, GPTTable)

function DecodeGPTTable (pgs, entry) = {
    assert(entry[3 .. 0] == GPT_Table);
    result : GPTTable = undefined;
    if not_bool(IsZero(entry[63 .. 52] @ entry[11 .. 4])) then {
        return((GPCF_Walk, __UNKNOWN_GPTTable()))
    };
    let 'l0sz = GPTL0Size();
    p : {|12, 14, 16|} = 12;
    match pgs {
      PGS_4KB => {
          p = 12
      },
      PGS_16KB => {
          p = 14
      },
      PGS_64KB => {
          p = 16
      },
      _ => {
          Unreachable()
      }
    };
    let 'p = p;
    if not_bool(is_zero_subrange(entry, l0sz - p - 2, 12)) then {
        return((GPCF_Walk, __UNKNOWN_GPTTable()))
    };
    match pgs {
      PGS_4KB => {
          result.address = entry[51 .. 17] @ Zeros(17)
      },
      PGS_16KB => {
          result.address = entry[51 .. 15] @ Zeros(15)
      },
      PGS_64KB => {
          result.address = entry[51 .. 13] @ Zeros(13)
      },
      _ => {
          Unreachable()
      }
    };
    if AbovePPS(result.address) then {
        return((GPCF_AddressSize, __UNKNOWN_GPTTable()))
    };
    return((GPCF_None, result))
}

val DecodePGS : bits(2) -> PGSe

function DecodePGS pgs = {
    match pgs {
      0b00 => {
          return(PGS_4KB)
      },
      0b10 => {
          return(PGS_16KB)
      },
      0b01 => {
          return(PGS_64KB)
      },
      _ => {
          Unreachable();
          return(undefined : PGSe)
      }
    }
}

val GPIIndex : bits(52) -> int

function GPIIndex pa = {
    match DecodePGS(Slice(GPCCR_EL3, 14, 2)) {
      PGS_4KB => {
          return(UInt(pa[15 .. 12]))
      },
      PGS_16KB => {
          return(UInt(pa[17 .. 14]))
      },
      PGS_64KB => {
          return(UInt(pa[19 .. 16]))
      },
      _ => {
          Unreachable();
          return(undefined : int)
      }
    }
}

val GPTLevel0Index : bits(52) -> int

function GPTLevel0Index pa = {
    let 'pps = DecodePPS();
    let 'l0sz = GPTL0Size();
    if pps <= l0sz then {
        return(0)
    };
    assert(constraint((0 <= 'l0sz & 'pps - 1 < 52)));
    return(UInt(pa[pps - 1 .. l0sz]))
}

val GPTLevel1Index : bits(52) -> int

function GPTLevel1Index pa = {
    let 'l0sz = GPTL0Size();
    match DecodePGS(Slice(GPCCR_EL3, 14, 2)) {
      PGS_4KB => {
          assert(constraint((16 <= 'l0sz - 1 & 'l0sz - 1 < 52)));
          return(UInt(pa[l0sz - 1 .. 16]))
      },
      PGS_16KB => {
          assert(constraint((18 <= 'l0sz - 1 & 'l0sz - 1 < 52)));
          return(UInt(pa[l0sz - 1 .. 18]))
      },
      PGS_64KB => {
          assert(constraint((20 <= 'l0sz - 1 & 'l0sz - 1 < 52)));
          return(UInt(pa[l0sz - 1 .. 20]))
      },
      _ => {
          Unreachable();
          return(undefined : int)
      }
    }
}

val PhysMemRead : forall 'size, 'size > 0.
  (AddressDescriptor, int('size), AccessDescriptor) -> (PhysMemRetStatus, bits(8 * 'size))

let MemAttr_NC : bits(2) = 0b00

let MemAttr_WB : bits(2) = 0b11

let MemAttr_WT : bits(2) = 0b10

let MemHint_RA : bits(2) = 0b10

let MemHint_RWA : bits(2) = 0b11

val DecodeSDFAttr : bits(2) -> MemAttrHints

function DecodeSDFAttr rgn = {
    sdfattr : MemAttrHints = undefined;
    match rgn {
      0b00 => {
          sdfattr.attrs = MemAttr_NC
      },
      0b01 => {
          sdfattr.attrs = MemAttr_WB;
          sdfattr.hints = MemHint_RWA
      },
      0b10 => {
          sdfattr.attrs = MemAttr_WT;
          sdfattr.hints = MemHint_RA
      },
      0b11 => {
          sdfattr.attrs = MemAttr_WB;
          sdfattr.hints = MemHint_RA
      }
    };
    sdfattr.transient = false;
    return(sdfattr)
}

val DecodeShareability : bits(2) -> Shareability

function DecodeShareability sh = {
    match sh {
      0b10 => {
          return(Shareability_OSH)
      },
      0b11 => {
          return(Shareability_ISH)
      },
      0b00 => {
          return(Shareability_NSH)
      },
      _ => {
          match ConstrainUnpredictable(Unpredictable_Shareability) {
            Constraint_OSH => {
                return(Shareability_OSH)
            },
            Constraint_ISH => {
                return(Shareability_ISH)
            },
            Constraint_NSH => {
                return(Shareability_NSH)
            },
            _ => {
                return(undefined : Shareability)
            }
          }
      }
    }
}

val WalkMemAttrs : (bits(2), bits(2), bits(2)) -> MemoryAttributes

function WalkMemAttrs (sh, irgn, orgn) = {
    walkmemattrs : MemoryAttributes = undefined;
    walkmemattrs.memtype = MemType_Normal;
    walkmemattrs.shareability = DecodeShareability(sh);
    walkmemattrs.inner = DecodeSDFAttr(irgn);
    walkmemattrs.outer = DecodeSDFAttr(orgn);
    walkmemattrs.tagged = false;
    if walkmemattrs.inner.attrs == MemAttr_WB & walkmemattrs.outer.attrs == MemAttr_WB then {
        walkmemattrs.xs = 0b0
    } else {
        walkmemattrs.xs = 0b1
    };
    return(walkmemattrs)
}

val GPTWalk : (bits(52), AccessDescriptor) -> (GPCFRecord, GPTEntry)

function GPTWalk (pa, accdesc) = {
    gpi_index : int = undefined;
    memstatus : PhysMemRetStatus = undefined;
    let pgs : PGSe = DecodePGS(Slice(GPCCR_EL3, 14, 2));
    base : bits(52) = Slice(GPTBR_EL3, 0, 40) @ Zeros(12);
    let 'pps = DecodePPS();
    let 'l0sz = GPTL0Size();
    let 'alignment = Max(pps - l0sz + 3, 12);
    assert(constraint(52 >= 'alignment));
    let base : bits(52) = base & not_vec(ZeroExtend(Ones(alignment), 52));
    gptaddrdesc : AddressDescriptor = undefined;
    gptaddrdesc.fault = NoFault();
    gptaddrdesc.memattrs = WalkMemAttrs(Slice(GPCCR_EL3, 12, 2), Slice(GPCCR_EL3, 10, 2), Slice(GPCCR_EL3, 8, 2));
    gptaddrdesc.paddress.paspace = PAS_Root;
    gptaddrdesc.paddress.address = base + GPTLevel0Index(pa) * 8;
    level_0_entry : bits(64) = undefined;
    (memstatus, level_0_entry) = PhysMemRead(gptaddrdesc, 8, accdesc);
    if IsFault__2(memstatus) then {
        return((GPCFault(GPCF_EABT, 0), __UNKNOWN_GPTEntry()))
    };
    result : GPTEntry = undefined;
    table : GPTTable = undefined;
    gpf : GPCF = undefined;
    match level_0_entry[3 .. 0] {
      ? if ? == GPT_Block => {
          (gpf, result) = DecodeGPTBlock(pgs, level_0_entry);
          return((GPCFault(gpf, 0), result))
      },
      ? if ? == GPT_Table => {
          (gpf, table) = DecodeGPTTable(pgs, level_0_entry);
          if gpf != GPCF_None then {
              return((GPCFault(gpf, 0), __UNKNOWN_GPTEntry()))
          };
          ()
      },
      _ => {
          return((GPCFault(GPCF_Walk, 0), __UNKNOWN_GPTEntry()))
      }
    };
    assert(level_0_entry[3 .. 0] == GPT_Table);
    let 'offset = GPTLevel1Index(pa) * 8;
    gptaddrdesc.paddress.address = table.address + offset;
    level_1_entry : bits(64) = undefined;
    (memstatus, level_1_entry) = PhysMemRead(gptaddrdesc, 8, accdesc);
    if IsFault__2(memstatus) then {
        return((GPCFault(GPCF_EABT, 1), __UNKNOWN_GPTEntry()))
    };
    match level_1_entry[3 .. 0] {
      ? if ? == GPT_Contig => {
          (gpf, result) = DecodeGPTContiguous(pgs, level_1_entry)
      },
      _ => {
          let 'gpi_index = GPIIndex(pa);
          (gpf, result) = DecodeGPTGranules(pgs, gpi_index, level_1_entry)
      }
    };
    if gpf != GPCF_None then {
        return((GPCFault(gpf, 1), __UNKNOWN_GPTEntry()))
    };
    if not_bool(GPIValid(result.gpi)) then {
        return((GPCFault(GPCF_Walk, 1), __UNKNOWN_GPTEntry()))
    };
    return((GPCNoFault(), result))
}

val GranuleProtectionCheck : (AddressDescriptor, AccessDescriptor) -> GPCFRecord

function GranuleProtectionCheck (addrdesc, accdesc) = {
    gpcf : GPCFRecord = undefined;
    gpt_entry : GPTEntry = undefined;
    assert(HaveRME());
    let address : FullAddress = addrdesc.paddress;
    if Slice(GPCCR_EL3, 16, 1) == 0b0 then {
        return(GPCNoFault())
    };
    if not_bool(GPCRegistersConsistent()) then {
        return(GPCFault(GPCF_Walk, 0))
    };
    if AbovePPS(address.address) then {
        if address.paspace == PAS_NonSecure then {
            return(GPCNoFault())
        } else {
            return(GPCFault(GPCF_Fail, 0))
        }
    };
    let gpt_base : bits(52) = Slice(GPTBR_EL3, 0, 40) @ Zeros(12);
    if AbovePPS(gpt_base) then {
        return(GPCFault(GPCF_AddressSize, 0))
    };
    (gpcf, gpt_entry) = GPTWalk(address.address, accdesc);
    if gpcf.gpf != GPCF_None then {
        return(gpcf)
    };
    let permitted : bool = GPICheck(address.paspace, gpt_entry.gpi);
    if not_bool(permitted) then {
        let gpcf : GPCFRecord = GPCFault(GPCF_Fail, gpt_entry.level);
        return(gpcf)
    };
    return(GPCNoFault())
}

val HandleExternalTTWAbort : forall ('iswrite : Bool) 'size.
  (PhysMemRetStatus, bool('iswrite), AddressDescriptor, AccessDescriptor, int('size), FaultRecord) -> FaultRecord

function HandleExternalTTWAbort (memretstatus, iswrite, memaddrdesc, accdesc, size, input_fault) = {
    output_fault : FaultRecord = input_fault;
    output_fault.extflag = memretstatus.extflag;
    output_fault.statuscode = memretstatus.statuscode;
    if IsExternalSyncAbort__1(output_fault) & not_bool(IsExternalAbortTakenSynchronously(memretstatus, iswrite, memaddrdesc, size, accdesc)) then {
        if output_fault.statuscode == Fault_SyncParity then {
            output_fault.statuscode = Fault_AsyncParity
        } else {
            output_fault.statuscode = Fault_AsyncExternal
        }
    };
    if IsExternalSyncAbort__1(output_fault) then {
        if output_fault.statuscode == Fault_SyncParity then {
            output_fault.statuscode = Fault_SyncParityOnWalk
        } else {
            output_fault.statuscode = Fault_SyncExternalOnWalk
        }
    };
    if HaveRASExt() then {
        output_fault.errortype = PEErrorState(memretstatus)
    } else {
        output_fault.errortype = __UNKNOWN_bits(2)
    };
    if not_bool(IsExternalSyncAbort__1(output_fault)) then {
        PendSErrorInterrupt(output_fault);
        output_fault.statuscode = Fault_None
    };
    return(output_fault)
}

val PhysMemWrite : forall 'size, 'size > 0.
  (AddressDescriptor, int('size), AccessDescriptor, bits(8 * 'size)) -> PhysMemRetStatus

val AArch64_MemSwapTableDesc : (FaultRecord, bits(64), bits(64), bits(1), AddressDescriptor) -> (FaultRecord, bits(64))

function AArch64_MemSwapTableDesc (fault_in, prev_desc, new_desc, ee, descupdateaddress) = {
    iswrite : bool = undefined;
    mem_desc : bits(64) = undefined;
    memstatus : PhysMemRetStatus = undefined;
    ordered_new_desc : bits(64) = undefined;
    let descupdateaccess : AccessDescriptor = CreateAccessDescriptor(AccType_ATOMICRW);
    fault : FaultRecord = fault_in;
    if HaveRME() then {
        fault.gpcf = GranuleProtectionCheck(descupdateaddress, descupdateaccess);
        if fault.gpcf.gpf != GPCF_None then {
            fault.statuscode = Fault_GPCFOnWalk;
            fault.paddress = descupdateaddress.paddress;
            fault.gpcfs2walk = fault.secondstage;
            return((fault, __UNKNOWN_bits(64)))
        };
        ()
    };
    (memstatus, mem_desc) = PhysMemRead(descupdateaddress, 8, descupdateaccess);
    if ee == 0b1 then {
        mem_desc = BigEndianReverse(mem_desc)
    };
    if IsFault__2(memstatus) then {
        iswrite = false;
        fault = HandleExternalTTWAbort(memstatus, iswrite, descupdateaddress, descupdateaccess, 8, fault);
        if IsFault__1(fault.statuscode) then {
            fault.acctype = AccType_ATOMICRW;
            return((fault, __UNKNOWN_bits(64)))
        };
        ()
    };
    if mem_desc == prev_desc then {
        let ordered_new_desc : bits(64) = if ee == 0b1 then
          BigEndianReverse(new_desc)
        else
          new_desc;
        let memstatus : PhysMemRetStatus = PhysMemWrite(descupdateaddress, 8, descupdateaccess, ordered_new_desc);
        if IsFault__2(memstatus) then {
            let iswrite : bool = true;
            fault = HandleExternalTTWAbort(memstatus, iswrite, descupdateaddress, descupdateaccess, 8, fault);
            fault.acctype = memstatus.acctype;
            if IsFault__1(fault.statuscode) then {
                fault.acctype = AccType_ATOMICRW;
                return((fault, __UNKNOWN_bits(64)))
            };
            ()
        };
        mem_desc = new_desc
    };
    return((fault, mem_desc))
}

val AArch64_S1DCacheEnabled : Regime -> bool

function AArch64_S1DCacheEnabled regime = {
    match regime {
      Regime_EL3 => {
          return(Slice(SCTLR_EL3, 2, 1) == 0b1)
      },
      Regime_EL2 => {
          return(Slice(SCTLR_EL2, 2, 1) == 0b1)
      },
      Regime_EL20 => {
          return(Slice(SCTLR_EL2, 2, 1) == 0b1)
      },
      Regime_EL10 => {
          return(Slice(SCTLR_EL1, 2, 1) == 0b1)
      },
      _ => {
          return(undefined : bool)
      }
    }
}

val AArch64_AddrTop : (bits(1), AccType, bits(1)) -> int

function AArch64_AddrTop (tbid, acctype, tbi) = {
    if tbid == 0b1 & acctype == AccType_IFETCH then {
        return(63)
    };
    if tbi == 0b1 then {
        return(55)
    } else {
        return(63)
    }
}

val AArch64_S1HasAlignmentFault : forall ('aligned : Bool).
  (AccType, bool('aligned), bits(1), MemoryAttributes) -> bool

function AArch64_S1HasAlignmentFault (acctype, aligned, ntlsmd, memattrs) = {
    if acctype == AccType_IFETCH | memattrs.memtype != MemType_Device then {
        return(false)
    };
    if (acctype == AccType_A32LSMD & ntlsmd == 0b0) & memattrs.device != DeviceType_GRE then {
        return(true)
    };
    return(not_bool(aligned) | acctype == AccType_DCZVA)
}

val AArch64_S1ICacheEnabled : Regime -> bool

function AArch64_S1ICacheEnabled regime = {
    match regime {
      Regime_EL3 => {
          return(Slice(SCTLR_EL3, 12, 1) == 0b1)
      },
      Regime_EL2 => {
          return(Slice(SCTLR_EL2, 12, 1) == 0b1)
      },
      Regime_EL20 => {
          return(Slice(SCTLR_EL2, 12, 1) == 0b1)
      },
      Regime_EL10 => {
          return(Slice(SCTLR_EL1, 12, 1) == 0b1)
      },
      _ => {
          return(undefined : bool)
      }
    }
}

val CreateAddressDescriptor : (bits(64), FullAddress, MemoryAttributes) -> AddressDescriptor

function CreateAddressDescriptor (va, pa, memattrs) = {
    addrdesc : AddressDescriptor = undefined;
    addrdesc.paddress = pa;
    addrdesc.vaddress = va;
    addrdesc.memattrs = memattrs;
    addrdesc.fault = NoFault();
    return(addrdesc)
}

register InGuardedPage : bool

val SetInGuardedPage : forall ('guardedpage : Bool). bool('guardedpage) -> unit

function SetInGuardedPage guardedpage = {
    InGuardedPage = guardedpage
}

val AArch64_S1DisabledOutput : forall ('aligned : Bool).
  (FaultRecord, Regime, SecurityState, bits(64), AccType, bool('aligned)) -> (FaultRecord, AddressDescriptor)

function AArch64_S1DisabledOutput (fault_in, regime, ss, va, acctype, aligned) = {
    ipa : AddressDescriptor = undefined;
    let walkparams : S1TTWParams = AArch64_GetS1TTWParams(regime, va);
    fault : FaultRecord = fault_in;
    SetInGuardedPage(false);
    oa : FullAddress = undefined;
    oa.address = va[51 .. 0];
    match ss {
      SS_Secure => {
          oa.paspace = PAS_Secure
      },
      SS_NonSecure => {
          oa.paspace = PAS_NonSecure
      },
      SS_Root => {
          oa.paspace = PAS_Root
      },
      SS_Realm => {
          oa.paspace = PAS_Realm
      }
    };
    memattrs : MemoryAttributes = undefined;
    if (regime == Regime_EL10 & EL2Enabled()) & walkparams.dc == 0b1 then {
        default_cacheability : MemAttrHints = undefined;
        default_cacheability.attrs = MemAttr_WB;
        default_cacheability.hints = MemHint_RWA;
        default_cacheability.transient = false;
        memattrs.memtype = MemType_Normal;
        memattrs.outer = default_cacheability;
        memattrs.inner = default_cacheability;
        memattrs.shareability = Shareability_NSH;
        memattrs.tagged = walkparams.dct == 0b1;
        memattrs.xs = 0b0
    } else if acctype == AccType_IFETCH then {
        i_cache_attr : MemAttrHints = undefined;
        if AArch64_S1ICacheEnabled(regime) then {
            i_cache_attr.attrs = MemAttr_WT;
            i_cache_attr.hints = MemHint_RA;
            i_cache_attr.transient = false
        } else {
            i_cache_attr.attrs = MemAttr_NC
        };
        memattrs.memtype = MemType_Normal;
        memattrs.outer = i_cache_attr;
        memattrs.inner = i_cache_attr;
        memattrs.shareability = Shareability_OSH;
        memattrs.tagged = false;
        memattrs.xs = 0b1
    } else {
        memattrs.memtype = MemType_Device;
        memattrs.device = DeviceType_nGnRnE;
        memattrs.shareability = Shareability_OSH;
        memattrs.xs = 0b1
    };
    fault.level = 0;
    let 'addrtop = AArch64_AddrTop(walkparams.tbid, acctype, walkparams.tbi);
    if not_bool(is_zero_subrange(va, addrtop, AArch64_PAMax())) then {
        fault.statuscode = Fault_AddressSize
    } else if AArch64_S1HasAlignmentFault(acctype, aligned, walkparams.ntlsmd, memattrs) then {
        fault.statuscode = Fault_Alignment
    } else ();
    if fault.statuscode != Fault_None then {
        return((fault, __UNKNOWN_AddressDescriptor()))
    } else {
        let ipa : AddressDescriptor = CreateAddressDescriptor(va, oa, memattrs);
        return((fault, ipa))
    }
}

val AArch64_S1Enabled : Regime -> bool

function AArch64_S1Enabled regime = {
    match regime {
      Regime_EL3 => {
          return(Slice(SCTLR_EL3, 0, 1) == 0b1)
      },
      Regime_EL2 => {
          return(Slice(SCTLR_EL2, 0, 1) == 0b1)
      },
      Regime_EL20 => {
          return(Slice(SCTLR_EL2, 0, 1) == 0b1)
      },
      Regime_EL10 => {
          return((not_bool(EL2Enabled()) | (Slice(HCR_EL2, 12, 1) @ Slice(HCR_EL2, 27, 1)) == 0b00) & Slice(SCTLR_EL1, 0, 1) == 0b1)
      },
      _ => {
          return(undefined : bool)
      }
    }
}

val HasUnprivileged : Regime -> bool

function HasUnprivileged regime = {
    return(regime == Regime_EL20 | regime == Regime_EL30 | regime == Regime_EL10)
}

val IsCMOWControlledInstruction : unit -> bool

struct Permissions = {
  ap_table : bits(2),
  xn_table : bits(1),
  pxn_table : bits(1),
  uxn_table : bits(1),
  ap : bits(3),
  xn : bits(1),
  uxn : bits(1),
  pxn : bits(1),
  s2ap : bits(2),
  s2xnx : bits(1),
  s2xn : bits(1)
}

enum SDFType = {
  SDFType_Table,
  SDFType_Invalid,
  SDFType_Supersection,
  SDFType_Section,
  SDFType_LargePage,
  SDFType_SmallPage
}

val __UNKNOWN_SDFType : unit -> SDFType

function __UNKNOWN_SDFType () = undefined

struct TTWState = {
  istable : bool,
  level : int,
  baseaddress : FullAddress,
  contiguous : bits(1),
  nG : bits(1),
  guardedpage : bits(1),
  sdftype : SDFType,
  domain : bits(4),
  memattrs : MemoryAttributes,
  permissions : Permissions
}

val __UNKNOWN_TTWState : unit -> TTWState

function __UNKNOWN_TTWState () = undefined

val AArch64_S1HasPermissionsFault : forall ('ispriv : Bool) ('iswrite : Bool).
  (Regime, SecurityState, TTWState, S1TTWParams, bool('ispriv), AccType, bool('iswrite)) -> bool

function AArch64_S1HasPermissionsFault (regime, ss, walkstate, walkparams, ispriv, acctype, iswrite) = {
    impdef_ic_fault : bool = undefined;
    pan_access : bool = undefined;
    px : bits(1) = undefined;
    ux : bits(1) = undefined;
    r : bits(1) = undefined;
    w : bits(1) = undefined;
    x : bits(1) = undefined;
    let permissions : Permissions = walkstate.permissions;
    if HasUnprivileged(regime) then {
        pr : bits(1) = undefined;
        pw : bits(1) = undefined;
        ur : bits(1) = undefined;
        uw : bits(1) = undefined;
        match permissions.ap[2 .. 1] {
          0b00 => {
              (pr, pw, ur, uw) = (0b1, 0b1, 0b0, 0b0)
          },
          0b01 => {
              (pr, pw, ur, uw) = (0b1, 0b1, 0b1, 0b1)
          },
          0b10 => {
              (pr, pw, ur, uw) = (0b1, 0b0, 0b0, 0b0)
          },
          0b11 => {
              (pr, pw, ur, uw) = (0b1, 0b0, 0b1, 0b0)
          }
        };
        match permissions.ap_table {
          0b00 => {
              (pr, pw, ur, uw) = (pr, pw, ur, uw)
          },
          0b01 => {
              (pr, pw, ur, uw) = (pr, pw, 0b0, 0b0)
          },
          0b10 => {
              (pr, pw, ur, uw) = (pr, 0b0, ur, 0b0)
          },
          0b11 => {
              (pr, pw, ur, uw) = (pr, 0b0, 0b0, 0b0)
          }
        };
        let px : bits(1) = not_vec((permissions.pxn | permissions.pxn_table) | uw);
        ux : bits(1) = not_vec(permissions.uxn | permissions.uxn_table);
        let pan_access : bool = not_bool(acctype == AccType_DC | acctype == AccType_IFETCH | acctype == AccType_AT | acctype == AccType_NV2REGISTER);
        if (HavePANExt() & pan_access) & not_bool(regime == Regime_EL10 & walkparams.nv1 == 0b1) then {
            if ((__IMPDEF_boolean("SCR_EL3.SIF affects EPAN") & CurrentSecurityState() == SS_Secure) & walkstate.baseaddress.paspace == PAS_NonSecure) & walkparams.sif == 0b1 then {
                ux = 0b0
            };
            if ((__IMPDEF_boolean("Realm EL2&0 regime affects EPAN") & CurrentSecurityState() == SS_Realm) & regime == Regime_EL20) & walkstate.baseaddress.paspace != PAS_Realm then {
                ux = 0b0
            };
            let pan : bits(1) = PSTATE.PAN & ((ur | uw) | walkparams.epan & ux);
            pr = pr & not_vec(pan);
            pw = pw & not_vec(pan)
        };
        (r, w, x) = if ispriv then (pr, pw, px) else (ur, uw, ux)
    } else {
        match [permissions.ap[2]] {
          0b0 => {
              (r, w) = (0b1, 0b1)
          },
          0b1 => {
              (r, w) = (0b1, 0b0)
          }
        };
        match [permissions.ap_table[1]] {
          0b0 => {
              (r, w) = (r, w)
          },
          0b1 => {
              (r, w) = (r, 0b0)
          }
        };
        x = not_vec(permissions.xn | permissions.xn_table)
    };
    x : bits(1) = x & not_vec(walkparams.wxn & w);
    if ss == SS_Secure & walkstate.baseaddress.paspace == PAS_NonSecure then {
        x = x & not_vec(walkparams.sif)
    };
    if ss == SS_Root & walkstate.baseaddress.paspace != PAS_Root then {
        x = 0b0
    };
    if (ss == SS_Realm & (regime == Regime_EL2 | regime == Regime_EL20)) & walkstate.baseaddress.paspace != PAS_Realm then {
        x = 0b0
    };
    let x = x;
    if acctype == AccType_IFETCH then {
        if ConstrainUnpredictable(Unpredictable_INSTRDEVICE) == Constraint_FAULT & walkstate.memattrs.memtype == MemType_Device then {
            return(true)
        };
        return(x == 0b0)
    } else if acctype == AccType_DC then {
        if iswrite then {
            return(w == 0b0)
        } else {
            return(not_bool(ispriv) & (r == 0b0 | (IsCMOWControlledInstruction() & walkparams.cmow == 0b1) & w == 0b0))
        }
    } else if acctype == AccType_IC then {
        assert(not_bool(iswrite));
        let impdef_ic_fault : bool = __IMPDEF_boolean("Permission fault on EL0 IC_IVAU execution");
        return(not_bool(ispriv) & (r == 0b0 & impdef_ic_fault | (IsCMOWControlledInstruction() & walkparams.cmow == 0b1) & w == 0b0))
    } else if iswrite then {
        return(w == 0b0)
    } else {
        return(r == 0b0)
    }
}

val AArch64_S1InvalidTxSZ : S1TTWParams -> bool

function AArch64_S1InvalidTxSZ walkparams = {
    let 'mintxsz = AArch64_S1MinTxSZ(walkparams.ds, walkparams.tgx);
    let 'maxtxsz = AArch64_MaxTxSZ(walkparams.tgx);
    return(UInt(walkparams.txsz) < mintxsz | UInt(walkparams.txsz) > maxtxsz)
}

val HaveBlockBBM : unit -> bool

function HaveBlockBBM () = {
    return(HasArchVersion(ARMv8p4))
}

val AArch64_BlockBBMSupportLevel : unit -> int

function AArch64_BlockBBMSupportLevel () = {
    if not_bool(HaveBlockBBM()) then {
        return(__UNKNOWN_integer())
    } else {
        return(__IMPDEF_integer("Block BBM support level"))
    }
}

val AArch64_BlocknTFaults : bits(64) -> bool

function AArch64_BlocknTFaults descriptor = {
    if not_bool(HaveBlockBBM()) then {
        return(false)
    };
    let 'bbm_level = AArch64_BlockBBMSupportLevel();
    let nT_faults : bool = __IMPDEF_boolean("BBM level 1 or 2 support nT bit causes Translation Fault");
    return(((bbm_level == 1 | bbm_level == 2) & [descriptor[16]] == 0b1) & nT_faults)
}

val AArch64_IASize : bits(6) -> int

function AArch64_IASize txsz = {
    return(64 - UInt(txsz))
}

val ContiguousSize : forall 'level. (TGx, int('level)) -> int

function ContiguousSize (tgx, level) = {
    match tgx {
      TGx_4KB => {
          assert(level == 1 | level == 2 | level == 3);
          return(4)
      },
      TGx_16KB => {
          assert(level == 2 | level == 3);
          return(if level == 2 then 5 else 7)
      },
      TGx_64KB => {
          assert(level == 2 | level == 3);
          return(5)
      },
      _ => {
          return(undefined : int)
      }
    }
}

let FINAL_LEVEL : int(3) = 3

val TGxGranuleBits : TGx -> int

function TGxGranuleBits tgx = {
    match tgx {
      TGx_4KB => {
          return(12)
      },
      TGx_16KB => {
          return(14)
      },
      TGx_64KB => {
          return(16)
      },
      _ => {
          return(undefined : int)
      }
    }
}

val TranslationSize : forall 'level. (TGx, int('level)) -> int

function TranslationSize (tgx, level) = {
    let 'granulebits = TGxGranuleBits(tgx);
    let 'blockbits = (FINAL_LEVEL - level) * (granulebits - 3);
    return(granulebits + blockbits)
}

val AArch64_ContiguousBitFaults : forall 'level.
  (bits(6), TGx, int('level)) -> bool

function AArch64_ContiguousBitFaults (txsz, tgx, level) = {
    let 'iasize = AArch64_IASize(txsz);
    let 'tsize = TranslationSize(tgx, level) + ContiguousSize(tgx, level);
    let fault : bool = __IMPDEF_boolean("Translation fault on misprogrammed contiguous bit");
    return(tsize > iasize & fault)
}

val AArch64_BlockDescSupported : forall 'level.
  (bits(1), TGx, int('level)) -> bool

function AArch64_BlockDescSupported (ds, tgx, level) = {
    match tgx {
      TGx_4KB => {
          return((level == 2 | level == 1) | level == 0 & ds == 0b1)
      },
      TGx_16KB => {
          return(level == 2 | level == 1 & ds == 0b1)
      },
      TGx_64KB => {
          return(level == 2 | level == 1 & AArch64_PAMax() == 52)
      }
    };
    return(false)
}

enum DescriptorType = {
  DescriptorType_Table,
  DescriptorType_Block,
  DescriptorType_Page,
  DescriptorType_Invalid
}

val AArch64_DecodeDescriptorType : forall 'level.
  (bits(64), bits(1), TGx, int('level)) -> DescriptorType

function AArch64_DecodeDescriptorType (descriptor, ds, tgx, level) = {
    if descriptor[1 .. 0] == 0b11 & level == FINAL_LEVEL then {
        return(DescriptorType_Page)
    } else if descriptor[1 .. 0] == 0b11 then {
        return(DescriptorType_Table)
    } else if descriptor[1 .. 0] == 0b01 then {
        if AArch64_BlockDescSupported(ds, tgx, level) then {
            return(DescriptorType_Block)
        } else {
            return(DescriptorType_Invalid)
        }
    } else {
        return(DescriptorType_Invalid)
    }
}

val HaveCommonNotPrivateTransExt : unit -> bool

function HaveCommonNotPrivateTransExt () = {
    return(HasArchVersion(ARMv8p2))
}

register TTBR0_EL1 : bits(64)

register TTBR1_EL1 : bits(64)

let VMID_NONE : bits(16) = Zeros()

val VTTBR_read : unit -> bits(64)

function VTTBR_read () = {
    r : bits(64) = undefined;
    r = SetSlice(64, r, 0, Slice(VTTBR_EL2, 0, 64));
    return(r)
}

val VMID_read : unit -> bits(16)

function VMID_read () = {
    if EL2Enabled() then {
        if not_bool(ELUsingAArch32(EL2)) then {
            if Have16bitVMID() & Slice(VTCR_EL2, 19, 1) == 0b1 then {
                return(Slice(VTTBR_EL2, 48, 16))
            } else {
                return(ZeroExtend(Slice(VTTBR_EL2, 48, 16)[7 .. 0], 16))
            }
        } else {
            return(ZeroExtend(Slice(VTTBR_read(), 48, 8), 16))
        }
    } else if HaveEL(EL2) & HaveSecureEL2Ext() then {
        return(Zeros(16))
    } else {
        return(VMID_NONE)
    }
}

val AArch64_TLBContextEL10 : (SecurityState, bits(64), TGx) -> TLBContext

function AArch64_TLBContextEL10 (ss, va, tg) = {
    tlbcontext : TLBContext = undefined;
    tlbcontext.ss = ss;
    tlbcontext.regime = Regime_EL10;
    tlbcontext.vmid = VMID_read();
    tlbcontext.asid = if Slice(TCR_EL1, 22, 1) == 0b0 then
      Slice(TTBR0_EL1, 48, 16)
    else
      Slice(TTBR1_EL1, 48, 16);
    tlbcontext.tg = tg;
    tlbcontext.ia = va;
    if HaveCommonNotPrivateTransExt() then {
        if AArch64_GetVARange(va) == VARange_LOWER then {
            tlbcontext.cnp = Slice(TTBR0_EL1, 0, 1)
        } else {
            tlbcontext.cnp = Slice(TTBR1_EL1, 0, 1)
        }
    } else {
        tlbcontext.cnp = 0b0
    };
    return(tlbcontext)
}

register TTBR0_EL2 : bits(64)

val AArch64_TLBContextEL2 : (SecurityState, bits(64), TGx) -> TLBContext

function AArch64_TLBContextEL2 (ss, va, tg) = {
    tlbcontext : TLBContext = undefined;
    tlbcontext.ss = ss;
    tlbcontext.regime = Regime_EL2;
    tlbcontext.tg = tg;
    tlbcontext.ia = va;
    tlbcontext.cnp = if HaveCommonNotPrivateTransExt() then
      Slice(TTBR0_EL2, 0, 1)
    else
      0b0;
    return(tlbcontext)
}

register TTBR1_EL2 : bits(64)

val AArch64_TLBContextEL20 : (SecurityState, bits(64), TGx) -> TLBContext

function AArch64_TLBContextEL20 (ss, va, tg) = {
    tlbcontext : TLBContext = undefined;
    tlbcontext.ss = ss;
    tlbcontext.regime = Regime_EL20;
    tlbcontext.asid = if Slice(TCR_EL2, 22, 1) == 0b0 then
      Slice(TTBR0_EL2, 48, 16)
    else
      Slice(TTBR1_EL2, 48, 16);
    tlbcontext.tg = tg;
    tlbcontext.ia = va;
    if HaveCommonNotPrivateTransExt() then {
        if AArch64_GetVARange(va) == VARange_LOWER then {
            tlbcontext.cnp = Slice(TTBR0_EL2, 0, 1)
        } else {
            tlbcontext.cnp = Slice(TTBR1_EL2, 0, 1)
        }
    } else {
        tlbcontext.cnp = 0b0
    };
    return(tlbcontext)
}

register TTBR0_EL3 : bits(64)

val AArch64_TLBContextEL3 : (SecurityState, bits(64), TGx) -> TLBContext

function AArch64_TLBContextEL3 (ss, va, tg) = {
    tlbcontext : TLBContext = undefined;
    tlbcontext.ss = ss;
    tlbcontext.regime = Regime_EL3;
    tlbcontext.tg = tg;
    tlbcontext.ia = va;
    tlbcontext.cnp = if HaveCommonNotPrivateTransExt() then
      Slice(TTBR0_EL3, 0, 1)
    else
      0b0;
    return(tlbcontext)
}

val AArch64_GetS1TLBContext : (Regime, SecurityState, bits(64), TGx) -> TLBContext

function AArch64_GetS1TLBContext (regime, ss, va, tg) = {
    tlbcontext : TLBContext = undefined;
    match regime {
      Regime_EL3 => {
          tlbcontext = AArch64_TLBContextEL3(ss, va, tg)
      },
      Regime_EL2 => {
          tlbcontext = AArch64_TLBContextEL2(ss, va, tg)
      },
      Regime_EL20 => {
          tlbcontext = AArch64_TLBContextEL20(ss, va, tg)
      },
      Regime_EL10 => {
          tlbcontext = AArch64_TLBContextEL10(ss, va, tg)
      },
      _ => ()
    };
    tlbcontext.includes_s1_name = true;
    tlbcontext.includes_s2_name = false;
    tlbcontext.includes_gpt_name = false;
    return(tlbcontext)
}

val AArch64_PhysicalAddressSize : (bits(3), TGx) -> int

function AArch64_PhysicalAddressSize (encoded_ps, tgx) = {
    ps : int = undefined;
    max_ps : int = undefined;
    match encoded_ps {
      0b000 => {
          ps = 32
      },
      0b001 => {
          ps = 36
      },
      0b010 => {
          ps = 40
      },
      0b011 => {
          ps = 42
      },
      0b100 => {
          ps = 44
      },
      0b101 => {
          ps = 48
      },
      0b110 => {
          ps = 52
      },
      _ => {
          ps = __IMPDEF_integer("Reserved Intermediate Physical Address size value")
      }
    };
    let 'ps = ps;
    if tgx != TGx_64KB & not_bool(Have52BitIPAAndPASpaceExt()) then {
        max_ps = Min(48, AArch64_PAMax())
    } else {
        max_ps = AArch64_PAMax()
    };
    let 'max_ps = max_ps;
    return(Min(ps, max_ps))
}

val StageOA : (bits(64), TGx, TTWState) -> FullAddress

function StageOA (ia, tgx, walkstate) = {
    oa : FullAddress = undefined;
    csize : int = undefined;
    let 'tsize = TranslationSize(tgx, walkstate.level);
    if walkstate.contiguous == 0b1 then {
        csize = ContiguousSize(tgx, walkstate.level)
    } else {
        csize = 0
    };
    let 'csize = csize;
    let 'ia_msb = tsize + csize;
    oa.paspace = walkstate.baseaddress.paspace;
    assert(constraint((0 <= 'ia_msb & 'ia_msb <= 51)));
    assert(constraint(0 <= 'ia_msb - 1));
    oa.address = walkstate.baseaddress.address[51 .. ia_msb] @ ia[ia_msb - 1 .. 0];
    return(oa)
}

val AArch64_OAOutOfRange : (TTWState, bits(3), TGx, bits(64)) -> bool

function AArch64_OAOutOfRange (walkstate, ps, tgx, ia) = {
    baseaddress : bits(52) = undefined;
    oa : FullAddress = undefined;
    let 'oasize = AArch64_PhysicalAddressSize(ps, tgx);
    if oasize < 52 then {
        if walkstate.istable then {
            let baseaddress : bits(52) = walkstate.baseaddress.address;
            return(not_bool(is_zero_subrange(baseaddress, 51, oasize)))
        } else {
            let oa : FullAddress = StageOA(ia, tgx, walkstate);
            return(not_bool(is_zero_subrange(oa.address, 51, oasize)))
        }
    } else {
        return(false)
    }
}

val AArch64_S1EPD : (Regime, bits(64)) -> bits(1)

function AArch64_S1EPD (regime, va) = {
    assert(HasUnprivileged(regime));
    let varange : VARange = AArch64_GetVARange(va);
    match regime {
      Regime_EL20 => {
          return(if varange == VARange_LOWER then Slice(TCR_EL2, 7, 1) else
            Slice(TCR_EL2, 23, 1))
      },
      Regime_EL10 => {
          return(if varange == VARange_LOWER then Slice(TCR_EL1, 7, 1) else
            Slice(TCR_EL1, 23, 1))
      },
      _ => {
          return(undefined : bits(1))
      }
    }
}

val AArch64_S1StartLevel : S1TTWParams -> int

function AArch64_S1StartLevel walkparams = {
    let 'iasize = AArch64_IASize(walkparams.txsz);
    let 'granulebits = TGxGranuleBits(walkparams.tgx);
    let 'stride = granulebits - 3;
    return(FINAL_LEVEL - DIV(iasize - 1 - granulebits, stride))
}

val AArch64_S1TTBR : (Regime, bits(64)) -> bits(64)

function AArch64_S1TTBR (regime, va) = {
    let varange : VARange = AArch64_GetVARange(va);
    match regime {
      Regime_EL3 => {
          return(TTBR0_EL3)
      },
      Regime_EL2 => {
          return(TTBR0_EL2)
      },
      Regime_EL20 => {
          return(if varange == VARange_LOWER then TTBR0_EL2 else TTBR1_EL2)
      },
      Regime_EL10 => {
          return(if varange == VARange_LOWER then TTBR0_EL1 else TTBR1_EL1)
      },
      _ => {
          return(undefined : bits(64))
      }
    }
}

val AArch64_TTBaseAddress : forall 'startlevel.
  (bits(64), bits(6), bits(3), bits(1), TGx, int('startlevel)) -> bits(52)

function AArch64_TTBaseAddress (ttb, txsz, ps, ds, tgx, startlevel) = {
    tablebase : bits(52) = Zeros();
    let 'iasize = AArch64_IASize(txsz);
    let 'granulebits = TGxGranuleBits(tgx);
    let 'stride = granulebits - 3;
    let 'levels = FINAL_LEVEL - startlevel;
    tsize : int = iasize - (levels * stride + granulebits) + 3;
    if (Have52BitPAExt() & tgx == TGx_64KB) & ps == 0b110 | ds == 0b1 then {
        tsize = Max(tsize, 6);
        tablebase[51 .. 6] = ttb[5 .. 2] @ ttb[47 .. 6]
    } else {
        tablebase[47 .. 1] = ttb[47 .. 1]
    };
    let 'tsize = tsize;
    let tablebase : bits(52) = Align(tablebase, (1 << tsize));
    return(tablebase)
}

val AArch64_S1InitialTTWState : (S1TTWParams, bits(64), Regime, SecurityState) -> TTWState

function AArch64_S1InitialTTWState (walkparams, va, regime, ss) = {
    walkstate : TTWState = undefined;
    tablebase : FullAddress = undefined;
    permissions : Permissions = undefined;
    let 'startlevel = AArch64_S1StartLevel(walkparams);
    let ttbr : bits(64) = AArch64_S1TTBR(regime, va);
    match ss {
      SS_Secure => {
          tablebase.paspace = PAS_Secure
      },
      SS_NonSecure => {
          tablebase.paspace = PAS_NonSecure
      },
      SS_Root => {
          tablebase.paspace = PAS_Root
      },
      SS_Realm => {
          tablebase.paspace = PAS_Realm
      }
    };
    tablebase.address = AArch64_TTBaseAddress(ttbr, walkparams.txsz, walkparams.ps, walkparams.ds, walkparams.tgx, startlevel);
    permissions.ap_table = Zeros();
    if HasUnprivileged(regime) then {
        permissions.uxn_table = Zeros();
        permissions.pxn_table = Zeros()
    } else {
        permissions.xn_table = Zeros()
    };
    walkstate.baseaddress = tablebase;
    walkstate.level = startlevel;
    walkstate.istable = true;
    walkstate.nG = if HasUnprivileged(regime) then 0b1 else 0b0;
    walkstate.memattrs = WalkMemAttrs(walkparams.sh, walkparams.irgn, walkparams.orgn);
    walkstate.permissions = permissions;
    return(walkstate)
}

val AArch64_BlockBase : forall 'level.
  (bits(64), bits(1), TGx, int('level)) -> bits(52)

function AArch64_BlockBase (descriptor, ds, tgx, level) = {
    blockbase : bits(52) = Zeros();
    if tgx == TGx_4KB & level == 2 then {
        blockbase[47 .. 21] = descriptor[47 .. 21]
    } else if tgx == TGx_4KB & level == 1 then {
        blockbase[47 .. 30] = descriptor[47 .. 30]
    } else if tgx == TGx_4KB & level == 0 then {
        blockbase[47 .. 39] = descriptor[47 .. 39]
    } else if tgx == TGx_16KB & level == 2 then {
        blockbase[47 .. 25] = descriptor[47 .. 25]
    } else if tgx == TGx_16KB & level == 1 then {
        blockbase[47 .. 36] = descriptor[47 .. 36]
    } else if tgx == TGx_64KB & level == 2 then {
        blockbase[47 .. 29] = descriptor[47 .. 29]
    } else if tgx == TGx_64KB & level == 1 then {
        blockbase[47 .. 42] = descriptor[47 .. 42]
    } else {
        Unreachable()
    };
    if Have52BitPAExt() & tgx == TGx_64KB then {
        blockbase[51 .. 48] = descriptor[15 .. 12]
    } else if ds == 0b1 then {
        blockbase[51 .. 48] = descriptor[9 .. 8] @ descriptor[49 .. 48]
    } else ();
    return(blockbase)
}

val AArch64_ContiguousBit : forall 'level.
  (TGx, int('level), bits(64)) -> bits(1)

function AArch64_ContiguousBit (tgx, level, descriptor) = {
    if (tgx == TGx_64KB & level == 1) & not_bool(Have52BitVAExt()) then {
        return(0b0)
    };
    if tgx == TGx_16KB & level == 1 then {
        return(0b0)
    };
    if tgx == TGx_4KB & level == 0 then {
        return(0b0)
    };
    return([descriptor[52]])
}

val AArch64_PageBase : (bits(64), bits(1), TGx) -> bits(52)

function AArch64_PageBase (descriptor, ds, tgx) = {
    pagebase : bits(52) = Zeros();
    match tgx {
      TGx_4KB => {
          pagebase[47 .. 12] = descriptor[47 .. 12]
      },
      TGx_16KB => {
          pagebase[47 .. 14] = descriptor[47 .. 14]
      },
      TGx_64KB => {
          pagebase[47 .. 16] = descriptor[47 .. 16]
      }
    };
    if Have52BitPAExt() & tgx == TGx_64KB then {
        pagebase[51 .. 48] = descriptor[15 .. 12]
    } else if ds == 0b1 then {
        pagebase[51 .. 48] = descriptor[9 .. 8] @ descriptor[49 .. 48]
    } else ();
    return(pagebase)
}

val AArch64_S1ApplyOutputPerms : (Permissions, bits(64), Regime, S1TTWParams) -> Permissions

function AArch64_S1ApplyOutputPerms (permissions_in, descriptor, regime, walkparams) = {
    permissions : Permissions = permissions_in;
    if (regime == Regime_EL10 & EL2Enabled()) & walkparams.nv1 == 0b1 then {
        permissions.ap[2 .. 1] = [descriptor[7]] @ 0b0;
        permissions.pxn = [descriptor[54]]
    } else if HasUnprivileged(regime) then {
        permissions.ap[2 .. 1] = descriptor[7 .. 6];
        permissions.uxn = [descriptor[54]];
        permissions.pxn = [descriptor[53]]
    } else {
        permissions.ap[2 .. 1] = [descriptor[7]] @ 0b1;
        permissions.xn = [descriptor[54]]
    };
    if (walkparams.ha == 0b1 & walkparams.hd == 0b1) & [descriptor[51]] == 0b1 then {
        permissions.ap[2 .. 2] = 0b0
    };
    return(permissions)
}

val MAIRAttr : forall 'index. (int('index), bits(64)) -> bits(8)

function MAIRAttr (index, mair) = {
    let 'bit_index = 8 * index;
    assert(constraint((0 <= 'bit_index & 'bit_index + 7 < 64)));
    return(mair[bit_index + 7 .. bit_index])
}

val DecodeDevice : bits(2) -> DeviceType

function DecodeDevice device = {
    match device {
      0b00 => {
          return(DeviceType_nGnRnE)
      },
      0b01 => {
          return(DeviceType_nGnRE)
      },
      0b10 => {
          return(DeviceType_nGRE)
      },
      0b11 => {
          return(DeviceType_GRE)
      },
      _ => {
          return(undefined : DeviceType)
      }
    }
}

let MemHint_No : bits(2) = 0b00

let MemHint_WA : bits(2) = 0b01

val DecodeLDFAttr : bits(4) -> MemAttrHints

function DecodeLDFAttr attr = {
    ldfattr : MemAttrHints = undefined;
    if (match attr {
      [_, bitzero, _, _] => true,
      _ => false
    }) : bool then {
        ldfattr.attrs = MemAttr_WT
    } else if attr == 0b0100 then {
        ldfattr.attrs = MemAttr_NC
    } else if (match attr {
      [_, bitone, _, _] => true,
      _ => false
    }) : bool then {
        ldfattr.attrs = MemAttr_WB
    } else {
        Unreachable()
    };
    if ldfattr.attrs != MemAttr_NC then {
        match attr[1 .. 0] {
          0b00 => {
              ldfattr.hints = MemHint_No
          },
          0b01 => {
              ldfattr.hints = MemHint_WA
          },
          0b10 => {
              ldfattr.hints = MemHint_RA
          },
          0b11 => {
              ldfattr.hints = MemHint_RWA
          }
        }
    };
    if ldfattr.attrs != MemAttr_NC & ldfattr.hints != MemHint_No then {
        ldfattr.transient = [attr[3]] == 0b0
    };
    return(ldfattr)
}

val HaveFeatXS : unit -> bool

function HaveFeatXS () = {
    return(HasArchVersion(ARMv8p7))
}

val S1ConstrainUnpredictableRESMAIR : forall ('s1aarch64 : Bool).
  (bits(8), bool('s1aarch64)) -> bool

function S1ConstrainUnpredictableRESMAIR (attr, s1aarch64) = {
    match attr {
      [bitzero, bitzero, bitzero, bitzero, _, _, bitzero, bitone] => {
          return(not_bool(s1aarch64 & HaveFeatXS()))
      },
      [bitzero, bitzero, bitzero, bitzero, _, _, _, _] => {
          return(attr[1 .. 0] != 0b00)
      },
      0b01000000 => {
          return(not_bool(s1aarch64 & HaveFeatXS()))
      },
      0b10100000 => {
          return(not_bool(s1aarch64 & HaveFeatXS()))
      },
      0b11110000 => {
          return(not_bool(s1aarch64 & HaveMTE2Ext()))
      },
      [_, _, _, _, bitzero, bitzero, bitzero, bitzero] => {
          return(true)
      },
      _ => {
          return(false)
      }
    }
}

val S1DecodeMemAttrs : forall ('s1aarch64 : Bool).
  (bits(8), bits(2), bool('s1aarch64)) -> MemoryAttributes

function S1DecodeMemAttrs (attr_in, sh, s1aarch64) = {
    attr : bits(8) = attr_in;
    if S1ConstrainUnpredictableRESMAIR(attr, s1aarch64) then {
        let (_, __tup_1 : bits(8)) = ConstrainUnpredictableBits(8, Unpredictable_RESMAIR);
        attr = __tup_1
    };
    memattrs : MemoryAttributes = undefined;
    match attr {
      [bitzero, bitzero, bitzero, bitzero, _, _, _, _] => {
          memattrs.memtype = MemType_Device;
          memattrs.device = DecodeDevice(attr[3 .. 2]);
          memattrs.tagged = false;
          memattrs.xs = if s1aarch64 then not_vec([attr[0]]) else 0b1
      },
      0b01000000 => {
          assert(s1aarch64 & HaveFeatXS());
          memattrs.memtype = MemType_Normal;
          memattrs.tagged = false;
          memattrs.outer.attrs = MemAttr_NC;
          memattrs.inner.attrs = MemAttr_NC;
          memattrs.xs = 0b0
      },
      0b10100000 => {
          assert(s1aarch64 & HaveFeatXS());
          memattrs.memtype = MemType_Normal;
          memattrs.tagged = false;
          memattrs.outer.attrs = MemAttr_WT;
          memattrs.outer.hints = MemHint_RA;
          memattrs.outer.transient = false;
          memattrs.inner.attrs = MemAttr_WT;
          memattrs.inner.hints = MemHint_RA;
          memattrs.inner.transient = false;
          memattrs.xs = 0b0
      },
      0b11110000 => {
          assert(s1aarch64 & HaveMTE2Ext());
          memattrs.memtype = MemType_Normal;
          memattrs.tagged = true;
          memattrs.outer.attrs = MemAttr_WB;
          memattrs.outer.hints = MemHint_RWA;
          memattrs.outer.transient = false;
          memattrs.inner.attrs = MemAttr_WB;
          memattrs.inner.hints = MemHint_RWA;
          memattrs.inner.transient = false;
          memattrs.xs = 0b0
      },
      _ => {
          memattrs.memtype = MemType_Normal;
          memattrs.outer = DecodeLDFAttr(attr[7 .. 4]);
          memattrs.inner = DecodeLDFAttr(attr[3 .. 0]);
          memattrs.tagged = false;
          if memattrs.inner.attrs == MemAttr_WB & memattrs.outer.attrs == MemAttr_WB then {
              memattrs.xs = 0b0
          } else {
              memattrs.xs = 0b1
          }
      }
    };
    memattrs.shareability = DecodeShareability(sh);
    return(memattrs)
}

val AArch64_S1NextWalkStateLast : (TTWState, Regime, SecurityState, S1TTWParams, bits(64)) -> TTWState

function AArch64_S1NextWalkStateLast (currentstate, regime, ss, walkparams, descriptor) = {
    nextstate : TTWState = undefined;
    baseaddress : FullAddress = undefined;
    if currentstate.level == FINAL_LEVEL then {
        baseaddress.address = AArch64_PageBase(descriptor, walkparams.ds, walkparams.tgx)
    } else {
        baseaddress.address = AArch64_BlockBase(descriptor, walkparams.ds, walkparams.tgx, currentstate.level)
    };
    if currentstate.baseaddress.paspace == PAS_Secure then {
        baseaddress.paspace = if [descriptor[5]] == 0b0 then PAS_Secure else
          PAS_NonSecure
    } else if currentstate.baseaddress.paspace == PAS_Root then {
        match descriptor[11 .. 11] @ [descriptor[5]] {
          0b00 => {
              baseaddress.paspace = PAS_Secure
          },
          0b01 => {
              baseaddress.paspace = PAS_NonSecure
          },
          0b10 => {
              baseaddress.paspace = PAS_Root
          },
          0b11 => {
              baseaddress.paspace = PAS_Realm
          }
        }
    } else if currentstate.baseaddress.paspace == PAS_Realm & (regime == Regime_EL2 | regime == Regime_EL20) then {
        baseaddress.paspace = if [descriptor[5]] == 0b0 then PAS_Realm else
          PAS_NonSecure
    } else if currentstate.baseaddress.paspace == PAS_Realm then {
        baseaddress.paspace = PAS_Realm
    } else {
        baseaddress.paspace = PAS_NonSecure
    };
    nextstate.istable = false;
    nextstate.level = currentstate.level;
    nextstate.baseaddress = baseaddress;
    let attrindx : bits(3) = descriptor[4 .. 2];
    let sh : bits(2) = if walkparams.ds == 0b1 then walkparams.sh else
      descriptor[9 .. 8];
    let attr : bits(8) = MAIRAttr(UInt(attrindx), walkparams.mair);
    let s1aarch64 : bool = true;
    nextstate.memattrs = S1DecodeMemAttrs(attr, sh, s1aarch64);
    nextstate.permissions = AArch64_S1ApplyOutputPerms(currentstate.permissions, descriptor, regime, walkparams);
    nextstate.contiguous = AArch64_ContiguousBit(walkparams.tgx, currentstate.level, descriptor);
    if not_bool(HasUnprivileged(regime)) then {
        nextstate.nG = 0b0
    } else if ss == SS_Secure & currentstate.baseaddress.paspace == PAS_NonSecure then {
        nextstate.nG = 0b1
    } else {
        nextstate.nG = [descriptor[11]]
    };
    nextstate.guardedpage = [descriptor[50]];
    return(nextstate)
}

val AArch64_NextTableBase : (bits(64), bits(1), TGx) -> bits(52)

function AArch64_NextTableBase (descriptor, ds, tgx) = {
    tablebase : bits(52) = Zeros();
    match tgx {
      TGx_4KB => {
          tablebase[47 .. 12] = descriptor[47 .. 12]
      },
      TGx_16KB => {
          tablebase[47 .. 14] = descriptor[47 .. 14]
      },
      TGx_64KB => {
          tablebase[47 .. 16] = descriptor[47 .. 16]
      }
    };
    if Have52BitPAExt() & tgx == TGx_64KB then {
        tablebase[51 .. 48] = descriptor[15 .. 12]
    } else if ds == 0b1 then {
        tablebase[51 .. 48] = descriptor[9 .. 8] @ descriptor[49 .. 48]
    } else ();
    return(tablebase)
}

val AArch64_S1ApplyTablePerms : (Permissions, bits(64), Regime, S1TTWParams) -> Permissions

function AArch64_S1ApplyTablePerms (permissions_in, descriptor, regime, walkparams) = {
    ap_table : bits(2) = undefined;
    pxn_table : bits(1) = undefined;
    uxn_table : bits(1) = undefined;
    xn_table : bits(1) = undefined;
    permissions : Permissions = permissions_in;
    if (regime == Regime_EL10 & EL2Enabled()) & walkparams.nv1 == 0b1 then {
        let ap_table : bits(2) = [descriptor[62]] @ 0b0;
        let pxn_table : bits(1) = [descriptor[60]];
        permissions.ap_table = permissions.ap_table | ap_table;
        permissions.pxn_table = permissions.pxn_table | pxn_table
    } else if HasUnprivileged(regime) then {
        let ap_table : bits(2) = descriptor[62 .. 61];
        let uxn_table : bits(1) = [descriptor[60]];
        let pxn_table : bits(1) = [descriptor[59]];
        permissions.ap_table = permissions.ap_table | ap_table;
        permissions.uxn_table = permissions.uxn_table | uxn_table;
        permissions.pxn_table = permissions.pxn_table | pxn_table
    } else {
        let ap_table : bits(2) = [descriptor[62]] @ 0b0;
        let xn_table : bits(1) = [descriptor[60]];
        permissions.ap_table = permissions.ap_table | ap_table;
        permissions.xn_table = permissions.xn_table | xn_table
    };
    return(permissions)
}

val AArch64_S1NextWalkStateTable : (TTWState, Regime, S1TTWParams, bits(64)) -> TTWState

function AArch64_S1NextWalkStateTable (currentstate, regime, walkparams, descriptor) = {
    nextstate : TTWState = undefined;
    tablebase : FullAddress = undefined;
    tablebase.address = AArch64_NextTableBase(descriptor, walkparams.ds, walkparams.tgx);
    if currentstate.baseaddress.paspace == PAS_Secure then {
        tablebase.paspace = if [descriptor[63]] == 0b0 then PAS_Secure else
          PAS_NonSecure
    } else {
        tablebase.paspace = currentstate.baseaddress.paspace
    };
    nextstate.istable = true;
    nextstate.nG = currentstate.nG;
    nextstate.level = currentstate.level + 1;
    nextstate.baseaddress = tablebase;
    nextstate.memattrs = currentstate.memattrs;
    if walkparams.hpd == 0b0 then {
        nextstate.permissions = AArch64_S1ApplyTablePerms(currentstate.permissions, descriptor, regime, walkparams)
    } else {
        nextstate.permissions = currentstate.permissions
    };
    return(nextstate)
}

val HaveStage2MemAttrControl : unit -> bool

function HaveStage2MemAttrControl () = {
    return(HasArchVersion(ARMv8p4))
}

struct S2TTWParams = {
  ha : bits(1),
  hd : bits(1),
  sl2 : bits(1),
  ds : bits(1),
  sw : bits(1),
  nsw : bits(1),
  sa : bits(1),
  nsa : bits(1),
  ps : bits(3),
  txsz : bits(6),
  fwb : bits(1),
  cmow : bits(1),
  s : bits(1),
  t0sz : bits(4),
  tgx : TGx,
  sl0 : bits(2),
  irgn : bits(2),
  orgn : bits(2),
  sh : bits(2),
  ee : bits(1),
  ptw : bits(1),
  vm : bits(1)
}

val AArch64_NSS2TTWParams : forall ('s1aarch64 : Bool).
  bool('s1aarch64) -> S2TTWParams

function AArch64_NSS2TTWParams s1aarch64 = {
    walkparams : S2TTWParams = undefined;
    walkparams.vm = Slice(HCR_EL2, 0, 1) | Slice(HCR_EL2, 12, 1);
    walkparams.tgx = AArch64_DecodeTG0(Slice(VTCR_EL2, 14, 2));
    walkparams.txsz = Slice(VTCR_EL2, 0, 6);
    walkparams.sl0 = Slice(VTCR_EL2, 6, 2);
    walkparams.ps = Slice(VTCR_EL2, 16, 3);
    walkparams.irgn = Slice(VTCR_EL2, 8, 2);
    walkparams.orgn = Slice(VTCR_EL2, 10, 2);
    walkparams.sh = Slice(VTCR_EL2, 12, 2);
    walkparams.ee = Slice(SCTLR_EL2, 25, 1);
    walkparams.ptw = if Slice(HCR_EL2, 27, 1) == 0b0 then Slice(HCR_EL2, 2, 1)
    else
      0b0;
    walkparams.fwb = if HaveStage2MemAttrControl() then Slice(HCR_EL2, 46, 1)
    else
      0b0;
    walkparams.ha = if HaveAccessFlagUpdateExt() then Slice(VTCR_EL2, 21, 1)
    else
      0b0;
    walkparams.hd = if HaveDirtyBitModifierExt() then Slice(VTCR_EL2, 22, 1)
    else
      0b0;
    if (walkparams.tgx == TGx_4KB | walkparams.tgx == TGx_16KB) & Have52BitIPAAndPASpaceExt() then {
        walkparams.ds = Slice(VTCR_EL2, 32, 1)
    } else {
        walkparams.ds = 0b0
    };
    if walkparams.tgx == TGx_4KB & Have52BitIPAAndPASpaceExt() then {
        walkparams.sl2 = Slice(VTCR_EL2, 33, 1) & Slice(VTCR_EL2, 32, 1)
    } else {
        walkparams.sl2 = 0b0
    };
    walkparams.cmow = if HaveFeatCMOW() & IsHCRXEL2Enabled() then
      Slice(HCRX_EL2, 9, 1)
    else
      0b0;
    return(walkparams)
}

val AArch64_S2MinTxSZ : forall ('s1aarch64 : Bool).
  (bits(1), TGx, bool('s1aarch64)) -> int

function AArch64_S2MinTxSZ (ds, tgx, s1aarch64) = {
    ips : int = AArch64_PAMax();
    if (Have52BitPAExt() & tgx != TGx_64KB) & ds == 0b0 then {
        ips = Min(48, AArch64_PAMax())
    };
    let 'ips = ips;
    min_txsz : int = 64 - ips;
    if not_bool(s1aarch64) then {
        min_txsz = Min(min_txsz, 24)
    };
    let 'min_txsz = min_txsz;
    return(min_txsz)
}

register VSTCR_EL2 : bits(64)

val AArch64_SS2TTWParams : forall ('s1aarch64 : Bool).
  (PASpace, bool('s1aarch64)) -> S2TTWParams

function AArch64_SS2TTWParams (ipaspace, s1aarch64) = {
    walkparams : S2TTWParams = undefined;
    if ipaspace == PAS_Secure then {
        walkparams.tgx = AArch64_DecodeTG0(Slice(VSTCR_EL2, 14, 2));
        walkparams.txsz = Slice(VSTCR_EL2, 0, 6);
        walkparams.sl0 = Slice(VSTCR_EL2, 6, 2);
        if walkparams.tgx == TGx_4KB & Have52BitIPAAndPASpaceExt() then {
            walkparams.sl2 = Slice(VSTCR_EL2, 33, 1) & Slice(VTCR_EL2, 32, 1)
        } else {
            walkparams.sl2 = 0b0
        }
    } else if ipaspace == PAS_NonSecure then {
        walkparams.tgx = AArch64_DecodeTG0(Slice(VTCR_EL2, 14, 2));
        walkparams.txsz = Slice(VTCR_EL2, 0, 6);
        walkparams.sl0 = Slice(VTCR_EL2, 6, 2);
        if walkparams.tgx == TGx_4KB & Have52BitIPAAndPASpaceExt() then {
            walkparams.sl2 = Slice(VTCR_EL2, 33, 1) & Slice(VTCR_EL2, 32, 1)
        } else {
            walkparams.sl2 = 0b0
        }
    } else {
        Unreachable()
    };
    walkparams.sw = Slice(VSTCR_EL2, 29, 1);
    walkparams.nsw = Slice(VTCR_EL2, 29, 1);
    walkparams.sa = Slice(VSTCR_EL2, 30, 1);
    walkparams.nsa = Slice(VTCR_EL2, 30, 1);
    walkparams.vm = Slice(HCR_EL2, 0, 1) | Slice(HCR_EL2, 12, 1);
    walkparams.ps = Slice(VTCR_EL2, 16, 3);
    walkparams.irgn = Slice(VTCR_EL2, 8, 2);
    walkparams.orgn = Slice(VTCR_EL2, 10, 2);
    walkparams.sh = Slice(VTCR_EL2, 12, 2);
    walkparams.ee = Slice(SCTLR_EL2, 25, 1);
    walkparams.ptw = if Slice(HCR_EL2, 27, 1) == 0b0 then Slice(HCR_EL2, 2, 1)
    else
      0b0;
    walkparams.fwb = if HaveStage2MemAttrControl() then Slice(HCR_EL2, 46, 1)
    else
      0b0;
    walkparams.ha = if HaveAccessFlagUpdateExt() then Slice(VTCR_EL2, 21, 1)
    else
      0b0;
    walkparams.hd = if HaveDirtyBitModifierExt() then Slice(VTCR_EL2, 22, 1)
    else
      0b0;
    if (walkparams.tgx == TGx_4KB | walkparams.tgx == TGx_16KB) & Have52BitIPAAndPASpaceExt() then {
        walkparams.ds = Slice(VTCR_EL2, 32, 1)
    } else {
        walkparams.ds = 0b0
    };
    walkparams.cmow = if HaveFeatCMOW() & IsHCRXEL2Enabled() then
      Slice(HCRX_EL2, 9, 1)
    else
      0b0;
    return(walkparams)
}

val AArch64_GetS2TTWParams : forall ('s1aarch64 : Bool).
  (SecurityState, PASpace, bool('s1aarch64)) -> S2TTWParams

function AArch64_GetS2TTWParams (ss, ipaspace, s1aarch64) = {
    walkparams : S2TTWParams = undefined;
    if ss == SS_NonSecure then {
        walkparams = AArch64_NSS2TTWParams(s1aarch64)
    } else if HaveSecureEL2Ext() & ss == SS_Secure then {
        walkparams = AArch64_SS2TTWParams(ipaspace, s1aarch64)
    } else if ss == SS_Realm then {
        walkparams = AArch64_NSS2TTWParams(s1aarch64)
    } else {
        Unreachable()
    };
    let 'maxtxsz = AArch64_MaxTxSZ(walkparams.tgx);
    let 'mintxsz = AArch64_S2MinTxSZ(walkparams.ds, walkparams.tgx, s1aarch64);
    if UInt(walkparams.txsz) > maxtxsz then {
        if not_bool(__IMPDEF_boolean("Fault on TxSZ value above maximum")) then {
            walkparams.txsz = maxtxsz[5 .. 0]
        };
        ()
    } else if not_bool(Have52BitPAExt()) & UInt(walkparams.txsz) < mintxsz then {
        if not_bool(__IMPDEF_boolean("Fault on TxSZ value below minimum")) then {
            walkparams.txsz = mintxsz[5 .. 0]
        };
        ()
    } else ();
    return(walkparams)
}

val AArch64_IPAIsOutOfRange : (bits(52), S2TTWParams) -> bool

function AArch64_IPAIsOutOfRange (ipa, walkparams) = {
    let 'iasize = AArch64_IASize(walkparams.txsz);
    if iasize < 52 then {
        return(not_bool(is_zero_subrange(ipa, 51, iasize)))
    } else {
        return(false)
    }
}

val AArch64_S2HasAlignmentFault : forall ('aligned : Bool).
  (AccType, bool('aligned), MemoryAttributes) -> bool

function AArch64_S2HasAlignmentFault (acctype, aligned, memattrs) = {
    if acctype == AccType_IFETCH | memattrs.memtype != MemType_Device then {
        return(false)
    };
    return(not_bool(aligned) | acctype == AccType_DCZVA)
}

val AArch64_S2HasPermissionsFault : forall ('ispriv : Bool) ('iswrite : Bool) ('s2fs1walk : Bool).
  (bool('s2fs1walk), TTWState, SecurityState, S2TTWParams, bool('ispriv), AccType, bool('iswrite)) -> bool

function AArch64_S2HasPermissionsFault (s2fs1walk, walkstate, ss, walkparams, ispriv, acctype, iswrite) = {
    constraint_name : Constraint = undefined;
    impdef_ic_fault : bool = undefined;
    let permissions : Permissions = walkstate.permissions;
    let memtype : MemType = walkstate.memattrs.memtype;
    let r : bits(1) = [permissions.s2ap[0]];
    let w : bits(1) = [permissions.s2ap[1]];
    px : bits(1) = undefined;
    ux : bits(1) = undefined;
    match permissions.s2xn @ permissions.s2xnx {
      0b00 => {
          (px, ux) = (0b1, 0b1)
      },
      0b01 => {
          (px, ux) = (0b0, 0b1)
      },
      0b10 => {
          (px, ux) = (0b0, 0b0)
      },
      0b11 => {
          (px, ux) = (0b1, 0b0)
      }
    };
    let x : bits(1) = if ispriv then px else ux;
    if (s2fs1walk & walkparams.ptw == 0b1) & memtype == MemType_Device then {
        return(true)
    } else if (s2fs1walk & ss == SS_Realm) & walkstate.baseaddress.paspace != PAS_Realm then {
        return(true)
    } else if acctype == AccType_IFETCH then {
        let constraint_name : Constraint = ConstrainUnpredictable(Unpredictable_INSTRDEVICE);
        if constraint_name == Constraint_FAULT & memtype == MemType_Device then {
            return(true)
        };
        if ss == SS_Realm & walkstate.baseaddress.paspace != PAS_Realm then {
            return(true)
        };
        return(x == 0b0)
    } else if acctype == AccType_DC then {
        if iswrite then {
            return(not_bool(ELUsingAArch32(EL1)) & w == 0b0)
        } else {
            return((not_bool(ispriv) & not_bool(ELUsingAArch32(EL1))) & r == 0b0 | (IsCMOWControlledInstruction() & walkparams.cmow == 0b1) & w == 0b0)
        }
    } else if acctype == AccType_IC then {
        assert(not_bool(iswrite));
        let impdef_ic_fault : bool = __IMPDEF_boolean("Permission fault on EL0 IC_IVAU execution");
        return(((not_bool(ispriv) & not_bool(ELUsingAArch32(EL1))) & r == 0b0) & impdef_ic_fault | (IsCMOWControlledInstruction() & walkparams.cmow == 0b1) & w == 0b0)
    } else if iswrite then {
        return(w == 0b0)
    } else {
        return(r == 0b0)
    }
}

val AArch64_S2StartLevel : S2TTWParams -> int

function AArch64_S2StartLevel walkparams = {
    match walkparams.tgx {
      TGx_4KB => {
          match walkparams.sl2 @ walkparams.sl0 {
            0b000 => {
                return(2)
            },
            0b001 => {
                return(1)
            },
            0b010 => {
                return(0)
            },
            0b011 => {
                return(3)
            },
            0b100 => {
                return(negate(1))
            },
            _ => {
                return(undefined : int)
            }
          }
      },
      TGx_16KB => {
          match walkparams.sl0 {
            0b00 => {
                return(3)
            },
            0b01 => {
                return(2)
            },
            0b10 => {
                return(1)
            },
            0b11 => {
                return(0)
            },
            _ => {
                return(undefined : int)
            }
          }
      },
      TGx_64KB => {
          match walkparams.sl0 {
            0b00 => {
                return(3)
            },
            0b01 => {
                return(2)
            },
            0b10 => {
                return(1)
            },
            _ => {
                return(undefined : int)
            }
          }
      },
      _ => {
          return(undefined : int)
      }
    }
}

val AArch64_S2InconsistentSL : S2TTWParams -> bool

function AArch64_S2InconsistentSL walkparams = {
    let 'startlevel = AArch64_S2StartLevel(walkparams);
    let 'levels = FINAL_LEVEL - startlevel;
    let 'granulebits = TGxGranuleBits(walkparams.tgx);
    let 'stride = granulebits - 3;
    let 'sl_min_iasize = levels * stride + granulebits + 1;
    let 'sl_max_iasize = sl_min_iasize + (stride - 1) + 4;
    let 'iasize = AArch64_IASize(walkparams.txsz);
    return(iasize < sl_min_iasize | iasize > sl_max_iasize)
}

val AArch64_S2InvalidSL : S2TTWParams -> bool

function AArch64_S2InvalidSL walkparams = {
    match walkparams.tgx {
      TGx_4KB => {
          match walkparams.sl2 @ walkparams.sl0 {
            [bitone, _, bitone] => {
                return(true)
            },
            [bitone, bitone, _] => {
                return(true)
            },
            0b010 => {
                return(AArch64_PAMax() < 44)
            },
            0b011 => {
                return(not_bool(HaveSmallTranslationTableExt()))
            },
            _ => {
                return(false)
            }
          }
      },
      TGx_16KB => {
          match walkparams.ds @ walkparams.sl0 {
            0b011 => {
                return(true)
            },
            0b010 => {
                return(AArch64_PAMax() < 42)
            },
            _ => {
                return(false)
            }
          }
      },
      TGx_64KB => {
          match walkparams.sl0 {
            0b11 => {
                return(true)
            },
            0b10 => {
                return(AArch64_PAMax() < 44)
            },
            _ => {
                return(false)
            }
          }
      },
      _ => {
          return(undefined : bool)
      }
    }
}

val AArch64_S2InvalidTxSZ : forall ('s1aarch64 : Bool).
  (S2TTWParams, bool('s1aarch64)) -> bool

function AArch64_S2InvalidTxSZ (walkparams, s1aarch64) = {
    let 'mintxsz = AArch64_S2MinTxSZ(walkparams.ds, walkparams.tgx, s1aarch64);
    let 'maxtxsz = AArch64_MaxTxSZ(walkparams.tgx);
    return(UInt(walkparams.txsz) < mintxsz | UInt(walkparams.txsz) > maxtxsz)
}

register VSTTBR_EL2 : bits(64)

val AArch64_GetS2TLBContext : (SecurityState, FullAddress, TGx) -> TLBContext

function AArch64_GetS2TLBContext (ss, ipa, tg) = {
    assert(EL2Enabled());
    tlbcontext : TLBContext = undefined;
    tlbcontext.ss = ss;
    tlbcontext.regime = Regime_EL10;
    tlbcontext.ipaspace = ipa.paspace;
    tlbcontext.vmid = VMID_read();
    tlbcontext.tg = tg;
    tlbcontext.ia = ZeroExtend(ipa.address);
    if HaveCommonNotPrivateTransExt() then {
        tlbcontext.cnp = if ipa.paspace == PAS_Secure then
          Slice(VSTTBR_EL2, 0, 1)
        else
          Slice(VTTBR_EL2, 0, 1)
    } else {
        tlbcontext.cnp = 0b0
    };
    tlbcontext.includes_s1_name = false;
    tlbcontext.includes_s2_name = true;
    tlbcontext.includes_gpt_name = false;
    return(tlbcontext)
}

val AArch64_S2InitialTTWState : (SecurityState, S2TTWParams) -> TTWState

function AArch64_S2InitialTTWState (ss, walkparams) = {
    walkstate : TTWState = undefined;
    tablebase : FullAddress = undefined;
    let ttbr : bits(64) = VTTBR_EL2;
    let 'startlevel = AArch64_S2StartLevel(walkparams);
    match ss {
      SS_NonSecure => {
          tablebase.paspace = PAS_NonSecure
      },
      SS_Realm => {
          tablebase.paspace = PAS_Realm
      },
      _ => ()
    };
    tablebase.address = AArch64_TTBaseAddress(ttbr, walkparams.txsz, walkparams.ps, walkparams.ds, walkparams.tgx, startlevel);
    walkstate.baseaddress = tablebase;
    walkstate.level = startlevel;
    walkstate.istable = true;
    walkstate.memattrs = WalkMemAttrs(walkparams.sh, walkparams.irgn, walkparams.orgn);
    return(walkstate)
}

val AArch64_IsS2ResultTagged : forall ('s1_tagged : Bool).
  (MemoryAttributes, bool('s1_tagged)) -> bool

function AArch64_IsS2ResultTagged (s2_memattrs, s1_tagged) = {
    return(((((((s1_tagged & s2_memattrs.memtype == MemType_Normal) & s2_memattrs.inner.attrs == MemAttr_WB) & s2_memattrs.inner.hints == MemHint_RWA) & not_bool(s2_memattrs.inner.transient)) & s2_memattrs.outer.attrs == MemAttr_WB) & s2_memattrs.outer.hints == MemHint_RWA) & not_bool(s2_memattrs.outer.transient))
}

val EffectiveShareability : MemoryAttributes -> Shareability

function EffectiveShareability memattrs = {
    if memattrs.memtype == MemType_Device | memattrs.inner.attrs == MemAttr_NC & memattrs.outer.attrs == MemAttr_NC then {
        return(Shareability_OSH)
    } else {
        return(memattrs.shareability)
    }
}

val S2CombineS1Device : (DeviceType, DeviceType) -> DeviceType

function S2CombineS1Device (s1_device, s2_device) = {
    if s1_device == DeviceType_nGnRnE | s2_device == DeviceType_nGnRnE then {
        return(DeviceType_nGnRnE)
    } else if s1_device == DeviceType_nGnRE | s2_device == DeviceType_nGnRE then {
        return(DeviceType_nGnRE)
    } else if s1_device == DeviceType_nGRE | s2_device == DeviceType_nGRE then {
        return(DeviceType_nGRE)
    } else {
        return(DeviceType_GRE)
    }
}

val S2CombineS1Shareability : (Shareability, Shareability) -> Shareability

function S2CombineS1Shareability (s1_shareability, s2_shareability) = {
    if s1_shareability == Shareability_OSH | s2_shareability == Shareability_OSH then {
        return(Shareability_OSH)
    } else if s1_shareability == Shareability_ISH | s2_shareability == Shareability_ISH then {
        return(Shareability_ISH)
    } else {
        return(Shareability_NSH)
    }
}

val AArch64_S2ApplyFWBMemAttrs : (MemoryAttributes, bits(4), bits(2)) -> MemoryAttributes

function AArch64_S2ApplyFWBMemAttrs (s1_memattrs, s2_attr, s2_sh) = {
    s2_device : DeviceType = undefined;
    memattrs : MemoryAttributes = undefined;
    if [s2_attr[2]] == 0b0 then {
        let s2_device : DeviceType = DecodeDevice(s2_attr[1 .. 0]);
        memattrs.memtype = MemType_Device;
        if s1_memattrs.memtype == MemType_Device then {
            memattrs.device = S2CombineS1Device(s1_memattrs.device, s2_device)
        } else {
            memattrs.device = s2_device
        }
    } else if s2_attr[1 .. 0] == 0b11 then {
        memattrs = s1_memattrs
    } else if s2_attr[1 .. 0] == 0b10 then {
        memattrs.memtype = MemType_Normal;
        memattrs.inner.attrs = MemAttr_WB;
        memattrs.outer.attrs = MemAttr_WB;
        if s1_memattrs.memtype == MemType_Normal & s1_memattrs.inner.attrs != MemAttr_NC then {
            memattrs.inner.hints = s1_memattrs.inner.hints;
            memattrs.inner.transient = s1_memattrs.inner.transient
        } else {
            memattrs.inner.hints = MemHint_RWA;
            memattrs.inner.transient = false
        };
        if s1_memattrs.memtype == MemType_Normal & s1_memattrs.outer.attrs != MemAttr_NC then {
            memattrs.outer.hints = s1_memattrs.outer.hints;
            memattrs.outer.transient = s1_memattrs.outer.transient
        } else {
            memattrs.outer.hints = MemHint_RWA;
            memattrs.outer.transient = false
        }
    } else {
        if s1_memattrs.memtype == MemType_Device then {
            memattrs = s1_memattrs
        } else {
            cacheability_attr : MemAttrHints = undefined;
            cacheability_attr.attrs = MemAttr_NC;
            memattrs.memtype = MemType_Normal;
            memattrs.inner = cacheability_attr;
            memattrs.outer = cacheability_attr
        }
    };
    let s2_shareability : Shareability = DecodeShareability(s2_sh);
    memattrs.shareability = S2CombineS1Shareability(s1_memattrs.shareability, s2_shareability);
    memattrs.tagged = AArch64_IsS2ResultTagged(memattrs, s1_memattrs.tagged);
    memattrs.shareability = EffectiveShareability(memattrs);
    return(memattrs)
}

val HaveExtendedExecuteNeverExt : unit -> bool

function HaveExtendedExecuteNeverExt () = {
    return(HasArchVersion(ARMv8p2))
}

val AArch64_S2ApplyOutputPerms : (bits(64), S2TTWParams) -> Permissions

function AArch64_S2ApplyOutputPerms (descriptor, walkparams) = {
    permissions : Permissions = undefined;
    permissions.s2ap = descriptor[7 .. 6];
    permissions.s2xn = [descriptor[54]];
    if HaveExtendedExecuteNeverExt() then {
        permissions.s2xnx = [descriptor[53]]
    } else {
        permissions.s2xnx = 0b0
    };
    if (walkparams.ha == 0b1 & walkparams.hd == 0b1) & [descriptor[51]] == 0b1 then {
        permissions.s2ap[1 .. 1] = 0b1
    };
    return(permissions)
}

val AArch64_SS2OutputPASpace : (S2TTWParams, PASpace) -> PASpace

function AArch64_SS2OutputPASpace (walkparams, ipaspace) = {
    if ipaspace == PAS_Secure then {
        if (walkparams.sw @ walkparams.sa) == 0b00 then {
            return(PAS_Secure)
        } else {
            return(PAS_NonSecure)
        }
    } else {
        if (walkparams.sw @ (walkparams.sa @ (walkparams.nsw @ walkparams.nsa))) == 0b0000 then {
            return(PAS_Secure)
        } else {
            return(PAS_NonSecure)
        }
    }
}

val S2DecodeCacheability : bits(2) -> MemAttrHints

function S2DecodeCacheability attr = {
    s2attr : MemAttrHints = undefined;
    match attr {
      0b01 => {
          s2attr.attrs = MemAttr_NC
      },
      0b10 => {
          s2attr.attrs = MemAttr_WT
      },
      0b11 => {
          s2attr.attrs = MemAttr_WB
      },
      _ => {
          match ConstrainUnpredictable(Unpredictable_S2RESMEMATTR) {
            Constraint_NC => {
                s2attr.attrs = MemAttr_NC
            },
            Constraint_WT => {
                s2attr.attrs = MemAttr_WT
            },
            Constraint_WB => {
                s2attr.attrs = MemAttr_WB
            },
            _ => ()
          }
      }
    };
    s2attr.hints = __UNKNOWN_bits(2);
    s2attr.transient = __UNKNOWN_boolean();
    return(s2attr)
}

val S2DecodeMemAttrs : (bits(4), bits(2)) -> MemoryAttributes

function S2DecodeMemAttrs (attr, sh) = {
    memattrs : MemoryAttributes = undefined;
    match attr {
      [bitzero, bitzero, _, _] => {
          memattrs.memtype = MemType_Device;
          memattrs.device = DecodeDevice(attr[1 .. 0])
      },
      _ => {
          memattrs.memtype = MemType_Normal;
          memattrs.outer = S2DecodeCacheability(attr[3 .. 2]);
          memattrs.inner = S2DecodeCacheability(attr[1 .. 0])
      }
    };
    memattrs.shareability = DecodeShareability(sh);
    return(memattrs)
}

val AArch64_S2NextWalkStateLast : (TTWState, SecurityState, S2TTWParams, AddressDescriptor, bits(64)) -> TTWState

function AArch64_S2NextWalkStateLast (currentstate, ss, walkparams, ipa, descriptor) = {
    nextstate : TTWState = undefined;
    baseaddress : FullAddress = undefined;
    if ss == SS_Secure then {
        baseaddress.paspace = AArch64_SS2OutputPASpace(walkparams, ipa.paddress.paspace)
    } else if ss == SS_Realm then {
        if [descriptor[55]] == 0b1 then {
            baseaddress.paspace = PAS_NonSecure
        } else {
            baseaddress.paspace = PAS_Realm
        }
    } else {
        baseaddress.paspace = PAS_NonSecure
    };
    if currentstate.level == FINAL_LEVEL then {
        baseaddress.address = AArch64_PageBase(descriptor, walkparams.ds, walkparams.tgx)
    } else {
        baseaddress.address = AArch64_BlockBase(descriptor, walkparams.ds, walkparams.tgx, currentstate.level)
    };
    nextstate.istable = false;
    nextstate.level = currentstate.level;
    nextstate.baseaddress = baseaddress;
    nextstate.permissions = AArch64_S2ApplyOutputPerms(descriptor, walkparams);
    let s2_attr : bits(4) = descriptor[5 .. 2];
    let s2_sh : bits(2) = if walkparams.ds == 0b1 then walkparams.sh else
      descriptor[9 .. 8];
    let s2_fnxs : bits(1) = [descriptor[11]];
    if walkparams.fwb == 0b1 then {
        nextstate.memattrs = AArch64_S2ApplyFWBMemAttrs(ipa.memattrs, s2_attr, s2_sh);
        if s2_attr[1 .. 0] == 0b10 then {
            nextstate.memattrs.xs = 0b0
        } else {
            nextstate.memattrs.xs = if s2_fnxs == 0b1 then 0b0 else
              ipa.memattrs.xs
        }
    } else {
        nextstate.memattrs = S2DecodeMemAttrs(s2_attr, s2_sh);
        nextstate.memattrs.xs = if s2_fnxs == 0b1 then 0b0 else ipa.memattrs.xs
    };
    nextstate.contiguous = AArch64_ContiguousBit(walkparams.tgx, currentstate.level, descriptor);
    return(nextstate)
}

val AArch64_S2NextWalkStateTable : (TTWState, S2TTWParams, bits(64)) -> TTWState

function AArch64_S2NextWalkStateTable (currentstate, walkparams, descriptor) = {
    nextstate : TTWState = undefined;
    tablebase : FullAddress = undefined;
    tablebase.address = AArch64_NextTableBase(descriptor, walkparams.ds, walkparams.tgx);
    tablebase.paspace = currentstate.baseaddress.paspace;
    nextstate.istable = true;
    nextstate.level = currentstate.level + 1;
    nextstate.baseaddress = tablebase;
    nextstate.memattrs = currentstate.memattrs;
    return(nextstate)
}

val AArch64_S2SLTTEntryAddress : (S2TTWParams, bits(52), FullAddress) -> FullAddress

function AArch64_S2SLTTEntryAddress (walkparams, ipa, tablebase) = {
    let 'startlevel = AArch64_S2StartLevel(walkparams);
    let 'iasize = AArch64_IASize(walkparams.txsz);
    let 'granulebits = TGxGranuleBits(walkparams.tgx);
    let 'stride = granulebits - 3;
    let 'levels = FINAL_LEVEL - startlevel;
    let 'lsb = levels * stride + granulebits;
    let 'msb = iasize - 1;
    assert(constraint((0 <= 'lsb & 'lsb <= 'msb & 'msb < 52)));
    assert(constraint(52 >= 'msb - 'lsb + 1 + 3));
    let index : bits(52) = ZeroExtend(ipa[msb .. lsb] @ Zeros(3));
    descaddress : FullAddress = undefined;
    descaddress.address = tablebase.address | index;
    descaddress.paspace = tablebase.paspace;
    return(descaddress)
}

val AArch64_SS2InitialTTWState : (S2TTWParams, PASpace) -> TTWState

function AArch64_SS2InitialTTWState (walkparams, ipaspace) = {
    walkstate : TTWState = undefined;
    tablebase : FullAddress = undefined;
    ttbr : bits(64) = undefined;
    if ipaspace == PAS_Secure then {
        ttbr = VSTTBR_EL2
    } else {
        ttbr = VTTBR_EL2
    };
    if ipaspace == PAS_Secure then {
        if walkparams.sw == 0b0 then {
            tablebase.paspace = PAS_Secure
        } else {
            tablebase.paspace = PAS_NonSecure
        }
    } else {
        if walkparams.nsw == 0b0 then {
            tablebase.paspace = PAS_Secure
        } else {
            tablebase.paspace = PAS_NonSecure
        }
    };
    let 'startlevel = AArch64_S2StartLevel(walkparams);
    tablebase.address = AArch64_TTBaseAddress(ttbr, walkparams.txsz, walkparams.ps, walkparams.ds, walkparams.tgx, startlevel);
    walkstate.baseaddress = tablebase;
    walkstate.level = startlevel;
    walkstate.istable = true;
    walkstate.memattrs = WalkMemAttrs(walkparams.sh, walkparams.irgn, walkparams.orgn);
    return(walkstate)
}

val AArch64_TTEntryAddress : forall 'level.
  (int('level), TGx, bits(6), bits(64), FullAddress) -> FullAddress

function AArch64_TTEntryAddress (level, tgx, txsz, ia, tablebase) = {
    let 'iasize = AArch64_IASize(txsz);
    let 'granulebits = TGxGranuleBits(tgx);
    let 'stride = granulebits - 3;
    let 'levels = FINAL_LEVEL - level;
    let 'lsb = levels * stride + granulebits;
    let 'msb = Min(iasize - 1, lsb + stride - 1);
    assert(constraint((0 <= 'lsb & 'lsb <= 'msb & 'msb < 64)));
    assert(constraint(52 >= 'msb - 'lsb + 1 + 3));
    let index : bits(52) = ZeroExtend(ia[msb .. lsb] @ Zeros(3));
    descaddress : FullAddress = undefined;
    descaddress.address = tablebase.address | index;
    descaddress.paspace = tablebase.paspace;
    return(descaddress)
}

val FetchDescriptor : forall 'N, 'N in {32, 64}.
  (implicit('N), bits(1), AddressDescriptor, FaultRecord) -> (FaultRecord, bits('N))

function FetchDescriptor (N, ee, walkaddress, fault_in) = {
    assert(N == 32 | N == 64);
    descriptor : bits('N) = undefined;
    fault : FaultRecord = fault_in;
    walkacc : AccessDescriptor = undefined;
    walkacc.acctype = AccType_TTW;
    walkacc.mpam = GenMPAMcurEL(fault.acctype);
    if HaveRME() then {
        fault.gpcf = GranuleProtectionCheck(walkaddress, walkacc);
        if fault.gpcf.gpf != GPCF_None then {
            fault.statuscode = Fault_GPCFOnWalk;
            fault.paddress = walkaddress.paddress;
            fault.gpcfs2walk = fault.secondstage;
            return((fault, __UNKNOWN_bits(N)))
        };
        ()
    };
    memstatus : PhysMemRetStatus = undefined;
    (memstatus, descriptor) = PhysMemRead(walkaddress, DIV(N, 8), walkacc);
    if IsFault__2(memstatus) then {
        fault = HandleExternalTTWAbort(memstatus, fault.write, walkaddress, walkacc, DIV(N, 8), fault);
        if IsFault__1(fault.statuscode) then {
            return((fault, __UNKNOWN_bits(N)))
        };
        ()
    };
    if ee == 0b1 then {
        descriptor = BigEndianReverse(descriptor)
    };
    let descriptor = descriptor;
    return((fault, descriptor))
}

val NormalNCMemAttr : unit -> MemoryAttributes

function NormalNCMemAttr () = {
    non_cacheable : MemAttrHints = undefined;
    non_cacheable.attrs = MemAttr_NC;
    nc_memattrs : MemoryAttributes = undefined;
    nc_memattrs.memtype = MemType_Normal;
    nc_memattrs.outer = non_cacheable;
    nc_memattrs.inner = non_cacheable;
    nc_memattrs.shareability = Shareability_OSH;
    nc_memattrs.tagged = false;
    return(nc_memattrs)
}

struct TLBRecord = {
  context : TLBContext,
  walkstate : TTWState,
  blocksize : int,
  contigsize : int,
  s1descriptor : bits(64),
  s2descriptor : bits(64)
}

val S2TLBCache : TLBRecord -> unit

struct TLBLine = {tlbrecord : TLBRecord, valid_name : bool}

val __UNKNOWN_TLBLine : unit -> TLBLine

function __UNKNOWN_TLBLine () = undefined

val S2TLBLookup : TLBContext -> TLBLine

register __tlb_enabled : bool = false

val AArch64_S2Walk : forall ('iswrite : Bool) ('s1aarch64 : Bool).
  (FaultRecord, AddressDescriptor, S2TTWParams, SecurityState, AccType, bool('iswrite), bool('s1aarch64)) -> (FaultRecord, AddressDescriptor, TTWState, bits(64))

function AArch64_S2Walk (fault_in, ipa, walkparams, ss, acctype, iswrite, s1aarch64) = {
    fault : FaultRecord = fault_in;
    ipa_64 : bits(64) = ZeroExtend(ipa.paddress.address, 64);
    tlbcontext : TLBContext = undefined;
    tlbrecord : TLBRecord = undefined;
    if __tlb_enabled then {
        tlbcontext = AArch64_GetS2TLBContext(ss, ipa.paddress, walkparams.tgx);
        let tlbentry : TLBLine = S2TLBLookup(tlbcontext);
        tlbrecord = tlbentry.tlbrecord;
        if (tlbentry.valid_name & not_bool(AArch64_OAOutOfRange(tlbrecord.walkstate, walkparams.ps, walkparams.tgx, ipa_64))) & not_bool(((((walkparams.ha @ walkparams.hd) == 0b11 & [tlbrecord.s2descriptor[51]] == 0b1) & [tlbrecord.s2descriptor[7]] == 0b0) & (IsAtomicRW(acctype) | iswrite)) & not_bool(acctype == AccType_AT | acctype == AccType_ATPAN | acctype == AccType_IC | acctype == AccType_DC)) then {
            fault.level = tlbrecord.walkstate.level;
            return((fault, __UNKNOWN_AddressDescriptor(), tlbrecord.walkstate, tlbrecord.s2descriptor))
        };
        ()
    };
    walkstate : TTWState = undefined;
    if ss == SS_Secure then {
        walkstate = AArch64_SS2InitialTTWState(walkparams, ipa.paddress.paspace)
    } else {
        walkstate = AArch64_S2InitialTTWState(ss, walkparams)
    };
    if AArch64_OAOutOfRange(walkstate, walkparams.ps, walkparams.tgx, ipa_64) then {
        fault.statuscode = Fault_AddressSize;
        fault.level = 0;
        return((fault, __UNKNOWN_AddressDescriptor(), __UNKNOWN_TTWState(), __UNKNOWN_bits(64)))
    };
    descriptor : bits(64) = undefined;
    walkaddress : AddressDescriptor = undefined;
    walkaddress.vaddress = ipa.vaddress;
    if Slice(HCR_EL2, 32, 1) == 0b1 then {
        walkaddress.memattrs = NormalNCMemAttr();
        walkaddress.memattrs.xs = walkstate.memattrs.xs
    } else {
        walkaddress.memattrs = walkstate.memattrs
    };
    walkaddress.memattrs.shareability = EffectiveShareability(walkaddress.memattrs);
    walkaddress.tlbcontext = tlbcontext;
    desctype : DescriptorType = undefined;
    repeat {
        fault.level = walkstate.level;
        descaddress : FullAddress = undefined;
        if walkstate.level == AArch64_S2StartLevel(walkparams) then {
            descaddress = AArch64_S2SLTTEntryAddress(walkparams, ipa.paddress.address, walkstate.baseaddress)
        } else {
            ipa_64 = ZeroExtend(ipa.paddress.address, 64);
            descaddress = AArch64_TTEntryAddress(walkstate.level, walkparams.tgx, walkparams.txsz, ipa_64, walkstate.baseaddress)
        };
        walkaddress.paddress = descaddress;
        (fault, descriptor) = FetchDescriptor(64, walkparams.ee, walkaddress, fault);
        if fault.statuscode != Fault_None then {
            return((fault, __UNKNOWN_AddressDescriptor(), __UNKNOWN_TTWState(), __UNKNOWN_bits(64)))
        };
        desctype = AArch64_DecodeDescriptorType(descriptor, walkparams.ds, walkparams.tgx, walkstate.level);
        match desctype {
          DescriptorType_Table => {
              walkstate = AArch64_S2NextWalkStateTable(walkstate, walkparams, descriptor);
              if AArch64_OAOutOfRange(walkstate, walkparams.ps, walkparams.tgx, ipa_64) then {
                  fault.statuscode = Fault_AddressSize;
                  return((fault, __UNKNOWN_AddressDescriptor(), __UNKNOWN_TTWState(), __UNKNOWN_bits(64)))
              };
              ()
          },
          DescriptorType_Page => {
              walkstate = AArch64_S2NextWalkStateLast(walkstate, ss, walkparams, ipa, descriptor)
          },
          DescriptorType_Block => {
              walkstate = AArch64_S2NextWalkStateLast(walkstate, ss, walkparams, ipa, descriptor)
          },
          DescriptorType_Invalid => {
              fault.statuscode = Fault_Translation;
              return((fault, __UNKNOWN_AddressDescriptor(), __UNKNOWN_TTWState(), __UNKNOWN_bits(64)))
          },
          _ => {
              Unreachable()
          }
        }
    } until desctype == DescriptorType_Page | desctype == DescriptorType_Block;
    if walkstate.contiguous == 0b1 & AArch64_ContiguousBitFaults(walkparams.txsz, walkparams.tgx, walkstate.level) then {
        fault.statuscode = Fault_Translation
    } else if desctype == DescriptorType_Block & AArch64_BlocknTFaults(descriptor) then {
        fault.statuscode = Fault_Translation
    } else if AArch64_OAOutOfRange(walkstate, walkparams.ps, walkparams.tgx, ipa_64) then {
        fault.statuscode = Fault_AddressSize
    } else if ([descriptor[10]] == 0b0 & walkparams.ha == 0b0) & not_bool((acctype == AccType_DC | acctype == AccType_IC) & not_bool(__IMPDEF_boolean("Generate access flag fault on IC/DC operations"))) then {
        fault.statuscode = Fault_AccessFlag
    } else ();
    if (__tlb_enabled & fault.statuscode == Fault_None) & [descriptor[10]] == 0b1 then {
        tlbcontext.xs = walkstate.memattrs.xs;
        tlbrecord.context = tlbcontext;
        tlbrecord.walkstate = walkstate;
        tlbrecord.blocksize = TranslationSize(walkparams.tgx, walkstate.level);
        tlbrecord.s2descriptor = descriptor;
        if walkstate.contiguous == 0b1 then {
            tlbrecord.contigsize = ContiguousSize(walkparams.tgx, walkstate.level)
        } else {
            tlbrecord.contigsize = 0
        };
        S2TLBCache(tlbrecord)
    };
    return((fault, walkaddress, walkstate, descriptor))
}

val S2CombineS1AttrHints : (MemAttrHints, MemAttrHints) -> MemAttrHints

function S2CombineS1AttrHints (s1_attrhints, s2_attrhints) = {
    attrhints : MemAttrHints = undefined;
    if s1_attrhints.attrs == MemAttr_NC | s2_attrhints.attrs == MemAttr_NC then {
        attrhints.attrs = MemAttr_NC
    } else if s1_attrhints.attrs == MemAttr_WT | s2_attrhints.attrs == MemAttr_WT then {
        attrhints.attrs = MemAttr_WT
    } else {
        attrhints.attrs = MemAttr_WB
    };
    if attrhints.attrs != MemAttr_NC then {
        attrhints.hints = s1_attrhints.hints;
        attrhints.transient = s1_attrhints.transient
    };
    return(attrhints)
}

val S2CombineS1MemAttrs : (MemoryAttributes, MemoryAttributes) -> MemoryAttributes

function S2CombineS1MemAttrs (s1_memattrs, s2_memattrs) = {
    memattrs : MemoryAttributes = undefined;
    if s1_memattrs.memtype == MemType_Device & s2_memattrs.memtype == MemType_Device then {
        memattrs.memtype = MemType_Device;
        memattrs.device = S2CombineS1Device(s1_memattrs.device, s2_memattrs.device)
    } else if s1_memattrs.memtype == MemType_Device then {
        memattrs = s1_memattrs
    } else if s2_memattrs.memtype == MemType_Device then {
        memattrs = s2_memattrs
    } else {
        memattrs.memtype = MemType_Normal;
        memattrs.inner = S2CombineS1AttrHints(s1_memattrs.inner, s2_memattrs.inner);
        memattrs.outer = S2CombineS1AttrHints(s1_memattrs.outer, s2_memattrs.outer)
    };
    if ELUsingAArch32(EL2) | not_bool(HaveMTE2Ext()) then {
        memattrs.tagged = false
    } else {
        memattrs.tagged = AArch64_IsS2ResultTagged(memattrs, s1_memattrs.tagged)
    };
    memattrs.shareability = S2CombineS1Shareability(s1_memattrs.shareability, s2_memattrs.shareability);
    memattrs.xs = s2_memattrs.xs;
    memattrs.shareability = EffectiveShareability(memattrs);
    return(memattrs)
}

val AArch64_S2Translate : forall ('aligned : Bool) ('ispriv : Bool) ('iswrite : Bool) ('s1aarch64 : Bool) ('s2fs1walk : Bool).
  (FaultRecord, AddressDescriptor, bool('s1aarch64), SecurityState, bool('s2fs1walk), AccType, bool('aligned), bool('iswrite), bool('ispriv)) -> (FaultRecord, AddressDescriptor)

function AArch64_S2Translate (fault_in, ipa, s1aarch64, ss, s2fs1walk, acctype, aligned, iswrite, ispriv) = {
    let walkparams : S2TTWParams = AArch64_GetS2TTWParams(ss, ipa.paddress.paspace, s1aarch64);
    fault : FaultRecord = fault_in;
    fault.statuscode = Fault_None;
    fault.secondstage = true;
    fault.s2fs1walk = s2fs1walk;
    fault.ipaddress = ipa.paddress;
    if walkparams.vm != 0b1 then {
        return((fault, ipa))
    };
    if ((AArch64_S2InvalidTxSZ(walkparams, s1aarch64) | AArch64_S2InvalidSL(walkparams)) | AArch64_S2InconsistentSL(walkparams)) | AArch64_IPAIsOutOfRange(ipa.paddress.address, walkparams) then {
        fault.statuscode = Fault_Translation;
        fault.level = 0;
        return((fault, __UNKNOWN_AddressDescriptor()))
    };
    descaddress : AddressDescriptor = undefined;
    walkstate : TTWState = undefined;
    descriptor : bits(64) = undefined;
    new_desc : bits(64) = undefined;
    mem_desc : bits(64) = undefined;
    repeat {
        (fault, descaddress, walkstate, descriptor) = AArch64_S2Walk(fault, ipa, walkparams, ss, acctype, iswrite, s1aarch64);
        if fault.statuscode != Fault_None then {
            return((fault, __UNKNOWN_AddressDescriptor()))
        };
        if AArch64_S2HasAlignmentFault(acctype, aligned, walkstate.memattrs) then {
            fault.statuscode = Fault_Alignment
        } else if IsAtomicRW(acctype) then {
            if AArch64_S2HasPermissionsFault(s2fs1walk, walkstate, ss, walkparams, ispriv, acctype, false) then {
                fault.statuscode = Fault_Permission;
                fault.write = false
            } else if AArch64_S2HasPermissionsFault(s2fs1walk, walkstate, ss, walkparams, ispriv, acctype, true) then {
                fault.statuscode = Fault_Permission;
                if not_bool(fault.s2fs1walk) then {
                    fault.write = true
                };
                ()
            } else ()
        } else if AArch64_S2HasPermissionsFault(s2fs1walk, walkstate, ss, walkparams, ispriv, acctype, iswrite) then {
            fault.statuscode = Fault_Permission
        } else ();
        new_desc = descriptor;
        if walkparams.ha == 0b1 & AArch64_FaultAllowsSetAccessFlag(fault) then {
            new_desc[10] = Bit(0b1)
        };
        if ((((fault.statuscode == Fault_None & walkparams.ha == 0b1) & walkparams.hd == 0b1) & [descriptor[51]] == 0b1) & (IsAtomicRW(acctype) | iswrite)) & not_bool(acctype == AccType_AT | acctype == AccType_ATPAN | acctype == AccType_IC | acctype == AccType_DC) then {
            new_desc[7] = Bit(0b1)
        };
        if new_desc != descriptor then {
            (fault, mem_desc) = AArch64_MemSwapTableDesc(fault, descriptor, new_desc, walkparams.ee, descaddress)
        };
        ()
    } until new_desc == descriptor | mem_desc == new_desc;
    if (__tlb_enabled & new_desc != descriptor) & [mem_desc[10]] == 0b1 then {
        tlbrecord : TLBRecord = undefined;
        if [descriptor[10]] == 0b1 then {
            let tlbentry : TLBLine = S2TLBLookup(descaddress.tlbcontext);
            assert(tlbentry.valid_name);
            tlbrecord = tlbentry.tlbrecord
        } else {
            tlbrecord.context = descaddress.tlbcontext;
            tlbrecord.context.xs = walkstate.memattrs.xs;
            tlbrecord.context.includes_s2_name = true;
            tlbrecord.walkstate = walkstate;
            tlbrecord.blocksize = TranslationSize(walkparams.tgx, walkstate.level);
            if walkstate.contiguous == 0b1 then {
                tlbrecord.contigsize = ContiguousSize(walkparams.tgx, walkstate.level)
            } else {
                tlbrecord.contigsize = 0
            }
        };
        tlbrecord.s2descriptor = mem_desc;
        S2TLBCache(tlbrecord)
    };
    if fault.statuscode != Fault_None then {
        return((fault, __UNKNOWN_AddressDescriptor()))
    };
    let ipa_64 : bits(64) = ZeroExtend(ipa.paddress.address, 64);
    let oa : FullAddress = StageOA(ipa_64, walkparams.tgx, walkstate);
    s2_memattrs : MemoryAttributes = undefined;
    if ((s2fs1walk & walkstate.memattrs.memtype == MemType_Device) & walkparams.ptw == 0b0 | acctype == AccType_IFETCH & (walkstate.memattrs.memtype == MemType_Device | Slice(HCR_EL2, 33, 1) == 0b1)) | (acctype != AccType_IFETCH & walkstate.memattrs.memtype == MemType_Normal) & Slice(HCR_EL2, 32, 1) == 0b1 then {
        s2_memattrs = NormalNCMemAttr();
        s2_memattrs.xs = walkstate.memattrs.xs
    } else {
        s2_memattrs = walkstate.memattrs
    };
    if (not_bool(s2fs1walk) & acctype == AccType_ATOMICLS64) & s2_memattrs.memtype == MemType_Normal then {
        if s2_memattrs.inner.attrs != MemAttr_NC | s2_memattrs.outer.attrs != MemAttr_NC then {
            fault.statuscode = Fault_Exclusive;
            return((fault, __UNKNOWN_AddressDescriptor()))
        };
        ()
    };
    memattrs : MemoryAttributes = undefined;
    if walkparams.fwb == 0b0 then {
        memattrs = S2CombineS1MemAttrs(ipa.memattrs, s2_memattrs)
    } else {
        memattrs = s2_memattrs
    };
    pa : AddressDescriptor = CreateAddressDescriptor(ipa.vaddress, oa, memattrs);
    pa.tlbcontext = descaddress.tlbcontext;
    return((fault, pa))
}

val S1TLBCache : TLBRecord -> unit

val S1TLBLookup : TLBContext -> TLBLine

val AArch64_S1Walk : forall ('ispriv : Bool) ('iswrite_in : Bool).
  (FaultRecord, S1TTWParams, bits(64), Regime, SecurityState, AccType, bool('iswrite_in), bool('ispriv)) -> (FaultRecord, AddressDescriptor, TTWState, bits(64))

function AArch64_S1Walk (fault_in, walkparams, va, regime, ss, acctype, iswrite_in, ispriv) = {
    aligned : bool = undefined;
    s1aarch64 : bool = undefined;
    s2fault : FaultRecord = undefined;
    s2fs1walk : bool = undefined;
    s2walkaddress : AddressDescriptor = undefined;
    fault : FaultRecord = fault_in;
    iswrite : bool = iswrite_in;
    tlbcontext : TLBContext = undefined;
    tlbrecord : TLBRecord = undefined;
    if __tlb_enabled then {
        tlbcontext = AArch64_GetS1TLBContext(regime, ss, va, walkparams.tgx);
        let tlbentry : TLBLine = S1TLBLookup(tlbcontext);
        tlbrecord = tlbentry.tlbrecord;
        if (tlbentry.valid_name & not_bool(AArch64_OAOutOfRange(tlbrecord.walkstate, walkparams.ps, walkparams.tgx, va))) & not_bool(((((walkparams.ha @ walkparams.hd) == 0b11 & [tlbrecord.s1descriptor[51]] == 0b1) & [tlbrecord.s1descriptor[7]] == 0b1) & (IsAtomicRW(acctype) | iswrite)) & not_bool(acctype == AccType_AT | acctype == AccType_ATPAN | acctype == AccType_IC | acctype == AccType_DC)) then {
            fault.level = tlbrecord.walkstate.level;
            return((fault, __UNKNOWN_AddressDescriptor(), tlbrecord.walkstate, tlbrecord.s1descriptor))
        };
        ()
    };
    if HasUnprivileged(regime) & AArch64_S1EPD(regime, va) == 0b1 then {
        fault.statuscode = Fault_Translation;
        fault.level = 0;
        return((fault, __UNKNOWN_AddressDescriptor(), __UNKNOWN_TTWState(), __UNKNOWN_bits(64)))
    };
    walkstate : TTWState = AArch64_S1InitialTTWState(walkparams, va, regime, ss);
    if AArch64_OAOutOfRange(walkstate, walkparams.ps, walkparams.tgx, va) then {
        fault.statuscode = Fault_AddressSize;
        fault.level = 0;
        return((fault, __UNKNOWN_AddressDescriptor(), __UNKNOWN_TTWState(), __UNKNOWN_bits(64)))
    };
    descriptor : bits(64) = undefined;
    walkaddress : AddressDescriptor = undefined;
    walkaddress.vaddress = va;
    if not_bool(AArch64_S1DCacheEnabled(regime)) then {
        walkaddress.memattrs = NormalNCMemAttr();
        walkaddress.memattrs.xs = walkstate.memattrs.xs
    } else {
        walkaddress.memattrs = walkstate.memattrs
    };
    if ((regime == Regime_EL10 & EL2Enabled()) & Slice(HCR_EL2, 0, 1) == 0b1) & not_bool(__IMPDEF_boolean("Apply effective shareability at stage 1")) then {
        walkaddress.memattrs.shareability = walkstate.memattrs.shareability
    } else {
        walkaddress.memattrs.shareability = EffectiveShareability(walkaddress.memattrs)
    };
    walkaddress.tlbcontext = tlbcontext;
    desctype : DescriptorType = undefined;
    repeat {
        fault.level = walkstate.level;
        let descaddress : FullAddress = AArch64_TTEntryAddress(walkstate.level, walkparams.tgx, walkparams.txsz, va, walkstate.baseaddress);
        walkaddress.paddress = descaddress;
        if regime == Regime_EL10 & EL2Enabled() then {
            s1aarch64 = true;
            s2fs1walk = true;
            aligned = true;
            iswrite = false;
            (s2fault, s2walkaddress) = AArch64_S2Translate(fault, walkaddress, s1aarch64, ss, s2fs1walk, AccType_TTW, aligned, iswrite, ispriv);
            if s2fault.statuscode != Fault_None then {
                return((s2fault, __UNKNOWN_AddressDescriptor(), __UNKNOWN_TTWState(), __UNKNOWN_bits(64)))
            };
            (fault, descriptor) = FetchDescriptor(64, walkparams.ee, s2walkaddress, fault)
        } else {
            (fault, descriptor) = FetchDescriptor(64, walkparams.ee, walkaddress, fault)
        };
        if fault.statuscode != Fault_None then {
            return((fault, __UNKNOWN_AddressDescriptor(), __UNKNOWN_TTWState(), __UNKNOWN_bits(64)))
        };
        desctype = AArch64_DecodeDescriptorType(descriptor, walkparams.ds, walkparams.tgx, walkstate.level);
        match desctype {
          DescriptorType_Table => {
              walkstate = AArch64_S1NextWalkStateTable(walkstate, regime, walkparams, descriptor);
              if AArch64_OAOutOfRange(walkstate, walkparams.ps, walkparams.tgx, va) then {
                  fault.statuscode = Fault_AddressSize;
                  return((fault, __UNKNOWN_AddressDescriptor(), __UNKNOWN_TTWState(), __UNKNOWN_bits(64)))
              };
              ()
          },
          DescriptorType_Page => {
              walkstate = AArch64_S1NextWalkStateLast(walkstate, regime, ss, walkparams, descriptor)
          },
          DescriptorType_Block => {
              walkstate = AArch64_S1NextWalkStateLast(walkstate, regime, ss, walkparams, descriptor)
          },
          DescriptorType_Invalid => {
              fault.statuscode = Fault_Translation;
              return((fault, __UNKNOWN_AddressDescriptor(), __UNKNOWN_TTWState(), __UNKNOWN_bits(64)))
          },
          _ => {
              Unreachable()
          }
        }
    } until desctype == DescriptorType_Page | desctype == DescriptorType_Block;
    if walkstate.contiguous == 0b1 & AArch64_ContiguousBitFaults(walkparams.txsz, walkparams.tgx, walkstate.level) then {
        fault.statuscode = Fault_Translation
    } else if desctype == DescriptorType_Block & AArch64_BlocknTFaults(descriptor) then {
        fault.statuscode = Fault_Translation
    } else if AArch64_OAOutOfRange(walkstate, walkparams.ps, walkparams.tgx, va) then {
        fault.statuscode = Fault_AddressSize
    } else if ([descriptor[10]] == 0b0 & walkparams.ha == 0b0) & not_bool((acctype == AccType_DC | acctype == AccType_IC) & not_bool(__IMPDEF_boolean("Generate access flag fault on IC/DC operations"))) then {
        fault.statuscode = Fault_AccessFlag
    } else ();
    if (__tlb_enabled & fault.statuscode == Fault_None) & [descriptor[10]] == 0b1 then {
        tlbcontext.xs = walkstate.memattrs.xs;
        tlbcontext.nG = walkstate.nG;
        tlbrecord.context = tlbcontext;
        tlbrecord.walkstate = walkstate;
        tlbrecord.blocksize = TranslationSize(walkparams.tgx, walkstate.level);
        tlbrecord.s1descriptor = descriptor;
        if walkstate.contiguous == 0b1 then {
            tlbrecord.contigsize = ContiguousSize(walkparams.tgx, walkstate.level)
        } else {
            tlbrecord.contigsize = 0
        };
        S1TLBCache(tlbrecord)
    };
    return((fault, walkaddress, walkstate, descriptor))
}

val AArch64_VAIsOutOfRange : (bits(64), AccType, Regime, S1TTWParams) -> bool

function AArch64_VAIsOutOfRange (va, acctype, regime, walkparams) = {
    let 'addrtop = AArch64_AddrTop(walkparams.tbid, acctype, walkparams.tbi);
    let 'iasize = AArch64_IASize(walkparams.txsz);
    if HasUnprivileged(regime) then {
        if AArch64_GetVARange(va) == VARange_LOWER then {
            return(not_bool(is_zero_subrange(va, addrtop, iasize)))
        } else {
            return(not_bool(is_ones_subrange(va, addrtop, iasize)))
        }
    } else {
        return(not_bool(is_zero_subrange(va, addrtop, iasize)))
    }
}

val IsDataAccess : AccType -> bool

function IsDataAccess acctype = {
    return(not_bool(acctype == AccType_IFETCH | acctype == AccType_TTW | acctype == AccType_DC | acctype == AccType_IC | acctype == AccType_AT | acctype == AccType_ATPAN))
}

val AArch64_S1Translate : forall ('aligned_in : Bool) ('ispriv : Bool) ('iswrite_in : Bool).
  (FaultRecord, Regime, SecurityState, bits(64), AccType, bool('aligned_in), bool('iswrite_in), bool('ispriv)) -> (FaultRecord, AddressDescriptor)

function AArch64_S1Translate (fault_in, regime, ss, va, acctype, aligned_in, iswrite_in, ispriv) = {
    s1aarch64 : bool = undefined;
    s2fs1walk : bool = undefined;
    tlbentry : TLBLine = undefined;
    fault : FaultRecord = fault_in;
    aligned : bool = aligned_in;
    iswrite : bool = iswrite_in;
    fault.secondstage = false;
    fault.s2fs1walk = false;
    if not_bool(AArch64_S1Enabled(regime)) then {
        return(AArch64_S1DisabledOutput(fault, regime, ss, va, acctype, aligned))
    };
    let walkparams : S1TTWParams = AArch64_GetS1TTWParams(regime, va);
    if (((AArch64_S1InvalidTxSZ(walkparams) | not_bool(ispriv) & walkparams.e0pd == 0b1) | ((not_bool(ispriv) & walkparams.nfd == 0b1) & IsDataAccess(acctype)) & TSTATE.depth > 0) | (not_bool(ispriv) & walkparams.nfd == 0b1) & acctype == AccType_NONFAULT) | AArch64_VAIsOutOfRange(va, acctype, regime, walkparams) then {
        fault.statuscode = Fault_Translation;
        fault.level = 0;
        return((fault, __UNKNOWN_AddressDescriptor()))
    };
    descaddress : AddressDescriptor = undefined;
    walkstate : TTWState = undefined;
    descriptor : bits(64) = undefined;
    new_desc : bits(64) = undefined;
    mem_desc : bits(64) = undefined;
    repeat {
        (fault, descaddress, walkstate, descriptor) = AArch64_S1Walk(fault, walkparams, va, regime, ss, acctype, iswrite, ispriv);
        if fault.statuscode != Fault_None then {
            return((fault, __UNKNOWN_AddressDescriptor()))
        };
        if acctype == AccType_IFETCH then {
            SetInGuardedPage(walkstate.guardedpage == 0b1)
        };
        if AArch64_S1HasAlignmentFault(acctype, aligned, walkparams.ntlsmd, walkstate.memattrs) then {
            fault.statuscode = Fault_Alignment
        } else if IsAtomicRW(acctype) then {
            if AArch64_S1HasPermissionsFault(regime, ss, walkstate, walkparams, ispriv, acctype, false) then {
                fault.statuscode = Fault_Permission;
                fault.write = false
            } else if AArch64_S1HasPermissionsFault(regime, ss, walkstate, walkparams, ispriv, acctype, true) then {
                fault.statuscode = Fault_Permission;
                fault.write = true
            } else ()
        } else if AArch64_S1HasPermissionsFault(regime, ss, walkstate, walkparams, ispriv, acctype, iswrite) then {
            fault.statuscode = Fault_Permission
        } else ();
        new_desc = descriptor;
        if walkparams.ha == 0b1 & AArch64_FaultAllowsSetAccessFlag(fault) then {
            new_desc[10] = Bit(0b1)
        };
        if ((((fault.statuscode == Fault_None & walkparams.ha == 0b1) & walkparams.hd == 0b1) & [descriptor[51]] == 0b1) & (IsAtomicRW(acctype) | iswrite)) & not_bool(acctype == AccType_AT | acctype == AccType_ATPAN | acctype == AccType_IC | acctype == AccType_DC) then {
            new_desc[7] = Bit(0b0)
        };
        descupdateaddress : AddressDescriptor = undefined;
        s2fault : FaultRecord = undefined;
        if new_desc != descriptor then {
            if regime == Regime_EL10 & EL2Enabled() then {
                s1aarch64 = true;
                s2fs1walk = true;
                aligned = true;
                iswrite = true;
                (s2fault, descupdateaddress) = AArch64_S2Translate(fault, descaddress, s1aarch64, ss, s2fs1walk, AccType_ATOMICRW, aligned, iswrite, ispriv);
                if s2fault.statuscode != Fault_None then {
                    return((s2fault, __UNKNOWN_AddressDescriptor()))
                };
                ()
            } else {
                descupdateaddress = descaddress
            };
            (fault, mem_desc) = AArch64_MemSwapTableDesc(fault, descriptor, new_desc, walkparams.ee, descupdateaddress)
        };
        ()
    } until new_desc == descriptor | mem_desc == new_desc;
    if (__tlb_enabled & new_desc != descriptor) & [mem_desc[10]] == 0b1 then {
        tlbrecord : TLBRecord = undefined;
        if [descriptor[10]] == 0b1 then {
            let tlbentry : TLBLine = S1TLBLookup(descaddress.tlbcontext);
            assert(tlbentry.valid_name);
            tlbrecord = tlbentry.tlbrecord
        } else {
            tlbrecord.context = descaddress.tlbcontext;
            tlbrecord.context.xs = walkstate.memattrs.xs;
            tlbrecord.context.nG = walkstate.nG;
            tlbrecord.walkstate = walkstate;
            tlbrecord.blocksize = TranslationSize(walkparams.tgx, walkstate.level);
            if walkstate.contiguous == 0b1 then {
                tlbrecord.contigsize = ContiguousSize(walkparams.tgx, walkstate.level)
            } else {
                tlbrecord.contigsize = 0
            }
        };
        tlbrecord.s1descriptor = mem_desc;
        S1TLBCache(tlbrecord)
    };
    if fault.statuscode != Fault_None then {
        return((fault, __UNKNOWN_AddressDescriptor()))
    };
    let oa : FullAddress = StageOA(va, walkparams.tgx, walkstate);
    memattrs : MemoryAttributes = undefined;
    if acctype == AccType_IFETCH & (walkstate.memattrs.memtype == MemType_Device | not_bool(AArch64_S1ICacheEnabled(regime))) then {
        memattrs = NormalNCMemAttr();
        memattrs.xs = walkstate.memattrs.xs
    } else if (acctype != AccType_IFETCH & not_bool(AArch64_S1DCacheEnabled(regime))) & walkstate.memattrs.memtype == MemType_Normal then {
        memattrs = NormalNCMemAttr();
        memattrs.xs = walkstate.memattrs.xs;
        if HaveMTE2Ext() & walkstate.memattrs.tagged then {
            memattrs.tagged = ConstrainUnpredictableBool(Unpredictable_S1CTAGGED)
        };
        ()
    } else {
        memattrs = walkstate.memattrs
    };
    if ((regime == Regime_EL10 & EL2Enabled()) & Slice(HCR_EL2, 0, 1) == 0b1) & not_bool(__IMPDEF_boolean("Apply effective shareability at stage 1")) then {
        memattrs.shareability = walkstate.memattrs.shareability
    } else {
        memattrs.shareability = EffectiveShareability(memattrs)
    };
    if acctype == AccType_ATOMICLS64 & memattrs.memtype == MemType_Normal then {
        if memattrs.inner.attrs != MemAttr_NC | memattrs.outer.attrs != MemAttr_NC then {
            fault.statuscode = Fault_Exclusive;
            return((fault, __UNKNOWN_AddressDescriptor()))
        };
        ()
    };
    ipa : AddressDescriptor = CreateAddressDescriptor(va, oa, memattrs);
    ipa.tlbcontext = descaddress.tlbcontext;
    return((fault, ipa))
}

val CreateFaultyAddressDescriptor : (bits(64), FaultRecord) -> AddressDescriptor

function CreateFaultyAddressDescriptor (va, fault) = {
    addrdesc : AddressDescriptor = undefined;
    addrdesc.vaddress = va;
    addrdesc.fault = fault;
    return(addrdesc)
}

val TranslationRegime : (bits(2), AccType) -> Regime

function TranslationRegime (el, acctype) = {
    if el == EL3 then {
        return(if ELUsingAArch32(EL3) then Regime_EL30 else Regime_EL3)
    } else if el == EL2 then {
        return(if ELIsInHost(EL2) then Regime_EL20 else Regime_EL2)
    } else if el == EL1 then {
        if acctype == AccType_NV2REGISTER then {
            assert(EL2Enabled());
            return(if ELIsInHost(EL2) then Regime_EL20 else Regime_EL2)
        } else {
            return(Regime_EL10)
        }
    } else if el == EL0 then {
        if IsSecure() & ELUsingAArch32(EL3) then {
            return(Regime_EL30)
        } else if ELIsInHost(EL0) then {
            return(Regime_EL20)
        } else {
            return(Regime_EL10)
        }
    } else {
        Unreachable();
        return(undefined : Regime)
    }
}

val AArch64_FullTranslate : forall ('aligned : Bool) ('iswrite : Bool).
  (bits(64), AccType, bool('iswrite), bool('aligned)) -> AddressDescriptor

function AArch64_FullTranslate (va, acctype, iswrite, aligned) = {
    s1aarch64 : bool = undefined;
    s2fs1walk : bool = undefined;
    fault : FaultRecord = NoFault();
    fault.acctype = acctype;
    fault.write = iswrite;
    let ispriv : bool = PSTATE.EL != EL0 & not_bool(acctype == AccType_UNPRIV | acctype == AccType_UNPRIVSTREAM);
    let regime : Regime = TranslationRegime(PSTATE.EL, acctype);
    let ss : SecurityState = SecurityStateAtEL(PSTATE.EL);
    ipa : AddressDescriptor = undefined;
    (fault, ipa) = AArch64_S1Translate(fault, regime, ss, va, acctype, aligned, iswrite, ispriv);
    if fault.statuscode != Fault_None then {
        return(CreateFaultyAddressDescriptor(va, fault))
    };
    assert(((ss == SS_Realm) --> EL2Enabled()));
    if regime == Regime_EL10 & EL2Enabled() then {
        let s1aarch64 : bool = true;
        let s2fs1walk : bool = false;
        pa : AddressDescriptor = undefined;
        (fault, pa) = AArch64_S2Translate(fault, ipa, s1aarch64, ss, s2fs1walk, acctype, aligned, iswrite, ispriv);
        if fault.statuscode != Fault_None then {
            return(CreateFaultyAddressDescriptor(va, fault))
        } else {
            return(pa)
        }
    } else {
        return(ipa)
    }
}

val AArch64_TranslateAddress : forall ('aligned : Bool) ('iswrite : Bool) 'size.
  (bits(64), AccType, bool('iswrite), bool('aligned), int('size)) -> AddressDescriptor

function AArch64_TranslateAddress (va, acctype, iswrite, aligned, size) = {
    result : AddressDescriptor = AArch64_FullTranslate(va, acctype, iswrite, aligned);
    if not_bool(IsFault(result)) then {
        result.fault = AArch64_CheckDebug(va, acctype, iswrite, size)
    };
    result.vaddress = ZeroExtend(va);
    return(result)
}

val CheckAllInAlignedQuantity : forall 'alignment 'size.
  (bits(64), int('size), int('alignment)) -> bool

function CheckAllInAlignedQuantity (address, size, alignment) = {
    assert(size <= alignment);
    return(Align(address + size - 1, alignment) == Align(address, alignment))
}

val CheckSingleAccessAttributes : forall ('aligned : Bool) ('ispair : Bool) ('iswrite : Bool) 'size.
  (bits(64), MemoryAttributes, int('size), AccType, bool('iswrite), bool('aligned), bool('ispair)) -> (bool, bool)

function CheckSingleAccessAttributes (address, memattrs, size, acctype, iswrite, aligned, ispair) = {
    secondstage : bool = undefined;
    let isnormalwb : bool = (memattrs.memtype == MemType_Normal & memattrs.inner.attrs == MemAttr_WB) & memattrs.outer.attrs == MemAttr_WB;
    atomic : bool = true;
    splitpair : bool = false;
    if isnormalwb then {
        return((atomic, splitpair))
    };
    let accatomic : bool = acctype == AccType_ATOMIC | acctype == AccType_ATOMICRW | acctype == AccType_ORDEREDATOMIC | acctype == AccType_ORDEREDATOMICRW | acctype == AccType_ATOMICLS64 | acctype == AccType_A32LSMD;
    let ordered : bool = acctype == AccType_ORDERED | acctype == AccType_ORDEREDRW | acctype == AccType_LIMITEDORDERED | acctype == AccType_ORDEREDATOMIC | acctype == AccType_ORDEREDATOMICRW;
    if not_bool(aligned) & (accatomic | ordered) then {
        atomic = ConstrainUnpredictableBool(Unpredictable_MISALIGNEDATOMIC);
        if not_bool(atomic) then {
            let secondstage : bool = false;
            AArch64_Abort(address, AlignmentFault(acctype, iswrite, secondstage))
        } else {
            return((atomic, splitpair))
        }
    };
    if ispair & aligned then {
        atomic = false;
        splitpair = true;
        return((atomic, splitpair))
    };
    if aligned then {
        return((atomic, splitpair))
    };
    let atomic : bool = __IMPDEF_boolean("Misaligned accesses within 16 byte aligned memory but not Normal Cacheable Writeback are Atomic");
    return((atomic, splitpair))
}

val MemHasTransactionalAccess : MemoryAttributes -> bool

function MemHasTransactionalAccess memattrs = {
    if (((((((memattrs.shareability == Shareability_ISH | memattrs.shareability == Shareability_OSH) & memattrs.memtype == MemType_Normal) & memattrs.inner.attrs == MemAttr_WB) & memattrs.inner.hints == MemHint_RWA) & memattrs.inner.transient == false) & memattrs.outer.hints == MemHint_RWA) & memattrs.outer.attrs == MemAttr_WB) & memattrs.outer.transient == false then {
        return(true)
    } else {
        return(__IMPDEF_boolean("Memory Region does not support Transactional access"))
    }
}

val AArch64_MemSingle_read : forall ('aligned : Bool) 'size,
  'size in {1, 2, 4, 8, 16}.
  (bits(64), int('size), AccType, bool('aligned)) -> bits('size * 8)

val AArch64_MemSingle_read__1 : forall ('aligned : Bool) ('ispair : Bool) 'size,
  'size in {1, 2, 4, 8, 16}.
  (bits(64), int('size), AccType, bool('aligned), bool('ispair)) -> bits('size * 8)

function AArch64_MemSingle_read (address, size, acctype, aligned) = {
    let ispair : bool = false;
    return(AArch64_MemSingle_read__1(address, size, acctype, aligned, ispair))
}

function AArch64_MemSingle_read__1 (address, size, acctype, aligned, ispair) = {
    atomic : bool = undefined;
    fault : FaultRecord = undefined;
    splitpair : bool = undefined;
    assert(size == 1 | size == 2 | size == 4 | size == 8 | size == 16);
    let 'halfsize = DIV(size, 2);
    if HaveLSE2Ext() then {
        assert(CheckAllInAlignedQuantity(address, size, 16))
    } else {
        assert(address == Align(address, size))
    };
    value_name : bits('size * 8) = undefined;
    let iswrite : bool = false;
    memaddrdesc : AddressDescriptor = AArch64_TranslateAddress(address, acctype, iswrite, aligned, size);
    if IsFault(memaddrdesc) then {
        AArch64_Abort(address, memaddrdesc.fault)
    };
    accdesc : AccessDescriptor = undefined;
    if HaveTME() then {
        accdesc = CreateAccessDescriptor(acctype);
        accdesc.transactional = TSTATE.depth > 0 & not_bool(acctype == AccType_IFETCH | acctype == AccType_TTW);
        if accdesc.transactional & not_bool(MemHasTransactionalAccess(memaddrdesc.memattrs)) then {
            FailTransaction(TMFailure_IMP, false)
        };
        ()
    } else {
        accdesc = CreateAccessDescriptor(acctype)
    };
    if HaveRME() then {
        fault : FaultRecord = NoFault();
        fault.gpcf = GranuleProtectionCheck(memaddrdesc, accdesc);
        if fault.gpcf.gpf != GPCF_None then {
            fault.statuscode = Fault_GPCFOnOutput;
            fault.paddress = memaddrdesc.paddress;
            fault.acctype = acctype;
            fault.write = false;
            AArch64_Abort(address, fault)
        };
        ()
    };
    let fault = fault;
    if HaveMTE2Ext() then {
        if AArch64_AccessIsTagChecked(ZeroExtend(address, 64), acctype) then {
            let ptag : bits(4) = AArch64_PhysicalTag(ZeroExtend(address, 64));
            if not_bool(AArch64_CheckTag(memaddrdesc, accdesc, ptag, iswrite)) then {
                AArch64_TagCheckFault(ZeroExtend(address, 64), acctype, iswrite)
            };
            ()
        };
        ()
    };
    (atomic, splitpair) = CheckSingleAccessAttributes(address, memaddrdesc.memattrs, size, acctype, iswrite, aligned, ispair);
    memstatus : PhysMemRetStatus = undefined;
    if atomic then {
        (memstatus, value_name) = PhysMemRead(memaddrdesc, size, accdesc);
        if IsFault__2(memstatus) then {
            HandleExternalReadAbort(memstatus, memaddrdesc, size, accdesc)
        };
        ()
    } else if splitpair then {
        assert(ispair);
        assert(size > 1);
        lowhalf : bits('halfsize * 8) = undefined;
        highhalf : bits('halfsize * 8) = undefined;
        (memstatus, lowhalf) = PhysMemRead(memaddrdesc, halfsize, accdesc);
        if IsFault__2(memstatus) then {
            HandleExternalReadAbort(memstatus, memaddrdesc, halfsize, accdesc)
        };
        memaddrdesc.paddress.address = memaddrdesc.paddress.address + halfsize;
        (memstatus, highhalf) = PhysMemRead(memaddrdesc, halfsize, accdesc);
        if IsFault__2(memstatus) then {
            HandleExternalReadAbort(memstatus, memaddrdesc, halfsize, accdesc)
        };
        value_name = highhalf @ lowhalf
    } else {
        foreach (i from 0 to (size - 1) by 1 in inc) {
            (memstatus, value_name[8 * i + 7 .. 8 * i]) = PhysMemRead(memaddrdesc, 1, accdesc);
            if IsFault__2(memstatus) then {
                HandleExternalReadAbort(memstatus, memaddrdesc, 1, accdesc)
            };
            memaddrdesc.paddress.address = memaddrdesc.paddress.address + 1
        }
    };
    return(value_name)
}

val BigEndian : AccType -> bool

function BigEndian acctype = {
    bigend : bool = undefined;
    if HaveNV2Ext() & acctype == AccType_NV2REGISTER then {
        return(Slice(SCTLR_EL2, 25, 1) == 0b1)
    };
    if UsingAArch32() then {
        bigend = PSTATE.E != 0b0
    } else if PSTATE.EL == EL0 then {
        bigend = [SCTLR_read__1()[24]] != 0b0
    } else {
        bigend = [SCTLR_read__1()[25]] != 0b0
    };
    return(bigend)
}

val Mem_read : forall 'size, 'size in {1, 2, 4, 8, 16}.
  (bits(64), int('size), AccType) -> bits('size * 8)

val Mem_read__1 : forall ('ispair : Bool) 'size,
  'size in {1, 2, 4, 8, 16}.
  (bits(64), int('size), AccType, bool('ispair)) -> bits('size * 8)

function Mem_read (address, size, acctype) = {
    let ispair : bool = false;
    return(Mem_read__1(address, size, acctype, ispair))
}

function Mem_read__1 (address, size, acctype, ispair) = {
    c : Constraint = undefined;
    single_is_aligned : bool = undefined;
    single_is_pair : bool = undefined;
    assert(size == 1 | size == 2 | size == 4 | size == 8 | size == 16);
    let 'halfsize = DIV(size, 2);
    value_name : bits('size * 8) = undefined;
    let iswrite : bool = false;
    aligned : bool = undefined;
    if ispair then {
        aligned = AArch64_CheckAlignment(address, halfsize, acctype, iswrite)
    } else {
        aligned = AArch64_CheckAlignment(address, size, acctype, iswrite)
    };
    atomic : bool = undefined;
    if size != 16 | not_bool(acctype == AccType_VEC | acctype == AccType_VECSTREAM) then {
        if not_bool(HaveLSE2Ext()) then {
            atomic = aligned
        } else {
            atomic = CheckAllInAlignedQuantity(address, size, 16)
        }
    } else if acctype == AccType_VEC | acctype == AccType_VECSTREAM then {
        atomic = address == Align(address, 8)
    } else {
        atomic = address == Align(address, 16)
    };
    if (not_bool(atomic) & ispair) & address == Align(address, halfsize) then {
        let single_is_pair : bool = false;
        let single_is_aligned : bool = true;
        assert(constraint('halfsize in {1, 2, 4, 8, 16}));
        let lowhalf : bits('halfsize * 8) = AArch64_MemSingle_read__1(address, halfsize, acctype, single_is_aligned, single_is_pair);
        let highhalf : bits('halfsize * 8) = AArch64_MemSingle_read__1(address + halfsize, halfsize, acctype, single_is_aligned, single_is_pair);
        value_name = highhalf @ lowhalf
    } else if atomic & ispair then {
        value_name = AArch64_MemSingle_read__1(address, size, acctype, aligned, ispair)
    } else if not_bool(atomic) then {
        assert(size > 1);
        value_name[7 .. 0] = AArch64_MemSingle_read(address, 1, acctype, aligned);
        if not_bool(aligned) then {
            let c : Constraint = ConstrainUnpredictable(Unpredictable_DEVPAGE2);
            assert(c == Constraint_FAULT | c == Constraint_NONE);
            if c == Constraint_NONE then {
                aligned = true
            };
            ()
        };
        foreach (i from 1 to (size - 1) by 1 in inc) {
            value_name[8 * i + 7 .. 8 * i] = AArch64_MemSingle_read(address + i, 1, acctype, aligned)
        }
