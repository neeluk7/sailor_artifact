val AddPACGA : (bits(64), bits(64)) -> bits(64)

function AddPACGA (X, Y) = {
    TrapEL2 : bool = undefined;
    TrapEL3 : bool = undefined;
    let APGAKey_EL1 : bits(128) = APGAKeyHi_EL1[63 .. 0] @ APGAKeyLo_EL1[63 .. 0];
    match PSTATE.EL {
      ? if ? == EL0 => {
          TrapEL2 = (EL2Enabled() & Slice(HCR_EL2, 41, 1) == 0b0) & (Slice(HCR_EL2, 27, 1) == 0b0 | Slice(HCR_EL2, 34, 1) == 0b0);
          TrapEL3 = HaveEL(EL3) & Slice(SCR_EL3, 17, 1) == 0b0
      },
      ? if ? == EL1 => {
          TrapEL2 = EL2Enabled() & Slice(HCR_EL2, 41, 1) == 0b0;
          TrapEL3 = HaveEL(EL3) & Slice(SCR_EL3, 17, 1) == 0b0
      },
      ? if ? == EL2 => {
          TrapEL2 = false;
          TrapEL3 = HaveEL(EL3) & Slice(SCR_EL3, 17, 1) == 0b0
      },
      ? if ? == EL3 => {
          TrapEL2 = false;
          TrapEL3 = false
      },
      _ => ()
    };
    if TrapEL2 then {
        TrapPACUse(EL2);
        return(undefined : bits(64))
    } else if TrapEL3 then {
        TrapPACUse(EL3);
        return(undefined : bits(64))
    } else {
        return(ComputePAC(X, Y, APGAKey_EL1[127 .. 64], APGAKey_EL1[63 .. 0])[63 .. 32] @ Zeros(32))
    }
}

val AuthIA : forall ('is_combined : Bool).
  (bits(64), bits(64), bool('is_combined)) -> bits(64)

function AuthIA (X, Y, is_combined) = {
    TrapEL2 : bool = undefined;
    TrapEL3 : bool = undefined;
    Enable : bits(1) = undefined;
    let APIAKey_EL1 : bits(128) = APIAKeyHi_EL1[63 .. 0] @ APIAKeyLo_EL1[63 .. 0];
    match PSTATE.EL {
      ? if ? == EL0 => {
          let IsEL1Regime : bool = S1TranslationRegime__1() == EL1;
          Enable = if IsEL1Regime then Slice(SCTLR_EL1, 31, 1) else
            Slice(SCTLR_EL2, 31, 1);
          TrapEL2 = (EL2Enabled() & Slice(HCR_EL2, 41, 1) == 0b0) & (Slice(HCR_EL2, 27, 1) == 0b0 | Slice(HCR_EL2, 34, 1) == 0b0);
          TrapEL3 = HaveEL(EL3) & Slice(SCR_EL3, 17, 1) == 0b0
      },
      ? if ? == EL1 => {
          Enable = Slice(SCTLR_EL1, 31, 1);
          TrapEL2 = EL2Enabled() & Slice(HCR_EL2, 41, 1) == 0b0;
          TrapEL3 = HaveEL(EL3) & Slice(SCR_EL3, 17, 1) == 0b0
      },
      ? if ? == EL2 => {
          Enable = Slice(SCTLR_EL2, 31, 1);
          TrapEL2 = false;
          TrapEL3 = HaveEL(EL3) & Slice(SCR_EL3, 17, 1) == 0b0
      },
      ? if ? == EL3 => {
          Enable = Slice(SCTLR_EL3, 31, 1);
          TrapEL2 = false;
          TrapEL3 = false
      },
      _ => ()
    };
    if Enable == 0b0 then {
        return(X)
    } else if TrapEL2 then {
        TrapPACUse(EL2);
        return(undefined : bits(64))
    } else if TrapEL3 then {
        TrapPACUse(EL3);
        return(undefined : bits(64))
    } else {
        return(Auth(X, Y, APIAKey_EL1, false, 0b0, is_combined))
    }
}

