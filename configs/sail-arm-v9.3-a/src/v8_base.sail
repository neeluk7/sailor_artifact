      },
      ? if ? == EL3 => {
          Enable = Slice(SCTLR_EL3, 30, 1);
          TrapEL2 = false;
          TrapEL3 = false
      },
      _ => ()
    };
    if Enable == 0b0 then {
        return(X)
    } else if TrapEL2 then {
