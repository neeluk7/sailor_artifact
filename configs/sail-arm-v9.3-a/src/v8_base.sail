register __unpred_tsize_aborts : bool = true

val ConstrainUnpredictable : Unpredictable -> Constraint

function ConstrainUnpredictable which = {
    match which {
      Unpredictable_VMSR => {
          return(Constraint_UNDEF)
      },
      Unpredictable_WBOVERLAPLD => {
          return(Constraint_WBSUPPRESS)
      },
      Unpredictable_WBOVERLAPST => {
          return(Constraint_NONE)
      },
      Unpredictable_LDPOVERLAP => {
          return(Constraint_UNDEF)
      },
      Unpredictable_BASEOVERLAP => {
          return(Constraint_UNKNOWN)
      },
      Unpredictable_DATAOVERLAP => {
          return(Constraint_UNKNOWN)
      },
      Unpredictable_DEVPAGE2 => {
          return(Constraint_FAULT)
      },
      Unpredictable_DEVICETAGSTORE => {
          return(Constraint_NONE)
      },
      Unpredictable_INSTRDEVICE => {
          return(Constraint_NONE)
      },
      Unpredictable_RESCPACR => {
          return(Constraint_TRUE)
      },
      Unpredictable_RESMAIR => {
          return(Constraint_UNKNOWN)
      },
      Unpredictable_S1CTAGGED => {
          return(Constraint_FALSE)
      },
      Unpredictable_S2RESMEMATTR => {
          return(Constraint_NC)
      },
      Unpredictable_RESTEXCB => {
          return(Constraint_UNKNOWN)
      },
      Unpredictable_RESDACR => {
          return(Constraint_UNKNOWN)
      },
      Unpredictable_RESPRRR => {
          return(Constraint_UNKNOWN)
      },
      Unpredictable_RESVTCRS => {
          return(Constraint_UNKNOWN)
      },
      Unpredictable_RESTnSZ => {
          return(Constraint_FORCE)
      },
      Unpredictable_OORTnSZ => {
          return(Constraint_FORCE)
      },
      Unpredictable_LARGEIPA => {
          if __unpred_tsize_aborts then {
              return(Constraint_FAULT)
          } else {
              return(Constraint_FORCE)
          }
      },
      Unpredictable_ESRCONDPASS => {
          return(Constraint_FALSE)
      },
      Unpredictable_ILZEROIT => {
          return(Constraint_FALSE)
      },
      Unpredictable_ILZEROT => {
          return(Constraint_FALSE)
      },
      Unpredictable_BPVECTORCATCHPRI => {
          return(Constraint_TRUE)
      },
      Unpredictable_VCMATCHHALF => {
          return(Constraint_FALSE)
      },
      Unpredictable_VCMATCHDAPA => {
          return(Constraint_FALSE)
      },
      Unpredictable_WPMASKANDBAS => {
          return(Constraint_FALSE)
      },
      Unpredictable_WPBASCONTIGUOUS => {
          return(Constraint_FALSE)
      },
      Unpredictable_RESWPMASK => {
          return(Constraint_DISABLED)
      },
      Unpredictable_WPMASKEDBITS => {
          return(Constraint_FALSE)
      },
      Unpredictable_RESBPWPCTRL => {
          return(Constraint_DISABLED)
      },
      Unpredictable_BPNOTIMPL => {
          return(Constraint_DISABLED)
      },
      Unpredictable_RESBPTYPE => {
          return(Constraint_DISABLED)
      },
      Unpredictable_BPNOTCTXCMP => {
          return(Constraint_DISABLED)
      },
      Unpredictable_BPMATCHHALF => {
          return(Constraint_FALSE)
      },
      Unpredictable_BPMISMATCHHALF => {
          return(Constraint_FALSE)
      },
      Unpredictable_RESTARTALIGNPC => {
          return(Constraint_FALSE)
      },
      Unpredictable_RESTARTZEROUPPERPC => {
          return(Constraint_TRUE)
      },
      Unpredictable_ZEROUPPER => {
          return(Constraint_TRUE)
      },
      Unpredictable_ERETZEROUPPERPC => {
          return(Constraint_TRUE)
      },
      Unpredictable_A32FORCEALIGNPC => {
          return(Constraint_FALSE)
      },
      Unpredictable_SMD => {
          return(Constraint_UNDEF)
      },
      Unpredictable_NONFAULT => {
          return(Constraint_FALSE)
      },
      Unpredictable_SVEZEROUPPER => {
          return(Constraint_TRUE)
      },
      Unpredictable_SVELDNFDATA => {
          return(Constraint_TRUE)
      },
      Unpredictable_SVELDNFZERO => {
          return(Constraint_TRUE)
      },
      Unpredictable_CHECKSPNONEACTIVE => {
          return(Constraint_TRUE)
      },
      Unpredictable_SMEZEROUPPER => {
          return(Constraint_TRUE)
      },
      Unpredictable_NVNV1 => {
          return(Constraint_NVNV1_00)
      },
      Unpredictable_Shareability => {
          return(Constraint_OSH)
      },
      Unpredictable_AFUPDATE => {
          return(Constraint_TRUE)
      },
      Unpredictable_IESBinDebug => {
          return(Constraint_TRUE)
      },
      Unpredictable_BADPMSFCR => {
          return(Constraint_TRUE)
      },
      Unpredictable_ZEROBTYPE => {
          return(Constraint_TRUE)
      },
      Unpredictable_CLEARERRITEZERO => {
          return(Constraint_FALSE)
      },
      Unpredictable_ALUEXCEPTIONRETURN => {
          return(Constraint_UNDEF)
      },
      Unpredictable_DBGxVR_RESS => {
          return(Constraint_FALSE)
      },
      Unpredictable_PMSCR_PCT => {
          return(Constraint_PMSCR_PCT_VIRT)
      },
      Unpredictable_WFxTDEBUG => {
          return(Constraint_FALSE)
      },
      Unpredictable_LS64UNSUPPORTED => {
          return(Constraint_LIMITED_ATOMICITY)
      },
      Unpredictable_MISALIGNEDATOMIC => {
          return(Constraint_FALSE)
      },
      Unpredictable_IGNORETRAPINDEBUG => {
          return(Constraint_TRUE)
      },
      Unpredictable_PMUEVENTCOUNTER => {
          return(Constraint_UNDEF)
      },
      Unpredictable_BRBFILTRATE => {
          return(Constraint_FALSE)
      },
      _ => {
          return(undefined : Constraint)
      }
    }
}

val ConstrainUnpredictableBool : Unpredictable -> bool

function ConstrainUnpredictableBool which = {
    let c : Constraint = ConstrainUnpredictable(which);
    assert(c == Constraint_TRUE | c == Constraint_FALSE);
    return(c == Constraint_TRUE)
}

val ConditionSyndrome : unit -> bits(5)

function ConditionSyndrome () = {
    cond : bits(4) = undefined;
    syndrome : bits(5) = undefined;
    if UsingAArch32() then {
        let cond : bits(4) = AArch32_CurrentCond();
        if PSTATE.T == 0b0 then {
            syndrome[4] = Bit(0b1);
            if ConditionHolds(cond) & ConstrainUnpredictableBool(Unpredictable_ESRCONDPASS) then {
                syndrome[3 .. 0] = 0b1110
            } else {
                syndrome[3 .. 0] = cond
            }
        } else {
            if __IMPDEF_boolean("Condition valid for trapped T32") then {
                syndrome[4] = Bit(0b1);
                syndrome[3 .. 0] = cond
            } else {
                syndrome[4] = Bit(0b0);
                syndrome[3 .. 0] = __UNKNOWN_bits(4)
            }
        }
    } else {
        syndrome[4] = Bit(0b1);
        syndrome[3 .. 0] = 0b1110
    };
    return(syndrome)
}

enum Exception = {
  Exception_Uncategorized,
  Exception_WFxTrap,
  Exception_CP15RTTrap,
  Exception_CP15RRTTrap,
  Exception_CP14RTTrap,
  Exception_CP14DTTrap,
  Exception_CP14RRTTrap,
  Exception_AdvSIMDFPAccessTrap,
  Exception_FPIDTrap,
  Exception_LDST64BTrap,
  Exception_PACTrap,
  Exception_IllegalState,
  Exception_SupervisorCall,
  Exception_HypervisorCall,
  Exception_MonitorCall,
  Exception_SystemRegisterTrap,
  Exception_ERetTrap,
  Exception_InstructionAbort,
  Exception_PCAlignment,
  Exception_DataAbort,
  Exception_NV2DataAbort,
  Exception_PACFail,
  Exception_SPAlignment,
  Exception_FPTrappedException,
  Exception_SError,
  Exception_Breakpoint,
  Exception_SoftwareStep,
  Exception_Watchpoint,
  Exception_NV2Watchpoint,
  Exception_SoftwareBreakpoint,
  Exception_VectorCatch,
  Exception_IRQ,
  Exception_SVEAccessTrap,
  Exception_SMEAccessTrap,
  Exception_TSTARTAccessTrap,
  Exception_GPC,
  Exception_BranchTarget,
  Exception_MemCpyMemSet,
  Exception_FIQ
}

enum PASpace = {PAS_NonSecure, PAS_Secure, PAS_Root, PAS_Realm}

val __UNKNOWN_PASpace : unit -> PASpace

function __UNKNOWN_PASpace () = undefined

struct FullAddress = {paspace : PASpace, address : bits(52)}

val __UNKNOWN_FullAddress : unit -> FullAddress

function __UNKNOWN_FullAddress () = undefined

struct ExceptionRecord = {
  exceptype : Exception,
  syndrome : bits(25),
  syndrome2 : bits(5),
  paddress : FullAddress,
  vaddress : bits(64),
  ipavalid : bool,
  NS : bits(1),
  ipaddress : bits(52),
  trappedsyscallinst : bool
}

val ExceptionSyndrome : Exception -> ExceptionRecord

function ExceptionSyndrome exceptype = {
    r : ExceptionRecord = undefined;
    r.exceptype = exceptype;
    r.syndrome = Zeros();
    r.syndrome2 = Zeros();
    r.vaddress = Zeros();
    r.ipavalid = false;
    r.NS = 0b0;
    r.ipaddress = Zeros();
    r.paddress.paspace = __UNKNOWN_PASpace();
    r.paddress.address = __UNKNOWN_bits(52);
    r.trappedsyscallinst = false;
    return(r)
}

val ThisInstr : unit -> bits(32)

val Unreachable : unit -> unit

function Unreachable () = {
    assert(false)
}

val AArch64_SystemAccessTrapSyndrome : forall 'ec.
  (bits(32), int('ec)) -> ExceptionRecord

function AArch64_SystemAccessTrapSyndrome (instr_in, ec) = {
    exception : ExceptionRecord = undefined;
    instr : bits(32) = instr_in;
    match ec {
      0 => {
          exception = ExceptionSyndrome(Exception_Uncategorized)
      },
      7 => {
          exception = ExceptionSyndrome(Exception_AdvSIMDFPAccessTrap);
          exception.syndrome[24 .. 20] = ConditionSyndrome()
      },
      24 => {
          exception = ExceptionSyndrome(Exception_SystemRegisterTrap);
          let instr : bits(32) = ThisInstr();
          exception.syndrome[21 .. 20] = instr[20 .. 19];
          exception.syndrome[19 .. 17] = instr[7 .. 5];
          exception.syndrome[16 .. 14] = instr[18 .. 16];
          exception.syndrome[13 .. 10] = instr[15 .. 12];
          exception.syndrome[9 .. 5] = instr[4 .. 0];
          exception.syndrome[4 .. 1] = instr[11 .. 8];
          exception.syndrome[0 .. 0] = [instr[21]]
      },
      25 => {
          exception = ExceptionSyndrome(Exception_SVEAccessTrap)
      },
      29 => {
          exception = ExceptionSyndrome(Exception_SMEAccessTrap)
      },
      _ => {
          Unreachable()
      }
    };
    return(exception)
}

register _R : vector(31, inc, bits(64))

val AArch64_MaybeZeroRegisterUppers : unit -> unit

function AArch64_MaybeZeroRegisterUppers () = {
    assert(UsingAArch32());
    first : {'first, 'first == 0. int('first)} = 0;
    last : {|14, 30|} = 14;
    include_R15_name : bool = undefined;
    if PSTATE.EL == EL0 & not_bool(ELUsingAArch32(EL1)) then {
        first = 0;
        last = 14;
        include_R15_name = false
    } else if ((PSTATE.EL == EL0 | PSTATE.EL == EL1) & EL2Enabled()) & not_bool(ELUsingAArch32(EL2)) then {
        first = 0;
        last = 30;
        include_R15_name = false
    } else {
        first = 0;
        last = 30;
        include_R15_name = true
    };
    let 'last = last;
    let 'first = first;
    foreach (n from first to last by 1 in inc) {
        if (n != 15 | include_R15_name) & ConstrainUnpredictableBool(Unpredictable_ZEROUPPER) then {
            _R[n][63 .. 32] = Zeros()
        };
        ()
    };
    return()
}

val ThisInstrLength : unit -> int

val AArch64_ExceptionClass : (Exception, bits(2)) -> (int, bits(1))

function AArch64_ExceptionClass (exceptype, target_el) = {
    il_is_valid : bool = true;
    let from_32 : bool = UsingAArch32();
    ec : int = undefined;
    match exceptype {
      Exception_Uncategorized => {
          ec = UInt(0x00);
          il_is_valid = false
      },
      Exception_WFxTrap => {
          ec = UInt(0x01)
      },
      Exception_CP15RTTrap => {
          ec = UInt(0x03);
          assert(from_32)
      },
      Exception_CP15RRTTrap => {
          ec = UInt(0x04);
          assert(from_32)
      },
      Exception_CP14RTTrap => {
          ec = UInt(0x05);
          assert(from_32)
      },
      Exception_CP14DTTrap => {
          ec = UInt(0x06);
          assert(from_32)
      },
      Exception_AdvSIMDFPAccessTrap => {
          ec = UInt(0x07)
      },
      Exception_FPIDTrap => {
          ec = UInt(0x08)
      },
      Exception_PACTrap => {
          ec = UInt(0x09)
      },
      Exception_LDST64BTrap => {
          ec = UInt(0x0A)
      },
      Exception_TSTARTAccessTrap => {
          ec = UInt(0x1B)
      },
      Exception_GPC => {
          ec = UInt(0x1E)
      },
      Exception_CP14RRTTrap => {
          ec = UInt(0x0C);
          assert(from_32)
      },
      Exception_BranchTarget => {
          ec = UInt(0x0D)
      },
      Exception_IllegalState => {
          ec = UInt(0x0E);
          il_is_valid = false
      },
      Exception_SupervisorCall => {
          ec = UInt(0x11)
      },
      Exception_HypervisorCall => {
          ec = UInt(0x12)
      },
      Exception_MonitorCall => {
          ec = UInt(0x13)
      },
      Exception_SystemRegisterTrap => {
          ec = UInt(0x18);
          assert(not_bool(from_32))
      },
      Exception_SVEAccessTrap => {
          ec = UInt(0x19);
          assert(not_bool(from_32))
      },
      Exception_ERetTrap => {
          ec = UInt(0x1A);
          assert(not_bool(from_32))
      },
      Exception_PACFail => {
          ec = UInt(0x1C);
          assert(not_bool(from_32))
      },
      Exception_SMEAccessTrap => {
          ec = UInt(0x1D);
          assert(not_bool(from_32))
      },
      Exception_InstructionAbort => {
          ec = UInt(0x20);
          il_is_valid = false
      },
      Exception_PCAlignment => {
          ec = UInt(0x22);
          il_is_valid = false
      },
      Exception_DataAbort => {
          ec = UInt(0x24)
      },
      Exception_NV2DataAbort => {
          ec = UInt(0x25)
      },
      Exception_SPAlignment => {
          ec = UInt(0x26);
          il_is_valid = false;
          assert(not_bool(from_32))
      },
      Exception_MemCpyMemSet => {
          ec = UInt(0x27)
      },
      Exception_FPTrappedException => {
          ec = UInt(0x28)
      },
      Exception_SError => {
          ec = UInt(0x2F);
          il_is_valid = false
      },
      Exception_Breakpoint => {
          ec = UInt(0x30);
          il_is_valid = false
      },
      Exception_SoftwareStep => {
          ec = UInt(0x32);
          il_is_valid = false
      },
      Exception_Watchpoint => {
          ec = UInt(0x34);
          il_is_valid = false
      },
      Exception_NV2Watchpoint => {
          ec = UInt(0x35);
          il_is_valid = false
      },
      Exception_SoftwareBreakpoint => {
          ec = UInt(0x38)
      },
      Exception_VectorCatch => {
          ec = UInt(0x3A);
          il_is_valid = false;
          assert(from_32)
      },
      _ => {
          Unreachable()
      }
    };
    if (ec == UInt(0x20) | ec == UInt(0x24) | ec == UInt(0x30) | ec == UInt(0x32) | ec == UInt(0x34)) & target_el == PSTATE.EL then {
        ec = ec + 1
    };
    if (ec == UInt(0x11) | ec == UInt(0x12) | ec == UInt(0x13) | ec == UInt(0x28) | ec == UInt(0x38)) & not_bool(from_32) then {
        ec = ec + 4
    };
    let 'ec = ec;
    il : bits(1) = undefined;
    if il_is_valid then {
        il = if ThisInstrLength() == 32 then 0b1 else 0b0
    } else {
        il = 0b1
    };
    assert(from_32 | il == 0b1);
    return((ec, il))
}

val AArch64_PAMax : unit -> {|32, 36, 40, 42, 44, 48, 52|}

function AArch64_PAMax () = {
    let 'pamax = __IMPDEF_integer("Maximum Physical Address Size");
    assert(pamax == 32 | pamax == 36 | pamax == 40 | pamax == 42 | pamax == 44 | pamax == 48 | pamax == 52);
    return(pamax)
}

register ESR_EL1 : bits(64)

register ESR_EL2 : bits(64)

register ESR_EL3 : bits(64)

val ELIsInHost : bits(2) -> bool

function ELIsInHost el = {
    if not_bool(HaveVirtHostExt()) | ELUsingAArch32(EL2) then {
        return(false)
    };
    match el {
      ? if ? == EL3 => {
          return(false)
      },
      ? if ? == EL2 => {
          return(EL2Enabled() & Slice(HCR_EL2, 34, 1) == 0b1)
      },
      ? if ? == EL1 => {
          return(false)
      },
      ? if ? == EL0 => {
          return(EL2Enabled() & (Slice(HCR_EL2, 34, 1) @ Slice(HCR_EL2, 27, 1)) == 0b11)
      },
      _ => {
          Unreachable();
          return(undefined : bool)
      }
    }
}

val S1TranslationRegime : bits(2) -> bits(2)

val S1TranslationRegime__1 : unit -> bits(2)

function S1TranslationRegime el = {
    if el != EL0 then {
        return(el)
    } else if (HaveEL(EL3) & ELUsingAArch32(EL3)) & Slice(SCR, 0, 1) == 0b0 then {
        return(EL3)
    } else if HaveVirtHostExt() & ELIsInHost(el) then {
        return(EL2)
    } else {
        return(EL1)
    }
}

function S1TranslationRegime__1 () = {
    return(S1TranslationRegime(PSTATE.EL))
}

val ESR_set : (bits(2), bits(64)) -> unit

val ESR_set__1 : bits(64) -> unit

function ESR_set (regime, value_name) = {
    let r : bits(64) = value_name;
    match regime {
      ? if ? == EL1 => {
          ESR_EL1 = r
      },
      ? if ? == EL2 => {
          ESR_EL2 = r
      },
      ? if ? == EL3 => {
          ESR_EL3 = r
      },
      _ => {
          Unreachable()
      }
    };
    return()
}

function ESR_set__1 value_name = {
    ESR_set(S1TranslationRegime__1()) = value_name
}

register FAR_EL1 : bits(64)

register FAR_EL2 : bits(64)

register FAR_EL3 : bits(64)

val FAR_set : (bits(2), bits(64)) -> unit

function FAR_set (regime, value_name) = {
    let r : bits(64) = value_name;
    match regime {
      ? if ? == EL1 => {
          FAR_EL1 = r
      },
      ? if ? == EL2 => {
          FAR_EL2 = r
      },
      ? if ? == EL3 => {
          FAR_EL3 = r
      },
      _ => {
          Unreachable()
      }
    };
    return()
}

register HPFAR_EL2 : bits(64)

register MFAR_EL3 : bits(64)

val AArch64_ReportException : (ExceptionRecord, bits(2)) -> unit

function AArch64_ReportException (exception, target_el) = {
    ec : int = undefined;
    il : bits(1) = undefined;
    let exceptype : Exception = exception.exceptype;
    (ec, il) = AArch64_ExceptionClass(exceptype, target_el);
    let 'ec = ec;
    let iss : bits(25) = exception.syndrome;
    let iss2 : bits(5) = exception.syndrome2;
    if (ec == UInt(0x24) | ec == UInt(0x25)) & [iss[24]] == 0b0 then {
        il = 0b1
    };
    let il = il;
    ESR_set(target_el) = (((Zeros(27) @ iss2) @ ec[5 .. 0]) @ il) @ iss;
    if exceptype == Exception_InstructionAbort | exceptype == Exception_PCAlignment | exceptype == Exception_DataAbort | exceptype == Exception_NV2DataAbort | exceptype == Exception_NV2Watchpoint | exceptype == Exception_GPC | exceptype == Exception_Watchpoint then {
        FAR_set(target_el) = exception.vaddress
    } else {
        FAR_set(target_el) = __UNKNOWN_bits(64)
    };
    if exception.ipavalid then {
        HPFAR_EL2[43 .. 4] = exception.ipaddress[51 .. 12];
        if IsSecureEL2Enabled() & IsSecure() then {
            HPFAR_EL2 = SetSlice(1, HPFAR_EL2, 63, exception.NS)
        } else {
            HPFAR_EL2 = SetSlice(1, HPFAR_EL2, 63, 0b0)
        }
    } else if target_el == EL2 then {
        HPFAR_EL2[43 .. 4] = __UNKNOWN_bits(40)
    } else ();
    if exception.exceptype == Exception_GPC then {
        (MFAR_EL3[51 .. 48] @ MFAR_EL3[47 .. 12]) = ZeroExtend(exception.paddress.address[AArch64_PAMax() - 1 .. 12]);
        match exception.paddress.paspace {
          PAS_Secure => {
              (MFAR_EL3[62 .. 62] @ MFAR_EL3[63 .. 63]) = 0b00
          },
          PAS_NonSecure => {
              (MFAR_EL3[62 .. 62] @ MFAR_EL3[63 .. 63]) = 0b01
          },
          PAS_Root => {
              (MFAR_EL3[62 .. 62] @ MFAR_EL3[63 .. 63]) = 0b10
          },
          PAS_Realm => {
              (MFAR_EL3[62 .. 62] @ MFAR_EL3[63 .. 63]) = 0b11
          }
        }
    };
    return()
}

enum ExceptionalOccurrenceTargetState = {
  AArch32_NonDebugState,
  AArch64_NonDebugState,
  DebugState
}

register BRBCR_EL1 : bits(64)

register BRBCR_EL2 : bits(64)

register BRBFCR_EL1 : bits(64)

val BRBCycleCountingEnabled : unit -> bool

function BRBCycleCountingEnabled () = {
    if EL2Enabled() & Slice(BRBCR_EL2, 3, 1) == 0b0 then {
        return(false)
    };
    if Slice(BRBCR_EL1, 3, 1) == 0b0 then {
        return(false)
    };
    return(true)
}

register __last_cycle_count : int

val BranchRawCycleCount : unit -> int

function BranchRawCycleCount () = {
    let 'diff = __cycle_count - __last_cycle_count;
    __last_cycle_count = __cycle_count;
    return(diff)
}

register __last_branch_valid : bool

val FirstBranchAfterProhibited : unit -> bool

function FirstBranchAfterProhibited () = {
    return(not_bool(__last_branch_valid))
}

val BranchEncCycleCount : unit -> (bits(1), bits(14))

function BranchEncCycleCount () = {
    cc : int = BranchRawCycleCount();
    if not_bool(BRBCycleCountingEnabled()) | FirstBranchAfterProhibited() then {
        return((0b1, Zeros(14)))
    };
    E : bits(6) = undefined;
    M : bits(8) = undefined;
    if cc < pow2(8) then {
        E = Zeros();
        M = cc[7 .. 0]
    } else if cc >= pow2(20) then {
        E = Ones();
        M = Ones()
    } else {
        E = 1[5 .. 0];
        while cc >= pow2(9) do {
            E = E + 1;
            cc = DIV(cc, 2)
        };
        let 'cc = cc;
        M = cc[7 .. 0]
    };
    return((0b0, E @ M))
}

val HaveBRBEv1p1 : unit -> bool

function HaveBRBEv1p1 () = {
    return(HasArchVersion(ARMv9p3) & __IMPDEF_boolean("Has BRBEv1p1 extension"))
}

register MDCR_EL3 : bits(64)

val BranchRecordAllowed : bits(2) -> bool

function BranchRecordAllowed el = {
    if Slice(BRBFCR_EL1, 7, 1) == 0b1 then {
        return(false)
    };
    if el == EL3 & HaveBRBEv1p1() then {
        return(Slice(MDCR_EL3, 38, 1) != Slice(MDCR_EL3, 37, 1))
    };
    if HaveEL(EL3) & (Slice(MDCR_EL3, 32, 2) == 0b00 | IsSecure() & Slice(MDCR_EL3, 32, 2) == 0b01) then {
        return(false)
    };
    match el {
      ? if ? == EL3 => {
          return(false)
      },
      ? if ? == EL2 => {
          return(Slice(BRBCR_EL2, 1, 1) == 0b1)
      },
      ? if ? == EL1 => {
          return(Slice(BRBCR_EL1, 1, 1) == 0b1)
      },
      ? if ? == EL0 => {
          if EL2Enabled() & Slice(HCR_EL2, 27, 1) == 0b1 then {
              return(Slice(BRBCR_EL2, 0, 1) == 0b1)
          } else {
              return(Slice(BRBCR_EL1, 0, 1) == 0b1)
          }
      },
      _ => {
          return(undefined : bool)
      }
    }
}

val HaveTME : unit -> bool

function HaveTME () = {
    return(__IMPDEF_boolean("Has Transactional Memory extension"))
}

val GetNumEventCounters : unit -> int

function GetNumEventCounters () = {
    return(__IMPDEF_integer("Number of event counters"))
}

val HavePMUv3 : unit -> bool

function HavePMUv3 () = {
    return(__IMPDEF_boolean("Has Performance Monitors extension"))
}

register MDCR_EL2 : bits(64)

register PMCR_EL0 : bits(64)

register PMEVTYPER_EL0 : vector(31, inc, bits(64))

val PMEVTYPER_read : forall 'n, (0 <= 'n & 'n < 31). int('n) -> bits(32)

function PMEVTYPER_read n = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(PMEVTYPER_EL0[n], 0, 32));
    return(r)
}

register PMUEventAccumulator : vector(31, inc, int)

val PMUEvent : bits(16) -> unit

val PMUEvent__1 : forall 'increment_name.
  (bits(16), int('increment_name)) -> unit

val PMUEvent__2 : forall 'idx 'increment_name.
  (bits(16), int('increment_name), int('idx)) -> unit

function PMUEvent event = {
    PMUEvent__1(event, 1)
}

function PMUEvent__1 (event, increment_name) = {
    if Slice(PMCR_EL0, 0, 1) == 0b0 & Slice(MDCR_EL2, 7, 1) == 0b0 then {
        return()
    };
    let 'counters = GetNumEventCounters();
    if counters != 0 then {
        foreach (idx from 0 to (counters - 1) by 1 in inc) {
            PMUEvent__2(event, increment_name, idx)
        }
    };
    ()
}

function PMUEvent__2 (event, increment_name, idx) = {
    if not_bool(HavePMUv3()) then {
        return()
    };
    if UsingAArch32() then {
        assert(constraint((0 <= 'idx & 'idx < 31)));
        if (Slice(PMEVTYPER_read(idx), 10, 6) @ Slice(PMEVTYPER_read(idx), 0, 10)) == event then {
            PMUEventAccumulator[idx] = PMUEventAccumulator[idx] + increment_name
        };
        ()
    } else {
        assert(constraint((0 <= 'idx & 'idx < 31)));
        if (Slice(PMEVTYPER_EL0[idx], 10, 6) @ Slice(PMEVTYPER_EL0[idx], 0, 10)) == event then {
            PMUEventAccumulator[idx] = PMUEventAccumulator[idx] + increment_name
        };
        ()
    }
}

let PMU_EVENT_BRB_FILTRATE : bits(16) = 0x811F

register ICC_PMR_EL1 : bits(64)

type MAX_PL : Int = 256

let MAX_VL : int(2048) = 2048

type MAX_VL : Int = 2048

struct TMState = {
  depth : int,
  Rt : int,
  nPC : bits(64),
  X : vector(31, inc, bits(64)),
  Z : vector(32, inc, bits(MAX_VL)),
  P : vector(16, inc, bits(MAX_PL)),
  FFR : bits(MAX_PL),
  SP : bits(64),
  FPCR : bits(64),
  FPSR : bits(64),
  ICC_PMR_EL1 : bits(64),
  nzcv : bits(4),
  D : bits(1),
  A : bits(1),
  I : bits(1),
  F : bits(1)
}

register TSTATE : TMState

register BRBIDR0_EL1 : bits(64)

val GetBRBENumRecords : unit -> int

function GetBRBENumRecords () = {
    assert(UInt(Slice(BRBIDR0_EL1, 0, 8)) == UInt(0x08) | UInt(Slice(BRBIDR0_EL1, 0, 8)) == UInt(0x10) | UInt(Slice(BRBIDR0_EL1, 0, 8)) == UInt(0x20) | UInt(Slice(BRBIDR0_EL1, 0, 8)) == UInt(0x40));
    return(__IMPDEF_integer("Number of BRB records"))
}

register Records_INF : vector(64, inc, bits(64))

register Records_SRC : vector(64, inc, bits(64))

register Records_TGT : vector(64, inc, bits(64))

val UpdateBranchRecordBuffer : (bits(1), bits(14), bits(1), bits(1), bits(6), bits(2), bits(1), bits(2), bits(64), bits(64)) -> unit

function UpdateBranchRecordBuffer (ccu, cc, lastfailed, transactional, branch_type, el, mispredict, valid_name, source_address, target_address) = {
    foreach (i from (GetBRBENumRecords() - 1) to 1 by 1 in dec) {
        assert(constraint('loop_i < 64));
        Records_SRC[i] = Records_SRC[i - 1];
        Records_TGT[i] = Records_TGT[i - 1];
        Records_INF[i] = Records_INF[i - 1]
    };
    Records_INF[0][46 .. 46] = ccu;
    Records_INF[0][45 .. 32] = cc;
    Records_INF[0][7 .. 6] = el;
    Records_INF[0][1 .. 0] = valid_name;
    Records_INF[0][16 .. 16] = transactional;
    Records_INF[0][17 .. 17] = lastfailed;
    Records_INF[0][5 .. 5] = mispredict;
    Records_INF[0][13 .. 8] = branch_type;
    Records_SRC[0] = source_address;
    Records_TGT[0] = target_address;
    return()
}

val BRBEException : forall ('trappedsyscallinst : Bool).
  (Exception, bits(64), bits(64), bits(2), bool('trappedsyscallinst)) -> unit

function BRBEException (exception, preferred_exception_return, target_address_in, target_el, trappedsyscallinst) = {
    target_address : bits(64) = target_address_in;
    match target_el {
      ? if ? == EL3 => {
          if not_bool(HaveBRBEv1p1()) | Slice(MDCR_EL3, 38, 1) == Slice(MDCR_EL3, 37, 1) then {
              return()
          };
          ()
      },
      ? if ? == EL2 => {
          if Slice(BRBCR_EL2, 23, 1) == 0b0 then {
              return()
          };
          ()
      },
      ? if ? == EL1 => {
          if Slice(BRBCR_EL1, 23, 1) == 0b0 then {
              return()
          };
          ()
      },
      _ => ()
    };
    let source_valid : bool = BranchRecordAllowed(PSTATE.EL);
    let target_valid : bool = BranchRecordAllowed(target_el);
    let branch_valid : bool = source_valid | target_valid;
    if branch_valid then {
        branch_type : bits(6) = undefined;
        match exception {
          Exception_Uncategorized => {
              branch_type = 0b100011
          },
          Exception_WFxTrap => {
              branch_type = 0b100011
          },
          Exception_CP15RTTrap => {
              branch_type = 0b100011
          },
          Exception_CP15RRTTrap => {
              branch_type = 0b100011
          },
          Exception_CP14RTTrap => {
              branch_type = 0b100011
          },
          Exception_CP14DTTrap => {
              branch_type = 0b100011
          },
          Exception_AdvSIMDFPAccessTrap => {
              branch_type = 0b100011
          },
          Exception_FPIDTrap => {
              branch_type = 0b100011
          },
          Exception_PACTrap => {
              branch_type = 0b100011
          },
          Exception_TSTARTAccessTrap => {
              branch_type = 0b100011
          },
          Exception_CP14RRTTrap => {
              branch_type = 0b100011
          },
          Exception_BranchTarget => {
              branch_type = 0b101011
          },
          Exception_IllegalState => {
              branch_type = 0b100011
          },
          Exception_SupervisorCall => {
              if not_bool(trappedsyscallinst) then {
                  branch_type = 0b100010
              } else {
                  branch_type = 0b100011
              }
          },
          Exception_HypervisorCall => {
              branch_type = 0b100010
          },
          Exception_MonitorCall => {
              if not_bool(trappedsyscallinst) then {
                  branch_type = 0b100010
              } else {
                  branch_type = 0b100011
              }
          },
          Exception_SystemRegisterTrap => {
              branch_type = 0b100011
          },
          Exception_SVEAccessTrap => {
              branch_type = 0b100011
          },
          Exception_SMEAccessTrap => {
              branch_type = 0b100011
          },
          Exception_ERetTrap => {
              branch_type = 0b100011
          },
          Exception_PACFail => {
              branch_type = 0b101100
          },
          Exception_InstructionAbort => {
              branch_type = 0b101011
          },
          Exception_PCAlignment => {
              branch_type = 0b101010
          },
          Exception_DataAbort => {
              branch_type = 0b101100
          },
          Exception_NV2DataAbort => {
              branch_type = 0b101100
          },
          Exception_SPAlignment => {
              branch_type = 0b101010
          },
          Exception_FPTrappedException => {
              branch_type = 0b100011
          },
          Exception_SError => {
              branch_type = 0b100100
          },
          Exception_Breakpoint => {
              branch_type = 0b100110
          },
          Exception_SoftwareStep => {
              branch_type = 0b100110
          },
          Exception_Watchpoint => {
              branch_type = 0b100111
          },
          Exception_NV2Watchpoint => {
              branch_type = 0b100111
          },
          Exception_SoftwareBreakpoint => {
              branch_type = 0b100110
          },
          Exception_IRQ => {
              branch_type = 0b101110
          },
          Exception_FIQ => {
              branch_type = 0b101111
          },
          Exception_MemCpyMemSet => {
              branch_type = 0b100011
          },
          _ => {
              Unreachable()
          }
        };
        ccu : bits(1) = undefined;
        cc : bits(14) = undefined;
        (ccu, cc) = BranchEncCycleCount();
        let lastfailed : bits(1) = if HaveTME() then Slice(BRBFCR_EL1, 6, 1)
        else
          0b0;
        let transactional : bits(1) = if (source_valid & HaveTME()) & TSTATE.depth > 0 then
          0b1
        else
          0b0;
        let el : bits(2) = if target_valid then target_el else 0b00;
        let mispredict : bits(1) = 0b0;
        let sv : bits(1) = if source_valid then 0b1 else 0b0;
        let tv : bits(1) = if target_valid then 0b1 else 0b0;
        let source_address : bits(64) = if source_valid then
          preferred_exception_return
        else
          Zeros(64);
        if not_bool(target_valid) then {
            target_address = Zeros(64)
        };
        UpdateBranchRecordBuffer(ccu, cc, lastfailed, transactional, branch_type, el, mispredict, sv @ tv, source_address, target_address);
        BRBFCR_EL1 = SetSlice(1, BRBFCR_EL1, 6, 0b0);
        PMUEvent(PMU_EVENT_BRB_FILTRATE)
    };
    __last_branch_valid = branch_valid;
    return()
}

val HavePACExt : unit -> bool

function HavePACExt () = {
    return(HasArchVersion(ARMv8p3))
}

register TCR_EL1 : bits(64)

register TCR_EL2 : bits(64)

register TCR_EL3 : bits(64)

val EffectiveTBI : forall ('IsInstr : Bool).
  (bits(64), bool('IsInstr), bits(2)) -> bits(1)

function EffectiveTBI (address, IsInstr, el) = {
    tbi : bits(1) = undefined;
    tbid : bits(1) = undefined;
    assert(HaveEL(el));
    let regime : bits(2) = S1TranslationRegime(el);
    assert(not_bool(ELUsingAArch32(regime)));
    match regime {
      ? if ? == EL1 => {
          tbi = if [address[55]] == 0b1 then Slice(TCR_EL1, 38, 1) else
            Slice(TCR_EL1, 37, 1);
          if HavePACExt() then {
              tbid = if [address[55]] == 0b1 then Slice(TCR_EL1, 52, 1) else
                Slice(TCR_EL1, 51, 1)
          };
          ()
      },
      ? if ? == EL2 => {
          if HaveVirtHostExt() & ELIsInHost(el) then {
              tbi = if [address[55]] == 0b1 then Slice(TCR_EL2, 38, 1) else
                Slice(TCR_EL2, 37, 1);
              if HavePACExt() then {
                  tbid = if [address[55]] == 0b1 then Slice(TCR_EL2, 52, 1) else
                    Slice(TCR_EL2, 51, 1)
              };
              ()
          } else {
              tbi = Slice(TCR_EL2, 20, 1);
              if HavePACExt() then {
                  tbid = Slice(TCR_EL2, 29, 1)
              };
              ()
          }
      },
      ? if ? == EL3 => {
          tbi = Slice(TCR_EL3, 20, 1);
          if HavePACExt() then {
              tbid = Slice(TCR_EL3, 29, 1)
          };
          ()
      },
      _ => ()
    };
    return(if tbi == 0b1 & ((not_bool(HavePACExt()) | tbid == 0b0) | not_bool(IsInstr)) then
      0b1
    else
      0b0)
}

val AddrTop : forall ('IsInstr : Bool).
  (bits(64), bool('IsInstr), bits(2)) -> int

function AddrTop (address, IsInstr, el) = {
    assert(HaveEL(el));
    let regime : bits(2) = S1TranslationRegime(el);
    if ELUsingAArch32(regime) then {
        return(31)
    } else {
        if EffectiveTBI(address, IsInstr, el) == 0b1 then {
            return(55)
        } else {
            return(63)
        }
    }
}

val IsInHost : unit -> bool

function IsInHost () = {
    return(ELIsInHost(PSTATE.EL))
}

val AArch64_BranchAddr : bits(64) -> bits(64)

function AArch64_BranchAddr vaddress = {
    assert(not_bool(UsingAArch32()));
    let 'msbit = AddrTop(vaddress, true, PSTATE.EL);
    assert(constraint((0 <= 'msbit & 'msbit < 64)));
    if msbit == 63 then {
        return(vaddress)
    } else if ((PSTATE.EL == EL0 | PSTATE.EL == EL1) | IsInHost()) & [vaddress[msbit]] == 0b1 then {
        return(SignExtend(vaddress[msbit .. 0]))
    } else {
        return(ZeroExtend(vaddress[msbit .. 0]))
    }
}

val BRBEMispredictAllowed : unit -> bool

function BRBEMispredictAllowed () = {
    if EL2Enabled() & Slice(BRBCR_EL2, 4, 1) == 0b0 then {
        return(false)
    };
    if Slice(BRBCR_EL1, 4, 1) == 0b0 then {
        return(false)
    };
    return(true)
}

val BranchMispredict : unit -> bool

function BranchMispredict () = {
    return(false)
}

enum BranchType = {
  BranchType_DIRCALL,
  BranchType_INDCALL,
  BranchType_ERET,
  BranchType_DBGEXIT,
  BranchType_RET,
  BranchType_DIR,
  BranchType_INDIR,
  BranchType_EXCEPTION,
  BranchType_TMFAIL,
  BranchType_RESET,
  BranchType_UNKNOWN
}

val FilterBranchRecord : forall ('cond : Bool).
  (BranchType, bool('cond)) -> bool

function FilterBranchRecord (br, cond) = {
    match br {
      BranchType_DIRCALL => {
          return(Slice(BRBFCR_EL1, 21, 1) != Slice(BRBFCR_EL1, 16, 1))
      },
      BranchType_INDCALL => {
          return(Slice(BRBFCR_EL1, 20, 1) != Slice(BRBFCR_EL1, 16, 1))
      },
      BranchType_RET => {
          return(Slice(BRBFCR_EL1, 19, 1) != Slice(BRBFCR_EL1, 16, 1))
      },
      BranchType_DIR => {
          if cond then {
              return(Slice(BRBFCR_EL1, 22, 1) != Slice(BRBFCR_EL1, 16, 1))
          } else {
              return(Slice(BRBFCR_EL1, 17, 1) != Slice(BRBFCR_EL1, 16, 1))
          }
      },
      BranchType_INDIR => {
          return(Slice(BRBFCR_EL1, 18, 1) != Slice(BRBFCR_EL1, 16, 1))
      },
      _ => {
          Unreachable()
      }
    };
    return(false)
}

enum InstrSet = {InstrSet_A64, InstrSet_A32, InstrSet_T32}

val CurrentInstrSet : unit -> InstrSet

function CurrentInstrSet () = {
    result : InstrSet = undefined;
    if UsingAArch32() then {
        result = if PSTATE.T == 0b0 then InstrSet_A32 else InstrSet_T32
    } else {
        result = InstrSet_A64
    };
    return(result)
}

let M32_Abort : bits(5) = 0b10111

let M32_FIQ : bits(5) = 0b10001

let M32_Hyp : bits(5) = 0b11010

let M32_IRQ : bits(5) = 0b10010

let M32_Svc : bits(5) = 0b10011

let M32_System : bits(5) = 0b11111

let M32_Undef : bits(5) = 0b11011

let M32_User : bits(5) = 0b10000

val BadMode : bits(5) -> bool

function BadMode mode = {
    valid_name : bool = undefined;
    match mode {
      ? if ? == M32_Monitor => {
          valid_name = HaveAArch32EL(EL3)
      },
      ? if ? == M32_Hyp => {
          valid_name = HaveAArch32EL(EL2)
      },
      ? if ? == M32_FIQ => {
          valid_name = HaveAArch32EL(EL1)
      },
      ? if ? == M32_IRQ => {
          valid_name = HaveAArch32EL(EL1)
      },
      ? if ? == M32_Svc => {
          valid_name = HaveAArch32EL(EL1)
      },
      ? if ? == M32_Abort => {
          valid_name = HaveAArch32EL(EL1)
      },
      ? if ? == M32_Undef => {
          valid_name = HaveAArch32EL(EL1)
      },
      ? if ? == M32_System => {
          valid_name = HaveAArch32EL(EL1)
      },
      ? if ? == M32_User => {
          valid_name = HaveAArch32EL(EL0)
      },
      _ => {
          valid_name = false
      }
    };
    let valid_name = valid_name;
    return(not_bool(valid_name))
}

register LR_mon : bits(32)

val RBankSelect : forall 'usr 'fiq 'irq 'svc 'abt 'und 'hyp.
  (bits(5), int('usr), int('fiq), int('irq), int('svc), int('abt), int('und), int('hyp)) -> {'n, ('n == 'usr | 'n == 'fiq | 'n == 'irq | 'n == 'svc | 'n == 'abt | 'n == 'und | 'n == 'hyp). int('n)}

function RBankSelect (mode, usr, fiq, irq, svc, abt, und, hyp) = {
    match mode {
      ? if ? == M32_User => usr,
      ? if ? == M32_FIQ => fiq,
      ? if ? == M32_IRQ => irq,
      ? if ? == M32_Svc => svc,
      ? if ? == M32_Abort => abt,
      ? if ? == M32_Hyp => hyp,
      ? if ? == M32_Undef => und,
      ? if ? == M32_System => usr
    }
}

val LookUpRIndex : forall 'n, ('n >= 0 & 'n <= 15).
  (int('n), bits(5)) -> {'m, (0 <= 'm & 'm <= 30). int('m)}

function LookUpRIndex (n, mode) = {
    assert(n >= 0 & n <= 14);
    match n {
      8 => {
          return(RBankSelect(mode, 8, 24, 8, 8, 8, 8, 8))
      },
      9 => {
          return(RBankSelect(mode, 9, 25, 9, 9, 9, 9, 9))
      },
      10 => {
          return(RBankSelect(mode, 10, 26, 10, 10, 10, 10, 10))
      },
      11 => {
          return(RBankSelect(mode, 11, 27, 11, 11, 11, 11, 11))
      },
      12 => {
          return(RBankSelect(mode, 12, 28, 12, 12, 12, 12, 12))
      },
      13 => {
          return(RBankSelect(mode, 13, 29, 17, 19, 21, 23, 15))
      },
      14 => {
          return(RBankSelect(mode, 14, 30, 16, 18, 20, 22, 14))
      },
      _ => {
          return(n)
      }
    }
}

register SP_mon : bits(32)

val Rmode_read : forall 'n. (int('n), bits(5)) -> bits(32)

function Rmode_read (n, mode) = {
    assert(n >= 0 & n <= 14);
    if not_bool(IsSecure()) then {
        assert(mode != M32_Monitor)
    };
    assert(not_bool(BadMode(mode)));
    if mode == M32_Monitor then {
        if n == 13 then {
            return(SP_mon)
        } else if n == 14 then {
            return(LR_mon)
        } else {
            return(_R[n][31 .. 0])
        }
    } else {
        return(_R[LookUpRIndex(n, mode)][31 .. 0])
    }
}

register _PC : bits(64)

val R_read : forall 'n. int('n) -> bits(32)

function R_read n = {
    offset : int = undefined;
    if n == 15 then {
        let 'offset = if CurrentInstrSet() == InstrSet_A32 then 8 else 4;
        return(_PC[31 .. 0] + offset)
    } else {
        return(Rmode_read(n, PSTATE.M))
    }
}

val PC_read : unit -> bits(64)

val PC_read__1 : unit -> bits(32)

function PC_read () = {
    return(_PC)
}

function PC_read__1 () = {
    return(R_read(15))
}

val BRBEBranch : forall ('cond : Bool).
  (BranchType, bool('cond), bits(64)) -> unit

function BRBEBranch (br_type, cond, target_address) = {
    let branch_valid : bool = BranchRecordAllowed(PSTATE.EL);
    if branch_valid & FilterBranchRecord(br_type, cond) then {
        branch_type : bits(6) = undefined;
        match br_type {
          BranchType_DIR => {
              branch_type = if cond then 0b001000 else 0b000000
          },
          BranchType_INDIR => {
              branch_type = 0b000001
          },
          BranchType_DIRCALL => {
              branch_type = 0b000010
          },
          BranchType_INDCALL => {
              branch_type = 0b000011
          },
          BranchType_RET => {
              branch_type = 0b000101
          },
          _ => {
              Unreachable()
          }
        };
        ccu : bits(1) = undefined;
        cc : bits(14) = undefined;
        (ccu, cc) = BranchEncCycleCount();
        let lastfailed : bits(1) = if HaveTME() then Slice(BRBFCR_EL1, 6, 1)
        else
          0b0;
        let transactional : bits(1) = if HaveTME() & TSTATE.depth > 0 then 0b1
        else
          0b0;
        let el : bits(2) = PSTATE.EL;
        let mispredict : bits(1) = if BRBEMispredictAllowed() & BranchMispredict() then
          0b1
        else
          0b0;
        UpdateBranchRecordBuffer(ccu, cc, lastfailed, transactional, branch_type, el, mispredict, 0b11, PC_read(), target_address);
        BRBFCR_EL1 = SetSlice(1, BRBFCR_EL1, 6, 0b0);
        PMUEvent(PMU_EVENT_BRB_FILTRATE)
    };
    __last_branch_valid = branch_valid;
    return()
}

val HaveBRBExt : unit -> bool

function HaveBRBExt () = {
    return(__IMPDEF_boolean("Has Branch Record Buffer Extension"))
}

val Hint_Branch : BranchType -> unit

register __BranchTaken : bool

val BranchTo : forall 'N ('branch_conditional : Bool).
  (bits('N), BranchType, bool('branch_conditional)) -> unit

function BranchTo (target, branch_type, branch_conditional) = {
    Hint_Branch(branch_type);
    if 'N == 32 then {
        assert(UsingAArch32());
        _PC = ZeroExtend(target)
    } else {
        assert('N == 64 & not_bool(UsingAArch32()));
        let target_vaddress : bits(64) = AArch64_BranchAddr(target[63 .. 0]);
        if HaveBRBExt() & (branch_type == BranchType_DIR | branch_type == BranchType_INDIR | branch_type == BranchType_DIRCALL | branch_type == BranchType_INDCALL | branch_type == BranchType_RET) then {
            BRBEBranch(branch_type, branch_conditional, target_vaddress)
        };
        _PC = target_vaddress
    };
    __BranchTaken = true;
    return()
}

let DebugHalt_ExceptionCatch : bits(6) = 0b110111

register OSECCR_EL1 : bits(64)

val EDECCR_read : unit -> bits(32)

function EDECCR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(OSECCR_EL1, 0, 32));
    return(r)
}

enum CrossTriggerIn = {
  CrossTriggerIn_CrossHalt,
  CrossTriggerIn_PMUOverflow,
  CrossTriggerIn_RSVD2,
  CrossTriggerIn_RSVD3,
  CrossTriggerIn_TraceExtOut0,
  CrossTriggerIn_TraceExtOut1,
  CrossTriggerIn_TraceExtOut2,
  CrossTriggerIn_TraceExtOut3
}

val CTI_SignalEvent : CrossTriggerIn -> unit

register DLR_EL0 : bits(64)

val DLR_write : bits(32) -> unit

function DLR_write val_name = {
    let r : bits(32) = val_name;
    DLR_EL0 = SetSlice(32, DLR_EL0, 0, Slice(r, 0, 32));
    return()
}

register DSPSR_EL0 : bits(64)

val DSPSR_write : bits(32) -> unit

function DSPSR_write val_name = {
    let r : bits(32) = val_name;
    DSPSR_EL0 = SetSlice(32, DSPSR_EL0, 0, Slice(r, 0, 32));
    return()
}

let DebugHalt_Breakpoint : bits(6) = 0b000111

let DebugHalt_HaltInstruction : bits(6) = 0b101111

let DebugHalt_Step_Exclusive : bits(6) = 0b011111

let DebugHalt_Step_NoSyndrome : bits(6) = 0b111011

let DebugHalt_Step_Normal : bits(6) = 0b011011

register MDCCSR_EL0 : bits(64)

register _EDSCR_0_28 : bits(29)

register _EDSCR_31_31 : bits(1)

val EDSCR_read : unit -> bits(32)

function EDSCR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(2, r, 29, Slice(MDCCSR_EL0, 29, 2));
    r = SetSlice(29, r, 0, _EDSCR_0_28);
    r = SetSlice(1, r, 31, _EDSCR_31_31);
    return(r)
}

val EDSCR_write : bits(32) -> unit

function EDSCR_write val_name = {
    let r : bits(32) = val_name;
    MDCCSR_EL0 = SetSlice(2, MDCCSR_EL0, 29, Slice(r, 29, 2));
    _EDSCR_0_28 = Slice(r, 0, 29);
    _EDSCR_31_31 = Slice(r, 31, 1);
    return()
}

register DBGEN : signal

val ExternalInvasiveDebugEnabled : unit -> bool

function ExternalInvasiveDebugEnabled () = {
    return(DBGEN == HIGH)
}

register SPIDEN : signal

val SecureOnlyImplementation : unit -> bool

function SecureOnlyImplementation () = {
    return(__IMPDEF_boolean("Secure-only implementation"))
}

val ExternalSecureInvasiveDebugEnabled : unit -> bool

function ExternalSecureInvasiveDebugEnabled () = {
    if not_bool(HaveEL(EL3)) & not_bool(SecureOnlyImplementation()) then {
        return(false)
    };
    return(ExternalInvasiveDebugEnabled() & SPIDEN == HIGH)
}

val HaveBTIExt : unit -> bool

function HaveBTIExt () = {
    return(HasArchVersion(ARMv8p5))
}

val HaveDITExt : unit -> bool

function HaveDITExt () = {
    return(HasArchVersion(ARMv8p4))
}

val HaveMTE2Ext : unit -> bool

function HaveMTE2Ext () = {
    if not_bool(HasArchVersion(ARMv8p5)) then {
        return(false)
    };
    return(__IMPDEF_boolean("Has MTE2 extension"))
}

val HaveMTEExt : unit -> bool

function HaveMTEExt () = {
    if not_bool(HasArchVersion(ARMv8p5)) then {
        return(false)
    };
    if HaveMTE2Ext() then {
        return(true)
    };
    return(__IMPDEF_boolean("Has MTE extension"))
}

val HavePANExt : unit -> bool

function HavePANExt () = {
    return(HasArchVersion(ARMv8p1))
}

val HaveSSBSExt : unit -> bool

function HaveSSBSExt () = {
    return(HasArchVersion(ARMv8p5) | __IMPDEF_boolean("Has SSBS extension"))
}

val HaveUAOExt : unit -> bool

function HaveUAOExt () = {
    return(HasArchVersion(ARMv8p2))
}

val GetPSRFromPSTATE : forall 'N, ('N >= 0 & 31 < 'N).
  (implicit('N), ExceptionalOccurrenceTargetState) -> bits('N)

function GetPSRFromPSTATE (N, targetELState) = {
    if UsingAArch32() & (targetELState == AArch32_NonDebugState | targetELState == DebugState) then {
        assert(N == 32)
    } else {
        assert(N == 64)
    };
    spsr : bits('N) = Zeros();
    spsr[31 .. 28] = PSTATE.N @ (PSTATE.Z @ (PSTATE.C @ PSTATE.V));
    if HavePANExt() then {
        spsr[22] = Bit(PSTATE.PAN)
    };
    spsr[20] = Bit(PSTATE.IL);
    if PSTATE.nRW == 0b1 then {
        spsr[27] = Bit(PSTATE.Q);
        spsr[26 .. 25] = PSTATE.IT[1 .. 0];
        if HaveSSBSExt() then {
            spsr[23] = Bit(PSTATE.SSBS)
        };
        if HaveDITExt() then {
            if targetELState == AArch32_NonDebugState then {
                spsr[21] = Bit(PSTATE.DIT)
            } else {
                spsr[24] = Bit(PSTATE.DIT)
            }
        };
        if targetELState == AArch64_NonDebugState | targetELState == DebugState then {
            spsr[21] = Bit(PSTATE.SS)
        };
        spsr[19 .. 16] = PSTATE.GE;
        spsr[15 .. 10] = PSTATE.IT[7 .. 2];
        spsr[9] = Bit(PSTATE.E);
        spsr[8 .. 6] = PSTATE.A @ (PSTATE.I @ PSTATE.F);
        spsr[5] = Bit(PSTATE.T);
        assert([PSTATE.M[4]] == PSTATE.nRW);
        spsr[4 .. 0] = PSTATE.M
    } else {
        if HaveMTEExt() then {
            spsr[25] = Bit(PSTATE.TCO)
        };
        if HaveDITExt() then {
            spsr[24] = Bit(PSTATE.DIT)
        };
        if HaveUAOExt() then {
            spsr[23] = Bit(PSTATE.UAO)
        };
        spsr[21] = Bit(PSTATE.SS);
        if HaveFeatNMI() then {
            spsr[13] = Bit(PSTATE.ALLINT)
        };
        if HaveSSBSExt() then {
            spsr[12] = Bit(PSTATE.SSBS)
        };
        if HaveBTIExt() then {
            spsr[11 .. 10] = PSTATE.BTYPE
        };
        spsr[9 .. 6] = PSTATE.D @ (PSTATE.A @ (PSTATE.I @ PSTATE.F));
        spsr[4] = Bit(PSTATE.nRW);
        spsr[3 .. 2] = PSTATE.EL;
        spsr[0] = Bit(PSTATE.SP)
    };
    return(spsr)
}

val StopInstructionPrefetchAndEnableITR : unit -> unit

val ThisInstrAddr : forall 'N, 'N > 0. int('N) -> bits('N)

val Halted : unit -> bool

function Halted () = {
    return(not_bool(Slice(EDSCR_read(), 0, 6) == 0b000001 | Slice(EDSCR_read(), 0, 6) == 0b000010))
}

val HaveRME : unit -> bool

function HaveRME () = {
    return(__IMPDEF_boolean("Has RME extension"))
}

enum SecurityState = {SS_NonSecure, SS_Root, SS_Realm, SS_Secure}

val SecurityStateAtEL : bits(2) -> SecurityState

function SecurityStateAtEL EL = {
    if HaveRME() then {
        if EL == EL3 then {
            return(SS_Root)
        };
        match Slice(SCR_EL3, 62, 1) @ Slice(SCR_EL3, 0, 1) {
          0b00 => {
              return(SS_Secure)
          },
          0b01 => {
              return(SS_NonSecure)
          },
          0b11 => {
              return(SS_Realm)
          },
          _ => ()
        }
    };
    if not_bool(HaveEL(EL3)) then {
        if SecureOnlyImplementation() then {
            return(SS_Secure)
        } else {
            return(SS_NonSecure)
        }
    } else if EL == EL3 then {
        return(SS_Secure)
    } else {
        assert(EL != EL2 | EL2Enabled());
        if not_bool(ELUsingAArch32(EL3)) then {
            return(if Slice(SCR_EL3, 0, 1) == 0b1 then SS_NonSecure else
              SS_Secure)
        } else {
            return(if Slice(SCR, 0, 1) == 0b1 then SS_NonSecure else SS_Secure)
        }
    }
}

val UpdateEDSCRFields : unit -> unit

function UpdateEDSCRFields () = {
    ss : SecurityState = undefined;
    if not_bool(Halted()) then {
        EDSCR_write() = SetSlice(2, EDSCR_read(), 8, 0b00);
        if HaveRME() then {
            EDSCR_write() = SetSlice(1, EDSCR_read(), 15, Slice(__UNKNOWN_bits(2), 1, 1));
            EDSCR_write() = SetSlice(1, EDSCR_read(), 18, Slice(__UNKNOWN_bits(2), 0, 1));
            ()
        } else {
            EDSCR_write() = SetSlice(1, EDSCR_read(), 18, __UNKNOWN_bits(1))
        };
        EDSCR_write() = SetSlice(4, EDSCR_read(), 10, 0b1111)
    } else {
        EDSCR_write() = SetSlice(2, EDSCR_read(), 8, PSTATE.EL);
        let ss : SecurityState = SecurityStateAtEL(PSTATE.EL);
        if HaveRME() then {
            match ss {
              SS_Secure => {
                  EDSCR_write() = SetSlice(1, EDSCR_read(), 15, Slice(0b00, 1, 1));
                  EDSCR_write() = SetSlice(1, EDSCR_read(), 18, Slice(0b00, 0, 1));
                  ()
              },
              SS_NonSecure => {
                  EDSCR_write() = SetSlice(1, EDSCR_read(), 15, Slice(0b01, 1, 1));
                  EDSCR_write() = SetSlice(1, EDSCR_read(), 18, Slice(0b01, 0, 1));
                  ()
              },
              SS_Root => {
                  EDSCR_write() = SetSlice(1, EDSCR_read(), 15, Slice(0b10, 1, 1));
                  EDSCR_write() = SetSlice(1, EDSCR_read(), 18, Slice(0b10, 0, 1));
                  ()
              },
              SS_Realm => {
                  EDSCR_write() = SetSlice(1, EDSCR_read(), 15, Slice(0b11, 1, 1));
                  EDSCR_write() = SetSlice(1, EDSCR_read(), 18, Slice(0b11, 0, 1));
                  ()
              }
            }
        } else {
            EDSCR_write() = SetSlice(1, EDSCR_read(), 18, if ss == SS_Secure then
              0b0
            else
              0b1)
        };
        RW : bits(4) = undefined;
        RW[1] = Bit(if ELUsingAArch32(EL1) then 0b0 else 0b1);
        if PSTATE.EL != EL0 then {
            RW[0] = Bit([RW[1]])
        } else {
            RW[0] = Bit(if UsingAArch32() then 0b0 else 0b1)
        };
        if not_bool(HaveEL(EL2)) | (HaveEL(EL3) & [SCR_GEN_read()[0]] == 0b0) & not_bool(IsSecureEL2Enabled()) then {
            RW[2] = Bit([RW[1]])
        } else {
            RW[2] = Bit(if ELUsingAArch32(EL2) then 0b0 else 0b1)
        };
        if not_bool(HaveEL(EL3)) then {
            RW[3] = Bit([RW[2]])
        } else {
            RW[3] = Bit(if ELUsingAArch32(EL3) then 0b0 else 0b1)
        };
        if [RW[3]] == 0b0 then {
            RW[2 .. 0] = __UNKNOWN_bits(3)
        } else if [RW[2]] == 0b0 then {
            RW[1 .. 0] = __UNKNOWN_bits(2)
        } else if [RW[1]] == 0b0 then {
            RW[0] = Bit(__UNKNOWN_bits(1))
        } else ();
        EDSCR_write() = SetSlice(4, EDSCR_read(), 10, RW)
    };
    return()
}

val Halt : bits(6) -> unit

function Halt reason = {
    CTI_SignalEvent(CrossTriggerIn_CrossHalt);
    let preferred_restart_address : bits(64) = ThisInstrAddr(64);
    spsr_32 : bits(32) = undefined;
    spsr_64 : bits(64) = undefined;
    if UsingAArch32() then {
        spsr_32 = GetPSRFromPSTATE(32, DebugState)
    } else {
        spsr_64 = GetPSRFromPSTATE(64, DebugState)
    };
    if (HaveBTIExt() & not_bool(reason == DebugHalt_Step_Normal | reason == DebugHalt_Step_Exclusive | reason == DebugHalt_Step_NoSyndrome | reason == DebugHalt_Breakpoint | reason == DebugHalt_HaltInstruction)) & ConstrainUnpredictableBool(Unpredictable_ZEROBTYPE) then {
        if UsingAArch32() then {
            spsr_32[11 .. 10] = 0b00
        } else {
            spsr_64[11 .. 10] = 0b00
        }
    };
    if UsingAArch32() then {
        DLR_write() = preferred_restart_address[31 .. 0];
        DSPSR_write() = spsr_32
    } else {
        DLR_EL0 = preferred_restart_address;
        DSPSR_EL0 = spsr_64
    };
    EDSCR_write() = SetSlice(1, EDSCR_read(), 24, 0b1);
    EDSCR_write() = SetSlice(1, EDSCR_read(), 28, 0b0);
    if IsSecure() then {
        EDSCR_write() = SetSlice(1, EDSCR_read(), 16, 0b0)
    } else if HaveEL(EL3) then {
        EDSCR_write() = SetSlice(1, EDSCR_read(), 16, if ExternalSecureInvasiveDebugEnabled() then
          0b0
        else
          0b1)
    } else {
        assert(Slice(EDSCR_read(), 16, 1) == 0b1)
    };
    EDSCR_write() = SetSlice(1, EDSCR_read(), 20, 0b0);
    if UsingAArch32() then {
        (PSTATE.IT @ PSTATE.SS @ PSTATE.SSBS @ PSTATE.A @ PSTATE.I @ PSTATE.F @ PSTATE.T) = __UNKNOWN_bits(14)
    } else {
        (PSTATE.SS @ PSTATE.SSBS @ PSTATE.D @ PSTATE.A @ PSTATE.I @ PSTATE.F) = __UNKNOWN_bits(6);
        PSTATE.TCO = 0b1;
        PSTATE.BTYPE = 0b00
    };
    PSTATE.IL = 0b0;
    StopInstructionPrefetchAndEnableITR();
    EDSCR_write() = SetSlice(6, EDSCR_read(), 0, reason);
    UpdateEDSCRFields();
    return()
}

register OSDLR_EL1 : bits(64)

val DBGOSDLR_read : unit -> bits(32)

function DBGOSDLR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(OSDLR_EL1, 0, 32));
    return(r)
}

register DBGPRCR_EL1 : bits(64)

val DBGPRCR_read : unit -> bits(32)

function DBGPRCR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(DBGPRCR_EL1, 0, 32));
    return(r)
}

val HaveDoubleLock : unit -> bool

function HaveDoubleLock () = {
    return(not_bool(HasArchVersion(ARMv8p4)) | __IMPDEF_boolean("OS Double Lock is implemented"))
}

val DoubleLockStatus : unit -> bool

function DoubleLockStatus () = {
    if not_bool(HaveDoubleLock()) then {
        return(false)
    } else if ELUsingAArch32(EL1) then {
        return((Slice(DBGOSDLR_read(), 0, 1) == 0b1 & Slice(DBGPRCR_read(), 0, 1) == 0b0) & not_bool(Halted()))
    } else {
        return((Slice(OSDLR_EL1, 0, 1) == 0b1 & Slice(DBGPRCR_EL1, 0, 1) == 0b0) & not_bool(Halted()))
    }
}

register RLPIDEN : signal

val ExternalRealmInvasiveDebugEnabled : unit -> bool

function ExternalRealmInvasiveDebugEnabled () = {
    if not_bool(HaveRME()) then {
        return(false)
    };
    return(ExternalInvasiveDebugEnabled() & RLPIDEN == HIGH)
}

register RTPIDEN : signal

val ExternalRootInvasiveDebugEnabled : unit -> bool

function ExternalRootInvasiveDebugEnabled () = {
    if not_bool(HaveRME()) then {
        return(false)
    };
    return(((ExternalInvasiveDebugEnabled() & ExternalSecureInvasiveDebugEnabled()) & ExternalRealmInvasiveDebugEnabled()) & RTPIDEN == HIGH)
}

val HaltingAllowed : unit -> bool

function HaltingAllowed () = {
    if Halted() | DoubleLockStatus() then {
        return(false)
    };
    let ss : SecurityState = SecurityStateAtEL(PSTATE.EL);
    match ss {
      SS_NonSecure => {
          return(ExternalInvasiveDebugEnabled())
      },
      SS_Secure => {
          return(ExternalSecureInvasiveDebugEnabled())
      },
      SS_Root => {
          return(ExternalRootInvasiveDebugEnabled())
      },
      SS_Realm => {
          return(ExternalRealmInvasiveDebugEnabled())
      },
      _ => {
          return(undefined : bool)
      }
    }
}

val HaveExtendedECDebugEvents : unit -> bool

function HaveExtendedECDebugEvents () = {
    return(HasArchVersion(ARMv8p2))
}

val CheckExceptionCatch : forall ('exception_entry : Bool).
  bool('exception_entry) -> unit

function CheckExceptionCatch exception_entry = {
    ctrl : bits(2) = undefined;
    exception_exit : bool = undefined;
    increment_name : int = undefined;
    let ss : SecurityState = SecurityStateAtEL(PSTATE.EL);
    base : {|0, 4, 16|} = 0;
    match ss {
      SS_Secure => {
          base = 0
      },
      SS_NonSecure => {
          base = 4
      },
      SS_Realm => {
          base = 16
      },
      SS_Root => {
          base = 0
      }
    };
    let 'base = base;
    if HaltingAllowed() then {
        halt : bool = undefined;
        if HaveExtendedECDebugEvents() then {
            let exception_exit : bool = not_bool(exception_entry);
            let 'increment_name = if ss == SS_Realm then 4 else 8;
            let ctrl : bits(2) = [EDECCR_read()[UInt(PSTATE.EL) + base + increment_name]] @ [EDECCR_read()[UInt(PSTATE.EL) + base]];
            match ctrl {
              0b00 => {
                  halt = false
              },
              0b01 => {
                  halt = true
              },
              0b10 => {
                  halt = exception_exit == true
              },
              0b11 => {
                  halt = exception_entry == true
              }
            }
        } else {
            halt = [EDECCR_read()[UInt(PSTATE.EL) + base]] == 0b1
        };
        if halt then {
            Halt(DebugHalt_ExceptionCatch)
        };
        ()
    };
    ()
}

register ELR_EL1 : bits(64)

register ELR_EL2 : bits(64)

register ELR_EL3 : bits(64)

val ELR_set : (bits(2), bits(64)) -> unit

val ELR_set__1 : bits(64) -> unit

function ELR_set (el, value_name) = {
    let r : bits(64) = value_name;
    match el {
      ? if ? == EL1 => {
          ELR_EL1 = r
      },
      ? if ? == EL2 => {
          ELR_EL2 = r
      },
      ? if ? == EL3 => {
          ELR_EL3 = r
      },
      _ => {
          Unreachable()
      }
    };
    return()
}

function ELR_set__1 value_name = {
    assert(PSTATE.EL != EL0);
    ELR_set(PSTATE.EL) = value_name;
    return()
}

val ClearExclusiveLocal : forall 'processorid. int('processorid) -> unit

val DiscardTransactionalWrites : unit -> unit

val ProcessorID : unit -> int

val HaveSME : unit -> bool

function HaveSME () = {
    return(__IMPDEF_boolean("Have SME extension"))
}

val Align__1 : forall 'x 'y. (int('x), int('y)) -> int

val Align : forall 'N 'y. (bits('N), int('y)) -> bits('N)

function Align__1 (x, y) = {
    return(y * DIV(x, y))
}

function Align (x, y) = {
    assert(constraint(0 <= 'N - 1));
    return(Align__1(UInt(x), y)['N - 1 .. 0])
}

val FloorPow2 : forall 'x. int('x) -> nat

function FloorPow2 x = {
    assert(x >= 0);
    n : {'n, 'n >= 0. int('n)} = 1;
    if x == 0 then {
        return(0)
    };
    while x >= pow2(n) do {
        n = n + 1
    };
    let 'n = n;
    assert(constraint(('n - 1 >= 0 | 'x == 0 | not('x >= 0))));
    let r = 2 ^ (n - 1);
    assert(r >= 0);
    return(r)
}

val CeilPow2 : forall 'x. int('x) -> int

function CeilPow2 x = {
    if x == 0 then {
        return(0)
    };
    if x == 1 then {
        return(2)
    };
    return(FloorPow2(x - 1) * 2)
}

val IsPow2 : forall 'x. int('x) -> bool

function IsPow2 x = {
    if x <= 0 then {
        return(false)
    };
    return(FloorPow2(x) == CeilPow2(x))
}

val MaxImplementedVL : unit -> int

val SupportedNonPowerTwoVL : forall 'nbits. int('nbits) -> bool

val ImplementedSVEVectorLength : forall 'nbits_in. int('nbits_in) -> int

function ImplementedSVEVectorLength nbits_in = {
    nbits : int = Min(nbits_in, MaxImplementedVL());
    assert((128 <= nbits & nbits <= 2048) & Align__1(nbits, 128) == nbits);
    while nbits > 128 do {
        if IsPow2(nbits) | SupportedNonPowerTwoVL(nbits) then {
            return(nbits)
        };
        nbits = nbits - 128
    };
    let 'nbits = nbits;
    return(nbits)
}

register ZCR_EL1 : bits(64)

register ZCR_EL2 : bits(64)

register ZCR_EL3 : bits(64)

val NVL_read : unit -> {'n, 'n >= 0. int('n)}

function NVL_read () = {
    vl : int = undefined;
    if PSTATE.EL == EL1 | PSTATE.EL == EL0 & not_bool(IsInHost()) then {
        vl = UInt(Slice(ZCR_EL1, 0, 4))
    };
    if PSTATE.EL == EL2 | PSTATE.EL == EL0 & IsInHost() then {
        vl = UInt(Slice(ZCR_EL2, 0, 4))
    } else if (PSTATE.EL == EL0 | PSTATE.EL == EL1) & EL2Enabled() then {
        vl = Min(vl, UInt(Slice(ZCR_EL2, 0, 4)))
    } else ();
    if PSTATE.EL == EL3 then {
        vl = UInt(Slice(ZCR_EL3, 0, 4))
    } else if HaveEL(EL3) then {
        vl = Min(vl, UInt(Slice(ZCR_EL3, 0, 4)))
    } else ();
    vl : int = (vl + 1) * 128;
    let 'vl = ImplementedSVEVectorLength(vl);
    assert(vl >= 0);
    return(vl)
}

val MaxImplementedSVL : unit -> int

val SupportedPowerTwoSVL : forall 'nbits. int('nbits) -> bool

val ImplementedSMEVectorLength : forall 'nbits_in. int('nbits_in) -> int

function ImplementedSMEVectorLength nbits_in = {
    let 'maxbits = MaxImplementedSVL();
    assert((128 <= maxbits & maxbits <= 2048) & IsPow2(maxbits));
    nbits : int = Min(nbits_in, maxbits);
    assert((128 <= nbits & nbits <= 2048) & Align__1(nbits, 128) == nbits);
    while nbits > 128 do {
        if IsPow2(nbits) & SupportedPowerTwoSVL(nbits) then {
            return(nbits)
        };
        nbits = nbits - 128
    };
    nbits : int = 128;
    while nbits < maxbits do {
        if SupportedPowerTwoSVL(nbits) then {
            return(nbits)
        };
        nbits = nbits * 2
    };
    return(maxbits)
}

register SMCR_EL1 : bits(64)

register SMCR_EL2 : bits(64)

register SMCR_EL3 : bits(64)

val SVL_read : unit -> {'n, 'n >= 0. int('n)}

function SVL_read () = {
    vl : int = undefined;
    if PSTATE.EL == EL1 | PSTATE.EL == EL0 & not_bool(IsInHost()) then {
        vl = UInt(Slice(SMCR_EL1, 0, 4))
    };
    if PSTATE.EL == EL2 | PSTATE.EL == EL0 & IsInHost() then {
        vl = UInt(Slice(SMCR_EL2, 0, 4))
    } else if (PSTATE.EL == EL0 | PSTATE.EL == EL1) & EL2Enabled() then {
        vl = Min(vl, UInt(Slice(SMCR_EL2, 0, 4)))
    } else ();
    if PSTATE.EL == EL3 then {
        vl = UInt(Slice(SMCR_EL3, 0, 4))
    } else if HaveEL(EL3) then {
        vl = Min(vl, UInt(Slice(SMCR_EL3, 0, 4)))
    } else ();
    vl : int = (vl + 1) * 128;
    let 'vl = ImplementedSMEVectorLength(vl);
    assert(vl >= 0);
    return(vl)
}

val VL_read : unit -> {'n, 'n >= 0. int('n)}

function VL_read () = {
    let 'SVL = SVL_read();
    return(if HaveSME() & PSTATE.SM == 0b1 then SVL else NVL_read())
}

register _FFR : bits(MAX_PL)

val FFR_set : forall 'width, (256 >= 'width & 0 <= 'width - 1).
  (implicit('width), bits('width)) -> unit

function FFR_set (width, value_name) = {
    let 'VL = VL_read();
    let 'PL = PL_of_VL(VL_read());
    assert(width == PL);
    if ConstrainUnpredictableBool(Unpredictable_SVEZEROUPPER) then {
        _FFR = ZeroExtend(value_name)
    } else {
        _FFR[width - 1 .. 0] = value_name
    }
}

register CPACR_EL1 : bits(64)

register CPTR_EL2 : bits(64)

register CPTR_EL3 : bits(64)

val AArch64_IsFPEnabled : bits(2) -> bool

function AArch64_IsFPEnabled el = {
    if (el == EL0 | el == EL1) & not_bool(IsInHost()) then {
        disabled : bool = undefined;
        match Slice(CPACR_EL1, 20, 2) {
          [_, bitzero] => {
              disabled = true
          },
          0b01 => {
              disabled = el == EL0
          },
          0b11 => {
              disabled = false
          }
        };
        let disabled = disabled;
        if disabled then {
            return(false)
        };
        ()
    };
    if (el == EL0 | el == EL1 | el == EL2) & EL2Enabled() then {
        if HaveVirtHostExt() & Slice(HCR_EL2, 34, 1) == 0b1 then {
            disabled : bool = undefined;
            match Slice(CPTR_EL2, 20, 2) {
              [_, bitzero] => {
                  disabled = true
              },
              0b01 => {
                  disabled = el == EL0 & Slice(HCR_EL2, 27, 1) == 0b1
              },
              0b11 => {
                  disabled = false
              }
            };
            let disabled = disabled;
            if disabled then {
                return(false)
            };
            ()
        } else {
            if Slice(CPTR_EL2, 10, 1) == 0b1 then {
                return(false)
            };
            ()
        }
    };
    if HaveEL(EL3) then {
        if Slice(CPTR_EL3, 10, 1) == 0b1 then {
            return(false)
        };
        ()
    };
    return(true)
}

val CPACR_read__1 : unit -> bits(32)

function CPACR_read__1 () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(CPACR_EL1, 0, 32));
    return(r)
}

val HCPTR_read : unit -> bits(32)

function HCPTR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(CPTR_EL2, 0, 32));
    return(r)
}

register NSACR : bits(32)

val AArch32_IsFPEnabled : bits(2) -> bool

function AArch32_IsFPEnabled el = {
    if el == EL0 & not_bool(ELUsingAArch32(EL1)) then {
        return(AArch64_IsFPEnabled(el))
    };
    if (HaveEL(EL3) & ELUsingAArch32(EL3)) & not_bool(IsSecure()) then {
        if Slice(NSACR, 10, 1) == 0b0 then {
            return(false)
        };
        ()
    };
    if el == EL0 | el == EL1 then {
        disabled : bool = undefined;
        match Slice(CPACR_read__1(), 20, 2) {
          0b00 => {
              disabled = true
          },
          0b01 => {
              disabled = el == EL0
          },
          0b10 => {
              disabled = ConstrainUnpredictableBool(Unpredictable_RESCPACR)
          },
          0b11 => {
              disabled = false
          }
        };
        let disabled = disabled;
        if disabled then {
            return(false)
        };
        ()
    };
    if (el == EL0 | el == EL1 | el == EL2) & EL2Enabled() then {
        if not_bool(ELUsingAArch32(EL2)) then {
            return(AArch64_IsFPEnabled(EL2))
        };
        if Slice(HCPTR_read(), 10, 1) == 0b1 then {
            return(false)
        };
        ()
    };
    if HaveEL(EL3) & not_bool(ELUsingAArch32(EL3)) then {
        if Slice(CPTR_EL3, 10, 1) == 0b1 then {
            return(false)
        };
        ()
    };
    return(true)
}

val IsFPEnabled : bits(2) -> bool

function IsFPEnabled el = {
    if ELUsingAArch32(el) then {
        return(AArch32_IsFPEnabled(el))
    } else {
        return(AArch64_IsFPEnabled(el))
    }
}

val HaveSVE : unit -> bool

function HaveSVE () = {
    return(HasArchVersion(ARMv8p2) & __IMPDEF_boolean("Have SVE ISA"))
}

val IsNormalSVEEnabled : bits(2) -> bool

function IsNormalSVEEnabled el = {
    disabled : bool = undefined;
    if ELUsingAArch32(el) then {
        return(false)
    };
    if (el == EL0 | el == EL1) & not_bool(IsInHost()) then {
        match Slice(CPACR_EL1, 16, 2) {
          [_, bitzero] => {
              disabled = true
          },
          0b01 => {
              disabled = el == EL0
          },
          0b11 => {
              disabled = false
          }
        };
        if disabled then {
            return(false)
        };
        ()
    };
    if (el == EL0 | el == EL1 | el == EL2) & EL2Enabled() then {
        if HaveVirtHostExt() & Slice(HCR_EL2, 34, 1) == 0b1 then {
            match Slice(CPTR_EL2, 16, 2) {
              [_, bitzero] => {
                  disabled = true
              },
              0b01 => {
                  disabled = el == EL0 & Slice(HCR_EL2, 27, 1) == 0b1
              },
              0b11 => {
                  disabled = false
              }
            };
            if disabled then {
                return(false)
            };
            ()
        } else {
            if Slice(CPTR_EL2, 8, 1) == 0b1 then {
                return(false)
            };
            ()
        }
    };
    if HaveEL(EL3) then {
        if Slice(CPTR_EL3, 8, 1) == 0b0 then {
            return(false)
        };
        ()
    };
    return(true)
}

val IsStreamingSVEEnabled : bits(2) -> bool

function IsStreamingSVEEnabled el = {
    disabled : bool = undefined;
    if ELUsingAArch32(el) then {
        return(false)
    };
    if (el == EL0 | el == EL1) & not_bool(IsInHost()) then {
        match Slice(CPACR_EL1, 24, 2) {
          [_, bitzero] => {
              disabled = true
          },
          0b01 => {
              disabled = el == EL0
          },
          0b11 => {
              disabled = false
          }
        };
        if disabled then {
            return(false)
        };
        ()
    };
    if (el == EL0 | el == EL1 | el == EL2) & EL2Enabled() then {
        if HaveVirtHostExt() & Slice(HCR_EL2, 34, 1) == 0b1 then {
            match Slice(CPTR_EL2, 24, 2) {
              [_, bitzero] => {
                  disabled = true
              },
              0b01 => {
                  disabled = el == EL0 & Slice(HCR_EL2, 27, 1) == 0b1
              },
              0b11 => {
                  disabled = false
              }
            };
            if disabled then {
                return(false)
            };
            ()
        } else {
            if Slice(CPTR_EL2, 12, 1) == 0b1 then {
                return(false)
            };
            ()
        }
    };
    if HaveEL(EL3) then {
        if Slice(CPTR_EL3, 12, 1) == 0b0 then {
            return(false)
        };
        ()
    };
    return(true)
}

val IsSVEEnabled : bits(2) -> bool

function IsSVEEnabled el = {
    if HaveSME() & PSTATE.SM == 0b1 then {
        return(IsStreamingSVEEnabled(el))
    } else if HaveSVE() then {
        return(IsNormalSVEEnabled(el))
    } else {
        return(false)
    }
}

register _P : vector(16, inc, bits(MAX_PL))

val P_set : forall 'n 'width,
  ('n < 16 | not(('n >= 0 & 'n <= 31))) & (256 >= 'width | not(('n >= 0 & 'n <= 31))) & (0 <= 'width - 1 | not(('n >= 0 & 'n <= 31))).
  (implicit('width), int('n), bits('width)) -> unit

function P_set (width, n, value_name) = {
    let 'VL = VL_read();
    let 'PL = PL_of_VL(VL_read());
    assert(n >= 0 & n <= 31);
    assert(width == PL);
    if ConstrainUnpredictableBool(Unpredictable_SVEZEROUPPER) then {
        _P[n] = ZeroExtend(value_name)
    } else {
        _P[n][width - 1 .. 0] = value_name
    }
}

register SP_EL0 : bits(64)

register SP_EL1 : bits(64)

register SP_EL2 : bits(64)

register SP_EL3 : bits(64)

val SP_set : forall 'width, 'width in {32, 64}.
  (implicit('width), bits('width)) -> unit

function SP_set (width, value_name) = {
    assert(width == 32 | width == 64);
    if PSTATE.SP == 0b0 then {
        SP_EL0 = ZeroExtend(value_name)
    } else {
        match PSTATE.EL {
          ? if ? == EL0 => {
              SP_EL0 = ZeroExtend(value_name)
          },
          ? if ? == EL1 => {
              SP_EL1 = ZeroExtend(value_name)
          },
          ? if ? == EL2 => {
              SP_EL2 = ZeroExtend(value_name)
          },
          ? if ? == EL3 => {
              SP_EL3 = ZeroExtend(value_name)
          },
          _ => ()
        }
    };
    return()
}

register _Z : vector(32, inc, bits(MAX_VL))

val V_set : forall 'n 'width,
  'width in {8, 16, 32, 64, 128}.
  (implicit('width), int('n), bits('width)) -> unit

function V_set (width, n, value_name) = {
    let 'VL = VL_read();
    assert(n >= 0 & n <= 31);
    assert(width == 8 | width == 16 | width == 32 | width == 64 | width == 128);
    let 'vlen = if IsSVEEnabled(PSTATE.EL) then VL else 128;
    if ConstrainUnpredictableBool(Unpredictable_SVEZEROUPPER) then {
        _Z[n] = ZeroExtend(value_name)
    } else {
        assert(constraint((0 <= 'vlen - 1 & 'vlen - 1 < 2048 | not(('n >= 0 & 'n <= 31)))));
        assert(constraint(('vlen - 1 - 0 + 1 >= 'width | not(('n >= 0 & 'n <= 31)))));
        _Z[n][vlen - 1 .. 0] = ZeroExtend(value_name)
    }
}

val X_set : forall 'n 'width,
  'width in {32, 64}.
  (implicit('width), int('n), bits('width)) -> unit

val X_set__1 : forall 'n 'width,
  'width in {32, 64}.
  (int('n), int('width), bits('width)) -> unit

function X_set (width, n, value_name) = {
    assert(n >= 0 & n <= 31);
    assert(width == 32 | width == 64);
    if n != 31 then {
        _R[n] = ZeroExtend(value_name)
    };
    return()
}

function X_set__1 (n, width, value_name) = {
    assert(n >= 0 & n <= 31);
    assert(width == 32 | width == 64);
    if n != 31 then {
        _R[n] = ZeroExtend(value_name, 64)
    };
    return()
}

val Z_set : forall 'n 'width,
  (2048 >= 'width | not(('n >= 0 & 'n <= 31))) & (0 <= 'width - 1 | not(('n >= 0 & 'n <= 31))).
  (implicit('width), int('n), bits('width)) -> unit

function Z_set (width, n, value_name) = {
    let 'VL = VL_read();
    assert(n >= 0 & n <= 31);
    assert(width == VL);
    if ConstrainUnpredictableBool(Unpredictable_SVEZEROUPPER) then {
        _Z[n] = ZeroExtend(value_name)
    } else {
        _Z[n][width - 1 .. 0] = value_name
    }
}

val RestoreTransactionCheckpointParameterised : forall 'pl 'vl, (is_VL('vl) & is_PL('pl)).
  (int('vl), int('pl)) -> unit

function RestoreTransactionCheckpointParameterised (vl, pl) = {
    assert(((((((((((((((vl == 128 | vl == 256) | vl == 384) | vl == 512) | vl == 640) | vl == 768) | vl == 896) | vl == 1024) | vl == 1152) | vl == 1280) | vl == 1408) | vl == 1536) | vl == 1664) | vl == 1792) | vl == 1920) | vl == 2048);
    SP_set(64) = TSTATE.SP;
    ICC_PMR_EL1 = TSTATE.ICC_PMR_EL1;
    (PSTATE.N @ PSTATE.Z @ PSTATE.C @ PSTATE.V) = TSTATE.nzcv;
    (PSTATE.D @ PSTATE.A @ PSTATE.I @ PSTATE.F) = TSTATE.D @ (TSTATE.A @ (TSTATE.I @ TSTATE.F));
    foreach (n from 0 to 30 by 1 in inc) {
        X_set(64, n) = TSTATE.X[n]
    };
    if IsFPEnabled(PSTATE.EL) then {
        if IsSVEEnabled(PSTATE.EL) then {
            foreach (n from 0 to 31 by 1 in inc) {
                Z_set(0 + (vl - 1 - 0 + 1), n) = TSTATE.Z[n][vl - 1 .. 0]
            };
            foreach (n from 0 to 15 by 1 in inc) {
                P_set(0 + (pl - 1 - 0 + 1), n) = TSTATE.P[n][pl - 1 .. 0]
            };
            FFR_set(0 + (pl - 1 - 0 + 1)) = TSTATE.FFR[pl - 1 .. 0]
        } else {
            foreach (n from 0 to 31 by 1 in inc) {
                V_set(0 + (127 - 0 + 1), n) = TSTATE.Z[n][127 .. 0]
            }
        };
        FPCR = TSTATE.FPCR;
        FPSR = TSTATE.FPSR
    };
    return()
}

val RestoreTransactionCheckpoint__1 : unit -> unit

function RestoreTransactionCheckpoint__1 () = {
    let 'VL = VL_read();
    match VL {
      128 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      256 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      384 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      512 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      640 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      768 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      896 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      1024 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      1152 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      1280 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      1408 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      1536 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      1664 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      1792 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      1920 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      2048 => {
          RestoreTransactionCheckpointParameterised(VL, DIV(VL, 8))
      },
      _ => {
          assert(false)
      }
    }
}

enum TMFailure = {
  TMFailure_CNCL,
  TMFailure_DBG,
  TMFailure_ERR,
  TMFailure_NEST,
  TMFailure_SIZE,
  TMFailure_MEM,
  TMFailure_TRIVIAL,
  TMFailure_IMP
}

val FailTransaction : forall ('retry : Bool). (TMFailure, bool('retry)) -> unit

val FailTransaction__1 : forall ('interrupt : Bool) ('retry : Bool).
  (TMFailure, bool('retry), bool('interrupt), bits(15)) -> unit

function FailTransaction (cause, retry) = {
    FailTransaction__1(cause, retry, false, Zeros(15));
    return()
}

function FailTransaction__1 (cause, retry, interrupt, reason) = {
    assert(not_bool(retry) | not_bool(interrupt));
    if HaveBRBExt() & BranchRecordAllowed(PSTATE.EL) then {
        BRBFCR_EL1 = SetSlice(1, BRBFCR_EL1, 6, 0b1)
    };
    DiscardTransactionalWrites();
    if cause != TMFailure_TRIVIAL then {
        RestoreTransactionCheckpoint__1()
    };
    ClearExclusiveLocal(ProcessorID());
    result : bits(64) = Zeros();
    result[23] = Bit(if interrupt then 0b1 else 0b0);
    result[15] = Bit(if retry & not_bool(interrupt) then 0b1 else 0b0);
    match cause {
      TMFailure_TRIVIAL => {
          result[24] = Bit(0b1)
      },
      TMFailure_DBG => {
          result[22] = Bit(0b1)
      },
      TMFailure_NEST => {
          result[21] = Bit(0b1)
      },
      TMFailure_SIZE => {
          result[20] = Bit(0b1)
      },
      TMFailure_ERR => {
          result[19] = Bit(0b1)
      },
      TMFailure_IMP => {
          result[18] = Bit(0b1)
      },
      TMFailure_MEM => {
          result[17] = Bit(0b1)
      },
      TMFailure_CNCL => {
          result[16] = Bit(0b1);
          result[14 .. 0] = reason
      }
    };
    TSTATE.depth = 0;
    X_set(64, TSTATE.Rt) = result;
    let branch_conditional : bool = false;
    BranchTo(TSTATE.nPC, BranchType_TMFAIL, branch_conditional);
    EndOfInstruction();
    return()
}

val HaveRASExt : unit -> bool

function HaveRASExt () = {
    return(HasArchVersion(ARMv8p2) | __IMPDEF_boolean("Has RAS extension"))
}

val HaveIESB : unit -> bool

function HaveIESB () = {
    return(HaveRASExt() & __IMPDEF_boolean("Has Implicit Error Synchronization Barrier"))
}

val HaveDoubleFaultExt : unit -> bool

function HaveDoubleFaultExt () = {
    return(((HasArchVersion(ARMv8p4) & HaveEL(EL3)) & not_bool(ELUsingAArch32(EL3))) & HaveIESB())
}

val HaveNVExt : unit -> bool

function HaveNVExt () = {
    return(HasArchVersion(ARMv8p3) & __IMPDEF_boolean("Has Nested Virtualization"))
}

val HaveNV2Ext : unit -> bool

function HaveNV2Ext () = {
    return((HasArchVersion(ARMv8p4) & HaveNVExt()) & __IMPDEF_boolean("Has support for Enhanced Nested Virtualization"))
}

val InsertIESBBeforeException : bits(2) -> bool

register _ZA : vector(256, inc, bits(MAX_VL))

val MaybeZeroSVEUppers : bits(2) -> unit

function MaybeZeroSVEUppers target_el = {
    let 'VL = VL_read();
    lower_enabled : bool = undefined;
    if UInt(target_el) <= UInt(PSTATE.EL) | not_bool(IsSVEEnabled(target_el)) then {
        return()
    };
    if target_el == EL3 then {
        if EL2Enabled() then {
            lower_enabled = IsFPEnabled(EL2)
        } else {
            lower_enabled = IsFPEnabled(EL1)
        }
    } else if target_el == EL2 then {
        assert(not_bool(ELUsingAArch32(EL2)));
        if Slice(HCR_EL2, 27, 1) == 0b0 then {
            lower_enabled = IsFPEnabled(EL1)
        } else {
            lower_enabled = IsFPEnabled(EL0)
        }
    } else {
        assert(target_el == EL1 & not_bool(ELUsingAArch32(EL1)));
        lower_enabled = IsFPEnabled(EL0)
    };
    if lower_enabled then {
        let 'vl = if IsSVEEnabled(PSTATE.EL) then VL else 128;
        let 'pl = DIV(vl, 8);
        foreach (n from 0 to 31 by 1 in inc) {
            if ConstrainUnpredictableBool(Unpredictable_SVEZEROUPPER) then {
                assert(constraint((0 <= 'vl - 1 & 'vl - 1 < 2048)));
                _Z[n] = ZeroExtend(_Z[n][vl - 1 .. 0])
            };
            ()
        };
        foreach (n from 0 to 15 by 1 in inc) {
            if ConstrainUnpredictableBool(Unpredictable_SVEZEROUPPER) then {
                assert(constraint((0 <= 'pl - 1 & 'pl - 1 < 256)));
                _P[n] = ZeroExtend(_P[n][pl - 1 .. 0])
            };
            ()
        };
        if ConstrainUnpredictableBool(Unpredictable_SVEZEROUPPER) then {
            assert(constraint((0 <= 'pl - 1 & 'pl - 1 < 256)));
            _FFR = ZeroExtend(_FFR[pl - 1 .. 0])
        };
        if HaveSME() & PSTATE.ZA == 0b1 then {
            let 'accessiblerows = DIV(VL, 8);
            let 'allrows = DIV(MAX_VL, 8);
            foreach (n from 0 to (accessiblerows - 1) by 1 in inc) {
                if ConstrainUnpredictableBool(Unpredictable_SMEZEROUPPER) then {
                    assert(constraint('loop_n < 256));
                    assert(constraint('VL - 1 < 2048));
                    _ZA[n] = ZeroExtend(_ZA[n][VL - 1 .. 0])
                };
                ()
            };
            foreach (n from accessiblerows to (allrows - 1) by 1 in inc) {
                if ConstrainUnpredictableBool(Unpredictable_SMEZEROUPPER) then {
                    _ZA[n] = Zeros()
                };
                ()
            }
        };
        ()
    };
    ()
}

val ResetSVEState : unit -> unit

function ResetSVEState () = {
    foreach (n from 0 to 31 by 1 in inc) {
        _Z[n] = Zeros()
    };
    foreach (n from 0 to 15 by 1 in inc) {
        _P[n] = Zeros()
    };
    _FFR = Zeros();
    FPSR = ZeroExtend(0x0800009f)
}

register SCTLR_EL1 : bits(64)

register SCTLR_EL2 : bits(64)

register SCTLR_EL3 : bits(64)

val SCTLR_NS_read : unit -> bits(32)

function SCTLR_NS_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(SCTLR_EL1, 0, 32));
    return(r)
}

register SCTLR_S : bits(32)

val SCTLR_read : bits(2) -> bits(64)

val SCTLR_read__1 : unit -> bits(64)

val SCTLR_read__2 : unit -> bits(32)

function SCTLR_read__2 () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = SCTLR_S
    } else {
        r = SCTLR_NS_read()
    };
    return(r)
}

function SCTLR_read regime = {
    r : bits(64) = undefined;
    match regime {
      ? if ? == EL1 => {
          r = SCTLR_EL1
      },
      ? if ? == EL2 => {
          r = SCTLR_EL2
      },
      ? if ? == EL3 => {
          r = SCTLR_EL3
      },
      _ => {
          Unreachable()
      }
    };
    return(r)
}

function SCTLR_read__1 () = {
    return(SCTLR_read(S1TranslationRegime__1()))
}

register SPSR_EL1 : bits(64)

register SPSR_EL2 : bits(64)

register SPSR_EL3 : bits(64)

register SPSR_abt : bits(64)

register SPSR_fiq : bits(64)

val SPSR_hyp_write : bits(32) -> unit

function SPSR_hyp_write val_name = {
    let r : bits(32) = val_name;
    SPSR_EL2 = SetSlice(32, SPSR_EL2, 0, Slice(r, 0, 32));
    return()
}

register SPSR_irq : bits(64)

register SPSR_mon : bits(32)

val SPSR_svc_write : bits(32) -> unit

function SPSR_svc_write val_name = {
    let r : bits(32) = val_name;
    SPSR_EL1 = SetSlice(32, SPSR_EL1, 0, Slice(r, 0, 32));
    return()
}

register SPSR_und : bits(64)

val SPSR_set : forall 'N. (implicit('N), bits('N)) -> unit

function SPSR_set (N, value_name) = {
    if UsingAArch32() then {
        assert(N == 32);
        match PSTATE.M {
          ? if ? == M32_FIQ => {
              SPSR_fiq = ZeroExtend(value_name)
          },
          ? if ? == M32_IRQ => {
              SPSR_irq = ZeroExtend(value_name)
          },
          ? if ? == M32_Svc => {
              SPSR_svc_write() = ZeroExtend(value_name)
          },
          ? if ? == M32_Monitor => {
              SPSR_mon = ZeroExtend(value_name)
          },
          ? if ? == M32_Abort => {
              SPSR_abt = ZeroExtend(value_name)
          },
          ? if ? == M32_Hyp => {
              SPSR_hyp_write() = ZeroExtend(value_name)
          },
          ? if ? == M32_Undef => {
              SPSR_und = ZeroExtend(value_name)
          },
          _ => {
              Unreachable()
          }
        }
    } else {
        assert(N == 64);
        match PSTATE.EL {
          ? if ? == EL1 => {
              SPSR_EL1 = ZeroExtend(value_name)
          },
          ? if ? == EL2 => {
              SPSR_EL2 = ZeroExtend(value_name)
          },
          ? if ? == EL3 => {
              SPSR_EL3 = ZeroExtend(value_name)
          },
          _ => {
              Unreachable()
          }
        }
    };
    return()
}

val SynchronizeContext : unit -> unit

val SynchronizeErrors : unit -> unit

val TakeUnmaskedPhysicalSErrorInterrupts : forall ('iesb_req : Bool).
  bool('iesb_req) -> unit

register VBAR_EL1 : bits(64)

register VBAR_EL2 : bits(64)

register VBAR_EL3 : bits(64)

val VBAR_NS_read : unit -> bits(32)

function VBAR_NS_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(VBAR_EL1, 0, 32));
    return(r)
}

register VBAR_S : bits(32)

val VBAR_read : bits(2) -> bits(64)

val VBAR_read__1 : unit -> bits(64)

val VBAR_read__2 : unit -> bits(32)

function VBAR_read__2 () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = VBAR_S
    } else {
        r = VBAR_NS_read()
    };
    return(r)
}

function VBAR_read regime = {
    r : bits(64) = undefined;
    match regime {
      ? if ? == EL1 => {
          r = VBAR_EL1
      },
      ? if ? == EL2 => {
          r = VBAR_EL2
      },
      ? if ? == EL3 => {
          r = VBAR_EL3
      },
      _ => {
          Unreachable()
      }
    };
    return(r)
}

function VBAR_read__1 () = {
    return(VBAR_read(S1TranslationRegime__1()))
}

val AArch64_TakeException : forall 'vect_offset_in.
  (bits(2), ExceptionRecord, bits(64), int('vect_offset_in)) -> unit

function AArch64_TakeException (target_el, exception_in, preferred_exception_return, vect_offset_in) = {
    iesb_req : bool = undefined;
    assert((HaveEL(target_el) & not_bool(ELUsingAArch32(target_el))) & UInt(target_el) >= UInt(PSTATE.EL));
    exception : ExceptionRecord = exception_in;
    sync_errors : bool = undefined;
    if HaveIESB() then {
        sync_errors = [SCTLR_read(target_el)[21]] == 0b1;
        if HaveDoubleFaultExt() then {
            sync_errors = sync_errors | (Slice(SCR_EL3, 3, 1) @ Slice(SCR_EL3, 20, 1)) == 0b11 & target_el == EL3
        };
        if sync_errors & InsertIESBBeforeException(target_el) then {
            SynchronizeErrors();
            iesb_req = false;
            sync_errors = false;
            TakeUnmaskedPhysicalSErrorInterrupts(iesb_req)
        };
        ()
    } else {
        sync_errors = false
    };
    if HaveTME() & TSTATE.depth > 0 then {
        cause : TMFailure = undefined;
        match exception.exceptype {
          Exception_SoftwareBreakpoint => {
              cause = TMFailure_DBG
          },
          Exception_Breakpoint => {
              cause = TMFailure_DBG
          },
          Exception_Watchpoint => {
              cause = TMFailure_DBG
          },
          Exception_SoftwareStep => {
              cause = TMFailure_DBG
          },
          _ => {
              cause = TMFailure_ERR
          }
        };
        let cause = cause;
        FailTransaction(cause, false)
    };
    SynchronizeContext();
    let from_32 : bool = UsingAArch32();
    if from_32 then {
        AArch64_MaybeZeroRegisterUppers()
    };
    if (from_32 & HaveSME()) & PSTATE.SM == 0b1 then {
        ResetSVEState()
    } else {
        MaybeZeroSVEUppers(target_el)
    };
    vect_offset : int = vect_offset_in;
    if UInt(target_el) > UInt(PSTATE.EL) then {
        lower_32 : bool = undefined;
        if target_el == EL3 then {
            if EL2Enabled() then {
                lower_32 = ELUsingAArch32(EL2)
            } else {
                lower_32 = ELUsingAArch32(EL1)
            }
        } else if (IsInHost() & PSTATE.EL == EL0) & target_el == EL2 then {
            lower_32 = ELUsingAArch32(EL0)
        } else {
            lower_32 = ELUsingAArch32(target_el - 1)
        };
        vect_offset = vect_offset + (if lower_32 then UInt(0x600) else
          UInt(0x400))
    } else if PSTATE.SP == 0b1 then {
        vect_offset = vect_offset + UInt(0x200)
    } else ();
    let 'vect_offset = vect_offset;
    spsr : bits(64) = GetPSRFromPSTATE(64, AArch64_NonDebugState);
    if (PSTATE.EL == EL1 & target_el == EL1) & EL2Enabled() then {
        if HaveNV2Ext() & ((Slice(HCR_EL2, 42, 1) @ (Slice(HCR_EL2, 43, 1) @ Slice(HCR_EL2, 45, 1))) == 0b100 | (Slice(HCR_EL2, 42, 1) @ (Slice(HCR_EL2, 43, 1) @ Slice(HCR_EL2, 45, 1))) == 0b111) then {
            spsr[3 .. 2] = 0b10
        } else {
            if HaveNVExt() & (Slice(HCR_EL2, 42, 1) @ Slice(HCR_EL2, 43, 1)) == 0b10 then {
                spsr[3 .. 2] = 0b10
            };
            ()
        }
    };
    if HaveBTIExt() & not_bool(UsingAArch32()) then {
        zero_btype : bool = undefined;
        if exception.exceptype == Exception_SError | exception.exceptype == Exception_IRQ | exception.exceptype == Exception_FIQ | exception.exceptype == Exception_SoftwareStep | exception.exceptype == Exception_PCAlignment | exception.exceptype == Exception_InstructionAbort | exception.exceptype == Exception_Breakpoint | exception.exceptype == Exception_VectorCatch | exception.exceptype == Exception_SoftwareBreakpoint | exception.exceptype == Exception_IllegalState | exception.exceptype == Exception_BranchTarget then {
            zero_btype = false
        } else {
            zero_btype = ConstrainUnpredictableBool(Unpredictable_ZEROBTYPE)
        };
        if zero_btype then {
            spsr[11 .. 10] = 0b00
        };
        ()
    };
    if (HaveNV2Ext() & exception.exceptype == Exception_NV2DataAbort) & target_el == EL3 then {
        exception.exceptype = Exception_DataAbort
    };
    if not_bool(exception.exceptype == Exception_IRQ | exception.exceptype == Exception_FIQ) then {
        AArch64_ReportException(exception, target_el)
    };
    if HaveBRBExt() then {
        BRBEException(exception.exceptype, preferred_exception_return, VBAR_read(target_el)[63 .. 11] @ vect_offset[10 .. 0], target_el, exception.trappedsyscallinst)
    };
    PSTATE.EL = target_el;
    PSTATE.nRW = 0b0;
    PSTATE.SP = 0b1;
    SPSR_set(64) = spsr;
    ELR_set__1() = preferred_exception_return;
    PSTATE.SS = 0b0;
    if HaveFeatNMI() & not_bool(ELUsingAArch32(target_el)) then {
        PSTATE.ALLINT = not_vec([SCTLR_read__1()[62]])
    };
    (PSTATE.D @ PSTATE.A @ PSTATE.I @ PSTATE.F) = 0b1111;
    PSTATE.IL = 0b0;
    if from_32 then {
        PSTATE.IT = 0b00000000;
        PSTATE.T = 0b0
    };
    if (HavePANExt() & (PSTATE.EL == EL1 | PSTATE.EL == EL2 & ELIsInHost(EL0))) & [SCTLR_read__1()[23]] == 0b0 then {
        PSTATE.PAN = 0b1
    };
    if HaveUAOExt() then {
        PSTATE.UAO = 0b0
    };
    if HaveBTIExt() then {
        PSTATE.BTYPE = 0b00
    };
    if HaveSSBSExt() then {
        PSTATE.SSBS = [SCTLR_read__1()[44]]
    };
    if HaveMTEExt() then {
        PSTATE.TCO = 0b1
    };
    let branch_conditional : bool = false;
    BranchTo(VBAR_read__1()[63 .. 11] @ vect_offset[10 .. 0], BranchType_EXCEPTION, branch_conditional);
    CheckExceptionCatch(true);
    if sync_errors then {
        SynchronizeErrors();
        let iesb_req : bool = true;
        TakeUnmaskedPhysicalSErrorInterrupts(iesb_req)
    };
    EndOfInstruction()
}

val AArch64_SystemAccessTrap : forall 'ec. (bits(2), int('ec)) -> unit

function AArch64_SystemAccessTrap (target_el, ec) = {
    assert((HaveEL(target_el) & target_el != EL0) & UInt(target_el) >= UInt(PSTATE.EL));
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    let exception : ExceptionRecord = AArch64_SystemAccessTrapSyndrome(ThisInstr(), ec);
    AArch64_TakeException(target_el, exception, preferred_exception_return, vect_offset)
}

