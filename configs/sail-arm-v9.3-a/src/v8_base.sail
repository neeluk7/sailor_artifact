val Have52BitPAExt : unit -> bool

function Have52BitPAExt () = {
    return(HasArchVersion(ARMv8p2) & __IMPDEF_boolean("Has large 52-bit PA/IPA support"))
}

val Have52BitVAExt : unit -> bool

function Have52BitVAExt () = {
    return(HasArchVersion(ARMv8p2) & __IMPDEF_boolean("Has large 52-bit VA support"))
}

val Have52BitIPAAndPASpaceExt : unit -> bool

function Have52BitIPAAndPASpaceExt () = {
    return(((HasArchVersion(ARMv8p7) & __IMPDEF_boolean("Has 52-bit IPA and PA support")) & Have52BitVAExt()) & Have52BitPAExt())
}

val EncodeLDFSC : forall 'level. (Fault, int('level)) -> bits(6)

function EncodeLDFSC (statuscode, level) = {
    result : bits(6) = undefined;
    if level == negate(1) then {
        assert(Have52BitIPAAndPASpaceExt());
        match statuscode {
          Fault_AddressSize => {
              result = 0b101001
          },
          Fault_Translation => {
              result = 0b101011
          },
          Fault_SyncExternalOnWalk => {
              result = 0b010011
          },
          Fault_SyncParityOnWalk => {
              result = 0b011011;
              assert(not_bool(HaveRASExt()))
          },
          Fault_GPCFOnWalk => {
              result = 0b100011
          },
          _ => {
              Unreachable()
          }
        };
        return(result)
    };
    match statuscode {
      Fault_AddressSize => {
          result = 0b0000 @ level[1 .. 0];
          assert(level == 0 | level == 1 | level == 2 | level == 3)
      },
      Fault_AccessFlag => {
          result = 0b0010 @ level[1 .. 0];
          assert(level == 0 | level == 1 | level == 2 | level == 3)
      },
      Fault_Permission => {
          result = 0b0011 @ level[1 .. 0];
          assert(level == 0 | level == 1 | level == 2 | level == 3)
      },
      Fault_Translation => {
          result = 0b0001 @ level[1 .. 0];
          assert(level == 0 | level == 1 | level == 2 | level == 3)
      },
      Fault_SyncExternal => {
          result = 0b010000
      },
      Fault_SyncExternalOnWalk => {
          result = 0b0101 @ level[1 .. 0];
          assert(level == 0 | level == 1 | level == 2 | level == 3)
      },
      Fault_SyncParity => {
          result = 0b011000
      },
      Fault_SyncParityOnWalk => {
          result = 0b0111 @ level[1 .. 0];
          assert(level == 0 | level == 1 | level == 2 | level == 3)
      },
      Fault_AsyncParity => {
          result = 0b011001
      },
      Fault_AsyncExternal => {
          result = 0b010001
      },
      Fault_Alignment => {
          result = 0b100001
      },
      Fault_Debug => {
          result = 0b100010
      },
      Fault_GPCFOnWalk => {
          result = 0b1001 @ level[1 .. 0];
          assert(level == 0 | level == 1 | level == 2 | level == 3)
      },
      Fault_GPCFOnOutput => {
          result = 0b101000
      },
      Fault_TLBConflict => {
          result = 0b110000
      },
      Fault_HWUpdateAccessFlag => {
          result = 0b110001
      },
      Fault_Lockdown => {
          result = 0b110100
      },
      Fault_Exclusive => {
          result = 0b110101
      },
      _ => {
          Unreachable()
      }
    };
    return(result)
}

enum GPCF = {GPCF_None, GPCF_AddressSize, GPCF_Walk, GPCF_EABT, GPCF_Fail}

struct GPCFRecord = {gpf : GPCF, level : int}

struct FaultRecord = {
  statuscode : Fault,
  acctype : AccType,
  ipaddress : FullAddress,
  gpcf : GPCFRecord,
  paddress : FullAddress,
  gpcfs2walk : bool,
  s2fs1walk : bool,
  write : bool,
  level : int,
  extflag : bits(1),
  secondstage : bool,
  domain : bits(4),
  errortype : bits(2),
  debugmoe : bits(4)
}

val HaveFeatLS64 : unit -> bool

function HaveFeatLS64 () = {
    return(HasArchVersion(ARMv8p7) & __IMPDEF_boolean("Has Load Store 64-Byte instruction support"))
}

val IsAsyncAbort : Fault -> bool

val IsAsyncAbort__1 : FaultRecord -> bool

function IsAsyncAbort statuscode = {
    assert(statuscode != Fault_None);
    return(statuscode == Fault_AsyncExternal | statuscode == Fault_AsyncParity)
}

function IsAsyncAbort__1 fault = {
    return(IsAsyncAbort(fault.statuscode))
}

val IsExternalAbort : Fault -> bool

val IsExternalAbort__1 : FaultRecord -> bool

function IsExternalAbort statuscode = {
    assert(statuscode != Fault_None);
    return(statuscode == Fault_SyncExternal | statuscode == Fault_SyncParity | statuscode == Fault_SyncExternalOnWalk | statuscode == Fault_SyncParityOnWalk | statuscode == Fault_AsyncExternal | statuscode == Fault_AsyncParity)
}

function IsExternalAbort__1 fault = {
    return(IsExternalAbort(fault.statuscode) | fault.gpcf.gpf == GPCF_EABT)
}

val IsExternalSyncAbort : Fault -> bool

val IsExternalSyncAbort__1 : FaultRecord -> bool

function IsExternalSyncAbort statuscode = {
    assert(statuscode != Fault_None);
    return(statuscode == Fault_SyncExternal | statuscode == Fault_SyncParity | statuscode == Fault_SyncExternalOnWalk | statuscode == Fault_SyncParityOnWalk)
}

function IsExternalSyncAbort__1 fault = {
    return(IsExternalSyncAbort(fault.statuscode) | fault.gpcf.gpf == GPCF_EABT)
}

val IsSecondStage : FaultRecord -> bool

function IsSecondStage fault = {
    assert(fault.statuscode != Fault_None);
    return(fault.secondstage)
}

val LS64InstructionSyndrome : unit -> (bits(5), bits(11), bits(2))

val LSInstructionSyndrome : unit -> bits(11)

val AArch64_FaultSyndrome : forall ('d_side : Bool).
  (bool('d_side), FaultRecord) -> (bits(25), bits(5))

function AArch64_FaultSyndrome (d_side, fault) = {
    assert(fault.statuscode != Fault_None);
    iss : bits(25) = Zeros();
    iss2 : bits(5) = Zeros();
    if (not_bool(HaveFeatLS64()) & HaveRASExt()) & IsAsyncAbort__1(fault) then {
        iss[12 .. 11] = fault.errortype
    };
    if d_side then {
        if HaveFeatLS64() & fault.acctype == AccType_ATOMICLS64 then {
            if fault.statuscode == Fault_AccessFlag | fault.statuscode == Fault_Translation | fault.statuscode == Fault_Permission then {
                (iss2, iss[24 .. 14], iss[12 .. 11]) = LS64InstructionSyndrome()
            };
            ()
        } else {
            if (IsSecondStage(fault) & not_bool(fault.s2fs1walk)) & (not_bool(IsExternalSyncAbort__1(fault)) | (not_bool(HaveRASExt()) & fault.acctype == AccType_TTW) & __IMPDEF_boolean("ISV on second stage translation table walk")) then {
                iss[24 .. 14] = LSInstructionSyndrome()
            };
            ()
        };
        if HaveNV2Ext() & fault.acctype == AccType_NV2REGISTER then {
            iss[13] = Bit(0b1)
        };
        if fault.acctype == AccType_DC | fault.acctype == AccType_IC | fault.acctype == AccType_AT | fault.acctype == AccType_ATPAN then {
            iss[8] = Bit(0b1);
            iss[6] = Bit(0b1)
        } else {
            iss[6] = Bit(if fault.write then 0b1 else 0b0)
        }
    };
    if IsExternalAbort__1(fault) then {
        iss[9] = Bit(fault.extflag)
    };
    iss[7] = Bit(if fault.s2fs1walk then 0b1 else 0b0);
    iss[5 .. 0] = EncodeLDFSC(fault.statuscode, fault.level);
    return((iss, iss2))
}

val IPAValid : FaultRecord -> bool

function IPAValid fault = {
    assert(fault.statuscode != Fault_None);
    if fault.gpcf.gpf != GPCF_None then {
        return(fault.secondstage)
    } else if fault.s2fs1walk then {
        return(fault.statuscode == Fault_AccessFlag | fault.statuscode == Fault_Permission | fault.statuscode == Fault_Translation | fault.statuscode == Fault_AddressSize)
    } else if fault.secondstage then {
        return(fault.statuscode == Fault_AccessFlag | fault.statuscode == Fault_Translation | fault.statuscode == Fault_AddressSize)
    } else {
        return(false)
    }
}

val AArch64_AbortSyndrome : (Exception, FaultRecord, bits(64)) -> ExceptionRecord

function AArch64_AbortSyndrome (exceptype, fault, vaddress) = {
    exception : ExceptionRecord = ExceptionSyndrome(exceptype);
    let d_side : bool = exceptype == Exception_DataAbort | exceptype == Exception_NV2DataAbort | exceptype == Exception_Watchpoint | exceptype == Exception_NV2Watchpoint;
    (exception.syndrome, exception.syndrome2) = AArch64_FaultSyndrome(d_side, fault);
    exception.vaddress = ZeroExtend(vaddress);
    if IPAValid(fault) then {
        exception.ipavalid = true;
        exception.NS = if fault.ipaddress.paspace == PAS_NonSecure then 0b1 else
          0b0;
        exception.ipaddress = fault.ipaddress.address
    } else {
        exception.ipavalid = false
    };
    return(exception)
}

val AArch64_BreakpointException : FaultRecord -> unit

function AArch64_BreakpointException fault = {
    assert(PSTATE.EL != EL3);
    let route_to_el2 : bool = ((PSTATE.EL == EL0 | PSTATE.EL == EL1) & EL2Enabled()) & (Slice(HCR_EL2, 27, 1) == 0b1 | Slice(MDCR_EL2, 8, 1) == 0b1);
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    let vaddress : bits(64) = __UNKNOWN_bits(64);
    let exception : ExceptionRecord = AArch64_AbortSyndrome(Exception_Breakpoint, fault, vaddress);
    if PSTATE.EL == EL2 | route_to_el2 then {
        AArch64_TakeException(EL2, exception, preferred_exception_return, vect_offset)
    } else {
        AArch64_TakeException(EL1, exception, preferred_exception_return, vect_offset)
    }
}

val AArch64_DataAbort : (bits(64), FaultRecord) -> unit

function AArch64_DataAbort (vaddress, fault) = {
    let route_to_el3 : bool = (HaveEL(EL3) & Slice(SCR_EL3, 3, 1) == 0b1) & IsExternalAbort__1(fault);
    let route_to_el2 : bool = (EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & ((((Slice(HCR_EL2, 27, 1) == 0b1 | (HaveRASExt() & Slice(HCR_EL2, 37, 1) == 0b1) & IsExternalAbort__1(fault)) | (HaveRME() & fault.gpcf.gpf == GPCF_Fail) & Slice(HCR_EL2, 48, 1) == 0b1) | HaveNV2Ext() & fault.acctype == AccType_NV2REGISTER) | IsSecondStage(fault));
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    vect_offset : int = undefined;
    if ((HaveDoubleFaultExt() & (PSTATE.EL == EL3 | route_to_el3)) & IsExternalAbort__1(fault)) & Slice(SCR_EL3, 19, 1) == 0b1 then {
        vect_offset = UInt(0x180)
    } else {
        vect_offset = UInt(0x0)
    };
    let 'vect_offset = vect_offset;
    exception : ExceptionRecord = undefined;
    if HaveNV2Ext() & fault.acctype == AccType_NV2REGISTER then {
        exception = AArch64_AbortSyndrome(Exception_NV2DataAbort, fault, vaddress)
    } else {
        exception = AArch64_AbortSyndrome(Exception_DataAbort, fault, vaddress)
    };
    target_el : bits(2) = EL1;
    if PSTATE.EL == EL3 | route_to_el3 then {
        target_el = EL3
    } else if PSTATE.EL == EL2 | route_to_el2 then {
        target_el = EL2
    } else ();
    AArch64_TakeException(target_el, exception, preferred_exception_return, vect_offset)
}

val AArch64_InstructionAbort : (bits(64), FaultRecord) -> unit

function AArch64_InstructionAbort (vaddress, fault) = {
    if HaveDoubleFaultExt() then {
        assert(fault.statuscode != Fault_AsyncExternal)
    };
    let route_to_el3 : bool = (HaveEL(EL3) & Slice(SCR_EL3, 3, 1) == 0b1) & IsExternalAbort__1(fault);
    let route_to_el2 : bool = (EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & (((Slice(HCR_EL2, 27, 1) == 0b1 | (HaveRASExt() & Slice(HCR_EL2, 37, 1) == 0b1) & IsExternalAbort__1(fault)) | (HaveRME() & fault.gpcf.gpf == GPCF_Fail) & Slice(HCR_EL2, 48, 1) == 0b1) | IsSecondStage(fault));
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    vect_offset : int = undefined;
    if ((HaveDoubleFaultExt() & (PSTATE.EL == EL3 | route_to_el3)) & IsExternalAbort__1(fault)) & Slice(SCR_EL3, 19, 1) == 0b1 then {
        vect_offset = UInt(0x180)
    } else {
        vect_offset = UInt(0x0)
    };
    let 'vect_offset = vect_offset;
    let exception : ExceptionRecord = AArch64_AbortSyndrome(Exception_InstructionAbort, fault, vaddress);
    target_el : bits(2) = EL1;
    if PSTATE.EL == EL3 | route_to_el3 then {
        target_el = EL3
    } else if PSTATE.EL == EL2 | route_to_el2 then {
        target_el = EL2
    } else ();
    AArch64_TakeException(target_el, exception, preferred_exception_return, vect_offset)
}

val AArch64_VectorCatchException : FaultRecord -> unit

function AArch64_VectorCatchException fault = {
    assert(PSTATE.EL != EL2);
    assert(EL2Enabled() & (Slice(HCR_EL2, 27, 1) == 0b1 | Slice(MDCR_EL2, 8, 1) == 0b1));
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    let vaddress : bits(64) = __UNKNOWN_bits(64);
    let exception : ExceptionRecord = AArch64_AbortSyndrome(Exception_VectorCatch, fault, vaddress);
    AArch64_TakeException(EL2, exception, preferred_exception_return, vect_offset)
}

val AArch64_WatchpointException : (bits(64), FaultRecord) -> unit

function AArch64_WatchpointException (vaddress, fault) = {
    assert(PSTATE.EL != EL3);
    let route_to_el2 : bool = ((PSTATE.EL == EL0 | PSTATE.EL == EL1) & EL2Enabled()) & (Slice(HCR_EL2, 27, 1) == 0b1 | Slice(MDCR_EL2, 8, 1) == 0b1);
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    exception : ExceptionRecord = undefined;
    if HaveNV2Ext() & fault.acctype == AccType_NV2REGISTER then {
        exception = AArch64_AbortSyndrome(Exception_NV2Watchpoint, fault, vaddress)
    } else {
        exception = AArch64_AbortSyndrome(Exception_Watchpoint, fault, vaddress)
    };
    if PSTATE.EL == EL2 | route_to_el2 then {
        AArch64_TakeException(EL2, exception, preferred_exception_return, vect_offset)
    } else {
        AArch64_TakeException(EL1, exception, preferred_exception_return, vect_offset)
    }
}

let DebugException_VectorCatch : bits(4) = 0b0101

val IsDebugException : FaultRecord -> bool

function IsDebugException fault = {
    assert(fault.statuscode != Fault_None);
    return(fault.statuscode == Fault_Debug)
}

val ReportAsGPCException : FaultRecord -> bool

function ReportAsGPCException fault = {
    assert(HaveRME());
    assert(fault.statuscode == Fault_GPCFOnWalk | fault.statuscode == Fault_GPCFOnOutput);
    assert(fault.gpcf.gpf != GPCF_None);
    match fault.gpcf.gpf {
      GPCF_Walk => {
          return(true)
      },
      GPCF_AddressSize => {
          return(true)
      },
      GPCF_EABT => {
          return(true)
      },
      GPCF_Fail => {
          return(Slice(SCR_EL3, 48, 1) == 0b1 & PSTATE.EL != EL3)
      },
      _ => {
          return(undefined : bool)
      }
    }
}

val EncodeGPCSC : GPCFRecord -> bits(6)

function EncodeGPCSC gpcf = {
    assert(gpcf.level == 0 | gpcf.level == 1);
    match gpcf.gpf {
      GPCF_AddressSize => {
          return(0b00000 @ [gpcf.level[0]])
      },
      GPCF_Walk => {
          return(0b00010 @ [gpcf.level[0]])
      },
      GPCF_Fail => {
          return(0b00110 @ [gpcf.level[0]])
      },
      GPCF_EABT => {
          return(0b01010 @ [gpcf.level[0]])
      },
      _ => {
          return(undefined : bits(6))
      }
    }
}

val HaveAccessFlagUpdateExt : unit -> bool

function HaveAccessFlagUpdateExt () = {
    return(HasArchVersion(ARMv8p1))
}

val HaveAtomicExt : unit -> bool

function HaveAtomicExt () = {
    return(HasArchVersion(ARMv8p1))
}

val HaveDirtyBitModifierExt : unit -> bool

function HaveDirtyBitModifierExt () = {
    return(HasArchVersion(ARMv8p1))
}

val HavePrivATExt : unit -> bool

function HavePrivATExt () = {
    return(HasArchVersion(ARMv8p2))
}

val IsAtomicRW : AccType -> bool

function IsAtomicRW acctype = {
    return(acctype == AccType_ATOMICRW | acctype == AccType_ORDEREDRW | acctype == AccType_ORDEREDATOMICRW)
}

val TakeGPCException : (bits(64), FaultRecord) -> unit

function TakeGPCException (vaddress, fault) = {
    assert(HaveRME());
    assert(HavePrivATExt());
    assert(HaveAtomicExt());
    assert(HaveAccessFlagUpdateExt());
    assert(HaveDirtyBitModifierExt());
    assert(HaveDoubleFaultExt());
    exception : ExceptionRecord = undefined;
    exception.exceptype = Exception_GPC;
    exception.vaddress = ZeroExtend(vaddress);
    exception.paddress = fault.paddress;
    if IPAValid(fault) then {
        exception.ipavalid = true;
        exception.NS = if fault.ipaddress.paspace == PAS_NonSecure then 0b1 else
          0b0;
        exception.ipaddress = fault.ipaddress.address
    } else {
        exception.ipavalid = false
    };
    exception.syndrome[24 .. 22] = Zeros();
    exception.syndrome[21 .. 21] = if fault.gpcfs2walk then 0b1 else 0b0;
    exception.syndrome[20 .. 20] = if fault.acctype == AccType_IFETCH then 0b1
    else
      0b0;
    exception.syndrome[19 .. 14] = EncodeGPCSC(fault.gpcf);
    if HaveNV2Ext() & fault.acctype == AccType_NV2REGISTER then {
        exception.syndrome[13 .. 13] = 0b1
    } else {
        exception.syndrome[13 .. 13] = 0b0
    };
    exception.syndrome[12 .. 11] = Zeros();
    exception.syndrome[10 .. 9] = Zeros();
    if fault.acctype == AccType_DC | fault.acctype == AccType_IC | fault.acctype == AccType_AT | fault.acctype == AccType_ATPAN then {
        exception.syndrome[8 .. 8] = 0b1
    } else {
        exception.syndrome[8 .. 8] = 0b0
    };
    exception.syndrome[7 .. 7] = if fault.s2fs1walk then 0b1 else 0b0;
    if fault.acctype == AccType_DC | fault.acctype == AccType_IC | fault.acctype == AccType_AT | fault.acctype == AccType_ATPAN then {
        exception.syndrome[6 .. 6] = 0b1
    } else if fault.statuscode == Fault_HWUpdateAccessFlag | fault.statuscode == Fault_Exclusive then {
        exception.syndrome[6 .. 6] = __UNKNOWN_bits(1)
    } else if IsAtomicRW(fault.acctype) & IsExternalAbort__1(fault) then {
        exception.syndrome[6 .. 6] = __UNKNOWN_bits(1)
    } else {
        exception.syndrome[6 .. 6] = if fault.write then 0b1 else 0b0
    };
    exception.syndrome[5 .. 0] = EncodeLDFSC(fault.statuscode, fault.level);
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    vect_offset : int = undefined;
    if IsExternalAbort__1(fault) & Slice(SCR_EL3, 19, 1) == 0b1 then {
        vect_offset = UInt(0x180)
    } else {
        vect_offset = UInt(0x0)
    };
    let 'vect_offset = vect_offset;
    AArch64_TakeException(EL3, exception, preferred_exception_return, vect_offset)
}

val AArch64_Abort : (bits(64), FaultRecord) -> unit

function AArch64_Abort (vaddress, fault) = {
    if IsDebugException(fault) then {
        if fault.acctype == AccType_IFETCH then {
            if UsingAArch32() & fault.debugmoe == DebugException_VectorCatch then {
                AArch64_VectorCatchException(fault)
            } else {
                AArch64_BreakpointException(fault)
            }
        } else {
            AArch64_WatchpointException(vaddress, fault)
        }
    } else if fault.gpcf.gpf != GPCF_None & ReportAsGPCException(fault) then {
        TakeGPCException(vaddress, fault)
    } else if fault.acctype == AccType_IFETCH then {
        AArch64_InstructionAbort(vaddress, fault)
    } else {
        AArch64_DataAbort(vaddress, fault)
    }
}

val AlignmentFault : forall ('iswrite : Bool) ('secondstage : Bool).
  (AccType, bool('iswrite), bool('secondstage)) -> FaultRecord

function AlignmentFault (acctype, iswrite, secondstage) = {
    fault : FaultRecord = undefined;
    fault.statuscode = Fault_Alignment;
    fault.acctype = acctype;
    fault.write = iswrite;
    fault.secondstage = secondstage;
    return(fault)
}

val HaveLSE2Ext : unit -> bool

function HaveLSE2Ext () = {
    return(HasArchVersion(ARMv8p4))
}

val AArch64_CheckAlignment : forall 'alignment ('iswrite : Bool).
  (bits(64), int('alignment), AccType, bool('iswrite)) -> bool

function AArch64_CheckAlignment (address, alignment, acctype, iswrite) = {
    secondstage : bool = undefined;
    let aligned : bool = address == Align(address, alignment);
    let atomic : bool = acctype == AccType_ATOMIC | acctype == AccType_ATOMICRW | acctype == AccType_ORDEREDATOMIC | acctype == AccType_ORDEREDATOMICRW | acctype == AccType_ATOMICLS64 | acctype == AccType_A32LSMD;
    let ordered : bool = acctype == AccType_ORDERED | acctype == AccType_ORDEREDRW | acctype == AccType_LIMITEDORDERED | acctype == AccType_ORDEREDATOMIC | acctype == AccType_ORDEREDATOMICRW;
    vector_name = acctype == AccType_VEC;
    check : bool = undefined;
    if [SCTLR_read__1()[1]] == 0b1 then {
        check = true
    } else if HaveLSE2Ext() then {
        check = UInt(address[3 .. 0]) + alignment > 16 & (ordered & [SCTLR_read__1()[6]] == 0b0 | atomic)
    } else {
        check = atomic | ordered
    };
    if check & not_bool(aligned) then {
        let secondstage : bool = false;
        AArch64_Abort(address, AlignmentFault(acctype, iswrite, secondstage))
    };
    return(aligned)
}

val AArch64_AccessUsesEL : AccType -> bits(2)

function AArch64_AccessUsesEL acctype = {
    if acctype == AccType_UNPRIV | acctype == AccType_UNPRIVSTREAM then {
        return(EL0)
    } else if acctype == AccType_NV2REGISTER then {
        return(EL2)
    } else {
        return(PSTATE.EL)
    }
}

val AArch64_AllocationTagAccessIsEnabled : AccType -> bool

function AArch64_AllocationTagAccessIsEnabled acctype = {
    let el : bits(2) = AArch64_AccessUsesEL(acctype);
    if Slice(SCR_EL3, 26, 1) == 0b0 & (el == EL0 | el == EL1 | el == EL2) then {
        return(false)
    } else if ((Slice(HCR_EL2, 56, 1) == 0b0 & (el == EL0 | el == EL1)) & EL2Enabled()) & (Slice(HCR_EL2, 34, 1) @ Slice(HCR_EL2, 27, 1)) != 0b11 then {
        return(false)
    } else if Slice(SCTLR_EL3, 43, 1) == 0b0 & el == EL3 then {
        return(false)
    } else if Slice(SCTLR_EL2, 43, 1) == 0b0 & el == EL2 then {
        return(false)
    } else if Slice(SCTLR_EL1, 43, 1) == 0b0 & el == EL1 then {
        return(false)
    } else if ((Slice(SCTLR_EL2, 42, 1) == 0b0 & el == EL0) & EL2Enabled()) & (Slice(HCR_EL2, 34, 1) @ Slice(HCR_EL2, 27, 1)) == 0b11 then {
        return(false)
    } else if (Slice(SCTLR_EL1, 42, 1) == 0b0 & el == EL0) & not_bool(EL2Enabled() & (Slice(HCR_EL2, 34, 1) @ Slice(HCR_EL2, 27, 1)) == 0b11) then {
        return(false)
    } else {
        return(true)
    }
}

val EffectiveTCMA : (bits(64), bits(2)) -> bits(1)

function EffectiveTCMA (address, el) = {
    tcma : bits(1) = undefined;
    assert(HaveEL(el));
    let regime : bits(2) = S1TranslationRegime(el);
    assert(not_bool(ELUsingAArch32(regime)));
    match regime {
      ? if ? == EL1 => {
          tcma = if [address[55]] == 0b1 then Slice(TCR_EL1, 58, 1) else
            Slice(TCR_EL1, 57, 1)
      },
      ? if ? == EL2 => {
          if HaveVirtHostExt() & ELIsInHost(el) then {
              tcma = if [address[55]] == 0b1 then Slice(TCR_EL2, 58, 1) else
                Slice(TCR_EL2, 57, 1)
          } else {
              tcma = Slice(TCR_EL2, 30, 1)
          }
      },
      ? if ? == EL3 => {
          tcma = Slice(TCR_EL3, 30, 1)
      },
      _ => ()
    };
    return(tcma)
}

val IsSIMDFPLoadStore : unit -> bool

val IsSMESaveRestore : unit -> bool

val IsTagCheckedInstruction : unit -> bool

val AArch64_AccessIsTagChecked : (bits(64), AccType) -> bool

function AArch64_AccessIsTagChecked (vaddr, acctype) = {
    if [PSTATE.M[4]] == 0b1 then {
        return(false)
    };
    if EffectiveTBI(vaddr, false, PSTATE.EL) == 0b0 then {
        return(false)
    };
    if EffectiveTCMA(vaddr, PSTATE.EL) == 0b1 & (vaddr[59 .. 55] == 0b00000 | vaddr[59 .. 55] == 0b11111) then {
        return(false)
    };
    if not_bool(AArch64_AllocationTagAccessIsEnabled(acctype)) then {
        return(false)
    };
    if acctype == AccType_IFETCH | acctype == AccType_TTW | acctype == AccType_DC | acctype == AccType_IC then {
        return(false)
    };
    if acctype == AccType_NV2REGISTER then {
        return(false)
    };
    if PSTATE.TCO == 0b1 then {
        return(false)
    };
    if ((HaveSME() & PSTATE.SM == 0b1) & IsSIMDFPLoadStore()) & __IMPDEF_boolean("No tag checking of SIMD&FP loads and stores in Streaming SVE mode") then {
        return(false)
    };
    if (HaveSME() & IsSMESaveRestore()) & __IMPDEF_boolean("No tag checking of SME LDR & STR instructions") then {
        return(false)
    };
    if not_bool(IsTagCheckedInstruction()) then {
        return(false)
    };
    return(true)
}

struct MPAMinfo = {mpam_sp : bits(2), partid : bits(16), pmg : bits(8)}

struct AccessDescriptor = {
  transactional : bool,
  mpam : MPAMinfo,
  acctype : AccType
}

enum DeviceType = {
  DeviceType_GRE,
  DeviceType_nGRE,
  DeviceType_nGnRE,
  DeviceType_nGnRnE
}

struct MemAttrHints = {attrs : bits(2), hints : bits(2), transient : bool}

enum MemType = {MemType_Normal, MemType_Device}

enum Shareability = {Shareability_NSH, Shareability_ISH, Shareability_OSH}

val __UNKNOWN_Shareability : unit -> Shareability

function __UNKNOWN_Shareability () = undefined

struct MemoryAttributes = {
  memtype : MemType,
  device : DeviceType,
  inner : MemAttrHints,
  outer : MemAttrHints,
  shareability : Shareability,
  tagged : bool,
  xs : bits(1)
}

val __UNKNOWN_MemoryAttributes : unit -> MemoryAttributes

function __UNKNOWN_MemoryAttributes () = undefined

enum Regime = {Regime_EL3, Regime_EL30, Regime_EL2, Regime_EL20, Regime_EL10}

enum TGx = {TGx_4KB, TGx_16KB, TGx_64KB}

struct TLBContext = {
  ss : SecurityState,
  regime : Regime,
  vmid : bits(16),
  asid : bits(16),
  nG : bits(1),
  ipaspace : PASpace,
  includes_s1_name : bool,
  includes_s2_name : bool,
  includes_gpt_name : bool,
  ia : bits(64),
  tg : TGx,
  cnp : bits(1),
  xs : bits(1)
}

struct AddressDescriptor = {
  fault : FaultRecord,
  memattrs : MemoryAttributes,
  paddress : FullAddress,
  tlbcontext : TLBContext,
  vaddress : bits(64)
}

val __UNKNOWN_AddressDescriptor : unit -> AddressDescriptor

function __UNKNOWN_AddressDescriptor () = undefined

val AArch32_FaultSyndrome : forall ('d_side : Bool).
  (bool('d_side), FaultRecord) -> bits(25)

function AArch32_FaultSyndrome (d_side, fault) = {
    assert(fault.statuscode != Fault_None);
    iss : bits(25) = Zeros();
    if HaveRASExt() & IsAsyncAbort__1(fault) then {
        iss[11 .. 10] = fault.errortype
    };
    if d_side then {
        if (IsSecondStage(fault) & not_bool(fault.s2fs1walk)) & (not_bool(IsExternalSyncAbort__1(fault)) | (not_bool(HaveRASExt()) & fault.acctype == AccType_TTW) & __IMPDEF_boolean("ISV on second stage translation table walk")) then {
            iss[24 .. 14] = LSInstructionSyndrome()
        };
        if fault.acctype == AccType_DC | fault.acctype == AccType_IC | fault.acctype == AccType_AT | fault.acctype == AccType_ATPAN then {
            iss[8] = Bit(0b1);
            iss[6] = Bit(0b1)
        } else {
            iss[6] = Bit(if fault.write then 0b1 else 0b0)
        }
    };
    if IsExternalAbort__1(fault) then {
        iss[9] = Bit(fault.extflag)
    };
    iss[7] = Bit(if fault.s2fs1walk then 0b1 else 0b0);
    iss[5 .. 0] = EncodeLDFSC(fault.statuscode, fault.level);
    return(iss)
}

val AArch32_AbortSyndrome : (Exception, FaultRecord, bits(32)) -> ExceptionRecord

function AArch32_AbortSyndrome (exceptype, fault, vaddress) = {
    exception : ExceptionRecord = ExceptionSyndrome(exceptype);
    let d_side : bool = exceptype == Exception_DataAbort;
    exception.syndrome = AArch32_FaultSyndrome(d_side, fault);
    exception.vaddress = ZeroExtend(vaddress);
    if IPAValid(fault) then {
        exception.ipavalid = true;
        exception.NS = if fault.ipaddress.paspace == PAS_NonSecure then 0b1 else
          0b0;
        exception.ipaddress = ZeroExtend(fault.ipaddress.address)
    } else {
        exception.ipavalid = false
    };
    return(exception)
}

val AArch32_ExceptionClass : Exception -> (int, bits(1))

function AArch32_ExceptionClass exceptype = {
    il_is_valid : bool = true;
    ec : int = undefined;
    match exceptype {
      Exception_Uncategorized => {
          ec = UInt(0x00);
          il_is_valid = false
      },
      Exception_WFxTrap => {
          ec = UInt(0x01)
      },
      Exception_CP15RTTrap => {
          ec = UInt(0x03)
      },
      Exception_CP15RRTTrap => {
          ec = UInt(0x04)
      },
      Exception_CP14RTTrap => {
          ec = UInt(0x05)
      },
      Exception_CP14DTTrap => {
          ec = UInt(0x06)
      },
      Exception_AdvSIMDFPAccessTrap => {
          ec = UInt(0x07)
      },
      Exception_FPIDTrap => {
          ec = UInt(0x08)
      },
      Exception_PACTrap => {
          ec = UInt(0x09)
      },
      Exception_TSTARTAccessTrap => {
          ec = UInt(0x1B)
      },
      Exception_GPC => {
          ec = UInt(0x1E)
      },
      Exception_CP14RRTTrap => {
          ec = UInt(0x0C)
      },
      Exception_BranchTarget => {
          ec = UInt(0x0D)
      },
      Exception_IllegalState => {
          ec = UInt(0x0E);
          il_is_valid = false
      },
      Exception_SupervisorCall => {
          ec = UInt(0x11)
      },
      Exception_HypervisorCall => {
          ec = UInt(0x12)
      },
      Exception_MonitorCall => {
          ec = UInt(0x13)
      },
      Exception_InstructionAbort => {
          ec = UInt(0x20);
          il_is_valid = false
      },
      Exception_PCAlignment => {
          ec = UInt(0x22);
          il_is_valid = false
      },
      Exception_DataAbort => {
          ec = UInt(0x24)
      },
      Exception_NV2DataAbort => {
          ec = UInt(0x25)
      },
      Exception_FPTrappedException => {
          ec = UInt(0x28)
      },
      _ => {
          Unreachable()
      }
    };
    if (ec == UInt(0x20) | ec == UInt(0x24)) & PSTATE.EL == EL2 then {
        ec = ec + 1
    };
    let 'ec = ec;
    il : bits(1) = undefined;
    if il_is_valid then {
        il = if ThisInstrLength() == 32 then 0b1 else 0b0
    } else {
        il = 0b1
    };
    return((ec, il))
}

val HDFAR_write : bits(32) -> unit

function HDFAR_write val_name = {
    let r : bits(32) = val_name;
    FAR_EL2 = SetSlice(32, FAR_EL2, 0, Slice(r, 0, 32));
    return()
}

val HIFAR_write : bits(32) -> unit

function HIFAR_write val_name = {
    let r : bits(32) = val_name;
    FAR_EL2 = SetSlice(32, FAR_EL2, 32, Slice(r, 0, 32));
    return()
}

val HPFAR_read : unit -> bits(32)

function HPFAR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(HPFAR_EL2, 0, 32));
    return(r)
}

val HPFAR_write : bits(32) -> unit

function HPFAR_write val_name = {
    let r : bits(32) = val_name;
    HPFAR_EL2 = SetSlice(32, HPFAR_EL2, 0, Slice(r, 0, 32));
    return()
}

val HSR_write : bits(32) -> unit

function HSR_write val_name = {
    let r : bits(32) = val_name;
    ESR_EL2 = SetSlice(32, ESR_EL2, 0, Slice(r, 0, 32));
    return()
}

val AArch32_ReportHypEntry : ExceptionRecord -> unit

function AArch32_ReportHypEntry exception = {
    ec : int = undefined;
    il : bits(1) = undefined;
    let exceptype : Exception = exception.exceptype;
    (ec, il) = AArch32_ExceptionClass(exceptype);
    let 'ec = ec;
    let iss : bits(25) = exception.syndrome;
    if (ec == UInt(0x24) | ec == UInt(0x25)) & [iss[24]] == 0b0 then {
        il = 0b1
    };
    let il = il;
    HSR_write() = (ec[5 .. 0] @ il) @ iss;
    if exceptype == Exception_InstructionAbort | exceptype == Exception_PCAlignment then {
        HIFAR_write() = exception.vaddress[31 .. 0];
        HDFAR_write() = __UNKNOWN_bits(32)
    } else if exceptype == Exception_DataAbort then {
        HIFAR_write() = __UNKNOWN_bits(32);
        HDFAR_write() = exception.vaddress[31 .. 0]
    } else ();
    if exception.ipavalid then {
        HPFAR_write() = [HPFAR_read() with 31 .. 4 = exception.ipaddress[39 .. 12]]
    } else {
        HPFAR_write() = [HPFAR_read() with 31 .. 4 = __UNKNOWN_bits(28)]
    };
    return()
}

val ELFromM32 : bits(5) -> (bool, bits(2))

function ELFromM32 mode = {
    el : bits(2) = undefined;
    valid_name : bool = not_bool(BadMode(mode));
    match mode {
      ? if ? == M32_Monitor => {
          el = EL3
      },
      ? if ? == M32_Hyp => {
          el = EL2;
          valid_name = valid_name & (not_bool(HaveEL(EL3)) | [SCR_GEN_read()[0]] == 0b1)
      },
      ? if ? == M32_FIQ => {
          el = if (HaveEL(EL3) & not_bool(HaveAArch64())) & Slice(SCR, 0, 1) == 0b0 then
            EL3
          else
            EL1
      },
      ? if ? == M32_IRQ => {
          el = if (HaveEL(EL3) & not_bool(HaveAArch64())) & Slice(SCR, 0, 1) == 0b0 then
            EL3
          else
            EL1
      },
      ? if ? == M32_Svc => {
          el = if (HaveEL(EL3) & not_bool(HaveAArch64())) & Slice(SCR, 0, 1) == 0b0 then
            EL3
          else
            EL1
      },
      ? if ? == M32_Abort => {
          el = if (HaveEL(EL3) & not_bool(HaveAArch64())) & Slice(SCR, 0, 1) == 0b0 then
            EL3
          else
            EL1
      },
      ? if ? == M32_Undef => {
          el = if (HaveEL(EL3) & not_bool(HaveAArch64())) & Slice(SCR, 0, 1) == 0b0 then
            EL3
          else
            EL1
      },
      ? if ? == M32_System => {
          el = if (HaveEL(EL3) & not_bool(HaveAArch64())) & Slice(SCR, 0, 1) == 0b0 then
            EL3
          else
            EL1
      },
      ? if ? == M32_User => {
          el = EL0
      },
      _ => {
          valid_name = false
      }
    };
    if not_bool(valid_name) then {
        el = __UNKNOWN_bits(2)
    };
    let el = el;
    return((valid_name, el))
}

val AArch32_WriteMode : bits(5) -> unit

function AArch32_WriteMode mode = {
    el : bits(2) = undefined;
    valid_name : bool = undefined;
    (valid_name, el) = ELFromM32(mode);
    assert(valid_name);
    PSTATE.M = mode;
    PSTATE.EL = el;
    PSTATE.nRW = 0b1;
    PSTATE.SP = if mode == M32_User | mode == M32_System then 0b0 else 0b1;
    return()
}

val ELR_hyp_write : bits(32) -> unit

function ELR_hyp_write val_name = {
    let r : bits(32) = val_name;
    ELR_EL2 = SetSlice(32, ELR_EL2, 0, Slice(r, 0, 32));
    return()
}

val HSCTLR_read : unit -> bits(32)

function HSCTLR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(SCTLR_EL2, 0, 32));
    return(r)
}

val HVBAR_read : unit -> bits(32)

function HVBAR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(VBAR_EL2, 0, 32));
    return(r)
}

val AArch32_EnterHypMode : forall 'vect_offset.
  (ExceptionRecord, bits(32), int('vect_offset)) -> unit

function AArch32_EnterHypMode (exception, preferred_exception_return, vect_offset) = {
    SynchronizeContext();
    assert((HaveEL(EL2) & not_bool(IsSecure())) & ELUsingAArch32(EL2));
    let spsr : bits(32) = GetPSRFromPSTATE(32, AArch32_NonDebugState);
    if not_bool(exception.exceptype == Exception_IRQ | exception.exceptype == Exception_FIQ) then {
        AArch32_ReportHypEntry(exception)
    };
    AArch32_WriteMode(M32_Hyp);
    SPSR_set(32) = spsr;
    ELR_hyp_write() = preferred_exception_return;
    PSTATE.T = Slice(HSCTLR_read(), 30, 1);
    PSTATE.SS = 0b0;
    if not_bool(HaveEL(EL3)) | [SCR_GEN_read()[3]] == 0b0 then {
        PSTATE.A = 0b1
    };
    if not_bool(HaveEL(EL3)) | [SCR_GEN_read()[1]] == 0b0 then {
        PSTATE.I = 0b1
    };
    if not_bool(HaveEL(EL3)) | [SCR_GEN_read()[2]] == 0b0 then {
        PSTATE.F = 0b1
    };
    PSTATE.E = Slice(HSCTLR_read(), 25, 1);
    PSTATE.IL = 0b0;
    PSTATE.IT = 0b00000000;
    if HaveSSBSExt() then {
        PSTATE.SSBS = Slice(HSCTLR_read(), 31, 1)
    };
    let branch_conditional : bool = false;
    BranchTo(HVBAR_read()[31 .. 5] @ vect_offset[4 .. 0], BranchType_EXCEPTION, branch_conditional);
    CheckExceptionCatch(true);
    EndOfInstruction()
}

val ExcVectorBase : unit -> bits(32)

function ExcVectorBase () = {
    if Slice(SCTLR_read__2(), 13, 1) == 0b1 then {
        return(Ones(16) @ Zeros(16))
    } else {
        return(VBAR_read__2()[31 .. 5] @ Zeros(5))
    }
}

val Rmode_set : forall 'n. (int('n), bits(5), bits(32)) -> unit

function Rmode_set (n, mode, value_name) = {
    assert(n >= 0 & n <= 14);
    if not_bool(IsSecure()) then {
        assert(mode != M32_Monitor)
    };
    assert(not_bool(BadMode(mode)));
    if mode == M32_Monitor then {
        if n == 13 then {
            SP_mon = value_name
        } else if n == 14 then {
            LR_mon = value_name
        } else {
            _R[n][31 .. 0] = value_name
        }
    } else {
        if HaveAArch64() & ConstrainUnpredictableBool(Unpredictable_ZEROUPPER) then {
            _R[LookUpRIndex(n, mode)] = ZeroExtend(value_name)
        } else {
            _R[LookUpRIndex(n, mode)][31 .. 0] = value_name
        }
    };
    return()
}

val R_set : forall 'n. (int('n), bits(32)) -> unit

function R_set (n, value_name) = {
    Rmode_set(n, PSTATE.M) = value_name;
    return()
}

val AArch32_EnterMode : forall 'lr_offset 'vect_offset.
  (bits(5), bits(32), int('lr_offset), int('vect_offset)) -> unit

function AArch32_EnterMode (target_mode, preferred_exception_return, lr_offset, vect_offset) = {
    SynchronizeContext();
    assert(ELUsingAArch32(EL1) & PSTATE.EL != EL2);
    let spsr : bits(32) = GetPSRFromPSTATE(32, AArch32_NonDebugState);
    if PSTATE.M == M32_Monitor then {
        SCR = SetSlice(1, SCR, 0, 0b0)
    };
    AArch32_WriteMode(target_mode);
    SPSR_set(32) = spsr;
    R_set(14) = preferred_exception_return + lr_offset;
    PSTATE.T = Slice(SCTLR_read__2(), 30, 1);
    PSTATE.SS = 0b0;
    if target_mode == M32_FIQ then {
        (PSTATE.A @ PSTATE.I @ PSTATE.F) = 0b111
    } else if target_mode == M32_Abort | target_mode == M32_IRQ then {
        (PSTATE.A @ PSTATE.I) = 0b11
    } else {
        PSTATE.I = 0b1
    };
    PSTATE.E = Slice(SCTLR_read__2(), 25, 1);
    PSTATE.IL = 0b0;
    PSTATE.IT = 0b00000000;
    if HavePANExt() & Slice(SCTLR_read__2(), 23, 1) == 0b0 then {
        PSTATE.PAN = 0b1
    };
    if HaveSSBSExt() then {
        PSTATE.SSBS = Slice(SCTLR_read__2(), 31, 1)
    };
    let branch_conditional : bool = false;
    BranchTo(ExcVectorBase()[31 .. 5] @ vect_offset[4 .. 0], BranchType_EXCEPTION, branch_conditional);
    CheckExceptionCatch(true);
    EndOfInstruction()
}

register MVBAR : bits(32)

val AArch32_EnterMonitorMode : forall 'lr_offset 'vect_offset.
  (bits(32), int('lr_offset), int('vect_offset)) -> unit

function AArch32_EnterMonitorMode (preferred_exception_return, lr_offset, vect_offset) = {
    SynchronizeContext();
    assert(HaveEL(EL3) & ELUsingAArch32(EL3));
    let from_secure : bool = IsSecure();
    let spsr : bits(32) = GetPSRFromPSTATE(32, AArch32_NonDebugState);
    if PSTATE.M == M32_Monitor then {
        SCR = SetSlice(1, SCR, 0, 0b0)
    };
    AArch32_WriteMode(M32_Monitor);
    SPSR_set(32) = spsr;
    R_set(14) = preferred_exception_return + lr_offset;
    PSTATE.T = Slice(SCTLR_read__2(), 30, 1);
    PSTATE.SS = 0b0;
    (PSTATE.A @ PSTATE.I @ PSTATE.F) = 0b111;
    PSTATE.E = Slice(SCTLR_read__2(), 25, 1);
    PSTATE.IL = 0b0;
    PSTATE.IT = 0b00000000;
    if HavePANExt() then {
        if not_bool(from_secure) then {
            PSTATE.PAN = 0b0
        } else if Slice(SCTLR_read__2(), 23, 1) == 0b0 then {
            PSTATE.PAN = 0b1
        } else ()
    };
    if HaveSSBSExt() then {
        PSTATE.SSBS = Slice(SCTLR_read__2(), 31, 1)
    };
    let branch_conditional : bool = false;
    BranchTo(MVBAR[31 .. 5] @ vect_offset[4 .. 0], BranchType_EXCEPTION, branch_conditional);
    CheckExceptionCatch(true);
    EndOfInstruction()
}

val AArch32_FaultStatusLD : forall ('d_side : Bool).
  (bool('d_side), FaultRecord) -> bits(32)

function AArch32_FaultStatusLD (d_side, fault) = {
    assert(fault.statuscode != Fault_None);
    fsr : bits(32) = Zeros();
    if HaveRASExt() & IsAsyncAbort__1(fault) then {
        fsr[15 .. 14] = fault.errortype
    };
    if d_side then {
        if fault.acctype == AccType_DC | fault.acctype == AccType_IC | fault.acctype == AccType_AT | fault.acctype == AccType_ATPAN then {
            fsr[13] = Bit(0b1);
            fsr[11] = Bit(0b1)
        } else {
            fsr[11] = Bit(if fault.write then 0b1 else 0b0)
        }
    };
    if IsExternalAbort__1(fault) then {
        fsr[12] = Bit(fault.extflag)
    };
    fsr[9] = Bit(0b1);
    fsr[5 .. 0] = EncodeLDFSC(fault.statuscode, fault.level);
    return(fsr)
}

val EncodeSDFSC : forall 'level. (Fault, int('level)) -> bits(5)

function EncodeSDFSC (statuscode, level) = {
    result : bits(5) = undefined;
    match statuscode {
      Fault_AccessFlag => {
          assert(level == 1 | level == 2);
          result = if level == 1 then 0b00011 else 0b00110
      },
      Fault_Alignment => {
          result = 0b00001
      },
      Fault_Permission => {
          assert(level == 1 | level == 2);
          result = if level == 1 then 0b01101 else 0b01111
      },
      Fault_Domain => {
          assert(level == 1 | level == 2);
          result = if level == 1 then 0b01001 else 0b01011
      },
      Fault_Translation => {
          assert(level == 1 | level == 2);
          result = if level == 1 then 0b00101 else 0b00111
      },
      Fault_SyncExternal => {
          result = 0b01000
      },
      Fault_SyncExternalOnWalk => {
          assert(level == 1 | level == 2);
          result = if level == 1 then 0b01100 else 0b01110
      },
      Fault_SyncParity => {
          result = 0b11001
      },
      Fault_SyncParityOnWalk => {
          assert(level == 1 | level == 2);
          result = if level == 1 then 0b11100 else 0b11110
      },
      Fault_AsyncParity => {
          result = 0b11000
      },
      Fault_AsyncExternal => {
          result = 0b10110
      },
      Fault_Debug => {
          result = 0b00010
      },
      Fault_TLBConflict => {
          result = 0b10000
      },
      Fault_Lockdown => {
          result = 0b10100
      },
      Fault_Exclusive => {
          result = 0b10101
      },
      Fault_ICacheMaint => {
          result = 0b00100
      },
      _ => {
          Unreachable()
      }
    };
    return(result)
}

val AArch32_FaultStatusSD : forall ('d_side : Bool).
  (bool('d_side), FaultRecord) -> bits(32)

function AArch32_FaultStatusSD (d_side, fault) = {
    assert(fault.statuscode != Fault_None);
    fsr : bits(32) = Zeros();
    if HaveRASExt() & IsAsyncAbort__1(fault) then {
        fsr[15 .. 14] = fault.errortype
    };
    if d_side then {
        if fault.acctype == AccType_DC | fault.acctype == AccType_IC | fault.acctype == AccType_AT | fault.acctype == AccType_ATPAN then {
            fsr[13] = Bit(0b1);
            fsr[11] = Bit(0b1)
        } else {
            fsr[11] = Bit(if fault.write then 0b1 else 0b0)
        }
    };
    if IsExternalAbort__1(fault) then {
        fsr[12] = Bit(fault.extflag)
    };
    fsr[9] = Bit(0b0);
    (fsr[10 .. 10] @ fsr[3 .. 0]) = EncodeSDFSC(fault.statuscode, fault.level);
    if d_side then {
        fsr[7 .. 4] = fault.domain
    };
    return(fsr)
}

val DFAR_NS_write : bits(32) -> unit

function DFAR_NS_write val_name = {
    let r : bits(32) = val_name;
    FAR_EL1 = SetSlice(32, FAR_EL1, 0, Slice(r, 0, 32));
    return()
}

