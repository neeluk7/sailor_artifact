}

val AArch32_EncodePARLD : (AddressDescriptor, SecurityState) -> unit

function AArch32_EncodePARLD (addrdesc, ss) = {
    if not_bool(IsFault(addrdesc)) then {
        ns : bits(1) = undefined;
        if ss == SS_NonSecure then {
            ns = __UNKNOWN_bits(1)
        } else if addrdesc.paddress.paspace == PAS_Secure then {
            ns = 0b0
        } else {
            ns = 0b1
        };
        let ns : bits(1) = if addrdesc.paddress.paspace == PAS_Secure then 0b0
        else
          0b1;
        PAR_write() = SetSlice(1, PAR_read(), 0, 0b0);
        PAR_write() = SetSlice(2, PAR_read(), 7, ReportedPARShareability(PAREncodeShareability(addrdesc.memattrs)));
        PAR_write() = SetSlice(1, PAR_read(), 9, ns);
        PAR_write() = [PAR_read() with 10 .. 10 = __IMPDEF_bits(1, "Non-Faulting PAR")];
        PAR_write() = SetSlice(1, PAR_read(), 11, 0b1);
        PAR_write() = SetSlice(28, PAR_read(), 12, addrdesc.paddress.address[39 .. 12]);
        PAR_write() = SetSlice(8, PAR_read(), 56, ReportedPARAttrs(EncodePARAttrs(addrdesc.memattrs)))
    } else {
        PAR_write() = SetSlice(1, PAR_read(), 0, 0b1);
        PAR_write() = SetSlice(6, PAR_read(), 1, AArch32_PARFaultStatusLD(addrdesc.fault));
        PAR_write() = SetSlice(1, PAR_read(), 8, if addrdesc.fault.s2fs1walk then
          0b1
        else
          0b0);
        PAR_write() = SetSlice(1, PAR_read(), 9, if addrdesc.fault.secondstage then
          0b1
        else
          0b0);
        PAR_write() = SetSlice(1, PAR_read(), 11, 0b1);
        PAR_write() = [PAR_read() with 63 .. 48 = __IMPDEF_bits(16, "Faulting PAR")]
    };
    return()
}

val AArch32_PARFaultStatusSD : FaultRecord -> bits(6)

function AArch32_PARFaultStatusSD fault = {
    let syndrome : bits(32) = AArch32_FaultStatusSD(true, fault);
    return(syndrome[12 .. 12] @ (syndrome[10 .. 10] @ syndrome[3 .. 0]))
}

val AArch32_PARInnerAttrs : MemoryAttributes -> bits(3)

function AArch32_PARInnerAttrs memattrs = {
    result : bits(3) = undefined;
    if memattrs.memtype == MemType_Device then {
        if memattrs.device == DeviceType_nGnRnE then {
            result = 0b001
        } else if memattrs.device == DeviceType_nGnRE then {
            result = 0b011
        } else ()
    } else {
        let inner : MemAttrHints = memattrs.inner;
        if inner.attrs == MemAttr_NC then {
            result = 0b000
        } else if inner.attrs == MemAttr_WB & [inner.hints[0]] == 0b1 then {
            result = 0b101
        } else if inner.attrs == MemAttr_WT then {
            result = 0b110
        } else if inner.attrs == MemAttr_WB & [inner.hints[0]] == 0b0 then {
            result = 0b111
        } else ()
    };
    return(result)
}

val AArch32_PAROuterAttrs : MemoryAttributes -> bits(2)

function AArch32_PAROuterAttrs memattrs = {
    result : bits(2) = undefined;
    if memattrs.memtype == MemType_Device then {
        result = __UNKNOWN_bits(2)
    } else {
        let outer : MemAttrHints = memattrs.outer;
        if outer.attrs == MemAttr_NC then {
            result = 0b00
        } else if outer.attrs == MemAttr_WB & [outer.hints[0]] == 0b1 then {
            result = 0b01
        } else if outer.attrs == MemAttr_WT & [outer.hints[0]] == 0b0 then {
            result = 0b10
        } else if outer.attrs == MemAttr_WB & [outer.hints[0]] == 0b0 then {
            result = 0b11
        } else ()
    };
    return(result)
}

val AArch32_ReportedInnerAttrs : bits(3) -> bits(3)

val AArch32_ReportedOuterAttrs : bits(2) -> bits(2)

val AArch32_EncodePARSD : (AddressDescriptor, bits(1), SecurityState) -> unit

function AArch32_EncodePARSD (addrdesc_in, supersection, ss) = {
    addrdesc : AddressDescriptor = addrdesc_in;
    if not_bool(IsFault(addrdesc)) then {
        if addrdesc.memattrs.memtype == MemType_Device | addrdesc.memattrs.inner.attrs == MemAttr_NC & addrdesc.memattrs.outer.attrs == MemAttr_NC then {
            addrdesc.memattrs.shareability = Shareability_OSH
        };
        ns : bits(1) = undefined;
        if ss == SS_NonSecure then {
            ns = __UNKNOWN_bits(1)
        } else if addrdesc.paddress.paspace == PAS_Secure then {
            ns = 0b0
        } else {
            ns = 0b1
        };
        let ns : bits(1) = if addrdesc.paddress.paspace == PAS_Secure then 0b0
        else
          0b1;
        let sh : bits(2) = if addrdesc.memattrs.shareability != Shareability_NSH then
          0b01
        else
          0b00;
        PAR_write() = SetSlice(1, PAR_read(), 0, 0b0);
        PAR_write() = SetSlice(1, PAR_read(), 1, supersection);
        PAR_write() = SetSlice(2, PAR_read(), 2, AArch32_ReportedOuterAttrs(AArch32_PAROuterAttrs(addrdesc.memattrs)));
        PAR_write() = SetSlice(3, PAR_read(), 4, AArch32_ReportedInnerAttrs(AArch32_PARInnerAttrs(addrdesc.memattrs)));
        PAR_write() = SetSlice(2, PAR_read(), 7, ReportedPARShareability(sh));
        PAR_write() = [PAR_read() with 8 .. 8 = __IMPDEF_bits(1, "Non-Faulting PAR")];
        PAR_write() = SetSlice(1, PAR_read(), 9, ns);
        PAR_write() = SetSlice(1, PAR_read(), 10, if addrdesc.memattrs.shareability == Shareability_OSH then
          0b0
        else
          0b1);
        PAR_write() = SetSlice(1, PAR_read(), 11, 0b0);
        PAR_write() = SetSlice(28, PAR_read(), 12, addrdesc.paddress.address[39 .. 12])
    } else {
        PAR_write() = SetSlice(1, PAR_read(), 0, 0b1);
        PAR_write() = SetSlice(6, PAR_read(), 1, AArch32_PARFaultStatusSD(addrdesc.fault));
        PAR_write() = SetSlice(1, PAR_read(), 11, 0b0);
        PAR_write() = [PAR_read() with 31 .. 16 = __IMPDEF_bits(16, "Faulting PAR")]
    };
    return()
}

val AArch32_AT : (bits(32), TranslationStage, bits(2), ATAccess) -> unit

function AArch32_AT (vaddress, stage_in, el, ataccess) = {
    s2fs1walk : bool = undefined;
    sdftype : SDFType = undefined;
    stage : TranslationStage = stage_in;
    ss : SecurityState = undefined;
    regime : Regime = undefined;
    eae : bool = undefined;
    if el == EL2 then {
        regime = Regime_EL2;
        eae = true;
        ss = SS_NonSecure
    } else if stage == TranslationStage_1 | stage == TranslationStage_12 & not_bool(HaveEL(EL2)) then {
        stage = TranslationStage_1;
        ss = SecurityStateAtEL(PSTATE.EL);
        regime = if ss == SS_Secure & ELUsingAArch32(EL3) then Regime_EL30 else
          Regime_EL10;
        eae = Slice(TTBCR_read(), 31, 1) == 0b1
    } else {
        regime = Regime_EL10;
        eae = if HaveAArch32EL(EL3) then Slice(TTBCR_NS_read(), 31, 1) == 0b1
        else
          Slice(TTBCR_read(), 31, 1) == 0b1;
        ss = SS_NonSecure
    };
    addrdesc : AddressDescriptor = undefined;
    let aligned : bool = true;
    let ispriv : bool = el != EL0;
    supersection : bits(1) = 0b0;
    let iswrite : bool = ataccess == ATAccess_WritePAN | ataccess == ATAccess_Write;
    let acctype : AccType = if ataccess == ATAccess_Read | ataccess == ATAccess_Write then
      AccType_AT
    else
      AccType_ATPAN;
    fault : FaultRecord = NoFault();
    fault.acctype = acctype;
    fault.write = iswrite;
    if eae then {
        (fault, addrdesc) = AArch32_S1TranslateLD(fault, regime, ss, vaddress, acctype, aligned, iswrite, ispriv)
    } else {
        (fault, addrdesc, sdftype) = AArch32_S1TranslateSD(fault, regime, ss, vaddress, acctype, aligned, iswrite, ispriv);
        supersection = if sdftype == SDFType_Supersection then 0b1 else 0b0
    };
    if stage == TranslationStage_12 & fault.statuscode == Fault_None then {
        let s2fs1walk : bool = false;
        (fault, addrdesc) = AArch32_S2Translate(fault, addrdesc, ss, s2fs1walk, acctype, aligned, iswrite, ispriv)
    };
    if fault.statuscode != Fault_None then {
        if IsExternalAbort__1(fault) | (((stage == TranslationStage_1 & el != EL2) & PSTATE.EL == EL1) & EL2Enabled()) & fault.s2fs1walk then {
            PAR_write() = __UNKNOWN_bits(64);
            AArch32_Abort(vaddress, fault)
        };
        ()
    };
    addrdesc.fault = fault;
    if (eae | stage == TranslationStage_12 & (Slice(HCR_read(), 0, 1) == 0b1 | Slice(HCR_read(), 12, 1) == 0b1)) | (stage == TranslationStage_1 & el != EL2) & PSTATE.EL == EL2 then {
        AArch32_EncodePARLD(addrdesc, ss)
    } else {
        AArch32_EncodePARSD(addrdesc, supersection, ss)
    };
    return()
}

