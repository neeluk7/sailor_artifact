val ClearExclusiveByAddress : forall 'processorid 'size.
  (FullAddress, int('processorid), int('size)) -> unit

val HandleExternalWriteAbort : forall 'size.
  (PhysMemRetStatus, AddressDescriptor, int('size), AccessDescriptor) -> unit

function HandleExternalWriteAbort (memstatus, memaddrdesc, size, accdesc) = {
    let iswrite : bool = true;
    HandleExternalAbort(memstatus, iswrite, memaddrdesc, size, accdesc)
}

val AArch64_MemSingle_set : forall ('aligned : Bool) 'size,
  'size in {1, 2, 4, 8, 16}.
  (bits(64), int('size), AccType, bool('aligned), bits('size * 8)) -> unit

val AArch64_MemSingle_set__1 : forall ('aligned : Bool) ('ispair : Bool) 'size,
  ('size in {1, 2, 4, 8, 16} & (0 < div('size, 2) | not('ispair))).
  (bits(64), int('size), AccType, bool('aligned), bool('ispair), bits('size * 8)) -> unit

function AArch64_MemSingle_set (address, size, acctype, aligned, value_name) = {
    let ispair : bool(false) = false;
    AArch64_MemSingle_set__1(address, size, acctype, aligned, ispair) = value_name;
    return()
}

function AArch64_MemSingle_set__1 (address, size, acctype, aligned, ispair, value_name) = {
    atomic : bool = undefined;
    fault : FaultRecord = undefined;
    memstatus : PhysMemRetStatus = undefined;
    splitpair : bool = undefined;
    assert(size == 1 | size == 2 | size == 4 | size == 8 | size == 16);
    let 'halfsize = DIV(size, 2);
    if HaveLSE2Ext() then {
        assert(CheckAllInAlignedQuantity(address, size, 16))
    } else {
        assert(address == Align(address, size))
    };
    let iswrite : bool = true;
    memaddrdesc : AddressDescriptor = AArch64_TranslateAddress(address, acctype, iswrite, aligned, size);
    if IsFault(memaddrdesc) then {
        AArch64_Abort(address, memaddrdesc.fault)
    };
    if memaddrdesc.memattrs.shareability != Shareability_NSH then {
        ClearExclusiveByAddress(memaddrdesc.paddress, ProcessorID(), size)
    };
    accdesc : AccessDescriptor = undefined;
    if HaveTME() then {
        accdesc = CreateAccessDescriptor(acctype);
        accdesc.transactional = TSTATE.depth > 0;
        if accdesc.transactional & not_bool(MemHasTransactionalAccess(memaddrdesc.memattrs)) then {
            FailTransaction(TMFailure_IMP, false)
        };
        ()
    } else {
        accdesc = CreateAccessDescriptor(acctype)
    };
    if HaveRME() then {
        fault : FaultRecord = NoFault();
        fault.gpcf = GranuleProtectionCheck(memaddrdesc, accdesc);
        if fault.gpcf.gpf != GPCF_None then {
            fault.statuscode = Fault_GPCFOnOutput;
            fault.paddress = memaddrdesc.paddress;
            fault.acctype = acctype;
            fault.write = true;
            AArch64_Abort(address, fault)
        };
        ()
    };
    let fault = fault;
    if HaveMTE2Ext() then {
        if AArch64_AccessIsTagChecked(ZeroExtend(address, 64), acctype) then {
            let ptag : bits(4) = AArch64_PhysicalTag(ZeroExtend(address, 64));
            if not_bool(AArch64_CheckTag(memaddrdesc, accdesc, ptag, iswrite)) then {
                AArch64_TagCheckFault(ZeroExtend(address, 64), acctype, iswrite)
            };
            ()
        };
        ()
    };
    (atomic, splitpair) = CheckSingleAccessAttributes(address, memaddrdesc.memattrs, size, acctype, iswrite, aligned, ispair);
    if atomic then {
        let memstatus : PhysMemRetStatus = PhysMemWrite(memaddrdesc, size, accdesc, value_name);
        if IsFault__2(memstatus) then {
            HandleExternalWriteAbort(memstatus, memaddrdesc, size, accdesc)
        };
        ()
    } else if splitpair then {
        assert(ispair);
        lowhalf : bits('halfsize * 8) = undefined;
        highhalf : bits('halfsize * 8) = undefined;
        (highhalf @ lowhalf) = value_name;
        memstatus : PhysMemRetStatus = PhysMemWrite(memaddrdesc, halfsize, accdesc, lowhalf);
        if IsFault__2(memstatus) then {
            HandleExternalWriteAbort(memstatus, memaddrdesc, halfsize, accdesc)
        };
        memaddrdesc.paddress.address = memaddrdesc.paddress.address + halfsize;
        let memstatus : PhysMemRetStatus = PhysMemWrite(memaddrdesc, halfsize, accdesc, highhalf);
        if IsFault__2(memstatus) then {
            HandleExternalWriteAbort(memstatus, memaddrdesc, halfsize, accdesc)
        };
        ()
    } else {
        foreach (i from 0 to (size - 1) by 1 in inc) {
            memstatus = PhysMemWrite(memaddrdesc, 1, accdesc, value_name[8 * i + 7 .. 8 * i]);
            if IsFault__2(memstatus) then {
                HandleExternalWriteAbort(memstatus, memaddrdesc, 1, accdesc)
            };
            memaddrdesc.paddress.address = memaddrdesc.paddress.address + 1
        }
    };
    return()
}

val Mem_set : forall 'size, 'size in {1, 2, 4, 8, 16}.
  (bits(64), int('size), AccType, bits('size * 8)) -> unit

val Mem_set__1 : forall ('ispair : Bool) 'size,
  'size in {1, 2, 4, 8, 16}.
  (bits(64), int('size), AccType, bool('ispair), bits('size * 8)) -> unit

function Mem_set (address, size, acctype, value_in_name) = {
    let ispair : bool = false;
    Mem_set__1(address, size, acctype, ispair) = value_in_name
}

function Mem_set__1 (address, size, acctype, ispair, value_in_name) = {
    c : Constraint = undefined;
    single_is_aligned : bool = undefined;
    let iswrite : bool = true;
    let 'halfsize = DIV(size, 2);
    value_name : bits('size * 8) = value_in_name;
    atomic : bool = undefined;
    aligned : bool = undefined;
    if BigEndian(acctype) then {
        value_name = BigEndianReverse(value_name)
    };
    if ispair then {
        aligned = AArch64_CheckAlignment(address, halfsize, acctype, iswrite)
    } else {
        aligned = AArch64_CheckAlignment(address, size, acctype, iswrite)
    };
    if ispair then {
        atomic = CheckAllInAlignedQuantity(address, size, 16)
    } else if size != 16 | not_bool(acctype == AccType_VEC | acctype == AccType_VECSTREAM) then {
        if not_bool(HaveLSE2Ext()) then {
            atomic = aligned
        } else {
            atomic = CheckAllInAlignedQuantity(address, size, 16)
        }
    } else if acctype == AccType_VEC | acctype == AccType_VECSTREAM then {
        atomic = address == Align(address, 8)
    } else {
        atomic = address == Align(address, 16)
    };
    if (not_bool(atomic) & ispair) & address == Align(address, halfsize) then {
        assert(halfsize > 0);
        let single_is_aligned : bool = true;
        assert(constraint('size * 8 == 'halfsize * 8 + 'halfsize * 8));
        let lowhalf : bits('halfsize * 8) = value_name[8 * halfsize - 1 .. 0];
        let highhalf : bits('halfsize * 8) = value_name[16 * halfsize - 1 .. 8 * halfsize];
        assert(constraint((0 < div('halfsize, 2) | not('ispair))));
        AArch64_MemSingle_set__1(address, halfsize, acctype, single_is_aligned, ispair) = lowhalf;
        AArch64_MemSingle_set__1(address + halfsize, halfsize, acctype, single_is_aligned, ispair) = highhalf
    } else if atomic & ispair then {
        assert(constraint((0 < div('size, 2) | not('ispair))));
        AArch64_MemSingle_set__1(address, size, acctype, aligned, ispair) = value_name
    } else if not_bool(atomic) then {
        assert(size > 1);
        AArch64_MemSingle_set(address, 1, acctype, aligned) = value_name[7 .. 0];
        if not_bool(aligned) then {
            let c : Constraint = ConstrainUnpredictable(Unpredictable_DEVPAGE2);
            assert(c == Constraint_FAULT | c == Constraint_NONE);
            if c == Constraint_NONE then {
                aligned = true
            };
            ()
        };
        foreach (i from 1 to (size - 1) by 1 in inc) {
            AArch64_MemSingle_set(address + i, 1, acctype, aligned) = value_name[8 * i + 7 .. 8 * i]
        }
    } else if size == 16 & (acctype == AccType_VEC | acctype == AccType_VECSTREAM) then {
        AArch64_MemSingle_set__1(address, halfsize, acctype, aligned, ispair) = value_name[63 .. 0];
        AArch64_MemSingle_set__1(address + halfsize, halfsize, acctype, aligned, ispair) = value_name[127 .. 64]
    } else {
        assert(constraint((0 < div('size, 2) | not('ispair))));
        AArch64_MemSingle_set__1(address, size, acctype, aligned, ispair) = value_name
    };
    return()
}

val NVMem_set : forall 'offset. (int('offset), bits(64)) -> unit

function NVMem_set (offset, value_name) = {
    assert(offset > 0);
    let address : bits(64) = SignExtend(Slice(VNCR_EL2, 12, 41) @ offset[11 .. 0], 64);
    Mem_set(address, 8, AccType_NV2REGISTER) = value_name;
    return()
}

