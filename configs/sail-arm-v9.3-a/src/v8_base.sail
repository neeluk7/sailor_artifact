          },
          15 => {
              result = UInt(0xbda8f76380fbb401)
          },
          _ => ()
        }
    };
    let 'result = result;
    return(result[N - 1 .. 0])
}

val FPTrigMAdd : forall 'N 'x_in,
  'N in {16, 32, 64}.
  (int('x_in), bits('N), bits('N), bits(64)) -> bits('N)

function FPTrigMAdd (x_in, op1, op2_in, fpcr) = {
    assert('N == 16 | 'N == 32 | 'N == 64);
    op2 : bits('N) = op2_in;
    x : int = x_in;
    assert(x >= 0);
    assert(x < 8);
    if [op2['N - 1]] == 0b1 then {
        x = x + 8
    };
    let 'x = x;
    let coeff : bits('N) = FPTrigMAddCoefficient_read('N, x);
    let op2 : bits('N) = FPAbs(op2);
    let result : bits('N) = FPMulAdd(coeff, op1, op2, fpcr);
    return(result)
}

