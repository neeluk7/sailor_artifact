function AESShiftRows op = {
    return(((((((((((((((op[95 .. 88] @ op[55 .. 48]) @ op[15 .. 8]) @ op[103 .. 96]) @ op[63 .. 56]) @ op[23 .. 16]) @ op[111 .. 104]) @ op[71 .. 64]) @ op[31 .. 24]) @ op[119 .. 112]) @ op[79 .. 72]) @ op[39 .. 32]) @ op[127 .. 120]) @ op[87 .. 80]) @ op[47 .. 40]) @ op[7 .. 0])
}

