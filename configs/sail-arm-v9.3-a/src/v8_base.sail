    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(FAR_EL2, 0, 32));
    return(r)
}

val DFAR_S_write : bits(32) -> unit

function DFAR_S_write val_name = {
    let r : bits(32) = val_name;
    HDFAR_write() = SetSlice(32, HDFAR_read(), 0, Slice(r, 0, 32));
    return()
}

val DFAR_write : bits(32) -> unit

function DFAR_write val_name = {
    let r : bits(32) = val_name;
    if ELUsingAArch32(EL3) & IsSecure() then {
        DFAR_S_write() = r
    } else {
        DFAR_NS_write() = r
    };
    return()
}

