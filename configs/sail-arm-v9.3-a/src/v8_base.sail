val ZCR_EL3_SysRegRead_db53f2dcbaed5b3a : forall 't.
  (bits(2), bits(2), bits(3), bits(4), bits(3), bits(4), int('t)) -> unit

function ZCR_EL3_SysRegRead_db53f2dcbaed5b3a (el, op0, op1, CRn, op2, CRm, t) = {
    let __PSTATE_EL : bits(2) = PSTATE.EL;
    let __CPTR_EL3_EZ : bits(1) = Slice(CPTR_EL3, 8, 1);
    if __PSTATE_EL == EL0 then {
        throw(Error_Undefined())
    } else if __PSTATE_EL == EL1 then {
        throw(Error_Undefined())
    } else if __PSTATE_EL == EL2 then {
        throw(Error_Undefined())
    } else if __PSTATE_EL == EL3 then {
        if __CPTR_EL3_EZ == 0b0 then {
            AArch64_SystemAccessTrap(EL3, UInt(0x19))
        } else {
            X_set__1(t, 64) = __get_ZCR_EL3(ZCR_EL3)
        }
    } else ()
}

