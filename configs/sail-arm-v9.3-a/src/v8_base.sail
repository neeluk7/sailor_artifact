          TrapEL2 = (EL2Enabled() & Slice(HCR_EL2, 41, 1) == 0b0) & (Slice(HCR_EL2, 27, 1) == 0b0 | Slice(HCR_EL2, 34, 1) == 0b0);
          TrapEL3 = HaveEL(EL3) & Slice(SCR_EL3, 17, 1) == 0b0
      },
      ? if ? == EL1 => {
