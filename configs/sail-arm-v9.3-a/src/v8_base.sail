val AArch64_SysInstr : forall 'crm 'crn 'op0 'op1 'op2 't.
  (int('op0), int('op1), int('crn), int('crm), int('op2), int('t)) -> unit

function AArch64_SysInstr (op0, op1, crn, crm, op2, t) = {
    AArch64_AutoGen_SysOpsWrite(PSTATE.EL, op0[1 .. 0], op1[2 .. 0], crn[3 .. 0], op2[2 .. 0], crm[3 .. 0], t)
}

val AArch64_SysInstrWithResult : forall 'crm 'crn 'op0 'op1 'op2 't.
  (int('op0), int('op1), int('crn), int('crm), int('op2), int('t)) -> unit

function AArch64_SysInstrWithResult (op0, op1, crn, crm, op2, t) = {
    AArch64_UnallocatedSysRegAccess(op0[1 .. 0], op1[2 .. 0], crn[3 .. 0], op2[2 .. 0], crm[3 .. 0], true, t)
}

register CP15SDISABLE : signal

register CP15SDISABLE2 : signal

val AArch32_SystemAccessTrapSyndrome : forall 'ec.
  (bits(32), int('ec)) -> ExceptionRecord

function AArch32_SystemAccessTrapSyndrome (instr, ec) = {
    exception : ExceptionRecord = undefined;
    match ec {
      0 => {
          exception = ExceptionSyndrome(Exception_Uncategorized)
      },
      3 => {
          exception = ExceptionSyndrome(Exception_CP15RTTrap)
      },
      4 => {
          exception = ExceptionSyndrome(Exception_CP15RRTTrap)
      },
      5 => {
          exception = ExceptionSyndrome(Exception_CP14RTTrap)
      },
      6 => {
          exception = ExceptionSyndrome(Exception_CP14DTTrap)
      },
      7 => {
          exception = ExceptionSyndrome(Exception_AdvSIMDFPAccessTrap)
      },
      8 => {
          exception = ExceptionSyndrome(Exception_FPIDTrap)
      },
      12 => {
          exception = ExceptionSyndrome(Exception_CP14RRTTrap)
      },
      _ => {
          Unreachable()
      }
    };
    iss : bits(20) = Zeros();
    if exception.exceptype == Exception_Uncategorized then {
        return(exception)
    } else if exception.exceptype == Exception_FPIDTrap | exception.exceptype == Exception_CP14RTTrap | exception.exceptype == Exception_CP15RTTrap then {
        iss[13 .. 10] = instr[19 .. 16];
        iss[8 .. 5] = instr[15 .. 12];
        iss[9] = Bit(0b0);
        if exception.exceptype != Exception_FPIDTrap then {
            iss[19 .. 17] = instr[7 .. 5];
            iss[16 .. 14] = instr[23 .. 21];
            iss[4 .. 1] = instr[3 .. 0]
        } else {
            iss[19 .. 17] = 0b000;
            iss[16 .. 14] = 0b111;
            iss[4 .. 1] = 0b0000
        }
    } else if exception.exceptype == Exception_CP14RRTTrap | exception.exceptype == Exception_AdvSIMDFPAccessTrap | exception.exceptype == Exception_CP15RRTTrap then {
        iss[19 .. 16] = instr[7 .. 4];
        iss[13 .. 10] = instr[19 .. 16];
        iss[8 .. 5] = instr[15 .. 12];
        iss[4 .. 1] = instr[3 .. 0]
    } else if exception.exceptype == Exception_CP14DTTrap then {
        iss[19 .. 12] = instr[7 .. 0];
        iss[4] = Bit([instr[23]]);
        iss[2 .. 1] = instr[24 .. 24] @ [instr[21]];
        if instr[19 .. 16] == 0b1111 then {
            iss[8 .. 5] = __UNKNOWN_bits(4);
            iss[3] = Bit(0b1)
        };
        ()
    } else ();
    iss[0] = Bit([instr[20]]);
    exception.syndrome[24 .. 20] = ConditionSyndrome();
    exception.syndrome[19 .. 0] = iss;
    return(exception)
}

val AArch32_TakeHypTrapException : forall 'ec. int('ec) -> unit

val AArch32_TakeHypTrapException__1 : ExceptionRecord -> unit

function AArch32_TakeHypTrapException ec = {
    let exception : ExceptionRecord = AArch32_SystemAccessTrapSyndrome(ThisInstr(), ec);
    AArch32_TakeHypTrapException__1(exception)
}

function AArch32_TakeHypTrapException__1 exception = {
    assert((HaveEL(EL2) & not_bool(IsSecure())) & ELUsingAArch32(EL2));
    let preferred_exception_return : bits(32) = ThisInstrAddr(32);
    let 'vect_offset = UInt(0x14);
    AArch32_EnterHypMode(exception, preferred_exception_return, vect_offset)
}

val AArch32_TakeUndefInstrException : unit -> unit

val AArch32_TakeUndefInstrException__1 : ExceptionRecord -> unit

function AArch32_TakeUndefInstrException () = {
    let exception : ExceptionRecord = ExceptionSyndrome(Exception_Uncategorized);
    AArch32_TakeUndefInstrException__1(exception)
}

function AArch32_TakeUndefInstrException__1 exception = {
    let route_to_hyp : bool = (PSTATE.EL == EL0 & EL2Enabled()) & Slice(HCR_read(), 27, 1) == 0b1;
    let preferred_exception_return : bits(32) = ThisInstrAddr(32);
    let 'vect_offset = UInt(0x04);
    let 'lr_offset = if CurrentInstrSet() == InstrSet_A32 then 4 else 2;
    if PSTATE.EL == EL2 then {
        AArch32_EnterHypMode(exception, preferred_exception_return, vect_offset)
    } else if route_to_hyp then {
        AArch32_EnterHypMode(exception, preferred_exception_return, UInt(0x14))
    } else {
        AArch32_EnterMode(M32_Undef, preferred_exception_return, lr_offset, vect_offset)
    }
}

val AArch32_SystemAccessTrap : forall 'ec. (bits(5), int('ec)) -> unit

function AArch32_SystemAccessTrap (mode, ec) = {
    exception : ExceptionRecord = undefined;
    target_el : bits(2) = undefined;
    valid_name : bool = undefined;
    (valid_name, target_el) = ELFromM32(mode);
    assert(((valid_name & HaveEL(target_el)) & target_el != EL0) & UInt(target_el) >= UInt(PSTATE.EL));
    if target_el == EL2 then {
        let exception : ExceptionRecord = AArch32_SystemAccessTrapSyndrome(ThisInstr(), ec);
        AArch32_TakeHypTrapException__1(exception)
    } else {
        AArch32_TakeUndefInstrException()
    }
}

val AArch64_AArch32SystemAccessTrapSyndrome : forall 'ec.
  (bits(32), int('ec)) -> ExceptionRecord

function AArch64_AArch32SystemAccessTrapSyndrome (instr, ec) = {
    exception : ExceptionRecord = undefined;
    match ec {
      0 => {
          exception = ExceptionSyndrome(Exception_Uncategorized)
      },
      3 => {
          exception = ExceptionSyndrome(Exception_CP15RTTrap)
      },
      4 => {
          exception = ExceptionSyndrome(Exception_CP15RRTTrap)
      },
      5 => {
          exception = ExceptionSyndrome(Exception_CP14RTTrap)
      },
      6 => {
          exception = ExceptionSyndrome(Exception_CP14DTTrap)
      },
      7 => {
          exception = ExceptionSyndrome(Exception_AdvSIMDFPAccessTrap)
      },
      8 => {
          exception = ExceptionSyndrome(Exception_FPIDTrap)
      },
      12 => {
          exception = ExceptionSyndrome(Exception_CP14RRTTrap)
      },
      _ => {
          Unreachable()
      }
    };
    iss : bits(20) = Zeros();
    if exception.exceptype == Exception_Uncategorized then {
        return(exception)
    } else if exception.exceptype == Exception_FPIDTrap | exception.exceptype == Exception_CP14RTTrap | exception.exceptype == Exception_CP15RTTrap then {
        if exception.exceptype != Exception_FPIDTrap then {
            iss[19 .. 17] = instr[7 .. 5];
            iss[16 .. 14] = instr[23 .. 21];
            iss[13 .. 10] = instr[19 .. 16];
            iss[4 .. 1] = instr[3 .. 0]
        } else {
            iss[19 .. 17] = 0b000;
            iss[16 .. 14] = 0b111;
            iss[13 .. 10] = instr[19 .. 16];
            iss[4 .. 1] = 0b0000
        };
        if [instr[20]] == 0b1 & instr[15 .. 12] == 0b1111 then {
            iss[9 .. 5] = 0b11111
        } else if [instr[20]] == 0b0 & instr[15 .. 12] == 0b1111 then {
            iss[9 .. 5] = __UNKNOWN_bits(5)
        } else {
            iss[9 .. 5] = LookUpRIndex(UInt(instr[15 .. 12]), PSTATE.M)[4 .. 0]
        }
    } else if exception.exceptype == Exception_CP14RRTTrap | exception.exceptype == Exception_AdvSIMDFPAccessTrap | exception.exceptype == Exception_CP15RRTTrap then {
        iss[19 .. 16] = instr[7 .. 4];
        if instr[19 .. 16] == 0b1111 then {
            iss[14 .. 10] = __UNKNOWN_bits(5)
        } else {
            iss[14 .. 10] = LookUpRIndex(UInt(instr[19 .. 16]), PSTATE.M)[4 .. 0]
        };
        if instr[15 .. 12] == 0b1111 then {
            iss[9 .. 5] = __UNKNOWN_bits(5)
        } else {
            iss[9 .. 5] = LookUpRIndex(UInt(instr[15 .. 12]), PSTATE.M)[4 .. 0]
        };
        iss[4 .. 1] = instr[3 .. 0]
    } else if exception.exceptype == Exception_CP14DTTrap then {
        iss[19 .. 12] = instr[7 .. 0];
        iss[4] = Bit([instr[23]]);
        iss[2 .. 1] = instr[24 .. 24] @ [instr[21]];
        if instr[19 .. 16] == 0b1111 then {
            iss[9 .. 5] = __UNKNOWN_bits(5);
            iss[3] = Bit(0b1)
        };
        ()
    } else ();
    iss[0] = Bit([instr[20]]);
    exception.syndrome[24 .. 20] = ConditionSyndrome();
    exception.syndrome[19 .. 0] = iss;
    return(exception)
}

val AArch64_AArch32SystemAccessTrap : forall 'ec. (bits(2), int('ec)) -> unit

function AArch64_AArch32SystemAccessTrap (target_el, ec) = {
    assert((HaveEL(target_el) & target_el != EL0) & UInt(target_el) >= UInt(PSTATE.EL));
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    let exception : ExceptionRecord = AArch64_AArch32SystemAccessTrapSyndrome(ThisInstr(), ec);
    AArch64_TakeException(target_el, exception, preferred_exception_return, vect_offset)
}

val AArch64_CheckCP15InstrCoarseTraps : forall 'CRm 'CRn 'nreg.
  (int('CRn), int('nreg), int('CRm)) -> unit

function AArch64_CheckCP15InstrCoarseTraps (CRn, nreg, CRm) = {
    major : int = undefined;
    let trapped_encoding : bool = (CRn == 9 & (CRm == 0 | CRm == 1 | CRm == 2 | CRm == 5 | CRm == 6 | CRm == 7 | CRm == 8) | CRn == 10 & (CRm == 0 | CRm == 1 | CRm == 4 | CRm == 8)) | CRn == 11 & (CRm == 0 | CRm == 1 | CRm == 2 | CRm == 3 | CRm == 4 | CRm == 5 | CRm == 6 | CRm == 7 | CRm == 8 | CRm == 15);
    if ((((HaveFeatTIDCP1() & PSTATE.EL == EL0) & not_bool(IsInHost())) & not_bool(ELUsingAArch32(EL1))) & Slice(SCTLR_EL1, 63, 1) == 0b1) & trapped_encoding then {
        if EL2Enabled() & Slice(HCR_EL2, 27, 1) == 0b1 then {
            AArch64_AArch32SystemAccessTrap(EL2, UInt(0x3))
        } else {
            AArch64_AArch32SystemAccessTrap(EL1, UInt(0x3))
        }
    };
    if (PSTATE.EL == EL0 | PSTATE.EL == EL1) & EL2Enabled() then {
        if (((HaveFeatTIDCP1() & PSTATE.EL == EL0) & IsInHost()) & Slice(SCTLR_EL2, 63, 1) == 0b1) & trapped_encoding then {
            AArch64_AArch32SystemAccessTrap(EL2, UInt(0x3))
        };
        let 'major = if nreg == 1 then CRn else CRm;
        assert(constraint((0 <= 'major & 'major < 64)));
        if (not_bool(IsInHost()) & not_bool(major == 4 | major == 14)) & [HSTR_EL2[major]] == 0b1 | (Slice(HCR_EL2, 20, 1) == 0b1 & nreg == 1) & trapped_encoding then {
            if PSTATE.EL == EL0 & __IMPDEF_boolean("UNDEF unallocated CP15 access at EL0") then {
                throw(Error_Undefined())
            };
            AArch64_AArch32SystemAccessTrap(EL2, UInt(0x3))
        };
        ()
    };
    ()
}

