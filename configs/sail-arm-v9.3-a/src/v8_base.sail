val ACCDATA_EL1_SysRegRead_d99808e8a6d38b6c : forall 't.
  (bits(2), bits(2), bits(3), bits(4), bits(3), bits(4), int('t)) -> unit

function ACCDATA_EL1_SysRegRead_d99808e8a6d38b6c (el, op0, op1, CRn, op2, CRm, t) = {
    let __PSTATE_EL : bits(2) = PSTATE.EL;
    let __EDSCR_SDD : bits(1) = Slice(EDSCR_read(), 16, 1);
    let __SCR_EL3_ADEn : bits(1) = Slice(SCR_EL3, 37, 1);
    let __SCR_EL3_FGTEn : bits(1) = Slice(SCR_EL3, 27, 1);
    let __HFGRTR_EL2_nACCDATA_EL1 : bits(1) = Slice(HFGRTR_EL2, 50, 1);
    if __PSTATE_EL == EL0 then {
        throw(Error_Undefined())
    } else if __PSTATE_EL == EL1 then {
        if (((Halted() & HaveEL(EL3)) & __EDSCR_SDD == 0b1) & __IMPDEF_boolean("EL3 trap priority when SDD == '1'")) & __SCR_EL3_ADEn == 0b0 then {
            throw(Error_Undefined())
        } else if (EL2Enabled() & (not_bool(HaveEL(EL3)) | __SCR_EL3_FGTEn == 0b1)) & __HFGRTR_EL2_nACCDATA_EL1 == 0b0 then {
            AArch64_SystemAccessTrap(EL2, UInt(0x18))
        } else if HaveEL(EL3) & __SCR_EL3_ADEn == 0b0 then {
            if Halted() & __EDSCR_SDD == 0b1 then {
                throw(Error_Undefined())
            } else {
                AArch64_SystemAccessTrap(EL3, UInt(0x18))
            }
        } else {
            X_set__1(t, 64) = __get_ACCDATA_EL1(ACCDATA_EL1)
        }
    } else if __PSTATE_EL == EL2 then {
        if (((Halted() & HaveEL(EL3)) & __EDSCR_SDD == 0b1) & __IMPDEF_boolean("EL3 trap priority when SDD == '1'")) & __SCR_EL3_ADEn == 0b0 then {
            throw(Error_Undefined())
        } else if HaveEL(EL3) & __SCR_EL3_ADEn == 0b0 then {
            if Halted() & __EDSCR_SDD == 0b1 then {
                throw(Error_Undefined())
            } else {
                AArch64_SystemAccessTrap(EL3, UInt(0x18))
            }
        } else {
            X_set__1(t, 64) = __get_ACCDATA_EL1(ACCDATA_EL1)
        }
    } else if __PSTATE_EL == EL3 then {
        X_set__1(t, 64) = __get_ACCDATA_EL1(ACCDATA_EL1)
    } else ()
