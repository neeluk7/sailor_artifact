val BRB_IALL : unit -> unit

function BRB_IALL () = {
    foreach (i from 0 to (GetBRBENumRecords() - 1) by 1 in inc) {
        assert(constraint('loop_i < 64));
        Records_SRC[i] = Zeros(64);
        Records_TGT[i] = Zeros(64);
        Records_INF[i] = Zeros(64)
    }
}

