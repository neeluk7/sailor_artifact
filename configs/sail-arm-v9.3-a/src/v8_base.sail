register FPCR : bits(64)

val __get_FPCR : bits(64) -> bits(64)

function __get_FPCR val_name = {
    tmp : bits(64) = val_name;
    tmp = SetSlice(5, tmp, 3, 0b00000);
    tmp = SetSlice(1, tmp, 14, 0b0);
    tmp = SetSlice(37, tmp, 27, 0b0000000000000000000000000000000000000);
    return(tmp)
}

val FPCR_read : unit -> bits(64)

function FPCR_read () = {
    let r : bits(64) = __get_FPCR(FPCR);
    return(r)
}

register FPSR : bits(64)

val __get_FPSCR : bits(32) -> bits(32)

function __get_FPSCR val_name = {
    tmp : bits(32) = val_name;
    tmp = SetSlice(2, tmp, 5, 0b00);
    tmp = SetSlice(2, tmp, 13, 0b00);
    return(tmp)
}

val FPSCR_read : unit -> bits(64)

val FPSCR_read__1 : unit -> bits(32)

function FPSCR_read () = {
    let r : bits(64) = Zeros(32) @ __get_FPSCR(FPSCR_read__1());
    return(r)
}

function FPSCR_read__1 () = {
    r : bits(32) = undefined;
    r = SetSlice(5, r, 27, Slice(FPSR, 27, 5));
    r = SetSlice(1, r, 7, Slice(FPSR, 7, 1));
    r = SetSlice(5, r, 0, Slice(FPSR, 0, 5));
    r = SetSlice(12, r, 15, Slice(FPCR, 15, 12));
    r = SetSlice(5, r, 8, Slice(FPCR, 8, 5));
    return(r)
}

register RVBAR : bits(32)

register ERRnFR : vector(4, inc, bits(64))

register __claim_tags : bits(8)

register __trcclaim_tags : bits(32)

let EL1 : bits(2) = 0b01

let EL2 : bits(2) = 0b10

let EL3 : bits(2) = 0b11

val HaveEL : bits(2) -> bool

let EL0 : bits(2) = 0b00

register HCR_EL2 : bits(64)

val HaveAArch32EL : bits(2) -> bool

val HaveAArch64 : unit -> bool

function HaveAArch64 () = {
    return(__IMPDEF_boolean("Highest EL using AArch64"))
}

enum ArchVersion = {
  ARMv8p0,
  ARMv8p1,
  ARMv8p2,
  ARMv8p3,
  ARMv8p4,
  ARMv8p5,
  ARMv8p6,
  ARMv8p7,
  ARMv8p8,
  ARMv9p0,
  ARMv9p1,
  ARMv9p2,
  ARMv9p3
}

val HasArchVersion : ArchVersion -> bool

val HaveSecureEL2Ext : unit -> bool

function HaveSecureEL2Ext () = {
    return(HasArchVersion(ARMv8p4))
}

val HaveVirtHostExt : unit -> bool

function HaveVirtHostExt () = {
    return(HasArchVersion(ARMv8p1))
}

struct ProcState = {
  N : bits(1),
  Z : bits(1),
  C : bits(1),
  V : bits(1),
  D : bits(1),
  A : bits(1),
  I : bits(1),
  F : bits(1),
  PAN : bits(1),
  UAO : bits(1),
  DIT : bits(1),
  TCO : bits(1),
  BTYPE : bits(2),
  ZA : bits(1),
  SM : bits(1),
  ALLINT : bits(1),
  SS : bits(1),
  IL : bits(1),
  EL : bits(2),
  nRW : bits(1),
  SP : bits(1),
  Q : bits(1),
  GE : bits(4),
  SSBS : bits(1),
  IT : bits(8),
  J : bits(1),
  T : bits(1),
  E : bits(1),
  M : bits(5)
}

register PSTATE : ProcState

register SCR_EL3 : bits(64)

val ELStateUsingAArch32K : forall ('secure : Bool).
  (bits(2), bool('secure)) -> (bool, bool)

function ELStateUsingAArch32K (el, secure) = {
    if not_bool(HaveAArch32EL(el)) then {
        return((true, false))
    } else if secure & el == EL2 then {
        return((true, false))
    } else if not_bool(HaveAArch64()) then {
        return((true, true))
    } else ();
    aarch32 : bool = __UNKNOWN_boolean();
    known : bool = true;
    let aarch32_below_el3 : bool = (HaveEL(EL3) & Slice(SCR_EL3, 10, 1) == 0b0) & ((not_bool(secure) | not_bool(HaveSecureEL2Ext())) | Slice(SCR_EL3, 18, 1) == 0b0);
    let aarch32_at_el1 : bool = aarch32_below_el3 | ((HaveEL(EL2) & (HaveSecureEL2Ext() & Slice(SCR_EL3, 18, 1) == 0b1 | not_bool(secure))) & Slice(HCR_EL2, 31, 1) == 0b0) & not_bool((Slice(HCR_EL2, 34, 1) == 0b1 & Slice(HCR_EL2, 27, 1) == 0b1) & HaveVirtHostExt());
    if el == EL0 & not_bool(aarch32_at_el1) then {
        if PSTATE.EL == EL0 then {
            aarch32 = PSTATE.nRW == 0b1
        } else {
            known = false
        }
    } else {
        aarch32 = aarch32_below_el3 & el != EL3 | aarch32_at_el1 & (el == EL1 | el == EL0)
    };
    if not_bool(known) then {
        aarch32 = __UNKNOWN_boolean()
    };
    return((known, aarch32))
}

val ELStateUsingAArch32 : forall ('secure : Bool).
  (bits(2), bool('secure)) -> bool

function ELStateUsingAArch32 (el, secure) = {
    aarch32 : bool = undefined;
    known : bool = undefined;
    (known, aarch32) = ELStateUsingAArch32K(el, secure);
    assert(known);
    return(aarch32)
}

register SCR : bits(32)

val SCR_GEN_read : unit -> bits(64)

function SCR_GEN_read () = {
    assert(HaveEL(EL3));
    r : bits(64) = undefined;
    if not_bool(HaveAArch64()) then {
        r = ZeroExtend(SCR)
    } else {
        r = SCR_EL3
    };
    return(r)
}

val IsSecureBelowEL3 : unit -> bool

function IsSecureBelowEL3 () = {
    if HaveEL(EL3) then {
        return([SCR_GEN_read()[0]] == 0b0)
    } else if HaveEL(EL2) & (not_bool(HaveSecureEL2Ext()) | not_bool(HaveAArch64())) then {
        return(false)
    } else {
        return(__IMPDEF_boolean("Secure-only implementation"))
    }
}

val ELUsingAArch32 : bits(2) -> bool

function ELUsingAArch32 el = {
    return(ELStateUsingAArch32(el, IsSecureBelowEL3()))
}

let M32_Monitor : bits(5) = 0b10110

val HaveAArch32 : unit -> bool

val UsingAArch32 : unit -> bool

function UsingAArch32 () = {
    let aarch32 : bool = PSTATE.nRW == 0b1;
    if not_bool(HaveAArch32()) then {
        assert(not_bool(aarch32))
    };
    if not_bool(HaveAArch64()) then {
        assert(aarch32)
    };
    return(aarch32)
}

val IsSecure : unit -> bool

function IsSecure () = {
    if (HaveEL(EL3) & not_bool(UsingAArch32())) & PSTATE.EL == EL3 then {
        return(true)
    } else if (HaveEL(EL3) & UsingAArch32()) & PSTATE.M == M32_Monitor then {
        return(true)
    } else ();
    return(IsSecureBelowEL3())
}

val IsSecureEL2Enabled : unit -> bool

function IsSecureEL2Enabled () = {
    if HaveEL(EL2) & HaveSecureEL2Ext() then {
        if HaveEL(EL3) then {
            if not_bool(ELUsingAArch32(EL3)) & Slice(SCR_EL3, 18, 1) == 0b1 then {
                return(true)
            } else {
                return(false)
            }
        } else {
            return(IsSecure())
        }
    } else {
        return(false)
    }
}

val EL2Enabled : unit -> bool

function EL2Enabled () = {
    return(HaveEL(EL2) & ((not_bool(HaveEL(EL3)) | [SCR_GEN_read()[0]] == 0b1) | IsSecureEL2Enabled()))
}

val FIQPending : unit -> (bool, bool)

register HCRX_EL2 : bits(64)

val HaveFeatNMI : unit -> bool

function HaveFeatNMI () = {
    return(HasArchVersion(ARMv8p8))
}

val IRQPending : unit -> (bool, bool)

val HaveFeatHCX : unit -> bool

function HaveFeatHCX () = {
    return(HasArchVersion(ARMv8p7))
}

val IsHCRXEL2Enabled : unit -> bool

function IsHCRXEL2Enabled () = {
    assert(HaveFeatHCX());
    if HaveEL(EL3) & Slice(SCR_EL3, 38, 1) == 0b0 then {
        return(false)
    };
    return(EL2Enabled())
}

val IsPhysicalSErrorPending : unit -> bool

val getISR : unit -> bits(32)

function getISR () = {
    fiq_nmi : bool = undefined;
    fiq_pending : bool = undefined;
    irq_nmi : bool = undefined;
    irq_pending : bool = undefined;
    value_name : bits(32) = Zeros();
    value_name[8] = Bit(if IsPhysicalSErrorPending() then 0b1 else 0b0);
    (irq_pending, irq_nmi) = IRQPending();
    (fiq_pending, fiq_nmi) = FIQPending();
    if HaveFeatNMI() & not_bool(UsingAArch32()) then {
        value_name[10] = Bit(if irq_pending & irq_nmi then 0b1 else 0b0);
        value_name[9] = Bit(if fiq_pending & fiq_nmi then 0b1 else 0b0)
    };
    value_name[7] = Bit(if irq_pending then 0b1 else 0b0);
    value_name[6] = Bit(if fiq_pending then 0b1 else 0b0);
    if (PSTATE.EL == EL1 & EL2Enabled()) & Slice(HCR_EL2, 27, 1) == 0b0 then {
        if (HaveFeatNMI() & not_bool(UsingAArch32())) & IsHCRXEL2Enabled() then {
            if (Slice(HCR_EL2, 4, 1) & Slice(HCR_EL2, 7, 1)) == 0b1 then {
                value_name[10] = Bit(Slice(HCRX_EL2, 7, 1))
            };
            if (Slice(HCR_EL2, 3, 1) & Slice(HCR_EL2, 6, 1)) == 0b1 then {
                value_name[9] = Bit(Slice(HCRX_EL2, 8, 1))
            };
            ()
        };
        if Slice(HCR_EL2, 5, 1) == 0b1 then {
            value_name[8] = Bit([value_name[8]] | Slice(HCR_EL2, 8, 1))
        };
        if Slice(HCR_EL2, 4, 1) == 0b1 then {
            value_name[7] = Bit(Slice(HCR_EL2, 7, 1))
        };
        if Slice(HCR_EL2, 3, 1) == 0b1 then {
            value_name[6] = Bit(Slice(HCR_EL2, 6, 1))
        };
        ()
    };
    return(value_name)
}

register __cycle_count : int

val Elem_read : forall 'N 'e 'size,
  (0 <= 'e * 'size & 'e * 'size <= 'e * 'size + 'size - 1 | not(('e >= 0 & ('e + 1) * 'size <= 'N))).
  (bits('N), int('e), int('size)) -> bits('size)

val Elem_read__1 : forall 'N 'e 'size,
  (0 <= 'e * 'size & 'e * 'size <= 'e * 'size + 'size - 1 | not(('e >= 0 & ('e + 1) * 'size <= 'N))).
  (implicit('size), bits('N), int('e)) -> bits('size)

function Elem_read (vector_name, e, size) = {
    assert(e >= 0 & (e + 1) * size <= 'N);
    return(vector_name[e * size + size - 1 .. e * size])
}

function Elem_read__1 (size, vector_name, e) = {
    return(Elem_read(vector_name, e, size))
}

val LSL_C : forall 'N 'shift. (bits('N), int('shift)) -> (bits('N), bits(1))

function LSL_C (x, shift) = {
    let carry_out = if shift > 0 & shift <= 'N then x['N - shift] else bitzero;
    (sail_shiftleft(x, shift), [carry_out])
}

overload LSL = {sail_shiftleft}

val LSR_C : forall 'N 'shift. (bits('N), int('shift)) -> (bits('N), bits(1))

function LSR_C (x, shift) = {
    let carry_out = if shift > 0 & shift <= 'N then x[shift - 1] else bitzero;
    (sail_shiftright(x, shift), [carry_out])
}

overload LSR = {sail_shiftright}

val ROR_C : forall 'N 'shift, 'N > 0.
  (bits('N), int('shift)) -> (bits('N), bits(1))

function ROR_C (x, shift) = {
    assert(shift > 0);
    let 'm = MOD(shift, 'N);
    let result : bits('N) = LSR(x, m) | LSL(x, 'N - m);
    let carry_out : bits(1) = [result['N - 1]];
    return((result, carry_out))
}

val ROR : forall 'N 'shift, ('N > 0 & 'shift >= 0).
  (bits('N), int('shift)) -> bits('N)

function ROR (x, shift) = {
    if shift == 0 then x else
      let 'm = MOD(shift, 'N) in LSR(x, m) | LSL(x, 'N - m)
}

val ROL : forall 'N 'shift. (bits('N), int('shift)) -> bits('N)

function ROL (x, shift) = {
    assert(shift >= 0 & shift <= 'N);
    if shift == 0 then {
        return(x)
    };
    return(ROR(x, 'N - shift))
}

val SHAchoose : (bits(32), bits(32), bits(32)) -> bits(32)

function SHAchoose (x, y, z) = {
    return(EOR(EOR(y, z) & x, z))
}

val SHAhashSIGMA0 : bits(32) -> bits(32)

function SHAhashSIGMA0 x = {
    return(EOR(EOR(ROR(x, 2), ROR(x, 13)), ROR(x, 22)))
}

val SHAhashSIGMA1 : bits(32) -> bits(32)

function SHAhashSIGMA1 x = {
    return(EOR(EOR(ROR(x, 6), ROR(x, 11)), ROR(x, 25)))
}

val SHAmajority : (bits(32), bits(32), bits(32)) -> bits(32)

function SHAmajority (x, y, z) = {
    return(x & y | (x | y) & z)
}

val SHA256hash : forall ('part1 : Bool).
  (bits(128), bits(128), bits(128), bool('part1)) -> bits(128)

function SHA256hash (x_in, y_in, w, part1) = {
    chs : bits(32) = undefined;
    maj : bits(32) = undefined;
    t : bits(32) = undefined;
    x : bits(128) = x_in;
    y : bits(128) = y_in;
    foreach (e from 0 to 3 by 1 in inc) {
        chs = SHAchoose(y[31 .. 0], y[63 .. 32], y[95 .. 64]);
        maj = SHAmajority(x[31 .. 0], x[63 .. 32], x[95 .. 64]);
        t = y[127 .. 96] + SHAhashSIGMA1(y[31 .. 0]) + chs + Elem_read(w, e, 32);
        x[127 .. 96] = t + x[127 .. 96];
        y[127 .. 96] = t + SHAhashSIGMA0(x[31 .. 0]) + maj;
        (y @ x) = ROL(y @ x, 32)
    };
    return(if part1 then x else y)
}

val genRandomNum : forall ('isRNDRRS : Bool). bool('isRNDRRS) -> bits(64)

function genRandomNum isRNDRRS = {
    (PSTATE.N @ PSTATE.Z @ PSTATE.C @ PSTATE.V) = 0b0000;
    let x : bits(128) = __cycle_count[127 .. 0];
    let y : bits(128) = (__cycle_count + 1)[127 .. 0];
    let w : bits(128) = (__cycle_count + 2)[127 .. 0];
    return(SHA256hash(x, y, w, true)[63 .. 0])
}

register CLIDR_EL1 : bits(64)

register __DCACHE_CCSIDR_RESET : vector(7, inc, bits(64))

register __ICACHE_CCSIDR_RESET : vector(7, inc, bits(64))

val getCacheID : forall ('data_cache : Bool) 'level,
  (0 <= 'level & 'level < 7 | 'data_cache) & (0 <= 'level & 'level < 7 | not('data_cache)).
  (int('level), bool('data_cache)) -> bits(64)

function getCacheID (level, data_cache) = {
    let 'range_min = level * 3;
    let cache_type : bits(3) = Slice(CLIDR_EL1, range_min, 3);
    ccsidr_val : bits(64) = undefined;
    match cache_type {
      0b000 => {
          ccsidr_val = __UNKNOWN_bits(64)
      },
      0b001 => {
          ccsidr_val = if data_cache then __UNKNOWN_bits(64) else
            __ICACHE_CCSIDR_RESET[level]
      },
      0b010 => {
          ccsidr_val = if not_bool(data_cache) then __UNKNOWN_bits(64) else
            __DCACHE_CCSIDR_RESET[level]
      },
      0b011 => {
          ccsidr_val = if data_cache then __DCACHE_CCSIDR_RESET[level] else
            __ICACHE_CCSIDR_RESET[level]
      },
      0b100 => {
          ccsidr_val = __DCACHE_CCSIDR_RESET[level]
      },
      _ => ()
    };
    return(ccsidr_val)
}

val CacheConfigRead : bits(4) -> bits(64)

function CacheConfigRead cache_sel = {
    let data_cache : bool = if [cache_sel[0]] == 0b0 then true else false;
    let 'level = UInt(cache_sel[3 .. 1]);
    assert(level < 7);
    return(getCacheID(level, data_cache))
}

val AArch32_CurrentCond : unit -> bits(4)

val ConditionHolds : bits(4) -> bool

function ConditionHolds cond = {
    result : bool = undefined;
    match cond[3 .. 1] {
      0b000 => {
          result = PSTATE.Z == 0b1
      },
      0b001 => {
          result = PSTATE.C == 0b1
      },
      0b010 => {
          result = PSTATE.N == 0b1
      },
      0b011 => {
          result = PSTATE.V == 0b1
      },
      0b100 => {
          result = PSTATE.C == 0b1 & PSTATE.Z == 0b0
      },
      0b101 => {
          result = PSTATE.N == PSTATE.V
      },
      0b110 => {
          result = PSTATE.N == PSTATE.V & PSTATE.Z == 0b0
      },
      0b111 => {
          result = true
      }
    };
    if [cond[0]] == 0b1 & cond != 0b1111 then {
        result = not_bool(result)
    };
    return(result)
}

