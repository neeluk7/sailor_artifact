function TLBI_ASIDE1IS_SysOpsWrite_005ec583c03cd738 (el, op0, op1, CRn, op2, CRm, t) = {
    let __PSTATE_EL : bits(2) = PSTATE.EL;
    let __HCR_EL2_TTLB : bits(1) = Slice(HCR_EL2, 25, 1);
    let __HCR_EL2_TTLBIS : bits(1) = Slice(HCR_EL2, 54, 1);
    let __SCR_EL3_FGTEn : bits(1) = Slice(SCR_EL3, 27, 1);
    let __HFGITR_EL2_TLBIASIDE1IS : bits(1) = Slice(HFGITR_EL2, 30, 1);
    let __HCRX_EL2_FnXS : bits(1) = Slice(HCRX_EL2, 3, 1);
    if __PSTATE_EL == EL0 then {
        throw(Error_Undefined())
    } else if __PSTATE_EL == EL1 then {
        if EL2Enabled() & __HCR_EL2_TTLB == 0b1 then {
            AArch64_SystemAccessTrap(EL2, UInt(0x18))
        } else if EL2Enabled() & __HCR_EL2_TTLBIS == 0b1 then {
            AArch64_SystemAccessTrap(EL2, UInt(0x18))
        } else if (EL2Enabled() & (not_bool(HaveEL(EL3)) | __SCR_EL3_FGTEn == 0b1)) & __HFGITR_EL2_TLBIASIDE1IS == 0b1 then {
            AArch64_SystemAccessTrap(EL2, UInt(0x18))
        } else {
            if ((HaveFeatXS() & HaveFeatHCX()) & IsHCRXEL2Enabled()) & __HCRX_EL2_FnXS == 0b1 then {
                AArch64_TLBI_ASID(SecurityStateAtEL(EL1), Regime_EL10, VMID_read(), Shareability_ISH, TLBI_ExcludeXS, X_read__1(t, 64))
            } else {
                AArch64_TLBI_ASID(SecurityStateAtEL(EL1), Regime_EL10, VMID_read(), Shareability_ISH, TLBI_AllAttr, X_read__1(t, 64))
            }
        }
    } else if __PSTATE_EL == EL2 then {
        if (Slice(HCR_EL2, 34, 1) @ Slice(HCR_EL2, 27, 1)) == 0b11 then {
            AArch64_TLBI_ASID(SecurityStateAtEL(EL2), Regime_EL20, VMID_NONE, Shareability_ISH, TLBI_AllAttr, X_read__1(t, 64))
        } else {
            AArch64_TLBI_ASID(SecurityStateAtEL(EL1), Regime_EL10, VMID_read(), Shareability_ISH, TLBI_AllAttr, X_read__1(t, 64))
        }
    } else if __PSTATE_EL == EL3 then {
        if (Slice(HCR_EL2, 34, 1) @ Slice(HCR_EL2, 27, 1)) == 0b11 then {
            AArch64_TLBI_ASID(SecurityStateAtEL(EL2), Regime_EL20, VMID_NONE, Shareability_ISH, TLBI_AllAttr, X_read__1(t, 64))
        } else {
            AArch64_TLBI_ASID(SecurityStateAtEL(EL1), Regime_EL10, VMID_read(), Shareability_ISH, TLBI_AllAttr, X_read__1(t, 64))
        }
    } else ()
}

