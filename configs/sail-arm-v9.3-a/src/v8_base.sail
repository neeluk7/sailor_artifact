            AArch64_TLBI_VMALL(SecurityStateAtEL(EL1), Regime_EL10, VMID_read(), Shareability_NSH, TLBI_AllAttr)
        } else {
            AArch64_TLBI_VMALLS12(SecurityStateAtEL(EL1), Regime_EL10, VMID_read(), Shareability_NSH, TLBI_AllAttr)
        }
    } else ()
}

val TLBI_VMALLS12E1_SysOpsWrite_8d34e637d7a914c6 : forall 't.
  (bits(2), bits(2), bits(3), bits(4), bits(3), bits(4), int('t)) -> unit

function TLBI_VMALLS12E1_SysOpsWrite_8d34e637d7a914c6 (el, op0, op1, CRn, op2, CRm, t) = {
    let __PSTATE_EL : bits(2) = PSTATE.EL;
    let __HCR_EL2_NV : bits(1) = Slice(HCR_EL2, 42, 1);
    if not_bool(HaveFeatXS()) then {
        throw(Error_Undefined())
    } else if __PSTATE_EL == EL0 then {
        throw(Error_Undefined())
    } else if __PSTATE_EL == EL1 then {
        if EL2Enabled() & __HCR_EL2_NV == 0b1 then {
            AArch64_SystemAccessTrap(EL2, UInt(0x18))
        } else {
            throw(Error_Undefined())
        }
    } else if __PSTATE_EL == EL2 then {
        AArch64_TLBI_VMALLS12(SecurityStateAtEL(EL1), Regime_EL10, VMID_read(), Shareability_NSH, TLBI_ExcludeXS)
    } else if __PSTATE_EL == EL3 then {
        if not_bool(EL2Enabled()) then {
            AArch64_TLBI_VMALL(SecurityStateAtEL(EL1), Regime_EL10, VMID_read(), Shareability_NSH, TLBI_ExcludeXS)
        } else {
            AArch64_TLBI_VMALLS12(SecurityStateAtEL(EL1), Regime_EL10, VMID_read(), Shareability_NSH, TLBI_ExcludeXS)
        }
    } else ()
}

