val AArch64_CheckNVCondsIfCurrentEL : forall 'crm 'crn 'op0 'op1 'op2.
  (int('op0), int('op1), int('crn), int('crm), int('op2)) -> bool

val HaveFeatHPMN0 : unit -> bool

function HaveFeatHPMN0 () = {
    return(((HasArchVersion(ARMv8p8) & HavePMUv3()) & HaveFGTExt()) & HaveEL(EL2))
}

val AArch64_GetNumEventCountersAccessible : unit -> int

function AArch64_GetNumEventCountersAccessible () = {
    n : int = undefined;
    let 'total_counters = GetNumEventCounters();
    if (PSTATE.EL == EL1 | PSTATE.EL == EL0) & EL2Enabled() then {
        n = UInt(Slice(MDCR_EL2, 0, 5));
        if n > total_counters | not_bool(HaveFeatHPMN0()) & n == 0 then {
            let (_, __tup_1 : int) = ConstrainUnpredictableInteger(0, total_counters, Unpredictable_PMUEVENTCOUNTER);
            n = __tup_1
        };
        ()
    } else {
        n = total_counters
    };
    let 'n = n;
    return(n)
}

val AArch32_GetNumEventCountersAccessible : unit -> int

function AArch32_GetNumEventCountersAccessible () = {
    n : int = undefined;
    let 'total_counters = GetNumEventCounters();
    if (PSTATE.EL == EL1 | PSTATE.EL == EL0) & EL2Enabled() then {
        n = UInt(if not_bool(ELUsingAArch32(EL2)) then Slice(MDCR_EL2, 0, 5)
        else
          Slice(HDCR_read(), 0, 5));
        if n > total_counters | not_bool(HaveFeatHPMN0()) & n == 0 then {
            let (_, __tup_1 : int) = ConstrainUnpredictableInteger(0, total_counters, Unpredictable_PMUEVENTCOUNTER);
            n = __tup_1
        };
        ()
    } else {
        n = total_counters
    };
    let 'n = n;
    return(n)
}

val PMUCounterMask : unit -> bits(32)

function PMUCounterMask () = {
    n : int = undefined;
    if UsingAArch32() then {
        n = AArch32_GetNumEventCountersAccessible()
    } else {
        n = AArch64_GetNumEventCountersAccessible()
    };
    let 'n = n;
    assert(constraint('n >= 0));
    assert(constraint(31 >= 'n));
    return(0b1 @ ZeroExtend(Ones(n), 31))
}

val X_read : forall 'n 'width,
  'width in {8, 16, 32, 64}.
  (implicit('width), int('n)) -> bits('width)

val X_read__1 : forall 'n 'width,
  'width in {8, 16, 32, 64}.
  (int('n), int('width)) -> bits('width)

function X_read (width, n) = {
    assert(n >= 0 & n <= 31);
    assert(width == 8 | width == 16 | width == 32 | width == 64);
    if n != 31 then {
        return(_R[n][width - 1 .. 0])
    } else {
        return(Zeros(width))
    }
}

function X_read__1 (n, width) = {
    assert(n >= 0 & n <= 31);
    assert(width == 8 | width == 16 | width == 32 | width == 64);
    if n != 31 then {
        return(_R[n][width - 1 .. 0])
    } else {
        return(Zeros(width))
    }
}

val AArch64_SysRegRead : forall 'crm 'crn 'op0 'op1 'op2 't.
  (int('op0), int('op1), int('crn), int('crm), int('op2), int('t)) -> unit

function AArch64_SysRegRead (op0, op1, crn, crm, op2, t) = {
    index : int = undefined;
    n : int = undefined;
    if (op0 == 3 & op1 == 3) & crn == 13 then {
        let 'n = UInt([crm[0]] @ op2[2 .. 0]);
        if crm[3 .. 1] == 0b010 | crm[3 .. 1] == 0b011 then {
            if n >= UInt(Slice(AMCGCR_EL0, 0, 8)) then {
                throw(Error_Undefined())
            };
            ()
        } else if crm[3 .. 1] == 0b110 | crm[3 .. 1] == 0b111 then {
            if n >= UInt(Slice(AMCGCR_EL0, 8, 8)) then {
                throw(Error_Undefined())
            };
            ()
        } else ()
    };
    if (((op0 == 3 & op1 == 3) & crn == 14) & (crm[3 .. 2] == 0b10 | crm[3 .. 2] == 0b11)) & (crm[1 .. 0] @ op2[2 .. 0]) != 0b11111 then {
        if UInt(crm[1 .. 0] @ op2[2 .. 0]) > GetNumEventCounters() - 1 | (EL2Enabled() & (PSTATE.EL == EL1 | PSTATE.EL == EL0 & (crm[3 .. 2] == 0b10 & (Slice(PMUSERENR_EL0, 3, 1) @ Slice(PMUSERENR_EL0, 0, 1)) != 0b00 | crm[3 .. 2] == 0b11 & Slice(PMUSERENR_EL0, 0, 1) == 0b1))) & UInt(crm[1 .. 0] @ op2[2 .. 0]) > AArch64_GetNumEventCountersAccessible() - 1 then {
            if UInt(crm[1 .. 0] @ op2[2 .. 0]) > GetNumEventCounters() - 1 then {
                throw(Error_Undefined())
            } else {
                AArch64_SystemAccessTrap(EL2, UInt(0x18))
            }
        };
        ()
    };
    if ((((op0 == 3 & op1 == 3) & crn == 9) & crm == 13) & (op2 == 1 | op2 == 2)) & Slice(PMSELR_EL0, 0, 5) != 0b11111 then {
        if UInt(Slice(PMSELR_EL0, 0, 5)) > GetNumEventCounters() - 1 | (EL2Enabled() & (PSTATE.EL == EL1 | PSTATE.EL == EL0 & (op2 == 2 & (Slice(PMUSERENR_EL0, 3, 1) @ Slice(PMUSERENR_EL0, 0, 1)) != 0b00 | op2 == 1 & Slice(PMUSERENR_EL0, 0, 1) == 0b1))) & UInt(Slice(PMSELR_EL0, 0, 5)) > AArch64_GetNumEventCountersAccessible() - 1 then {
            if UInt(Slice(PMSELR_EL0, 0, 5)) > GetNumEventCounters() - 1 then {
                throw(Error_Undefined())
            } else {
                AArch64_SystemAccessTrap(EL2, UInt(0x18))
            }
        };
        ()
    };
    let temp : bits(64) = X_read__1(t, 64);
    AArch64_AutoGen_SysRegRead(PSTATE.EL, op0[1 .. 0], op1[2 .. 0], crn[3 .. 0], op2[2 .. 0], crm[3 .. 0], t);
    if (op0 == 3 & crn == 9) & (((op1 == 3 & op2 == 3) & (crm == 12 | crm == 14) | (op1 == 3 & (op2 == 1 | op2 == 2)) & crm == 12) | (op1 == 0 & (op2 == 1 | op2 == 2)) & crm == 14) then {
        let mask : bits(32) = PMUCounterMask();
        X_set__1(t, 64) = [X_read__1(t, 64) with 31 .. 0 = X_read__1(t, 64)[31 .. 0] & mask]
    };
    if (((op0 == 3 & op1 == 3) & crn == 9) & crm == 13) & (op2 == 1 | op2 == 2) then {
        if op2 == 1 then {
            if ((EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & Slice(PMSELR_EL0, 0, 5) != 0b11111) & UInt(Slice(PMSELR_EL0, 0, 5)) > AArch64_GetNumEventCountersAccessible() - 1 then {
                if UInt(Slice(PMSELR_EL0, 0, 5)) > GetNumEventCounters() - 1 then {
                    X_set__1(t, 64) = temp;
                    throw(Error_Undefined())
                } else {
                    X_set__1(t, 64) = temp;
                    AArch64_SystemAccessTrap(EL2, UInt(0x18))
                }
            } else if Slice(PMSELR_EL0, 0, 5) == 0b11111 then {
                X_set__1(t, 64) = PMCCFILTR_EL0
            } else {
                let 'pmselr_el0 = UInt(Slice(PMSELR_EL0, 0, 5));
                assert(pmselr_el0 < 31);
                X_set__1(t, 64) = PMEVTYPER_EL0[pmselr_el0]
            }
        };
        if op2 == 2 then {
            if UInt(Slice(PMSELR_EL0, 0, 5)) > GetNumEventCounters() - 1 & Slice(PMSELR_EL0, 0, 5) != 0b11111 | (EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & UInt(Slice(PMSELR_EL0, 0, 5)) > AArch64_GetNumEventCountersAccessible() - 1 then {
                if UInt(Slice(PMSELR_EL0, 0, 5)) > GetNumEventCounters() - 1 then {
                    X_set__1(t, 64) = temp;
                    throw(Error_Undefined())
                } else {
                    X_set__1(t, 64) = temp;
                    AArch64_SystemAccessTrap(EL2, UInt(0x18))
                }
            } else {
                let 'pmselr_el0 = UInt(Slice(PMSELR_EL0, 0, 5));
                assert(pmselr_el0 < 31);
                X_set__1(t, 64) = PMEVCNTR_EL0[pmselr_el0]
            }
        };
        ()
    };
    if (((op0 == 3 & crn == 9) & op1 == 3) & op2 == 0) & crm == 12 then {
        X_set__1(t, 64) = [X_read__1(t, 64) with 15 .. 11 = AArch64_GetNumEventCountersAccessible()[4 .. 0]]
    };
    if ((op0 == 3 & crn == 14) & op1 == 3) & (crm[3 .. 2] == 0b10 | crm[3 .. 2] == 0b11 & (crm[1 .. 0] @ op2[2 .. 0]) != 0b11111) then {
        if UInt(crm[1 .. 0] @ op2[2 .. 0]) > GetNumEventCounters() - 1 & (crm[1 .. 0] @ op2[2 .. 0]) != 0b11111 | (EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & UInt(crm[1 .. 0] @ op2[2 .. 0]) > AArch64_GetNumEventCountersAccessible() - 1 then {
            if UInt(crm[1 .. 0] @ op2[2 .. 0]) > GetNumEventCounters() - 1 then {
                throw(Error_Undefined())
            } else {
                X_set__1(t, 64) = temp;
                AArch64_SystemAccessTrap(EL2, UInt(0x18))
            }
        };
        ()
    };
    if (((op0 == 3 & crn == 5) & crm == 3) & op2 == 0) & op1 == 4 then {
        X_set__1(t, 64) = [X_read__1(t, 64) with 31 .. 31 = 0b0];
        X_set__1(t, 64) = [X_read__1(t, 64) with 28 .. 28 = 0b0];
        X_set__1(t, 64) = [X_read__1(t, 64) with 27 .. 27 = 0b0];
        X_set__1(t, 64) = [X_read__1(t, 64) with 10 .. 8 = 0b111];
        X_set__1(t, 64) = [X_read__1(t, 64) with 26 .. 26 = if __IMPDEF_boolean("Floating-Point Traps Support") then
          0b1
        else
          0b0];
        return()
    };
    if ((op0 == 2 & op1 == 0) & crn == 7) & op2 == 6 then {
        if crm == 8 then {
            X_set__1(t, 64) = [X_read__1(t, 64) with 7 .. 0 = 0b11111111];
            return()
        };
        if crm == 9 then {
            X_set__1(t, 64) = [X_read__1(t, 64) with 7 .. 0 = __claim_tags];
            return()
        };
        ()
    };
    if ((op0 == 2 & op1 == 1) & crn == 7) & op2 == 6 then {
        if crm == 8 then {
            X_set__1(t, 64) = [X_read__1(t, 64) with 31 .. 0 = __trcclaim_tags];
            return()
        };
        if crm == 9 then {
            X_set__1(t, 64) = [X_read__1(t, 64) with 31 .. 0 = __trcclaim_tags];
            return()
        };
        ()
    };
    if (((op0 == 3 & op1 == 0) & crn == 0) & op2 == 0) & crm == 6 then {
        if Slice(SCR_EL3, 34, 1) == 0b0 & (PSTATE.EL == EL1 | PSTATE.EL == EL2) then {
            X_set__1(t, 64) = [X_read__1(t, 64) with 27 .. 24 = 0b0000]
        } else if Slice(HCR_EL2, 39, 1) == 0b0 & PSTATE.EL == EL1 then {
            X_set__1(t, 64) = [X_read__1(t, 64) with 27 .. 24 = 0b0000]
        } else ();
        return()
    };
    if (((op0 == 3 & op1 == 0) & crn == UInt(0xa)) & op2 == 0) & crm == 5 then {
        if IsSecure() then {
            X_set__1(t, 64) = [X_read__1(t, 64) with 60 .. 60 = Slice(MPAM3_EL3, 60, 1)]
        };
        return()
    };
