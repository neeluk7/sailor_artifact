val __get_ACCDATA_EL1 : bits(64) -> bits(64)

function __get_ACCDATA_EL1 val_name = {
    tmp : bits(64) = val_name;
    tmp = SetSlice(32, tmp, 32, 0b00000000000000000000000000000000);
