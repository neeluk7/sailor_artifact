val AArch32_BreakpointValueMatch : forall ('linked_to : Bool) 'n_in.
  (int('n_in), bits(32), bool('linked_to)) -> (bool, bool)

function AArch32_BreakpointValueMatch (n_in, vaddress, linked_to) = {
    byte : int = undefined;
    c : Constraint = undefined;
    n : int = n_in;
    if n >= NumBreakpointsImplemented() then {
        c : Constraint = undefined;
        (c, n) = ConstrainUnpredictableInteger(0, NumBreakpointsImplemented() - 1, Unpredictable_BPNOTIMPL);
        assert(c == Constraint_DISABLED | c == Constraint_UNKNOWN);
        if c == Constraint_DISABLED then {
            return((false, false))
        };
        ()
    };
    let 'n = n;
    assert(constraint((0 <= 'n & 'n < 16)));
    if Slice(DBGBCR_read(n), 0, 1) == 0b0 then {
        return((false, false))
    };
    let context_aware : bool = n >= NumBreakpointsImplemented() - NumContextAwareBreakpointsImplemented();
    dbgtype : bits(4) = Slice(DBGBCR_read(n), 20, 4);
    if ((((match dbgtype {
      [bitzero, bitone, bitone, _] => true,
      [bitone, bitone, _, _] => true,
      _ => false
    }) : bool & not_bool(HaveVirtHostExt())) & not_bool(HaveV82Debug()) | (match dbgtype {
      [bitzero, bitone, bitzero, _] => true,
      _ => false
    }) : bool & HaltOnBreakpointOrWatchpoint()) | not_bool((match dbgtype {
      [bitzero, _, bitzero, _] => true,
      _ => false
    }) : bool) & not_bool(context_aware)) | (match dbgtype {
      [bitone, _, _, _] => true,
      _ => false
    }) : bool & not_bool(HaveEL(EL2)) then {
        (c, dbgtype) = ConstrainUnpredictableBits(0 + 4, Unpredictable_RESBPTYPE);
        assert(c == Constraint_DISABLED | c == Constraint_UNKNOWN);
        if c == Constraint_DISABLED then {
            return((false, false))
        };
        ()
    };
    let match_addr : bool = (match dbgtype {
      [bitzero, _, bitzero, _] => true,
      _ => false
    }) : bool;
    let mismatch : bool = (match dbgtype {
      [bitzero, bitone, bitzero, _] => true,
      _ => false
    }) : bool;
    let match_vmid : bool = (match dbgtype {
      [bitone, bitzero, _, _] => true,
      _ => false
    }) : bool;
    let match_cid1 : bool = (match dbgtype {
      [_, _, bitone, _] => true,
      _ => false
    }) : bool;
    let match_cid2 : bool = (match dbgtype {
      [bitone, bitone, _, _] => true,
      _ => false
    }) : bool;
    let linked : bool = (match dbgtype {
      [_, _, _, bitone] => true,
      _ => false
    }) : bool;
    if linked_to & (not_bool(linked) | match_addr) then {
        return((false, false))
    };
    if (not_bool(linked_to) & linked) & not_bool(match_addr) then {
        return((false, false))
    };
    BVR_match : bool = undefined;
    if match_addr then {
        let 'byte = UInt(vaddress[1 .. 0]);
        assert(byte == 0 | byte == 2);
        let byte_select_match : bool = [Slice(DBGBCR_read(n), 5, 4)[byte]] == 0b1;
        let 'top = 31;
        BVR_match = vaddress[top .. 2] == DBGBVR_read(n)[top .. 2] & byte_select_match
    } else if match_cid1 then {
        BVR_match = PSTATE.EL != EL2 & CONTEXTIDR_read() == DBGBVR_read(n)[31 .. 0]
    } else ();
    BXVR_match : bool = undefined;
    if match_vmid then {
        vmid : bits(16) = undefined;
        bvr_vmid : bits(16) = undefined;
        if ELUsingAArch32(EL2) then {
            vmid = ZeroExtend(Slice(VTTBR_read(), 48, 8), 16);
            bvr_vmid = ZeroExtend(DBGBXVR_read(n)[7 .. 0], 16)
        } else if not_bool(Have16bitVMID()) | Slice(VTCR_EL2, 19, 1) == 0b0 then {
            vmid = ZeroExtend(Slice(VTTBR_EL2, 48, 16)[7 .. 0], 16);
            bvr_vmid = ZeroExtend(DBGBXVR_read(n)[7 .. 0], 16)
        } else {
            vmid = Slice(VTTBR_EL2, 48, 16);
            bvr_vmid = DBGBXVR_read(n)[15 .. 0]
        };
        BXVR_match = ((PSTATE.EL == EL0 | PSTATE.EL == EL1) & EL2Enabled()) & vmid == bvr_vmid
    } else if match_cid2 then {
        BXVR_match = (((PSTATE.EL != EL3 & (HaveVirtHostExt() | HaveV82Debug())) & EL2Enabled()) & not_bool(ELUsingAArch32(EL2))) & DBGBXVR_read(n)[31 .. 0] == CONTEXTIDR_EL2[31 .. 0]
    } else ();
    let bvr_match_valid : bool = match_addr | match_cid1;
    let bxvr_match_valid : bool = match_vmid | match_cid2;
    let val_match : bool = (not_bool(bxvr_match_valid) | BXVR_match) & (not_bool(bvr_match_valid) | BVR_match);
    return((val_match & not_bool(mismatch), not_bool(val_match) & mismatch))
}

val AArch32_StateMatch : forall ('isbreakpnt : Bool) ('ispriv : Bool) ('linked_in : Bool).
  (bits(2), bits(1), bits(2), bool('linked_in), bits(4), bool('isbreakpnt), bool('ispriv)) -> bool

function AArch32_StateMatch (SSC_in, HMC_in, PxC_in, linked_in, LBN, isbreakpnt, ispriv) = {
    first_ctx_cmp : int = undefined;
    last_ctx_cmp : int = undefined;
    linked_to : bool = undefined;
    vaddress : bits(32) = undefined;
    SSC : bits(2) = SSC_in;
    HMC : bits(1) = HMC_in;
    PxC : bits(2) = PxC_in;
    linked : bool = linked_in;
    c : Constraint = undefined;
    let (__tup_0 : Constraint, __tup_1 : bits(2), _, __tup_3 : bits(1), __tup_4 : bits(2)) =
      CheckValidStateMatch(SSC, 0b0, HMC, PxC, isbreakpnt)
    in
      {
          c = __tup_0;
          SSC = __tup_1;
          HMC = __tup_3;
          PxC = __tup_4
      };
    if c == Constraint_DISABLED then {
        return(false)
    };
    let PL2_match : bool = HaveEL(EL2) & (HMC == 0b1 & (SSC @ PxC) != 0b1000 | SSC == 0b11);
    let PL1_match : bool = [PxC[0]] == 0b1;
    let PL0_match : bool = [PxC[1]] == 0b1;
    let SSU_match : bool = ((isbreakpnt & HMC == 0b0) & PxC == 0b00) & SSC != 0b11;
    priv_match : bool = undefined;
    if not_bool(ispriv) & not_bool(isbreakpnt) then {
        priv_match = PL0_match
    } else if SSU_match then {
        priv_match = PSTATE.M == M32_User | PSTATE.M == M32_Svc | PSTATE.M == M32_System
    } else {
        match PSTATE.EL {
          ? if ? == EL3 => {
              priv_match = PL1_match
          },
          ? if ? == EL2 => {
              priv_match = PL2_match
          },
          ? if ? == EL1 => {
              priv_match = PL1_match
          },
          ? if ? == EL0 => {
              priv_match = PL0_match
          },
          _ => ()
        }
    };
    security_state_match : bool = undefined;
    let ss : SecurityState = CurrentSecurityState();
    match SSC {
      0b00 => {
          security_state_match = true
      },
      0b01 => {
          security_state_match = ss == SS_NonSecure
      },
      0b10 => {
          security_state_match = ss == SS_Secure
      },
      0b11 => {
          security_state_match = HMC == 0b1 | ss == SS_Secure
      },
      _ => ()
    };
    lbn : int = undefined;
    if linked then {
        lbn = UInt(LBN);
        let 'first_ctx_cmp = NumBreakpointsImplemented() - NumContextAwareBreakpointsImplemented();
        let 'last_ctx_cmp = NumBreakpointsImplemented() - 1;
        if lbn < first_ctx_cmp | lbn > last_ctx_cmp then {
            (c, lbn) = ConstrainUnpredictableInteger(first_ctx_cmp, last_ctx_cmp, Unpredictable_BPNOTCTXCMP);
            assert(c == Constraint_DISABLED | c == Constraint_NONE | c == Constraint_UNKNOWN);
            match c {
              Constraint_DISABLED => {
                  return(false)
              },
              Constraint_NONE => {
                  linked = false
              },
              _ => ()
            }
        };
        ()
    };
    let 'lbn = lbn;
    linked_match : bool = undefined;
    if linked then {
        let vaddress : bits(32) = __UNKNOWN_bits(32);
        let linked_to : bool = true;
        let (__tup_0 : bool, _) = AArch32_BreakpointValueMatch(lbn, vaddress, linked_to);
        linked_match = __tup_0
    };
    return((priv_match & security_state_match) & (not_bool(linked) | linked_match))
}

val AArch32_BreakpointMatch : forall 'n 'size, (0 <= 'n & 'n < 16).
  (int('n), bits(32), int('size)) -> (bool, bool)

function AArch32_BreakpointMatch (n, vaddress, size) = {
    match_i : bool = undefined;
    mismatch_i : bool = undefined;
    value_match_name : bool = undefined;
    value_mismatch_name : bool = undefined;
    assert(ELUsingAArch32(S1TranslationRegime__1()));
    assert(n < NumBreakpointsImplemented());
    let enabled : bool = Slice(DBGBCR_read(n), 0, 1) == 0b1;
    let ispriv : bool = PSTATE.EL != EL0;
    let linked : bool = (match Slice(DBGBCR_read(n), 20, 4) {
      [bitzero, _, bitzero, bitone] => true,
      _ => false
    }) : bool;
    let isbreakpnt : bool = true;
    let linked_to : bool = false;
    let state_match : bool = AArch32_StateMatch(Slice(DBGBCR_read(n), 14, 2), Slice(DBGBCR_read(n), 13, 1), Slice(DBGBCR_read(n), 1, 2), linked, Slice(DBGBCR_read(n), 16, 4), isbreakpnt, ispriv);
    (value_match_name, value_mismatch_name) = AArch32_BreakpointValueMatch(n, vaddress, linked_to);
    if size == 4 then {
        (match_i, mismatch_i) = AArch32_BreakpointValueMatch(n, vaddress + 2, linked_to);
        if not_bool(value_match_name) & match_i then {
            value_match_name = ConstrainUnpredictableBool(Unpredictable_BPMATCHHALF)
        };
        if value_mismatch_name & not_bool(mismatch_i) then {
            value_mismatch_name = ConstrainUnpredictableBool(Unpredictable_BPMISMATCHHALF)
        };
        ()
    };
    if [vaddress[1]] == 0b1 & Slice(DBGBCR_read(n), 5, 4) == 0b1111 then {
        if value_match_name then {
            value_match_name = ConstrainUnpredictableBool(Unpredictable_BPMATCHHALF)
        };
        if not_bool(value_mismatch_name) then {
            value_mismatch_name = ConstrainUnpredictableBool(Unpredictable_BPMISMATCHHALF)
        };
        ()
    };
    let val_match : bool = (value_match_name & state_match) & enabled;
    let mismatch : bool = (value_mismatch_name & state_match) & enabled;
    return((val_match, mismatch))
}

val AArch32_DebugFault : forall ('iswrite : Bool).
  (AccType, bool('iswrite), bits(4)) -> FaultRecord

function AArch32_DebugFault (acctype, iswrite, debugmoe) = {
    fault : FaultRecord = undefined;
    fault.statuscode = Fault_Debug;
    fault.acctype = acctype;
    fault.write = iswrite;
    fault.debugmoe = debugmoe;
    fault.secondstage = false;
    fault.s2fs1walk = false;
    return(fault)
}

let DebugException_Breakpoint : bits(4) = 0b0001

val AArch32_CheckBreakpoint : forall 'size.
  (bits(32), int('size)) -> FaultRecord

function AArch32_CheckBreakpoint (vaddress, size) = {
    acctype : AccType = undefined;
    debugmoe : bits(4) = undefined;
    iswrite : bool = undefined;
    match_i : bool = undefined;
    mismatch_i : bool = undefined;
    reason : bits(6) = undefined;
    assert(ELUsingAArch32(S1TranslationRegime__1()));
    assert(size == 2 | size == 4);
    val_match : bool = false;
    mismatch : bool = false;
    foreach (i from 0 to (NumBreakpointsImplemented() - 1) by 1 in inc) {
        assert(constraint(('loop_i < 16 | not('size in {2, 4}))));
        (match_i, mismatch_i) = AArch32_BreakpointMatch(i, vaddress, size);
        val_match = val_match | match_i;
        mismatch = mismatch | mismatch_i
    };
    if val_match & HaltOnBreakpointOrWatchpoint() then {
        let reason : bits(6) = DebugHalt_Breakpoint;
        Halt(reason);
        return(undefined : FaultRecord)
    } else if val_match | mismatch then {
        let acctype : AccType = AccType_IFETCH;
        let iswrite : bool = false;
        let debugmoe : bits(4) = DebugException_Breakpoint;
        return(AArch32_DebugFault(acctype, iswrite, debugmoe))
    } else {
        return(NoFault())
    }
}

val DebugTargetFrom : forall ('secure : Bool). bool('secure) -> bits(2)

function DebugTargetFrom secure = {
    route_to_el2 : bool = undefined;
    if HaveEL(EL2) & (not_bool(secure) | HaveSecureEL2Ext() & (not_bool(HaveEL(EL3)) | Slice(SCR_EL3, 18, 1) == 0b1)) then {
        if ELUsingAArch32(EL2) then {
            route_to_el2 = Slice(HDCR_read(), 8, 1) == 0b1 | Slice(HCR_read(), 27, 1) == 0b1
        } else {
            route_to_el2 = Slice(MDCR_EL2, 8, 1) == 0b1 | Slice(HCR_EL2, 27, 1) == 0b1
        }
    } else {
        route_to_el2 = false
    };
    target : bits(2) = undefined;
    if route_to_el2 then {
        target = EL2
    } else if (HaveEL(EL3) & not_bool(HaveAArch64())) & secure then {
        target = EL3
    } else {
        target = EL1
    };
    return(target)
}

val DebugTarget : unit -> bits(2)

function DebugTarget () = {
    let secure : bool = IsSecure();
    return(DebugTargetFrom(secure))
}

val AArch32_VCRMatch : bits(32) -> bool

function AArch32_VCRMatch vaddress = {
    match_word : bits(32) = undefined;
    val_match : bool = undefined;
    if (UsingAArch32() & ELUsingAArch32(EL1)) & PSTATE.EL != EL2 then {
        match_word : bits(32) = Zeros(32);
        if vaddress[31 .. 5] == ExcVectorBase()[31 .. 5] then {
            if HaveEL(EL3) & not_bool(IsSecure()) then {
                match_word[UInt(vaddress[4 .. 2]) + 24] = Bit(0b1)
            } else {
                match_word[UInt(vaddress[4 .. 2]) + 0] = Bit(0b1)
            }
        };
        if ((HaveEL(EL3) & ELUsingAArch32(EL3)) & IsSecure()) & vaddress[31 .. 5] == MVBAR[31 .. 5] then {
            match_word[UInt(vaddress[4 .. 2]) + 8] = Bit(0b1)
        };
        mask : bits(32) = undefined;
        if not_bool(HaveEL(EL3)) then {
            mask = ((0b00000000 @ 0b00000000) @ 0b00000000) @ 0b11011110
        } else if not_bool(ELUsingAArch32(EL3)) then {
            mask = ((0b11011110 @ 0b00000000) @ 0b00000000) @ 0b11011110
        } else {
            mask = ((0b11011110 @ 0b00000000) @ 0b11011100) @ 0b11011110
        };
        let match_word : bits(32) = (match_word & DBGVCR_read()) & mask;
        val_match = not_bool(IsZero(match_word));
        if not_bool(IsZero(match_word[28 .. 27] @ (match_word[12 .. 11] @ match_word[4 .. 3]))) & DebugTarget() == PSTATE.EL then {
            val_match = ConstrainUnpredictableBool(Unpredictable_VCMATCHDAPA)
        };
        if not_bool(IsZero(vaddress[1 .. 0])) & val_match then {
            val_match = ConstrainUnpredictableBool(Unpredictable_VCMATCHHALF)
        };
        ()
    } else {
        val_match = false
    };
    return(val_match)
}

val AArch32_CheckVectorCatch : forall 'size.
  (bits(32), int('size)) -> FaultRecord

function AArch32_CheckVectorCatch (vaddress, size) = {
    acctype : AccType = undefined;
    debugmoe : bits(4) = undefined;
    iswrite : bool = undefined;
    assert(ELUsingAArch32(S1TranslationRegime__1()));
    val_match : bool = AArch32_VCRMatch(vaddress);
    if (size == 4 & not_bool(val_match)) & AArch32_VCRMatch(vaddress + 2) then {
        val_match = ConstrainUnpredictableBool(Unpredictable_VCMATCHHALF)
    };
    if val_match then {
        let acctype : AccType = AccType_IFETCH;
        let iswrite : bool = false;
        let debugmoe : bits(4) = DebugException_VectorCatch;
        return(AArch32_DebugFault(acctype, iswrite, debugmoe))
    } else {
        return(NoFault())
    }
}

val AArch32_AccessUsesEL : AccType -> bits(2)

function AArch32_AccessUsesEL acctype = {
    if acctype == AccType_UNPRIV then {
        return(EL0)
    } else {
        return(PSTATE.EL)
    }
}

val AArch32_WatchpointByteMatch : forall 'n, (0 <= 'n & 'n < 16).
  (int('n), bits(32)) -> bool

function AArch32_WatchpointByteMatch (n, vaddress) = {
    LSB : bits(8) = undefined;
    MSB : bits(8) = undefined;
    top : {|31, 63|} = 31;
    bottom : {|2, 3|} = if [DBGWVR_read(n)[2]] == 0b1 then 2 else 3;
    byte_select_match : bool = let 'bottom = bottom in
      {
          [Slice(DBGWCR_read(n), 5, 8)[UInt(vaddress[bottom - 1 .. 0])]] != 0b0
      };
    mask : int = UInt(Slice(DBGWCR_read(n), 24, 5));
    if mask > 0 & not_bool(IsOnes(Slice(DBGWCR_read(n), 5, 8))) then {
        byte_select_match = ConstrainUnpredictableBool(Unpredictable_WPMASKANDBAS)
    } else {
        let LSB : bits(8) = Slice(DBGWCR_read(n), 5, 8) & not_vec(Slice(DBGWCR_read(n), 5, 8) - 1);
        let MSB : bits(8) = Slice(DBGWCR_read(n), 5, 8) + LSB;
        if not_bool(IsZero(MSB & MSB - 1)) then {
            byte_select_match = ConstrainUnpredictableBool(Unpredictable_WPBASCONTIGUOUS);
            bottom = 3
        };
        ()
    };
    let 'bottom = bottom;
    if mask > 0 & mask <= 2 then {
        c : Constraint = undefined;
        (c, mask) = ConstrainUnpredictableInteger(3, 31, Unpredictable_RESWPMASK);
        assert(c == Constraint_DISABLED | c == Constraint_NONE | c == Constraint_UNKNOWN);
        match c {
          Constraint_DISABLED => {
              return(false)
          },
          Constraint_NONE => {
              mask = 0
          },
          _ => ()
        }
    };
    let 'mask = mask;
    WVR_match : bool = undefined;
    if mask > bottom then {
        if not_bool(is_ones_subrange(DBGBVR_EL1[n], 63, top)) & not_bool(is_zero_subrange(DBGBVR_EL1[n], 63, top)) then {
            if ConstrainUnpredictableBool(Unpredictable_DBGxVR_RESS) then {
                top = 63
            };
            ()
        };
        let 'top = top;
        assert(constraint(('mask <= 'top & 'top < 32)));
        WVR_match = vaddress[top .. mask] == DBGWVR_read(n)[top .. mask];
        if WVR_match & not_bool(is_zero_subrange(DBGWVR_read(n), mask - 1, bottom)) then {
            WVR_match = ConstrainUnpredictableBool(Unpredictable_WPMASKEDBITS)
        };
        ()
    } else {
        let 'top = top in
          {
              assert(constraint('top < 32));
              WVR_match = vaddress[top .. bottom] == DBGWVR_read(n)[top .. bottom]
          };
        ()
    };
    return(WVR_match & byte_select_match)
}

val AArch32_WatchpointMatch : forall ('ispriv : Bool) ('iswrite : Bool) 'n 'size,
  (0 <= 'n & 'n < 16).
  (int('n), bits(32), int('size), bool('ispriv), AccType, bool('iswrite)) -> bool

function AArch32_WatchpointMatch (n, vaddress, size, ispriv, acctype, iswrite) = {
    assert(ELUsingAArch32(S1TranslationRegime__1()));
    assert(n < NumWatchpointsImplemented());
    let enabled : bool = Slice(DBGWCR_read(n), 0, 1) == 0b1;
    let linked : bool = Slice(DBGWCR_read(n), 20, 1) == 0b1;
    let isbreakpnt : bool = false;
    let state_match : bool = AArch32_StateMatch(Slice(DBGWCR_read(n), 14, 2), Slice(DBGWCR_read(n), 13, 1), Slice(DBGWCR_read(n), 1, 2), linked, Slice(DBGWCR_read(n), 16, 4), isbreakpnt, ispriv);
    ls_match : bool = false;
    let ls_match : bool = [Slice(DBGWCR_read(n), 3, 2)[if iswrite then 1 else 0]] == 0b1;
    value_match_name : bool = false;
    foreach (byte from 0 to (size - 1) by 1 in inc) {
        value_match_name = value_match_name | AArch32_WatchpointByteMatch(n, vaddress + byte)
    };
    return(((value_match_name & state_match) & ls_match) & enabled)
}

let DebugException_Watchpoint : bits(4) = 0b1010

val AArch32_CheckWatchpoint : forall ('iswrite : Bool) 'size.
  (bits(32), AccType, bool('iswrite), int('size)) -> FaultRecord

function AArch32_CheckWatchpoint (vaddress, acctype, iswrite, size) = {
    debugmoe : bits(4) = undefined;
    reason : bits(6) = undefined;
    assert(ELUsingAArch32(S1TranslationRegime__1()));
    if acctype == AccType_TTW | acctype == AccType_IC | acctype == AccType_AT | acctype == AccType_ATPAN then {
        return(NoFault())
    };
    if acctype == AccType_DC then {
        if not_bool(iswrite) then {
            return(NoFault())
        } else if not_bool(__IMPDEF_boolean("DCIMVAC generates watchpoint")) then {
            return(NoFault())
        } else ()
    };
    val_match : bool = false;
    let ispriv : bool = AArch32_AccessUsesEL(acctype) != EL0;
    foreach (i from 0 to (NumWatchpointsImplemented() - 1) by 1 in inc) {
        assert(constraint('loop_i < 16));
        if AArch32_WatchpointMatch(i, vaddress, size, ispriv, acctype, iswrite) then {
            val_match = true
        };
        ()
    };
    if val_match & HaltOnBreakpointOrWatchpoint() then {
        let reason : bits(6) = DebugHalt_Watchpoint;
        EDWAR = ZeroExtend(vaddress);
        Halt(reason);
        return(undefined : FaultRecord)
    } else if val_match then {
        let debugmoe : bits(4) = DebugException_Watchpoint;
        return(AArch32_DebugFault(acctype, iswrite, debugmoe))
    } else {
        return(NoFault())
    }
}

val AArch32_SelfHostedSecurePrivilegedInvasiveDebugEnabled : unit -> bool

function AArch32_SelfHostedSecurePrivilegedInvasiveDebugEnabled () = {
    if not_bool(HaveEL(EL3)) & not_bool(IsSecure()) then {
        return(false)
    };
    return(DBGEN == HIGH & SPIDEN == HIGH)
}

val AArch32_GenerateDebugExceptionsFrom : forall ('secure : Bool).
  (bits(2), bool('secure)) -> bool

function AArch32_GenerateDebugExceptionsFrom (from, secure) = {
    mask : bits(1) = undefined;
    spd : bits(2) = undefined;
    if not_bool(ELUsingAArch32(DebugTargetFrom(secure))) then {
        let mask : bits(1) = 0b0;
        return(AArch64_GenerateDebugExceptionsFrom(from, secure, mask))
    };
    if (Slice(DBGOSLSR_read(), 1, 1) == 0b1 | DoubleLockStatus()) | Halted() then {
        return(false)
    };
    enabled : bool = undefined;
    if HaveEL(EL3) & secure then {
        assert(from != EL2);
        if IsSecureEL2Enabled() then {
            enabled = Slice(MDCR_EL3, 16, 1) == 0b0
        } else {
            let spd : bits(2) = if ELUsingAArch32(EL3) then Slice(SDCR, 14, 2)
            else
              Slice(MDCR_EL3, 14, 2);
            if [spd[1]] == 0b1 then {
                enabled = [spd[0]] == 0b1
            } else {
                enabled = AArch32_SelfHostedSecurePrivilegedInvasiveDebugEnabled()
            }
        };
        if from == EL0 then {
            enabled = enabled | Slice(SDER_read(), 0, 1) == 0b1
        };
        ()
    } else {
        enabled = from != EL2
    };
    return(enabled)
}

val AArch32_GenerateDebugExceptions : unit -> bool

function AArch32_GenerateDebugExceptions () = {
    return(AArch32_GenerateDebugExceptionsFrom(PSTATE.EL, IsSecure()))
}

val AArch32_CheckDebug : forall ('iswrite : Bool) 'size.
  (bits(32), AccType, bool('iswrite), int('size)) -> FaultRecord

function AArch32_CheckDebug (vaddress, acctype, iswrite, size) = {
    fault : FaultRecord = NoFault();
    let d_side : bool = acctype != AccType_IFETCH;
    let generate_exception : bool = AArch32_GenerateDebugExceptions() & Slice(DBGDSCRext_read(), 15, 1) == 0b1;
    let halt : bool = HaltOnBreakpointOrWatchpoint();
    let vector_catch_first_name : bool = ConstrainUnpredictableBool(Unpredictable_BPVECTORCATCHPRI);
    if (not_bool(d_side) & vector_catch_first_name) & generate_exception then {
        fault = AArch32_CheckVectorCatch(vaddress, size)
    };
    if fault.statuscode == Fault_None & (generate_exception | halt) then {
        if d_side then {
            fault = AArch32_CheckWatchpoint(vaddress, acctype, iswrite, size)
        } else {
            fault = AArch32_CheckBreakpoint(vaddress, size)
        }
    };
    if ((fault.statuscode == Fault_None & not_bool(d_side)) & not_bool(vector_catch_first_name)) & generate_exception then {
        return(AArch32_CheckVectorCatch(vaddress, size))
    };
    return(fault)
}

val AArch32_FullTranslate : forall ('aligned : Bool) ('iswrite : Bool).
  (bits(32), AccType, bool('iswrite), bool('aligned)) -> AddressDescriptor

function AArch32_FullTranslate (va, acctype, iswrite, aligned) = {
    s2fs1walk : bool = undefined;
    fault : FaultRecord = NoFault();
    fault.acctype = acctype;
    fault.write = iswrite;
    let regime : Regime = TranslationRegime(PSTATE.EL, acctype);
    let ispriv : bool = PSTATE.EL != EL0 & acctype != AccType_UNPRIV;
    let ss : SecurityState = SecurityStateForRegime(regime);
    ipa : AddressDescriptor = undefined;
    if regime == Regime_EL2 | Slice(TTBCR_read(), 31, 1) == 0b1 then {
        (fault, ipa) = AArch32_S1TranslateLD(fault, regime, ss, va, acctype, aligned, iswrite, ispriv)
    } else {
        let (__tup_0 : FaultRecord, __tup_1 : AddressDescriptor, _) = AArch32_S1TranslateSD(fault, regime, ss, va, acctype, aligned, iswrite, ispriv);
        fault = __tup_0;
        ipa = __tup_1
    };
    if fault.statuscode != Fault_None then {
        return(CreateFaultyAddressDescriptor(ZeroExtend(va), fault))
    };
    if regime == Regime_EL10 & EL2Enabled() then {
        ipa.vaddress = ZeroExtend(va);
        let s2fs1walk : bool = false;
        pa : AddressDescriptor = undefined;
        (fault, pa) = AArch32_S2Translate(fault, ipa, ss, s2fs1walk, acctype, aligned, iswrite, ispriv);
        if fault.statuscode != Fault_None then {
            return(CreateFaultyAddressDescriptor(ZeroExtend(va), fault))
        } else {
            return(pa)
        }
    } else {
        return(ipa)
    }
}

val RegimeUsingAArch32 : Regime -> bool

function RegimeUsingAArch32 regime = {
    match regime {
      Regime_EL10 => {
          return(ELUsingAArch32(EL1))
      },
      Regime_EL30 => {
          return(true)
      },
      Regime_EL20 => {
          return(false)
      },
      Regime_EL2 => {
          return(ELUsingAArch32(EL2))
      },
      Regime_EL3 => {
          return(false)
      },
      _ => {
          return(undefined : bool)
      }
    }
}

val AArch32_TranslateAddress : forall ('aligned : Bool) ('iswrite : Bool) 'size.
  (bits(32), AccType, bool('iswrite), bool('aligned), int('size)) -> AddressDescriptor

function AArch32_TranslateAddress (va, acctype, iswrite, aligned, size) = {
    let regime : Regime = TranslationRegime(PSTATE.EL, acctype);
    if not_bool(RegimeUsingAArch32(regime)) then {
        return(AArch64_TranslateAddress(ZeroExtend(va, 64), acctype, iswrite, aligned, size))
    };
    result : AddressDescriptor = AArch32_FullTranslate(va, acctype, iswrite, aligned);
    if not_bool(IsFault(result)) then {
        result.fault = AArch32_CheckDebug(va, acctype, iswrite, size)
    };
    result.vaddress = ZeroExtend(va);
    return(result)
}

val AArch32_DC : (bits(32), CacheOp, CacheOpScope) -> unit

function AArch32_DC (regval, cacheop, opscope) = {
    memaddrdesc : AddressDescriptor = undefined;
    memattrs : MemoryAttributes = undefined;
    wasaligned : bool = undefined;
    let acctype : AccType = AccType_DC;
    cache : CacheRecord = undefined;
    cache.acctype = acctype;
    cache.cacheop = cacheop;
    cache.opscope = opscope;
    cache.cachetype = CacheType_Data;
    cache.security = SecurityStateAtEL(PSTATE.EL);
    if opscope == CacheOpScope_SetWay then {
        cache.shareability = Shareability_NSH;
        (cache.set, cache.way, cache.level) = DecodeSW(ZeroExtend(regval), CacheType_Data);
        if ((cacheop == CacheOp_Invalidate & PSTATE.EL == EL1) & EL2Enabled()) & (((not_bool(ELUsingAArch32(EL2)) & Slice(HCR_EL2, 1, 1) == 0b1 | ELUsingAArch32(EL2) & Slice(HCR_read(), 1, 1) == 0b1) | not_bool(ELUsingAArch32(EL2)) & (Slice(HCR_EL2, 12, 1) @ Slice(HCR_EL2, 0, 1)) != 0b00) | ELUsingAArch32(EL2) & (Slice(HCR_read(), 12, 1) @ Slice(HCR_read(), 0, 1)) != 0b00) then {
            cache.cacheop = CacheOp_CleanInvalidate
        };
        CACHE_OP(cache);
        return()
    };
    if EL2Enabled() then {
        if PSTATE.EL == EL0 | PSTATE.EL == EL1 then {
            cache.is_vmid_valid = true;
            cache.vmid = VMID_read()
        } else {
            cache.is_vmid_valid = false
        }
    } else {
        cache.is_vmid_valid = false
    };
    if PSTATE.EL == EL0 then {
        cache.is_asid_valid = true;
        cache.asid = ASID_read()
    } else {
        cache.is_asid_valid = false
    };
    let need_translate : bool = DCInstNeedsTranslation(opscope);
    let iswrite : bool = cacheop == CacheOp_Invalidate;
    vaddress : bits(32) = regval;
    size : int = 0;
    if iswrite then {
        size = __IMPDEF_integer("Data Cache Invalidate Watchpoint Size");
        assert(size >= 4 * pow2(UInt(Slice(CTR_EL0, 16, 4))) & size <= 2048);
        assert(UInt(size[32 .. 0] & (size - 1)[32 .. 0]) == 0);
        vaddress = Align(regval, size)
    };
    let 'size = size;
    cache.translated = need_translate;
    cache.vaddress = ZeroExtend(vaddress);
    if need_translate then {
        let wasaligned : bool = true;
        let memaddrdesc : AddressDescriptor = AArch32_TranslateAddress(vaddress, acctype, iswrite, wasaligned, size);
        if IsFault(memaddrdesc) then {
            AArch32_Abort(regval, memaddrdesc.fault)
        };
        let memattrs : MemoryAttributes = memaddrdesc.memattrs;
        cache.paddress = memaddrdesc.paddress;
        if opscope == CacheOpScope_PoC then {
            cache.shareability = memattrs.shareability
        } else {
            cache.shareability = Shareability_NSH
        }
    } else {
        cache.shareability = __UNKNOWN_Shareability();
        cache.paddress = __UNKNOWN_FullAddress()
    };
