val BRB_INJ : unit -> unit

function BRB_INJ () = {
    UpdateBranchRecordBuffer(Slice(BRBINFINJ_EL1, 46, 1), Slice(BRBINFINJ_EL1, 32, 14), Slice(BRBINFINJ_EL1, 17, 1), Slice(BRBINFINJ_EL1, 16, 1), Slice(BRBINFINJ_EL1, 8, 6), Slice(BRBINFINJ_EL1, 6, 2), Slice(BRBINFINJ_EL1, 5, 1), Slice(BRBINFINJ_EL1, 0, 2), Slice(BRBSRCINJ_EL1, 0, 64), Slice(BRBTGTINJ_EL1, 0, 64));
    BRBINFINJ_EL1 = __UNKNOWN_bits(64);
    BRBSRCINJ_EL1 = __UNKNOWN_bits(64);
    BRBTGTINJ_EL1 = __UNKNOWN_bits(64);
    if ConstrainUnpredictableBool(Unpredictable_BRBFILTRATE) then {
        PMUEvent(PMU_EVENT_BRB_FILTRATE)
    };
    ()
}

