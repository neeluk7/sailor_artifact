val ZAvector_read : forall 'index 'width,
  ('index < 256 | not(('index >= 0 & 'index < div('width, 8)))) & ('width - 1 < 2048 | not(('index >= 0 & 'index < div('width, 8)))).
  (implicit('width), int('index)) -> bits('width)

function ZAvector_read (width, index) = {
    let 'SVL = SVL_read();
    assert(width == SVL);
    assert(index >= 0 & index < DIV(width, 8));
    return(_ZA[index][width - 1 .. 0])
}

val ZAvector_set : forall 'index 'width,
  ('index < 256 | not(('index >= 0 & 'index < div('width, 8)))) & (2048 >= 'width | not(('index >= 0 & 'index < div('width, 8)))).
  (implicit('width), int('index), bits('width)) -> unit

function ZAvector_set (width, index, value_name) = {
    let 'SVL = SVL_read();
    assert(width == SVL);
    assert(index >= 0 & index < DIV(width, 8));
    if ConstrainUnpredictableBool(Unpredictable_SMEZEROUPPER) then {
        _ZA[index] = ZeroExtend(value_name)
    } else {
        _ZA[index][width - 1 .. 0] = value_name
    }
}

val ZAhslice_read : forall 'esize 'slice_name 'tile 'width.
  (implicit('width), int('tile), int('esize), int('slice_name)) -> bits('width)

function ZAhslice_read (width, tile, esize, slice_name) = {
    let 'SVL = SVL_read();
    assert(esize == 8 | esize == 16 | esize == 32 | esize == 64 | esize == 128);
    let 'tiles = DIV(esize, 8);
    assert(tile >= 0 & tile < tiles);
    let 'slices = DIV(SVL, esize);
    assert(slice_name >= 0 & slice_name < slices);
    assert(constraint(('tile + 'slice_name * 'tiles < 256 | not(('tile + 'slice_name * 'tiles >= 0 & 'tile + 'slice_name * 'tiles < div('width, 8))) | not('esize in {8, 16, 32, 64, 128}))));
    assert(constraint(('width - 1 < 2048 | not(('tile + 'slice_name * 'tiles >= 0 & 'tile + 'slice_name * 'tiles < div('width, 8))) | not('esize in {8, 16, 32, 64, 128}))));
    return(ZAvector_read(width, tile + slice_name * tiles))
}

val ZAhslice_set : forall 'esize 'slice_name 'tile 'width.
  (implicit('width), int('tile), int('esize), int('slice_name), bits('width)) -> unit

function ZAhslice_set (width, tile, esize, slice_name, value_name) = {
    let 'SVL = SVL_read();
    assert(esize == 8 | esize == 16 | esize == 32 | esize == 64 | esize == 128);
    let 'tiles = DIV(esize, 8);
    assert(tile >= 0 & tile < tiles);
    let 'slices = DIV(SVL, esize);
    assert(slice_name >= 0 & slice_name < slices);
    assert(constraint(('tile + 'slice_name * 'tiles < 256 | not(('tile + 'slice_name * 'tiles >= 0 & 'tile + 'slice_name * 'tiles < div('width, 8))) | not('esize in {8, 16, 32, 64, 128}))));
    assert(constraint((2048 >= 'width | not(('tile + 'slice_name * 'tiles >= 0 & 'tile + 'slice_name * 'tiles < div('width, 8))) | not('esize in {8, 16, 32, 64, 128}))));
    ZAvector_set(width, tile + slice_name * tiles) = value_name
}

val ZAvslice_read : forall 'esize 'slice_name 'tile 'width,
  (0 <= 'slice_name * 'esize & 'slice_name * 'esize <= 'slice_name * 'esize + 'esize - 1 | not(('slice_name >= 0 & ('slice_name + 1) * 'esize <= 'width))).
  (implicit('width), int('tile), int('esize), int('slice_name)) -> bits('width)

function ZAvslice_read (width, tile, esize, slice_name) = {
    let 'SVL = SVL_read();
    let 'slices = DIV(SVL, esize);
    result : bits('width) = undefined;
    foreach (s from 0 to (slices - 1) by 1 in inc) {
        let hslice : bits('width) = ZAhslice_read(width, tile, esize, s);
        assert(constraint((0 <= 'loop_s * 'esize & 'loop_s * 'esize <= ('loop_s + 1) * 'esize - 1 | not(('loop_s >= 0 & ('loop_s + 1) * 'esize <= 'width)))));
        result = Elem_set(result, s, esize, Elem_read(hslice, slice_name, esize))
    };
    return(result)
}

val ZAvslice_set : forall 'esize 'slice_name 'tile 'width,
  (0 <= 'slice_name * 'esize & 'slice_name * 'esize <= ('slice_name + 1) * 'esize - 1 | not(('slice_name >= 0 & ('slice_name + 1) * 'esize <= 'width))).
  (implicit('width), int('tile), int('esize), int('slice_name), bits('width)) -> unit

function ZAvslice_set (width, tile, esize, slice_name, value_name) = {
    let 'SVL = SVL_read();
    let 'slices = DIV(SVL, esize);
    foreach (s from 0 to (slices - 1) by 1 in inc) {
        hslice : bits('width) = ZAhslice_read(width, tile, esize, s);
        assert(constraint((0 <= 'loop_s * 'esize & 'loop_s * 'esize <= 'loop_s * 'esize + 'esize - 1 | not(('loop_s >= 0 & ('loop_s + 1) * 'esize <= 'width)))));
        hslice = Elem_set(hslice, slice_name, esize, Elem_read(value_name, s, esize));
        ZAhslice_set(width, tile, esize, s) = hslice
    }
}

val ZAslice_read : forall 'esize 'slice_name 'tile ('vertical : Bool) 'width,
  (0 <= 'slice_name * 'esize & 'slice_name * 'esize <= 'slice_name * 'esize + 'esize - 1 | not(('slice_name >= 0 & ('slice_name + 1) * 'esize <= 'width)) | not('vertical)).
  (implicit('width), int('tile), int('esize), bool('vertical), int('slice_name)) -> bits('width)

function ZAslice_read (width, tile, esize, vertical, slice_name) = {
    result : bits('width) = undefined;
    if vertical then {
        result = ZAvslice_read(width, tile, esize, slice_name)
    } else {
        result = ZAhslice_read(width, tile, esize, slice_name)
    };
    return(result)
}

val ZAslice_set : forall 'esize 'slice_name 'tile ('vertical : Bool) 'width,
  (0 <= 'slice_name * 'esize & 'slice_name * 'esize <= ('slice_name + 1) * 'esize - 1 | not(('slice_name >= 0 & ('slice_name + 1) * 'esize <= 'width)) | not('vertical)).
  (implicit('width), int('tile), int('esize), bool('vertical), int('slice_name), bits('width)) -> unit

function ZAslice_set (width, tile, esize, vertical, slice_name, value_name) = {
    if vertical then {
        ZAvslice_set(width, tile, esize, slice_name) = value_name
    } else {
        ZAhslice_set(width, tile, esize, slice_name) = value_name
    }
}

val ZAtile_read : forall 'esize 'svl 'tile 'width.
  (implicit('width), int('svl), int('tile), int('esize)) -> bits('width)

function ZAtile_read (width, svl, tile, esize) = {
    let 'slices = DIV(svl, esize);
    assert(width == svl * slices);
    result : bits('width) = undefined;
    foreach (slice_name from 0 to (slices - 1) by 1 in inc) {
        assert(constraint((0 <= 'loop_slice_name * 'svl & 'loop_slice_name * 'svl <= ('loop_slice_name + 1) * 'svl - 1 | not(('loop_slice_name >= 0 & ('loop_slice_name + 1) * 'svl <= 'width)))));
        result = Elem_set(result, slice_name, svl, ZAhslice_read(svl, tile, esize, slice_name))
    };
    return(result)
}

val ZAtile_set : forall 'esize 'svl 'tile 'width.
  (implicit('width), int('svl), int('tile), int('esize), bits('width)) -> unit

function ZAtile_set (width, svl, tile, esize, value_name) = {
    let 'slices = DIV(svl, esize);
    assert(width == svl * slices);
    foreach (slice_name from 0 to (slices - 1) by 1 in inc) {
        assert(constraint((0 <= 'loop_slice_name * 'svl & 'loop_slice_name * 'svl <= 'loop_slice_name * 'svl + 'svl - 1 | not(('loop_slice_name >= 0 & ('loop_slice_name + 1) * 'svl <= 'width)))));
        ZAhslice_set(svl, tile, esize, slice_name) = Elem_read(value_name, slice_name, svl)
    }
}

val CheckMOPSEnabled : unit -> unit

function CheckMOPSEnabled () = {
    if (((PSTATE.EL == EL0 | PSTATE.EL == EL1) & EL2Enabled()) & (Slice(HCR_EL2, 27, 1) == 0b0 | Slice(HCR_EL2, 34, 1) == 0b0)) & (not_bool(IsHCRXEL2Enabled()) | Slice(HCRX_EL2, 11, 1) == 0b0) then {
        throw(Error_Undefined())
    };
    if (PSTATE.EL == EL0 & Slice(SCTLR_EL1, 33, 1) == 0b0) & ((not_bool(EL2Enabled()) | Slice(HCR_EL2, 27, 1) == 0b0) | Slice(HCR_EL2, 34, 1) == 0b0) then {
        throw(Error_Undefined())
    };
    if (PSTATE.EL == EL0 & IsInHost()) & Slice(SCTLR_EL2, 33, 1) == 0b0 then {
        throw(Error_Undefined())
    };
    ()
}

val MemCpyAccessTypes : bits(4) -> (AccType, AccType)

function MemCpyAccessTypes options_name = {
    let unpriv_at_el1 : bool = PSTATE.EL == EL1 & not_bool((EL2Enabled() & HaveNVExt()) & (Slice(HCR_EL2, 42, 1) @ Slice(HCR_EL2, 43, 1)) == 0b11);
    let unpriv_at_el2 : bool = (PSTATE.EL == EL2 & HaveVirtHostExt()) & (Slice(HCR_EL2, 34, 1) @ Slice(HCR_EL2, 27, 1)) == 0b11;
    let runpriv_at_el1 : bool = [options_name[1]] == 0b1 & unpriv_at_el1;
    let runpriv_at_el2 : bool = [options_name[1]] == 0b1 & unpriv_at_el2;
    let wunpriv_at_el1 : bool = [options_name[0]] == 0b1 & unpriv_at_el1;
    let wunpriv_at_el2 : bool = [options_name[0]] == 0b1 & unpriv_at_el2;
    let user_access_override : bool = HaveUAOExt() & PSTATE.UAO == 0b1;
    racctype : AccType = undefined;
    if not_bool(user_access_override) & (runpriv_at_el1 | runpriv_at_el2) then {
        racctype = if [options_name[3]] == 0b0 then AccType_UNPRIV else
          AccType_UNPRIVSTREAM
    } else {
        racctype = if [options_name[3]] == 0b0 then AccType_NORMAL else
          AccType_STREAM
    };
    wacctype : AccType = undefined;
    if not_bool(user_access_override) & (wunpriv_at_el1 | wunpriv_at_el2) then {
        wacctype = if [options_name[2]] == 0b0 then AccType_UNPRIV else
          AccType_UNPRIVSTREAM
    } else {
        wacctype = if [options_name[2]] == 0b0 then AccType_NORMAL else
          AccType_STREAM
    };
    return((racctype, wacctype))
}

val MemSetAccessType : bits(2) -> AccType

function MemSetAccessType options_name = {
    let unpriv_at_el1 : bool = ([options_name[0]] == 0b1 & PSTATE.EL == EL1) & not_bool((EL2Enabled() & HaveNVExt()) & (Slice(HCR_EL2, 42, 1) @ Slice(HCR_EL2, 43, 1)) == 0b11);
    let unpriv_at_el2 : bool = (([options_name[0]] == 0b1 & PSTATE.EL == EL2) & HaveVirtHostExt()) & (Slice(HCR_EL2, 34, 1) @ Slice(HCR_EL2, 27, 1)) == 0b11;
    let user_access_override : bool = HaveUAOExt() & PSTATE.UAO == 0b1;
    acctype : AccType = undefined;
    if not_bool(user_access_override) & (unpriv_at_el1 | unpriv_at_el2) then {
        acctype = if [options_name[1]] == 0b0 then AccType_UNPRIV else
          AccType_UNPRIVSTREAM
    } else {
        acctype = if [options_name[1]] == 0b0 then AccType_NORMAL else
          AccType_STREAM
    };
    return(acctype)
}

val MismatchedCpySetTargetEL : unit -> bits(2)

function MismatchedCpySetTargetEL () = {
    target_el : bits(2) = undefined;
    if UInt(PSTATE.EL) > UInt(EL1) then {
        target_el = PSTATE.EL
    } else if (PSTATE.EL == EL0 & EL2Enabled()) & Slice(HCR_EL2, 27, 1) == 0b1 then {
        target_el = EL2
    } else if ((PSTATE.EL == EL1 & EL2Enabled()) & IsHCRXEL2Enabled()) & Slice(HCRX_EL2, 10, 1) == 0b1 then {
        target_el = EL2
    } else {
        target_el = EL1
    };
    return(target_el)
}

val MismatchedMemCpyException : forall 'destreg ('from_epilogue : Bool) ('option_a_name : Bool) 'sizereg 'srcreg ('wrong_option : Bool).
  (bool('option_a_name), int('destreg), int('srcreg), int('sizereg), bool('wrong_option), bool('from_epilogue), bits(4)) -> unit

function MismatchedMemCpyException (option_a_name, destreg, srcreg, sizereg, wrong_option, from_epilogue, options_name) = {
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    let target_el : bits(2) = MismatchedCpySetTargetEL();
    exception : ExceptionRecord = ExceptionSyndrome(Exception_MemCpyMemSet);
    exception.syndrome[24 .. 24] = 0b0;
    exception.syndrome[23 .. 23] = 0b0;
    exception.syndrome[22 .. 19] = options_name;
    exception.syndrome[18 .. 18] = if from_epilogue then 0b1 else 0b0;
    exception.syndrome[17 .. 17] = if wrong_option then 0b1 else 0b0;
    exception.syndrome[16 .. 16] = if option_a_name then 0b1 else 0b0;
    exception.syndrome[14 .. 10] = destreg[4 .. 0];
    exception.syndrome[9 .. 5] = srcreg[4 .. 0];
    exception.syndrome[4 .. 0] = sizereg[4 .. 0];
    AArch64_TakeException(target_el, exception, preferred_exception_return, vect_offset)
}

val MismatchedMemSetException : forall 'datareg 'destreg ('from_epilogue : Bool) ('is_SETG : Bool) ('option_a_name : Bool) 'sizereg ('wrong_option : Bool).
  (bool('option_a_name), int('destreg), int('datareg), int('sizereg), bool('wrong_option), bool('from_epilogue), bits(2), bool('is_SETG)) -> unit

function MismatchedMemSetException (option_a_name, destreg, datareg, sizereg, wrong_option, from_epilogue, options_name, is_SETG) = {
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    let target_el : bits(2) = MismatchedCpySetTargetEL();
    exception : ExceptionRecord = ExceptionSyndrome(Exception_MemCpyMemSet);
    exception.syndrome[24 .. 24] = 0b1;
    exception.syndrome[23 .. 23] = if is_SETG then 0b1 else 0b0;
    exception.syndrome[20 .. 19] = options_name;
    exception.syndrome[18 .. 18] = if from_epilogue then 0b1 else 0b0;
    exception.syndrome[17 .. 17] = if wrong_option then 0b1 else 0b0;
    exception.syndrome[16 .. 16] = if option_a_name then 0b1 else 0b0;
    exception.syndrome[14 .. 10] = destreg[4 .. 0];
    exception.syndrome[9 .. 5] = datareg[4 .. 0];
    exception.syndrome[4 .. 0] = sizereg[4 .. 0];
    AArch64_TakeException(target_el, exception, preferred_exception_return, vect_offset)
}

