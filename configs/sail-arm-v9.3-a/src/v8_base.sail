val AArch64_ClearEventCounters : unit -> unit

function AArch64_ClearEventCounters () = {
    let 'counters = AArch64_GetNumEventCountersAccessible();
    if counters != 0 then {
        foreach (idx from 0 to (counters - 1) by 1 in inc) {
            assert(constraint('loop_idx < 31));
            PMEVCNTR_EL0[idx] = Zeros()
        }
    };
    ()
}

let PMU_EVENT_SW_INCR : bits(16) = 0x0000

val AArch64_PMUSwIncrement : bits(32) -> unit

function AArch64_PMUSwIncrement sw_incr = {
    if Slice(PMCR_EL0, 0, 1) == 0b0 & Slice(MDCR_EL2, 7, 1) == 0b0 then {
        return()
    };
    let 'counters = AArch64_GetNumEventCountersAccessible();
    if counters != 0 then {
        foreach (idx from 0 to (counters - 1) by 1 in inc) {
            assert(constraint('loop_idx < 32));
            if [sw_incr[idx]] == 0b1 then {
                PMUEvent__2(PMU_EVENT_SW_INCR, 1, idx)
            };
            ()
        }
    };
    ()
}

val DBGOSLSR_read : unit -> bits(32)

function DBGOSLSR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(OSLSR_EL1, 0, 32));
    return(r)
}

val DBGOSLSR_write : bits(32) -> unit

function DBGOSLSR_write val_name = {
    let r : bits(32) = val_name;
    OSLSR_EL1 = SetSlice(32, OSLSR_EL1, 0, Slice(r, 0, 32));
    return()
}

register EDPRSR : bits(32)

val TakeReset : forall ('cold : Bool). bool('cold) -> unit

register __clock_divider : int

val AArch64_SysRegWrite : forall 'crm 'crn 'op0 'op1 'op2 't.
  (int('op0), int('op1), int('crn), int('crm), int('op2), int('t)) -> unit

function AArch64_SysRegWrite (op0, op1, crn, crm, op2, t) = {
    n : int = undefined;
    tempxt : bits(64) = X_read__1(t, 64);
    if ((op0 == 2 & crn == 0) & op1 == 0) & op2 == 5 then {
        tempxt[8] = Bit([tempxt[7]]);
        tempxt[6] = Bit([tempxt[5]])
    };
    if (((op0 == 3 & crn == 12) & op1 == 0) & op2 == 4) & crm == 12 then {
        tempxt[19] = Bit(Slice(ICV_CTLR_EL1, 19, 1));
        tempxt[13 .. 11] = Slice(ICV_CTLR_EL1, 11, 3);
        tempxt[10 .. 8] = Slice(ICV_CTLR_EL1, 8, 3);
        tempxt[15] = Bit(Slice(ICV_CTLR_EL1, 15, 1));
        tempxt[14] = Bit(Slice(ICV_CTLR_EL1, 14, 1))
    };
    if (((op0 == 3 & crn == 12) & op1 == 6) & op2 == 4) & crm == 12 then {
        tempxt[19] = Bit(Slice(ICC_CTLR_EL3, 19, 1));
        tempxt[13 .. 11] = Slice(ICC_CTLR_EL3, 11, 3);
        tempxt[10 .. 8] = Slice(ICC_CTLR_EL3, 8, 3);
        tempxt[17] = Bit(Slice(ICC_CTLR_EL3, 17, 1));
        tempxt[15] = Bit(Slice(ICC_CTLR_EL3, 15, 1));
        tempxt[14] = Bit(Slice(ICC_CTLR_EL3, 14, 1))
    };
    if (((op0 == 3 & crn == 12) & op1 == 4) & op2 == 7) & crm == 11 then {
        if PSTATE.EL == EL2 | PSTATE.EL == EL3 then {
            if UInt(tempxt[23 .. 21]) < 6 - UInt(Slice(ICH_VTR_EL2, 26, 3)) then {
                tempxt[23 .. 21] = (6 - UInt(Slice(ICH_VTR_EL2, 26, 3)))[2 .. 0]
            };
            if IsSecure() then {
                if UInt(tempxt[20 .. 18]) < 6 - UInt(Slice(ICH_VTR_EL2, 26, 3)) then {
                    tempxt[20 .. 18] = (6 - UInt(Slice(ICH_VTR_EL2, 26, 3)))[2 .. 0]
                };
                ()
            } else {
                if UInt(tempxt[20 .. 18]) < 7 - UInt(Slice(ICH_VTR_EL2, 26, 3)) then {
                    tempxt[20 .. 18] = (7 - UInt(Slice(ICH_VTR_EL2, 26, 3)))[2 .. 0]
                };
                ()
            };
            if Slice(ICC_SRE_EL1_NS, 0, 1) == 0b1 then {
                tempxt[3 .. 2] = 0b10
            };
            ()
        };
        ()
    };
    if (((op0 == 3 & crn == 12) & op1 == 0) & op2 == 3) & crm == 8 then {
        if UInt(tempxt[2 .. 0]) < 6 - UInt(Slice(ICH_VTR_EL2, 26, 3)) then {
            tempxt[2 .. 0] = (6 - UInt(Slice(ICH_VTR_EL2, 26, 3)))[2 .. 0]
        };
        ()
    };
    if (((op0 == 3 & crn == 12) & op1 == 0) & op2 == 3) & crm == 12 then {
        if Slice(ICV_CTLR_EL1, 0, 1) == 0b0 then {
            if IsSecure() then {
                if UInt(tempxt[2 .. 0]) < 6 - UInt(Slice(ICH_VTR_EL2, 26, 3)) then {
                    tempxt[2 .. 0] = (6 - UInt(Slice(ICH_VTR_EL2, 26, 3)))[2 .. 0]
                };
                ()
            } else {
                if UInt(tempxt[2 .. 0]) < 7 - UInt(Slice(ICH_VTR_EL2, 26, 3)) then {
                    tempxt[2 .. 0] = (7 - UInt(Slice(ICH_VTR_EL2, 26, 3)))[2 .. 0]
                };
                ()
            }
        } else {
            tempxt[2 .. 0] = Slice(ICV_BPR1_EL1, 0, 3)
        }
    };
    if (op0 == 3 & op1 == 3) & crn == 13 then {
        let 'n = UInt([crm[0]] @ op2[2 .. 0]);
        if crm[3 .. 1] == 0b010 | crm[3 .. 1] == 0b011 then {
            if n >= UInt(Slice(AMCGCR_EL0, 0, 8)) then {
                throw(Error_Undefined())
            };
            ()
        } else if crm[3 .. 1] == 0b110 | crm[3 .. 1] == 0b111 then {
            if n >= UInt(Slice(AMCGCR_EL0, 8, 8)) then {
                throw(Error_Undefined())
            };
            ()
        } else ()
    };
    let mask : bits(32) = PMUCounterMask();
    if (((op0 == 3 & crn == 9) & op1 == 3) & op2 == 3) & (crm == 12 | crm == 14) then {
        if crm == 12 then {
            tempxt[31 .. 0] = PMOVSSET_EL0[31 .. 0] & not_vec(tempxt[31 .. 0] & mask)
        };
        if crm == 14 then {
            tempxt[31 .. 0] = PMOVSSET_EL0[31 .. 0] | tempxt[31 .. 0] & mask
        };
        ()
    };
    if (((op0 == 3 & crn == 9) & op1 == 3) & (op2 == 1 | op2 == 2)) & crm == 12 then {
        if op2 == 2 then {
            tempxt[31 .. 0] = PMCNTENSET_EL0[31 .. 0] & not_vec(tempxt[31 .. 0] & mask)
        };
        if op2 == 1 then {
            tempxt[31 .. 0] = PMCNTENSET_EL0[31 .. 0] | tempxt[31 .. 0] & mask
        };
        ()
    };
    if (((op0 == 3 & crn == 9) & op1 == 0) & (op2 == 1 | op2 == 2)) & crm == 14 then {
        if op2 == 2 then {
            tempxt[31 .. 0] = PMINTENSET_EL1[31 .. 0] & not_vec(tempxt[31 .. 0] & mask)
        };
        if op2 == 1 then {
            tempxt[31 .. 0] = PMINTENSET_EL1[31 .. 0] | tempxt[31 .. 0] & mask
        };
        ()
    };
    if (((op0 == 3 & crn == 9) & op1 == 3) & op2 == 0) & crm == 12 then {
        if [tempxt[3]] == 0b1 & Slice(PMCR_EL0, 3, 1) == 0b0 then {
            __clock_divider = 63
        };
        ()
    };
    if ((op0 == 3 & crn == 14) & op1 == 3) & (crm[3 .. 2] == 0b10 | crm[3 .. 2] == 0b11 & (crm[1 .. 0] @ op2[2 .. 0]) != 0b11111) then {
        if UInt(crm[1 .. 0] @ op2[2 .. 0]) > GetNumEventCounters() - 1 & (crm[1 .. 0] @ op2[2 .. 0]) != 0b11111 | ((EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & Slice(PMUSERENR_EL0, 0, 1) == 0b1) & UInt(crm[1 .. 0] @ op2[2 .. 0]) > AArch64_GetNumEventCountersAccessible() - 1 then {
            if UInt(crm[1 .. 0] @ op2[2 .. 0]) > GetNumEventCounters() - 1 then {
                throw(Error_Undefined())
            } else {
                AArch64_SystemAccessTrap(EL2, UInt(0x18))
            }
        };
        ()
    };
    if (((op0 == 3 & op1 == 3) & crn == 9) & crm == 13) & (op2 == 2 | op2 == 1 & Slice(PMSELR_EL0, 0, 5) != 0b11111) then {
        if UInt(Slice(PMSELR_EL0, 0, 5)) > GetNumEventCounters() - 1 & Slice(PMSELR_EL0, 0, 5) != 0b11111 | ((EL2Enabled() & (PSTATE.EL == EL0 | PSTATE.EL == EL1)) & Slice(PMUSERENR_EL0, 0, 1) == 0b1) & UInt(Slice(PMSELR_EL0, 0, 5)) > AArch64_GetNumEventCountersAccessible() - 1 then {
            if UInt(Slice(PMSELR_EL0, 0, 5)) > GetNumEventCounters() - 1 then {
                throw(Error_Undefined())
            } else {
                AArch64_SystemAccessTrap(EL2, UInt(0x18))
            }
        };
        ()
    };
    tempxt2 : bits(64) = undefined;
    restore_xt : bool = undefined;
    if tempxt != X_read(64, t) then {
        tempxt2 = X_read(64, t);
        X_set(64, t) = tempxt;
        restore_xt = true
    } else {
        restore_xt = false
    };
    AArch64_AutoGen_SysRegWrite(PSTATE.EL, op0[1 .. 0], op1[2 .. 0], crn[3 .. 0], op2[2 .. 0], crm[3 .. 0], t);
    if restore_xt then {
        X_set(64, t) = tempxt2
    };
    if (((crm == 0 & crn == 1) & op0 == 2) & op1 == 0) & op2 == 4 then {
        OSLSR_EL1 = SetSlice(1, OSLSR_EL1, 1, Slice(OSLAR_EL1, 0, 1));
        EDPRSR = SetSlice(1, EDPRSR, 5, Slice(OSLSR_EL1, 1, 1));
        DBGOSLSR_write() = SetSlice(1, DBGOSLSR_read(), 1, Slice(OSLSR_EL1, 1, 1))
    };
    if ((op0 == 2 & op1 == 1) & crn == 7) & op2 == 6 then {
        if crm == 8 then {
            __trcclaim_tags = __trcclaim_tags | tempxt[31 .. 0];
            return()
        };
        if crm == 9 then {
            __trcclaim_tags = __trcclaim_tags & not_vec(tempxt[31 .. 0]);
            return()
        };
        ()
    };
    if ((op0 == 2 & op1 == 0) & crn == 7) & op2 == 6 then {
        if crm == 8 then {
            __claim_tags = __claim_tags | tempxt[7 .. 0];
            return()
        };
        if crm == 9 then {
            __claim_tags = __claim_tags & not_vec(tempxt[7 .. 0]);
            return()
        };
        ()
    };
    if ((((op0 == 3 & crn == UInt(0xc)) & ((op1 == 6 | op1 == 4) | op1 == 0)) & op2 == 2) & crm == 0) & [tempxt[1]] == 0b1 then {
        TakeReset(false)
    };
    if (((op0 == 3 & crn == 9) & op1 == 3) & op2 == 3) & (crm == 12 | crm == 14) then {
        if crm == 12 then {
            PMOVSSET_EL0[31 .. 0] = tempxt[31 .. 0]
        };
        if crm == 14 then {
            PMOVSCLR_EL0[31 .. 0] = tempxt[31 .. 0]
        };
        ()
    };
    if (((op0 == 3 & crn == 9) & op1 == 3) & (op2 == 1 | op2 == 2)) & crm == 12 then {
        if op2 == 2 then {
            PMCNTENSET_EL0[31 .. 0] = tempxt[31 .. 0]
        };
        if op2 == 1 then {
            PMCNTENCLR_EL0[31 .. 0] = tempxt[31 .. 0]
        };
        ()
    };
    if (((op0 == 3 & crn == 9) & op1 == 0) & (op2 == 1 | op2 == 2)) & crm == 14 then {
        if op2 == 2 then {
            PMINTENSET_EL1[31 .. 0] = tempxt[31 .. 0]
        };
        if op2 == 1 then {
            PMINTENCLR_EL1[31 .. 0] = tempxt[31 .. 0]
        };
        ()
    };
    if (((op0 == 3 & crn == 9) & op1 == 3) & op2 == 0) & crm == 12 then {
        if [tempxt[2]] == 0b1 then {
            PMCCNTR_EL0 = Zeros(64)
        };
        if [tempxt[1]] == 0b1 then {
            AArch64_ClearEventCounters()
        };
        ()
    };
    if (((op0 == 3 & op1 == 3) & crn == 9) & crm == 13) & (op2 == 1 | op2 == 2) then {
        if op2 == 1 then {
            if Slice(PMSELR_EL0, 0, 5) == 0b11111 then {
                PMCCFILTR_EL0 = __get_PMCCFILTR_EL0(tempxt)
            } else {
                let 'pmselr_el0 = UInt(Slice(PMSELR_EL0, 0, 5));
                assert(pmselr_el0 < 31);
                PMEVTYPER_EL0[pmselr_el0] = __get_PMEVTYPER_EL0(tempxt)
            }
        };
        if op2 == 2 then {
            let 'pmselr_el0 = UInt(Slice(PMSELR_EL0, 0, 5));
            assert(pmselr_el0 < 31);
            PMEVCNTR_EL0[pmselr_el0] = tempxt
        };
        ()
    };
    if ((op0 == 3 & op1 == 3) & crn == 14) & crm[3 .. 2] == 0b11 then {
        let 'index = UInt(crm[1 .. 0] @ op2[2 .. 0]);
        if index == 31 then {
            PMCCFILTR_EL0 = __get_PMCCFILTR_EL0(tempxt)
        } else {
            PMEVTYPER_EL0[index] = __get_PMEVTYPER_EL0(tempxt)
        }
    };
    if (((op0 == 3 & crn == 9) & op1 == 3) & op2 == 4) & crm == 12 then {
        AArch64_PMUSwIncrement(tempxt[31 .. 0])
    };
    if (((op0 == 2 & crn == 0) & op1 == 3) & op2 == 0) & (crm == 4 | crm == 5) then {
        DBGDSCRint_write() = SetSlice(1, DBGDSCRint_read(), 29, 0b1);
        MDCCSR_EL0 = SetSlice(1, MDCCSR_EL0, 29, 0b1);
        DBGDSCRext_write() = SetSlice(1, DBGDSCRext_read(), 29, 0b1);
        EDSCR_write() = SetSlice(1, EDSCR_read(), 29, 0b1)
    };
    if (((op0 == 3 & crn == 12) & op1 == 4) & op2 == 7) & crm == 11 then {
        ICV_PMR_EL1 = SetSlice(8, ICV_PMR_EL1, 0, Slice(ICH_VMCR_EL2, 24, 8));
        ICV_BPR0_EL1 = SetSlice(3, ICV_BPR0_EL1, 0, Slice(ICH_VMCR_EL2, 21, 3));
        ICV_BPR1_EL1 = SetSlice(3, ICV_BPR1_EL1, 0, Slice(ICH_VMCR_EL2, 18, 3));
        ICV_IGRPEN0_EL1 = SetSlice(1, ICV_IGRPEN0_EL1, 0, Slice(ICH_VMCR_EL2, 0, 1));
        ICV_IGRPEN1_EL1 = SetSlice(1, ICV_IGRPEN1_EL1, 0, Slice(ICH_VMCR_EL2, 1, 1));
        ICV_CTLR_EL1 = SetSlice(1, ICV_CTLR_EL1, 1, Slice(ICH_VMCR_EL2, 9, 1));
        ICV_CTLR_EL1 = SetSlice(1, ICV_CTLR_EL1, 0, Slice(ICH_VMCR_EL2, 4, 1))
    };
    if (((op0 == 3 & crn == 4) & op1 == 0) & op2 == 0) & crm == 6 then {
        ICH_VMCR_EL2 = SetSlice(8, ICH_VMCR_EL2, 24, Slice(ICV_PMR_EL1, 0, 8))
    };
    if (((op0 == 3 & crn == 12) & op1 == 0) & op2 == 3) & crm == 8 then {
        ICH_VMCR_EL2 = SetSlice(3, ICH_VMCR_EL2, 21, Slice(ICV_BPR0_EL1, 0, 3))
    };
    if (((op0 == 3 & crn == 12) & op1 == 0) & op2 == 3) & crm == 12 then {
        ICH_VMCR_EL2 = SetSlice(3, ICH_VMCR_EL2, 18, Slice(ICV_BPR1_EL1, 0, 3))
    };
    if (((op0 == 3 & crn == 12) & op1 == 0) & op2 == 4) & crm == 12 then {
        ICH_VMCR_EL2 = SetSlice(1, ICH_VMCR_EL2, 9, Slice(ICV_CTLR_EL1, 1, 1));
        ICH_VMCR_EL2 = SetSlice(1, ICH_VMCR_EL2, 4, Slice(ICV_CTLR_EL1, 0, 1))
    };
    if (((op0 == 3 & crn == 12) & op1 == 0) & op2 == 6) & crm == 12 then {
        ICH_VMCR_EL2 = SetSlice(1, ICH_VMCR_EL2, 0, Slice(ICV_IGRPEN0_EL1, 0, 1))
    };
    if (((op0 == 3 & crn == 12) & op1 == 0) & op2 == 7) & crm == 12 then {
        ICH_VMCR_EL2 = SetSlice(1, ICH_VMCR_EL2, 1, Slice(ICV_IGRPEN1_EL1, 0, 1))
    };
    return()
}

val AArch32_EL2Enabled : SecurityState -> bool

function AArch32_EL2Enabled ss = {
    if ss == SS_Secure then {
        if not_bool(HaveEL(EL2) & HaveSecureEL2Ext()) then {
            return(false)
        } else if HaveEL(EL3) then {
            return(Slice(SCR_EL3, 18, 1) == 0b1)
        } else {
            return(__IMPDEF_boolean("Secure-only implementation"))
        }
    } else {
        return(HaveEL(EL2))
    }
}

val AArch32_S1IASize : bits(3) -> int

function AArch32_S1IASize txsz = {
    return(32 - UInt(txsz))
}

val AArch32_GetVARange : (bits(32), bits(3), bits(3)) -> VARange

function AArch32_GetVARange (va, t0sz, t1sz) = {
    let 'lo_iasize = AArch32_S1IASize(t0sz);
    let 'up_iasize = AArch32_S1IASize(t1sz);
    if t1sz == 0b000 & t0sz == 0b000 then {
        return(VARange_LOWER)
    } else if t1sz == 0b000 then {
        return(if is_zero_subrange(va, 31, lo_iasize) then VARange_LOWER else
          VARange_UPPER)
    } else if t0sz == 0b000 then {
        return(if is_ones_subrange(va, 31, up_iasize) then VARange_UPPER else
          VARange_LOWER)
    } else if is_zero_subrange(va, 31, lo_iasize) then {
        return(VARange_LOWER)
    } else if is_ones_subrange(va, 31, up_iasize) then {
        return(VARange_UPPER)
    } else {
        return(__UNKNOWN_VARange())
    }
}

val AArch32_HaveHPDExt : unit -> bool

function AArch32_HaveHPDExt () = {
    return(HasArchVersion(ARMv8p2) & __IMPDEF_boolean("Has AArch32 hierarchical permission disables"))
}

val MAIR0_NS_read : unit -> bits(32)

function MAIR0_NS_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(MAIR_EL1, 0, 32));
    return(r)
}

register MAIR0_S : bits(32)

val MAIR0_read : unit -> bits(32)

function MAIR0_read () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = MAIR0_S
    } else {
        r = MAIR0_NS_read()
    };
    return(r)
}

val NMRR_NS_read : unit -> bits(32)

function NMRR_NS_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(MAIR_EL1, 32, 32));
    return(r)
}

register NMRR_S : bits(32)

val NMRR_read : unit -> bits(32)

function NMRR_read () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = NMRR_S
    } else {
        r = NMRR_NS_read()
    };
    return(r)
}

val MAIR1_NS_read : unit -> bits(32)

function MAIR1_NS_read () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) then {
        r = SetSlice(32, r, 0, Slice(NMRR_NS_read(), 0, 32))
    } else {
        if not_bool(HaveEL(EL3)) | not_bool(ELUsingAArch32(EL3)) then {
            r = SetSlice(32, r, 0, Slice(MAIR_EL1, 32, 32))
        } else {
            r = SetSlice(32, r, 0, Slice(NMRR_read(), 0, 32))
        }
    };
    return(r)
}

val MAIR1_S_read : unit -> bits(32)

function MAIR1_S_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(NMRR_S, 0, 32));
    return(r)
}

val MAIR1_read : unit -> bits(32)

function MAIR1_read () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = MAIR1_S_read()
    } else {
        r = MAIR1_NS_read()
    };
    return(r)
}

val TTBCR2_NS_read : unit -> bits(32)

function TTBCR2_NS_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(TCR_EL1, 32, 32));
    return(r)
}

register TTBCR2_S : bits(32)

val TTBCR2_read : unit -> bits(32)

function TTBCR2_read () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = TTBCR2_S
    } else {
        r = TTBCR2_NS_read()
    };
    return(r)
}

val AArch32_S1TTWParamsEL10 : bits(32) -> S1TTWParams

function AArch32_S1TTWParamsEL10 va = {
    mair : bits(64) = undefined;
    sif : bits(1) = undefined;
    ttbcr : bits(32) = undefined;
    ttbcr2 : bits(32) = undefined;
    sctlr : bits(32) = undefined;
    if HaveAArch32EL(EL3) then {
        ttbcr = TTBCR_NS_read();
        ttbcr2 = TTBCR2_NS_read();
        sctlr = SCTLR_NS_read();
        mair = MAIR1_NS_read() @ MAIR0_NS_read();
        sif = Slice(SCR, 9, 1)
    } else {
        ttbcr = TTBCR_read();
        ttbcr2 = TTBCR2_read();
        sctlr = SCTLR_read__2();
        mair = MAIR1_read() @ MAIR0_read();
        sif = Slice(SCR_EL3, 9, 1)
    };
    assert(Slice(ttbcr, 31, 1) == 0b1);
    walkparams : S1TTWParams = undefined;
    walkparams.t0sz = Slice(ttbcr, 0, 3);
    walkparams.t1sz = Slice(ttbcr, 16, 3);
    walkparams.ee = Slice(sctlr, 25, 1);
    walkparams.wxn = Slice(sctlr, 19, 1);
    walkparams.uwxn = Slice(sctlr, 20, 1);
    walkparams.ntlsmd = if HaveTrapLoadStoreMultipleDeviceExt() then
      Slice(sctlr, 3, 1)
    else
      0b1;
    walkparams.mair = mair;
    walkparams.sif = sif;
    let varange : VARange = AArch32_GetVARange(va, walkparams.t0sz, walkparams.t1sz);
    if varange == VARange_LOWER then {
        walkparams.sh = Slice(ttbcr, 12, 2);
        walkparams.irgn = Slice(ttbcr, 8, 2);
        walkparams.orgn = Slice(ttbcr, 10, 2);
        walkparams.hpd = if AArch32_HaveHPDExt() then
          Slice(ttbcr, 6, 1) & Slice(ttbcr2, 9, 1)
        else
          0b0
    } else {
        walkparams.sh = Slice(ttbcr, 28, 2);
        walkparams.irgn = Slice(ttbcr, 24, 2);
        walkparams.orgn = Slice(ttbcr, 26, 2);
        walkparams.hpd = if AArch32_HaveHPDExt() then
          Slice(ttbcr, 6, 1) & Slice(ttbcr2, 10, 1)
        else
          0b0
    };
    return(walkparams)
}

val HMAIR0_read : unit -> bits(32)

function HMAIR0_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(MAIR_EL2, 0, 32));
    return(r)
}

val HMAIR1_read : unit -> bits(32)

function HMAIR1_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(MAIR_EL2, 32, 32));
    return(r)
}

val HTCR_read : unit -> bits(32)

function HTCR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(TCR_EL2, 0, 32));
    return(r)
}

val AArch32_S1TTWParamsEL2 : unit -> S1TTWParams

function AArch32_S1TTWParamsEL2 () = {
    walkparams : S1TTWParams = undefined;
    walkparams.tgx = TGx_4KB;
    walkparams.t0sz = Slice(HTCR_read(), 0, 3);
    walkparams.irgn = Slice(HTCR_read(), 12, 2);
    walkparams.orgn = Slice(HTCR_read(), 8, 2);
    walkparams.sh = Slice(HTCR_read(), 10, 2);
    walkparams.hpd = if AArch32_HaveHPDExt() then Slice(HTCR_read(), 24, 1) else
      0b0;
    walkparams.ee = Slice(HSCTLR_read(), 25, 1);
    walkparams.wxn = Slice(HSCTLR_read(), 19, 1);
    if HaveTrapLoadStoreMultipleDeviceExt() then {
        walkparams.ntlsmd = Slice(HSCTLR_read(), 3, 1)
    } else {
        walkparams.ntlsmd = 0b1
    };
    walkparams.mair = HMAIR1_read() @ HMAIR0_read();
    return(walkparams)
}

val AArch32_S1TTWParamsEL30 : bits(32) -> S1TTWParams

function AArch32_S1TTWParamsEL30 va = {
    assert(Slice(TTBCR_S, 31, 1) == 0b1);
    walkparams : S1TTWParams = undefined;
    walkparams.t0sz = Slice(TTBCR_S, 0, 3);
    walkparams.t1sz = Slice(TTBCR_S, 16, 3);
    walkparams.ee = Slice(SCTLR_S, 25, 1);
    walkparams.wxn = Slice(SCTLR_S, 19, 1);
    walkparams.uwxn = Slice(SCTLR_S, 20, 1);
    walkparams.ntlsmd = if HaveTrapLoadStoreMultipleDeviceExt() then
      Slice(SCTLR_S, 3, 1)
    else
      0b1;
    walkparams.mair = MAIR1_S_read() @ MAIR0_S;
    walkparams.sif = Slice(SCR, 9, 1);
    let varange : VARange = AArch32_GetVARange(va, walkparams.t0sz, walkparams.t1sz);
    if varange == VARange_LOWER then {
        walkparams.sh = Slice(TTBCR_S, 12, 2);
        walkparams.irgn = Slice(TTBCR_S, 8, 2);
        walkparams.orgn = Slice(TTBCR_S, 10, 2);
        walkparams.hpd = if AArch32_HaveHPDExt() then
          Slice(TTBCR_S, 6, 1) & Slice(TTBCR2_S, 9, 1)
        else
          0b0
    } else {
        walkparams.sh = Slice(TTBCR_S, 28, 2);
        walkparams.irgn = Slice(TTBCR_S, 24, 2);
        walkparams.orgn = Slice(TTBCR_S, 26, 2);
        walkparams.hpd = if AArch32_HaveHPDExt() then
          Slice(TTBCR_S, 6, 1) & Slice(TTBCR2_S, 10, 1)
        else
          0b0
    };
    return(walkparams)
}

val AArch32_GetS1TTWParams : (Regime, bits(32)) -> S1TTWParams

function AArch32_GetS1TTWParams (regime, va) = {
    walkparams : S1TTWParams = undefined;
    match regime {
      Regime_EL2 => {
          walkparams = AArch32_S1TTWParamsEL2()
      },
      Regime_EL10 => {
          walkparams = AArch32_S1TTWParamsEL10(va)
      },
      Regime_EL30 => {
          walkparams = AArch32_S1TTWParamsEL30(va)
      },
      _ => ()
    };
    return(walkparams)
}

val AArch32_S1DCacheEnabled : Regime -> bool

function AArch32_S1DCacheEnabled regime = {
    match regime {
      Regime_EL30 => {
          return(Slice(SCTLR_S, 2, 1) == 0b1)
      },
      Regime_EL2 => {
          return(Slice(HSCTLR_read(), 2, 1) == 0b1)
      },
      Regime_EL10 => {
          return((if HaveAArch32EL(EL3) then Slice(SCTLR_NS_read(), 2, 1) else
            Slice(SCTLR_read__2(), 2, 1)) == 0b1)
      },
      _ => {
          return(undefined : bool)
      }
    }
}

val AArch32_S1HasAlignmentFault : forall ('aligned : Bool).
  (AccType, bool('aligned), bits(1), MemoryAttributes) -> bool

function AArch32_S1HasAlignmentFault (acctype, aligned, ntlsmd, memattrs) = {
    if acctype == AccType_IFETCH | memattrs.memtype != MemType_Device then {
        return(false)
    };
    if (acctype == AccType_A32LSMD & ntlsmd == 0b0) & memattrs.device != DeviceType_GRE then {
        return(true)
    };
    return(not_bool(aligned) | acctype == AccType_DCZVA)
}

val AArch32_S1ICacheEnabled : Regime -> bool

function AArch32_S1ICacheEnabled regime = {
    match regime {
      Regime_EL30 => {
          return(Slice(SCTLR_S, 12, 1) == 0b1)
      },
      Regime_EL2 => {
          return(Slice(HSCTLR_read(), 12, 1) == 0b1)
      },
      Regime_EL10 => {
          return((if HaveAArch32EL(EL3) then Slice(SCTLR_NS_read(), 12, 1) else
            Slice(SCTLR_read__2(), 12, 1)) == 0b1)
      },
      _ => {
          return(undefined : bool)
      }
    }
}

val AArch32_S1DisabledOutput : forall ('aligned : Bool).
  (FaultRecord, Regime, SecurityState, bits(32), AccType, bool('aligned)) -> (FaultRecord, AddressDescriptor)

function AArch32_S1DisabledOutput (fault_in, regime, ss, va, acctype, aligned) = {
    fault : FaultRecord = fault_in;
    SetInGuardedPage(false);
    memattrs : MemoryAttributes = undefined;
    default_cacheable : bits(1) = undefined;
    if regime == Regime_EL10 & AArch32_EL2Enabled(ss) then {
        if ELStateUsingAArch32(EL2, ss == SS_Secure) then {
            default_cacheable = Slice(HCR_read(), 12, 1)
        } else {
            default_cacheable = Slice(HCR_EL2, 12, 1)
        }
    } else {
        default_cacheable = 0b0
    };
    if default_cacheable == 0b1 then {
        memattrs.memtype = MemType_Normal;
        memattrs.inner.attrs = MemAttr_WB;
        memattrs.inner.hints = MemHint_RWA;
        memattrs.outer.attrs = MemAttr_WB;
        memattrs.outer.hints = MemHint_RWA;
        memattrs.shareability = Shareability_NSH;
        if not_bool(ELStateUsingAArch32(EL2, ss == SS_Secure)) & HaveMTE2Ext() then {
            memattrs.tagged = Slice(HCR_EL2, 57, 1) == 0b1
        } else {
            memattrs.tagged = false
        }
    } else if acctype == AccType_IFETCH then {
        memattrs.memtype = MemType_Normal;
        memattrs.shareability = Shareability_OSH;
        memattrs.tagged = false;
        if AArch32_S1ICacheEnabled(regime) then {
            memattrs.inner.attrs = MemAttr_WT;
            memattrs.inner.hints = MemHint_RA;
            memattrs.outer.attrs = MemAttr_WT;
            memattrs.outer.hints = MemHint_RA
        } else {
            memattrs.inner.attrs = MemAttr_NC;
            memattrs.outer.attrs = MemAttr_NC
        }
    } else {
        memattrs.memtype = MemType_Device;
        memattrs.device = DeviceType_nGnRnE;
        memattrs.shareability = Shareability_OSH;
        memattrs.tagged = false
    };
    ntlsmd : bits(1) = undefined;
    if HaveTrapLoadStoreMultipleDeviceExt() then {
        match regime {
          Regime_EL30 => {
              ntlsmd = Slice(SCTLR_S, 3, 1)
          },
          Regime_EL2 => {
              ntlsmd = Slice(HSCTLR_read(), 3, 1)
          },
          Regime_EL10 => {
              ntlsmd = if HaveAArch32EL(EL3) then Slice(SCTLR_NS_read(), 3, 1)
              else
                Slice(SCTLR_read__2(), 3, 1)
          },
          _ => ()
        }
    } else {
        ntlsmd = 0b1
    };
    if AArch32_S1HasAlignmentFault(acctype, aligned, ntlsmd, memattrs) then {
        fault.statuscode = Fault_Alignment;
        return((fault, __UNKNOWN_AddressDescriptor()))
    };
    oa : FullAddress = undefined;
    oa.address = ZeroExtend(va);
    oa.paspace = if ss == SS_Secure then PAS_Secure else PAS_NonSecure;
    let ipa : AddressDescriptor = CreateAddressDescriptor(ZeroExtend(va), oa, memattrs);
    return((fault, ipa))
}

val AArch32_S1Enabled : (Regime, SecurityState) -> bool

function AArch32_S1Enabled (regime, ss) = {
    if regime == Regime_EL2 then {
        return(Slice(HSCTLR_read(), 0, 1) == 0b1)
    } else if regime == Regime_EL30 then {
        return(Slice(SCTLR_S, 0, 1) == 0b1)
    } else if not_bool(AArch32_EL2Enabled(ss)) then {
        return((if HaveAArch32EL(EL3) then Slice(SCTLR_NS_read(), 0, 1) else
          Slice(SCTLR_read__2(), 0, 1)) == 0b1)
    } else if ELStateUsingAArch32(EL2, ss == SS_Secure) then {
        return((Slice(HCR_read(), 27, 1) @ Slice(HCR_read(), 12, 1)) == 0b00 & (if HaveAArch32EL(EL3) then
          Slice(SCTLR_NS_read(), 0, 1)
        else
          Slice(SCTLR_read__2(), 0, 1)) == 0b1)
    } else {
        return((Slice(HCR_EL2, 27, 1) @ Slice(HCR_EL2, 12, 1)) == 0b00 & Slice(SCTLR_read__2(), 0, 1) == 0b1)
    }
}

val AArch32_S1LDHasPermissionsFault : forall ('ispriv : Bool) ('iswrite : Bool).
  (Regime, SecurityState, S1TTWParams, Permissions, MemType, PASpace, bool('ispriv), AccType, bool('iswrite)) -> bool

function AArch32_S1LDHasPermissionsFault (regime, ss, walkparams, perms, memtype, paspace, ispriv, acctype, iswrite) = {
    constraint_name : Constraint = undefined;
    pan : bits(1) = undefined;
    pan_access : bool = undefined;
    px : bits(1) = undefined;
    pxn : bits(1) = undefined;
    ux : bits(1) = undefined;
    xn : bits(1) = undefined;
    r : bits(1) = undefined;
    w : bits(1) = undefined;
    x : bits(1) = undefined;
    pr : bits(1) = undefined;
    pw : bits(1) = undefined;
    ur : bits(1) = undefined;
    uw : bits(1) = undefined;
    if HasUnprivileged(regime) then {
        match perms.ap[2 .. 1] {
          0b00 => {
              (pr, pw, ur, uw) = (0b1, 0b1, 0b0, 0b0)
          },
          0b01 => {
              (pr, pw, ur, uw) = (0b1, 0b1, 0b1, 0b1)
          },
          0b10 => {
              (pr, pw, ur, uw) = (0b1, 0b0, 0b0, 0b0)
          },
          0b11 => {
              (pr, pw, ur, uw) = (0b1, 0b0, 0b1, 0b0)
          }
        };
        match perms.ap_table {
          0b00 => {
              (pr, pw, ur, uw) = (pr, pw, ur, uw)
          },
          0b01 => {
              (pr, pw, ur, uw) = (pr, pw, 0b0, 0b0)
          },
          0b10 => {
              (pr, pw, ur, uw) = (pr, 0b0, ur, 0b0)
          },
          0b11 => {
              (pr, pw, ur, uw) = (pr, 0b0, 0b0, 0b0)
          }
        };
        let xn : bits(1) = perms.xn | perms.xn_table;
        let pxn : bits(1) = perms.pxn | perms.pxn_table;
        let ux : bits(1) = ur & not_vec(xn | uw & walkparams.wxn);
        let px : bits(1) = pr & not_vec(((xn | pxn) | pw & walkparams.wxn) | uw & walkparams.uwxn);
        let pan_access : bool = not_bool(acctype == AccType_DC | acctype == AccType_IFETCH | acctype == AccType_AT);
        if HavePANExt() & pan_access then {
            let pan : bits(1) = PSTATE.PAN & (ur | uw);
            pr = pr & not_vec(pan);
            pw = pw & not_vec(pan)
        };
        (r, w, x) = if ispriv then (pr, pw, px) else (ur, uw, ux);
        if ss == SS_Secure & paspace == PAS_NonSecure then {
            x = x & not_vec(walkparams.sif)
        };
        ()
    } else {
        match [perms.ap[2]] {
          0b0 => {
              (r, w) = (0b1, 0b1)
          },
          0b1 => {
              (r, w) = (0b1, 0b0)
          }
        };
        match [perms.ap_table[1]] {
          0b0 => {
              (r, w) = (r, w)
          },
          0b1 => {
              (r, w) = (r, 0b0)
          }
        };
        let xn : bits(1) = perms.xn | perms.xn_table;
        x = not_vec(xn | w & walkparams.wxn)
    };
    if acctype == AccType_IFETCH then {
        let constraint_name : Constraint = ConstrainUnpredictable(Unpredictable_INSTRDEVICE);
        if constraint_name == Constraint_FAULT & memtype == MemType_Device then {
            return(true)
        } else {
            return(x == 0b0)
        }
    } else if acctype == AccType_IC | acctype == AccType_DC then {
        return(false)
    } else if iswrite then {
        return(w == 0b0)
    } else {
        return(r == 0b0)
    }
}

val AArch32_DecodeDescriptorTypeLD : forall 'level.
  (bits(64), int('level)) -> DescriptorType

function AArch32_DecodeDescriptorTypeLD (descriptor, level) = {
    if descriptor[1 .. 0] == 0b11 & level == FINAL_LEVEL then {
        return(DescriptorType_Page)
    } else if descriptor[1 .. 0] == 0b11 then {
        return(DescriptorType_Table)
    } else if descriptor[1 .. 0] == 0b01 & level != FINAL_LEVEL then {
        return(DescriptorType_Block)
    } else {
        return(DescriptorType_Invalid)
    }
}

val CONTEXTIDR_NS_read : unit -> bits(32)

function CONTEXTIDR_NS_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(CONTEXTIDR_EL1, 0, 32));
    return(r)
}

register CONTEXTIDR_S : bits(32)

val CONTEXTIDR_read : unit -> bits(32)

function CONTEXTIDR_read () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = CONTEXTIDR_S
    } else {
        r = CONTEXTIDR_NS_read()
    };
    return(r)
}

val TTBR0_NS_read : unit -> bits(64)

function TTBR0_NS_read () = {
    r : bits(64) = undefined;
    r = SetSlice(64, r, 0, Slice(TTBR0_EL1, 0, 64));
    return(r)
}

register TTBR0_S : bits(64)

val TTBR0_read : unit -> bits(64)

function TTBR0_read () = {
    r : bits(64) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = TTBR0_S
    } else {
        r = TTBR0_NS_read()
    };
    return(r)
}

val TTBR1_NS_read : unit -> bits(64)

function TTBR1_NS_read () = {
    r : bits(64) = undefined;
    r = SetSlice(64, r, 0, Slice(TTBR1_EL1, 0, 64));
    return(r)
}

register TTBR1_S : bits(64)

val TTBR1_read : unit -> bits(64)

function TTBR1_read () = {
    r : bits(64) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = TTBR1_S
    } else {
        r = TTBR1_NS_read()
    };
    return(r)
}

val AArch32_TLBContextEL10 : (SecurityState, bits(32)) -> TLBContext

function AArch32_TLBContextEL10 (ss, va) = {
    contextidr : bits(32) = undefined;
    tlbcontext : TLBContext = undefined;
    ttbcr : bits(32) = undefined;
    ttbr0 : bits(64) = undefined;
    ttbr1 : bits(64) = undefined;
    if HaveAArch32EL(EL3) then {
        ttbcr = TTBCR_NS_read();
        ttbr0 = TTBR0_NS_read();
        ttbr1 = TTBR1_NS_read();
        contextidr = CONTEXTIDR_NS_read()
    } else {
        ttbcr = TTBCR_read();
        ttbr0 = TTBR0_read();
        ttbr1 = TTBR1_read();
        contextidr = CONTEXTIDR_read()
    };
    tlbcontext.ss = ss;
    tlbcontext.regime = Regime_EL10;
    if AArch32_EL2Enabled(ss) then {
        tlbcontext.vmid = ZeroExtend(Slice(VTTBR_read(), 48, 8))
    };
    if Slice(ttbcr, 31, 1) == 0b1 then {
        tlbcontext.asid = ZeroExtend(if Slice(ttbcr, 22, 1) == 0b0 then
          Slice(ttbr0, 48, 8)
        else
          Slice(ttbr1, 48, 8))
    } else {
        tlbcontext.asid = ZeroExtend(Slice(contextidr, 0, 8))
    };
    tlbcontext.tg = TGx_4KB;
    tlbcontext.ia = ZeroExtend(va);
    if HaveCommonNotPrivateTransExt() & Slice(ttbcr, 31, 1) == 0b1 then {
        if AArch32_GetVARange(va, Slice(ttbcr, 0, 3), Slice(ttbcr, 16, 3)) == VARange_LOWER then {
            tlbcontext.cnp = Slice(ttbr0, 0, 1)
        } else {
            tlbcontext.cnp = Slice(ttbr1, 0, 1)
        }
    } else {
        tlbcontext.cnp = 0b0
    };
    return(tlbcontext)
}

val HTTBR_read : unit -> bits(64)

function HTTBR_read () = {
    r : bits(64) = undefined;
    r = SetSlice(47, r, 1, Slice(TTBR0_EL2, 1, 47));
    return(r)
}

val AArch32_TLBContextEL2 : bits(32) -> TLBContext

function AArch32_TLBContextEL2 va = {
    tlbcontext : TLBContext = undefined;
    tlbcontext.ss = SS_NonSecure;
    tlbcontext.regime = Regime_EL2;
    tlbcontext.ia = ZeroExtend(va);
    tlbcontext.tg = TGx_4KB;
    tlbcontext.cnp = if HaveCommonNotPrivateTransExt() then
      Slice(HTTBR_read(), 0, 1)
    else
      0b0;
    return(tlbcontext)
}

val AArch32_TLBContextEL30 : bits(32) -> TLBContext

function AArch32_TLBContextEL30 va = {
    tlbcontext : TLBContext = undefined;
    tlbcontext.ss = SS_Secure;
    tlbcontext.regime = Regime_EL30;
    if Slice(TTBCR_S, 31, 1) == 0b1 then {
        tlbcontext.asid = ZeroExtend(if Slice(TTBCR_S, 22, 1) == 0b0 then
          Slice(TTBR0_S, 48, 8)
        else
          Slice(TTBR1_S, 48, 8))
    } else {
        tlbcontext.asid = ZeroExtend(Slice(CONTEXTIDR_S, 0, 8))
    };
    tlbcontext.tg = TGx_4KB;
    tlbcontext.ia = ZeroExtend(va);
    if HaveCommonNotPrivateTransExt() & Slice(TTBCR_S, 31, 1) == 0b1 then {
        if AArch32_GetVARange(va, Slice(TTBCR_S, 0, 3), Slice(TTBCR_S, 16, 3)) == VARange_LOWER then {
            tlbcontext.cnp = Slice(TTBR0_S, 0, 1)
        } else {
            tlbcontext.cnp = Slice(TTBR1_S, 0, 1)
        }
    } else {
        tlbcontext.cnp = 0b0
    };
    return(tlbcontext)
}

val AArch32_GetS1TLBContext : (Regime, SecurityState, bits(32)) -> TLBContext

function AArch32_GetS1TLBContext (regime, ss, va) = {
    tlbcontext : TLBContext = undefined;
    match regime {
      Regime_EL2 => {
          tlbcontext = AArch32_TLBContextEL2(va)
      },
      Regime_EL10 => {
          tlbcontext = AArch32_TLBContextEL10(ss, va)
      },
      Regime_EL30 => {
          tlbcontext = AArch32_TLBContextEL30(va)
      },
      _ => ()
    };
    tlbcontext.includes_s1_name = true;
    tlbcontext.includes_s2_name = false;
    return(tlbcontext)
}

val VTCR_read : unit -> bits(32)

function VTCR_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(VTCR_EL2, 0, 32));
    return(r)
}

val AArch32_GetS2TTWParams : unit -> S2TTWParams

function AArch32_GetS2TTWParams () = {
    walkparams : S2TTWParams = undefined;
    walkparams.tgx = TGx_4KB;
    walkparams.s = Slice(VTCR_read(), 4, 1);
    walkparams.t0sz = Slice(VTCR_read(), 0, 4);
    walkparams.sl0 = Slice(VTCR_read(), 6, 2);
    walkparams.irgn = Slice(VTCR_read(), 8, 2);
    walkparams.orgn = Slice(VTCR_read(), 10, 2);
    walkparams.sh = Slice(VTCR_read(), 12, 2);
    walkparams.ee = Slice(HSCTLR_read(), 25, 1);
    walkparams.ptw = Slice(HCR_read(), 2, 1);
    walkparams.vm = Slice(HCR_read(), 0, 1) | Slice(HCR_read(), 12, 1);
    if walkparams.s != [walkparams.t0sz[3]] then {
        let (_, __tup_1) = ConstrainUnpredictableBits(4, Unpredictable_RESVTCRS);
        walkparams.t0sz = __tup_1
    };
    return(walkparams)
}

val AArch32_S2IASize : bits(4) -> int

function AArch32_S2IASize t0sz = {
    return(32 - SInt(t0sz))
}

val AArch32_IPAIsOutOfRange : (S2TTWParams, bits(40)) -> bool

function AArch32_IPAIsOutOfRange (walkparams, ipa) = {
    let 'iasize = AArch32_S2IASize(walkparams.t0sz);
    return(iasize < 40 & not_bool(is_zero_subrange(ipa, 39, iasize)))
}

val AArch32_S2HasAlignmentFault : forall ('aligned : Bool).
  (AccType, bool('aligned), MemoryAttributes) -> bool

function AArch32_S2HasAlignmentFault (acctype, aligned, memattrs) = {
    if acctype == AccType_IFETCH | memattrs.memtype != MemType_Device then {
        return(false)
    };
    return(not_bool(aligned) | acctype == AccType_DCZVA)
}

val AArch32_S2HasPermissionsFault : forall ('ispriv : Bool) ('iswrite : Bool) ('s2fs1walk : Bool).
  (bool('s2fs1walk), S2TTWParams, Permissions, MemType, bool('ispriv), AccType, bool('iswrite)) -> bool

function AArch32_S2HasPermissionsFault (s2fs1walk, walkparams, perms, memtype, ispriv, acctype, iswrite) = {
    constraint_name : Constraint = undefined;
    px : bits(1) = undefined;
    ux : bits(1) = undefined;
    let r : bits(1) = [perms.s2ap[0]];
    let w : bits(1) = [perms.s2ap[1]];
    x : bits(1) = undefined;
    if HaveExtendedExecuteNeverExt() then {
        match perms.s2xn @ perms.s2xnx {
          0b00 => {
              (px, ux) = (r, r)
          },
          0b01 => {
              (px, ux) = (0b0, r)
          },
          0b10 => {
              (px, ux) = (0b0, 0b0)
          },
          0b11 => {
              (px, ux) = (r, 0b0)
          }
        };
        x = if ispriv then px else ux
    } else {
        x = r & not_vec(perms.s2xn)
    };
    if (s2fs1walk & walkparams.ptw == 0b1) & memtype == MemType_Device then {
        return(true)
    } else if acctype == AccType_IFETCH then {
        let constraint_name : Constraint = ConstrainUnpredictable(Unpredictable_INSTRDEVICE);
        if constraint_name == Constraint_FAULT & memtype == MemType_Device then {
            return(true)
        } else {
            return(x == 0b0)
        }
    } else if acctype == AccType_IC | acctype == AccType_DC then {
        return(false)
    } else if iswrite then {
        return(w == 0b0)
    } else {
        return(r == 0b0)
    }
}

val AArch32_GetS2TLBContext : FullAddress -> TLBContext

function AArch32_GetS2TLBContext ipa = {
    assert(ipa.paspace == PAS_NonSecure);
    tlbcontext : TLBContext = undefined;
    tlbcontext.ss = SS_NonSecure;
    tlbcontext.regime = Regime_EL10;
    tlbcontext.ipaspace = ipa.paspace;
    tlbcontext.vmid = ZeroExtend(Slice(VTTBR_read(), 48, 8));
    tlbcontext.tg = TGx_4KB;
    tlbcontext.includes_s1_name = false;
    tlbcontext.includes_s2_name = true;
    tlbcontext.ia = ZeroExtend(ipa.address);
    tlbcontext.cnp = if HaveCommonNotPrivateTransExt() then
      Slice(VTTBR_read(), 0, 1)
    else
      0b0;
    return(tlbcontext)
}

val AArch32_S2StartLevel : bits(2) -> int

function AArch32_S2StartLevel sl0 = {
    return(2 - UInt(sl0))
}

val AArch32_S2InconsistentSL : S2TTWParams -> bool

function AArch32_S2InconsistentSL walkparams = {
    let 'startlevel = AArch32_S2StartLevel(walkparams.sl0);
    let 'levels = FINAL_LEVEL - startlevel;
    let 'granulebits = TGxGranuleBits(walkparams.tgx);
    let 'stride = granulebits - 3;
    let 'sl_min_iasize = levels * stride + granulebits + 1;
    let 'sl_max_iasize = sl_min_iasize + (stride - 1) + 4;
    let 'iasize = AArch32_S2IASize(walkparams.t0sz);
    return(iasize < sl_min_iasize | iasize > sl_max_iasize)
}

val AArch32_S2Walk : (FaultRecord, S2TTWParams, AddressDescriptor) -> (FaultRecord, TTWState)

function AArch32_S2Walk (fault_in, walkparams, ipa) = {
    finalwalkstate : TTWState = undefined;
    fault : FaultRecord = fault_in;
    tlbcontext : TLBContext = undefined;
    if __tlb_enabled then {
        tlbcontext = AArch32_GetS2TLBContext(ipa.paddress);
        let tlbentry : TLBLine = S2TLBLookup(tlbcontext);
        if tlbentry.valid_name then {
            let finalwalkstate : TTWState = tlbentry.tlbrecord.walkstate;
            fault.level = finalwalkstate.level;
            return((fault, finalwalkstate))
        };
        ()
    };
    if (match walkparams.sl0 {
      [bitone, _] => true,
      _ => false
    }) : bool | AArch32_S2InconsistentSL(walkparams) then {
        fault.statuscode = Fault_Translation;
        fault.level = 1;
        return((fault, __UNKNOWN_TTWState()))
    };
    let 'iasize = AArch32_S2IASize(walkparams.t0sz);
    let 'startlevel = AArch32_S2StartLevel(walkparams.sl0);
    let 'levels = FINAL_LEVEL - startlevel;
    let 'granulebits = TGxGranuleBits(walkparams.tgx);
    let 'stride = granulebits - 3;
    if not_bool(IsZero(VTTBR_read()[47 .. 40])) then {
        fault.statuscode = Fault_AddressSize;
        fault.level = 0;
        return((fault, __UNKNOWN_TTWState()))
    };
    baseaddress : FullAddress = undefined;
    let 'baselsb = iasize - (levels * stride + granulebits) + 3;
    baseaddress.paspace = PAS_NonSecure;
    assert(constraint((0 <= 'baselsb & 'baselsb <= 39)));
    baseaddress.address = ZeroExtend(VTTBR_read()[39 .. baselsb] @ Zeros(baselsb));
    walkstate : TTWState = undefined;
    walkstate.baseaddress = baseaddress;
    walkstate.level = startlevel;
    walkstate.istable = true;
    walkstate.memattrs = WalkMemAttrs(walkparams.sh, walkparams.irgn, walkparams.orgn);
    indexmsb : int = iasize - 1;
    descriptor : bits(64) = undefined;
    walkaddress : AddressDescriptor = undefined;
    walkaddress.vaddress = ipa.vaddress;
    if Slice(HCR2_read(), 0, 1) == 0b1 then {
        walkaddress.memattrs = NormalNCMemAttr();
        walkaddress.memattrs.xs = walkstate.memattrs.xs
    } else {
        walkaddress.memattrs = walkstate.memattrs
    };
    walkaddress.memattrs.shareability = EffectiveShareability(walkaddress.memattrs);
    indexlsb : int = undefined;
    desctype : DescriptorType = undefined;
    repeat {
        fault.level = walkstate.level;
        indexlsb = (FINAL_LEVEL - walkstate.level) * stride + granulebits;
        let index : bits(40) = let 'indexmsb = indexmsb in
          {
              let 'indexlsb = indexlsb;
              assert(constraint((0 <= 'indexlsb & 'indexlsb <= 'indexmsb & 'indexmsb < 52)));
              assert(constraint(40 >= 'indexmsb - 'indexlsb + 1 + 3));
              ZeroExtend(ipa.paddress.address[indexmsb .. indexlsb] @ 0b000)
          };
        walkaddress.paddress.address = walkstate.baseaddress.address | ZeroExtend(index);
        walkaddress.paddress.paspace = walkstate.baseaddress.paspace;
        (fault, descriptor) = FetchDescriptor(64, walkparams.ee, walkaddress, fault);
        if fault.statuscode != Fault_None then {
            return((fault, __UNKNOWN_TTWState()))
        };
        desctype = AArch32_DecodeDescriptorTypeLD(descriptor, walkstate.level);
        match desctype {
          DescriptorType_Table => {
              if not_bool(IsZero(descriptor[47 .. 40])) then {
                  fault.statuscode = Fault_AddressSize;
                  return((fault, __UNKNOWN_TTWState()))
              };
              walkstate.baseaddress.address = ZeroExtend(descriptor[39 .. 12] @ Zeros(12));
              walkstate.level = walkstate.level + 1;
              indexmsb = indexlsb - 1
          },
          DescriptorType_Invalid => {
              fault.statuscode = Fault_Translation;
              return((fault, __UNKNOWN_TTWState()))
          },
          DescriptorType_Page => {
              walkstate.istable = false
          },
          DescriptorType_Block => {
              walkstate.istable = false
          },
          _ => ()
        }
    } until desctype == DescriptorType_Page | desctype == DescriptorType_Block;
    let 'indexlsb = indexlsb;
    if not_bool(IsZero(descriptor[47 .. 40])) then {
        fault.statuscode = Fault_AddressSize;
        return((fault, __UNKNOWN_TTWState()))
    };
    if [descriptor[10]] == 0b0 then {
        fault.statuscode = Fault_AccessFlag;
        return((fault, __UNKNOWN_TTWState()))
    };
    assert(constraint((0 <= 'indexlsb & 'indexlsb <= 39)));
    walkstate.baseaddress.address = ZeroExtend(descriptor[39 .. indexlsb] @ Zeros(indexlsb));
    walkstate.permissions.s2ap = descriptor[7 .. 6];
    walkstate.permissions.s2xn = [descriptor[54]];
    if HaveExtendedExecuteNeverExt() then {
        walkstate.permissions.s2xnx = [descriptor[53]]
    } else {
        walkstate.permissions.s2xnx = 0b0
    };
    let memattr : bits(4) = descriptor[5 .. 2];
    let sh : bits(2) = descriptor[9 .. 8];
    walkstate.memattrs = S2DecodeMemAttrs(memattr, sh);
    walkstate.contiguous = [descriptor[52]];
    if __tlb_enabled then {
        tlbcontext.xs = walkstate.memattrs.xs;
        tlbrecord : TLBRecord = undefined;
        tlbrecord.context = tlbcontext;
        tlbrecord.walkstate = walkstate;
        tlbrecord.blocksize = TranslationSize(walkparams.tgx, walkstate.level);
        if walkstate.contiguous == 0b1 then {
            tlbrecord.contigsize = ContiguousSize(walkparams.tgx, walkstate.level)
        } else {
            tlbrecord.contigsize = 0
        };
        S2TLBCache(tlbrecord)
    };
    return((fault, walkstate))
}

val AArch32_S2Translate : forall ('aligned : Bool) ('ispriv : Bool) ('iswrite : Bool) ('s2fs1walk : Bool).
  (FaultRecord, AddressDescriptor, SecurityState, bool('s2fs1walk), AccType, bool('aligned), bool('iswrite), bool('ispriv)) -> (FaultRecord, AddressDescriptor)

function AArch32_S2Translate (fault_in, ipa, ss, s2fs1walk, acctype, aligned, iswrite, ispriv) = {
    s1aarch64 : bool = undefined;
    fault : FaultRecord = fault_in;
    assert(IsZero(ipa.paddress.address[51 .. 40]));
    if not_bool(ELStateUsingAArch32(EL2, ss == SS_Secure)) then {
        let s1aarch64 : bool = false;
        return(AArch64_S2Translate(fault, ipa, s1aarch64, ss, s2fs1walk, acctype, aligned, iswrite, ispriv))
    };
    fault.statuscode = Fault_None;
    fault.secondstage = true;
    fault.s2fs1walk = s2fs1walk;
    fault.ipaddress = ipa.paddress;
    let walkparams : S2TTWParams = AArch32_GetS2TTWParams();
    if walkparams.vm == 0b0 then {
        return((fault, ipa))
    };
    if AArch32_IPAIsOutOfRange(walkparams, ipa.paddress.address[39 .. 0]) then {
        fault.statuscode = Fault_Translation;
        fault.level = 1;
        return((fault, __UNKNOWN_AddressDescriptor()))
    };
    walkstate : TTWState = undefined;
    (fault, walkstate) = AArch32_S2Walk(fault, walkparams, ipa);
    if fault.statuscode != Fault_None then {
        return((fault, __UNKNOWN_AddressDescriptor()))
    };
    if AArch32_S2HasAlignmentFault(acctype, aligned, walkstate.memattrs) then {
        fault.statuscode = Fault_Alignment
    } else if IsAtomicRW(acctype) then {
        assert(not_bool(s2fs1walk));
        if AArch32_S2HasPermissionsFault(s2fs1walk, walkparams, walkstate.permissions, walkstate.memattrs.memtype, ispriv, acctype, false) then {
            fault.statuscode = Fault_Permission;
            fault.write = false
        } else if AArch32_S2HasPermissionsFault(s2fs1walk, walkparams, walkstate.permissions, walkstate.memattrs.memtype, ispriv, acctype, true) then {
            fault.statuscode = Fault_Permission;
            fault.write = true
        } else ()
    } else if AArch32_S2HasPermissionsFault(s2fs1walk, walkparams, walkstate.permissions, walkstate.memattrs.memtype, ispriv, acctype, iswrite) then {
        fault.statuscode = Fault_Permission
    } else ();
    s2_memattrs : MemoryAttributes = undefined;
    if (s2fs1walk & walkstate.memattrs.memtype == MemType_Device | acctype == AccType_IFETCH & (walkstate.memattrs.memtype == MemType_Device | Slice(HCR2_read(), 1, 1) == 0b1)) | (acctype != AccType_IFETCH & walkstate.memattrs.memtype == MemType_Normal) & Slice(HCR2_read(), 0, 1) == 0b1 then {
        s2_memattrs = NormalNCMemAttr();
        s2_memattrs.xs = walkstate.memattrs.xs
    } else {
        s2_memattrs = walkstate.memattrs
    };
    let memattrs : MemoryAttributes = S2CombineS1MemAttrs(ipa.memattrs, s2_memattrs);
    let ipa_64 : bits(64) = ZeroExtend(ipa.paddress.address[39 .. 0], 64);
    let oa : FullAddress = StageOA(ipa_64, walkparams.tgx, walkstate);
    let pa : AddressDescriptor = CreateAddressDescriptor(ipa.vaddress, oa, memattrs);
    return((fault, pa))
}

val AArch32_S1WalkLD : forall ('ispriv : Bool).
  (FaultRecord, Regime, SecurityState, S1TTWParams, bits(32), bool('ispriv)) -> (FaultRecord, TTWState)

function AArch32_S1WalkLD (fault_in, regime, ss, walkparams, va, ispriv) = {
    finalwalkstate : TTWState = undefined;
    s2acctype : AccType = undefined;
    s2aligned : bool = undefined;
    s2fault : FaultRecord = undefined;
    s2fs1walk : bool = undefined;
    s2walkaddress : AddressDescriptor = undefined;
    s2write : bool = undefined;
    varange : VARange = undefined;
    fault : FaultRecord = fault_in;
    tlbcontext : TLBContext = undefined;
    if __tlb_enabled then {
        tlbcontext = AArch32_GetS1TLBContext(regime, ss, va);
        let tlbentry : TLBLine = S1TLBLookup(tlbcontext);
        if tlbentry.valid_name then {
            let finalwalkstate : TTWState = tlbentry.tlbrecord.walkstate;
            fault.level = finalwalkstate.level;
            return((fault, finalwalkstate))
        };
        ()
    };
    txsz : bits(3) = undefined;
    ttbr : bits(64) = undefined;
    epd : bits(1) = undefined;
    if regime == Regime_EL2 then {
        ttbr = HTTBR_read();
        txsz = walkparams.t0sz
    } else {
        let varange : VARange = AArch32_GetVARange(va, walkparams.t0sz, walkparams.t1sz);
        ttbr0 : bits(64) = undefined;
        ttbr1 : bits(64) = undefined;
        ttbcr : bits(32) = undefined;
        if regime == Regime_EL30 then {
            ttbcr = TTBCR_S;
            ttbr0 = TTBR0_S;
            ttbr1 = TTBR1_S
        } else if HaveAArch32EL(EL3) then {
            ttbcr = TTBCR_NS_read();
            ttbr0 = TTBR0_NS_read();
            ttbr1 = TTBR1_NS_read()
        } else {
            ttbcr = TTBCR_read();
            ttbr0 = TTBR0_read();
            ttbr1 = TTBR1_read()
        };
        assert(Slice(ttbcr, 31, 1) == 0b1);
        if varange == VARange_LOWER then {
            txsz = walkparams.t0sz;
            ttbr = ttbr0;
            epd = Slice(ttbcr, 7, 1)
        } else {
            txsz = walkparams.t1sz;
            ttbr = ttbr1;
            epd = Slice(ttbcr, 23, 1)
        }
    };
    if regime != Regime_EL2 & epd == 0b1 then {
        fault.level = 1;
        fault.statuscode = Fault_Translation;
        return((fault, __UNKNOWN_TTWState()))
    };
    let 'iasize = AArch32_S1IASize(txsz);
    let 'granulebits = TGxGranuleBits(walkparams.tgx);
    let 'stride = granulebits - 3;
    let 'startlevel = FINAL_LEVEL - DIV(iasize - 1 - granulebits, stride);
    let 'levels = FINAL_LEVEL - startlevel;
    if not_bool(IsZero(ttbr[47 .. 40])) then {
        fault.statuscode = Fault_AddressSize;
        fault.level = 0;
        return((fault, __UNKNOWN_TTWState()))
    };
    baseaddress : FullAddress = undefined;
    let 'baselsb = iasize - (levels * stride + granulebits) + 3;
    baseaddress.paspace = if ss == SS_Secure then PAS_Secure else PAS_NonSecure;
    assert(constraint((0 <= 'baselsb & 'baselsb <= 39)));
    baseaddress.address = ZeroExtend(ttbr[39 .. baselsb] @ Zeros(baselsb));
    walkstate : TTWState = undefined;
    walkstate.baseaddress = baseaddress;
    walkstate.level = startlevel;
    walkstate.istable = true;
    walkstate.nG = if HasUnprivileged(regime) then 0b1 else 0b0;
    walkstate.memattrs = WalkMemAttrs(walkparams.sh, walkparams.irgn, walkparams.orgn);
    walkstate.permissions.ap_table = 0b00;
    walkstate.permissions.xn_table = 0b0;
    walkstate.permissions.pxn_table = 0b0;
    indexmsb : int = iasize - 1;
    descriptor : bits(64) = undefined;
    walkaddress : AddressDescriptor = undefined;
    walkaddress.vaddress = ZeroExtend(va);
    if not_bool(AArch32_S1DCacheEnabled(regime)) then {
        walkaddress.memattrs = NormalNCMemAttr();
        walkaddress.memattrs.xs = walkstate.memattrs.xs
    } else {
        walkaddress.memattrs = walkstate.memattrs
    };
    if ((regime == Regime_EL10 & AArch32_EL2Enabled(ss)) & (if ELStateUsingAArch32(EL2, ss == SS_Secure) then
      Slice(HCR_read(), 0, 1)
    else
      Slice(HCR_EL2, 0, 1)) == 0b1) & not_bool(__IMPDEF_boolean("Apply effective shareability at stage 1")) then {
        walkaddress.memattrs.shareability = walkstate.memattrs.shareability
    } else {
        walkaddress.memattrs.shareability = EffectiveShareability(walkaddress.memattrs)
    };
    indexlsb : int = undefined;
    desctype : DescriptorType = undefined;
    repeat {
        fault.level = walkstate.level;
        indexlsb = (FINAL_LEVEL - walkstate.level) * stride + granulebits;
        let index : bits(40) = let 'indexmsb = indexmsb in
          {
              let 'indexlsb = indexlsb;
              assert(constraint((0 <= 'indexlsb & 'indexlsb <= 'indexmsb & 'indexmsb < 32)));
              ZeroExtend(va[indexmsb .. indexlsb] @ 0b000)
          };
        walkaddress.paddress.address = walkstate.baseaddress.address | ZeroExtend(index);
        walkaddress.paddress.paspace = walkstate.baseaddress.paspace;
        if regime == Regime_EL10 & AArch32_EL2Enabled(ss) then {
            s2fs1walk = true;
            s2acctype = AccType_TTW;
            s2aligned = true;
            s2write = false;
            (s2fault, s2walkaddress) = AArch32_S2Translate(fault, walkaddress, ss, s2fs1walk, s2acctype, s2aligned, s2write, ispriv);
            if s2fault.statuscode != Fault_None then {
                return((s2fault, __UNKNOWN_TTWState()))
            };
            (fault, descriptor) = FetchDescriptor(64, walkparams.ee, s2walkaddress, fault)
        } else {
            (fault, descriptor) = FetchDescriptor(64, walkparams.ee, walkaddress, fault)
        };
        if fault.statuscode != Fault_None then {
            return((fault, __UNKNOWN_TTWState()))
        };
        desctype = AArch32_DecodeDescriptorTypeLD(descriptor, walkstate.level);
        match desctype {
          DescriptorType_Table => {
              if not_bool(IsZero(descriptor[47 .. 40])) then {
                  fault.statuscode = Fault_AddressSize;
                  return((fault, __UNKNOWN_TTWState()))
              };
              walkstate.baseaddress.address = ZeroExtend(descriptor[39 .. 12] @ Zeros(12));
              if walkstate.baseaddress.paspace == PAS_Secure & [descriptor[63]] == 0b1 then {
                  walkstate.baseaddress.paspace = PAS_NonSecure
              };
              if walkparams.hpd == 0b0 then {
                  walkstate.permissions.xn_table = walkstate.permissions.xn_table | [descriptor[60]];
                  walkstate.permissions.ap_table = walkstate.permissions.ap_table | descriptor[62 .. 61];
                  walkstate.permissions.pxn_table = walkstate.permissions.pxn_table | [descriptor[59]]
              };
              walkstate.level = walkstate.level + 1;
              indexmsb = indexlsb - 1
          },
          DescriptorType_Invalid => {
              fault.statuscode = Fault_Translation;
              return((fault, __UNKNOWN_TTWState()))
          },
          DescriptorType_Page => {
              walkstate.istable = false
          },
          DescriptorType_Block => {
              walkstate.istable = false
          },
          _ => ()
        }
    } until desctype == DescriptorType_Page | desctype == DescriptorType_Block;
    let 'indexlsb = indexlsb;
    if not_bool(IsZero(descriptor[47 .. 40])) then {
        fault.statuscode = Fault_AddressSize;
        return((fault, __UNKNOWN_TTWState()))
    };
    if [descriptor[10]] == 0b0 then {
        fault.statuscode = Fault_AccessFlag;
        return((fault, __UNKNOWN_TTWState()))
    };
    walkstate.permissions.xn = [descriptor[54]];
    walkstate.permissions.pxn = [descriptor[53]];
    walkstate.permissions.ap = descriptor[7 .. 6] @ 0b1;
    walkstate.contiguous = [descriptor[52]];
    if regime == Regime_EL2 then {
        walkstate.nG = 0b0
    } else if ss == SS_Secure & walkstate.baseaddress.paspace == PAS_NonSecure then {
        walkstate.nG = 0b1
    } else {
        walkstate.nG = [descriptor[11]]
    };
    assert(constraint((0 <= 'indexlsb & 'indexlsb <= 39)));
    walkstate.baseaddress.address = ZeroExtend(descriptor[39 .. indexlsb] @ Zeros(indexlsb));
    if walkstate.baseaddress.paspace == PAS_Secure & [descriptor[5]] == 0b1 then {
        walkstate.baseaddress.paspace = PAS_NonSecure
    };
    let memattr : bits(3) = descriptor[4 .. 2];
    let sh : bits(2) = descriptor[9 .. 8];
    let attr : bits(8) = MAIRAttr(UInt(memattr), walkparams.mair);
    let s1aarch64 : bool = false;
    walkstate.memattrs = S1DecodeMemAttrs(attr, sh, s1aarch64);
    if __tlb_enabled then {
        tlbcontext.xs = walkstate.memattrs.xs;
        tlbcontext.nG = walkstate.nG;
        tlbrecord : TLBRecord = undefined;
        tlbrecord.context = tlbcontext;
        tlbrecord.walkstate = walkstate;
        tlbrecord.blocksize = TranslationSize(walkparams.tgx, walkstate.level);
        if walkstate.contiguous == 0b1 then {
            tlbrecord.contigsize = ContiguousSize(walkparams.tgx, walkstate.level)
        } else {
            tlbrecord.contigsize = 0
        };
        S1TLBCache(tlbrecord)
    };
    return((fault, walkstate))
}

val AArch32_VAIsOutOfRange : (Regime, S1TTWParams, bits(32)) -> bool

function AArch32_VAIsOutOfRange (regime, walkparams, va) = {
    iasize : int = undefined;
    lo_iasize : int = undefined;
    up_iasize : int = undefined;
    if regime == Regime_EL2 then {
        let 'iasize = AArch32_S1IASize(walkparams.t0sz);
        return(walkparams.t0sz != 0b000 & not_bool(is_zero_subrange(va, 31, iasize)))
    } else if walkparams.t1sz != 0b000 & walkparams.t0sz != 0b000 then {
        let 'lo_iasize = AArch32_S1IASize(walkparams.t0sz);
        let 'up_iasize = AArch32_S1IASize(walkparams.t1sz);
        return(not_bool(is_zero_subrange(va, 31, lo_iasize)) & not_bool(is_ones_subrange(va, 31, up_iasize)))
    } else {
        return(false)
    }
}

val AArch32_S1TranslateLD : forall ('aligned : Bool) ('ispriv : Bool) ('iswrite : Bool).
  (FaultRecord, Regime, SecurityState, bits(32), AccType, bool('aligned), bool('iswrite), bool('ispriv)) -> (FaultRecord, AddressDescriptor)

function AArch32_S1TranslateLD (fault_in, regime, ss, va, acctype, aligned, iswrite, ispriv) = {
    fault : FaultRecord = fault_in;
    fault.secondstage = false;
    fault.s2fs1walk = false;
    if not_bool(AArch32_S1Enabled(regime, ss)) then {
        return(AArch32_S1DisabledOutput(fault, regime, ss, va, acctype, aligned))
    };
    let walkparams : S1TTWParams = AArch32_GetS1TTWParams(regime, va);
    if AArch32_VAIsOutOfRange(regime, walkparams, va) then {
        fault.level = 1;
        fault.statuscode = Fault_Translation;
        return((fault, __UNKNOWN_AddressDescriptor()))
    };
    walkstate : TTWState = undefined;
    (fault, walkstate) = AArch32_S1WalkLD(fault, regime, ss, walkparams, va, ispriv);
    if fault.statuscode != Fault_None then {
        return((fault, __UNKNOWN_AddressDescriptor()))
    };
    SetInGuardedPage(false);
    if AArch32_S1HasAlignmentFault(acctype, aligned, walkparams.ntlsmd, walkstate.memattrs) then {
        fault.statuscode = Fault_Alignment
    } else if IsAtomicRW(acctype) then {
        if AArch32_S1LDHasPermissionsFault(regime, ss, walkparams, walkstate.permissions, walkstate.memattrs.memtype, walkstate.baseaddress.paspace, ispriv, acctype, false) then {
            fault.statuscode = Fault_Permission;
            fault.write = false
        } else if AArch32_S1LDHasPermissionsFault(regime, ss, walkparams, walkstate.permissions, walkstate.memattrs.memtype, walkstate.baseaddress.paspace, ispriv, acctype, true) then {
            fault.statuscode = Fault_Permission;
            fault.write = true
        } else ()
    } else if AArch32_S1LDHasPermissionsFault(regime, ss, walkparams, walkstate.permissions, walkstate.memattrs.memtype, walkstate.baseaddress.paspace, ispriv, acctype, iswrite) then {
        fault.statuscode = Fault_Permission
    } else ();
    if fault.statuscode != Fault_None then {
        return((fault, __UNKNOWN_AddressDescriptor()))
    };
    memattrs : MemoryAttributes = undefined;
    if acctype == AccType_IFETCH & (walkstate.memattrs.memtype == MemType_Device | not_bool(AArch32_S1ICacheEnabled(regime))) | (acctype != AccType_IFETCH & walkstate.memattrs.memtype == MemType_Normal) & not_bool(AArch32_S1DCacheEnabled(regime)) then {
        memattrs = NormalNCMemAttr();
        memattrs.xs = walkstate.memattrs.xs
    } else {
        memattrs = walkstate.memattrs
    };
    if ((regime == Regime_EL10 & AArch32_EL2Enabled(ss)) & (if ELStateUsingAArch32(EL2, ss == SS_Secure) then
      Slice(HCR_read(), 0, 1)
    else
      Slice(HCR_EL2, 0, 1)) == 0b1) & not_bool(__IMPDEF_boolean("Apply effective shareability at stage 1")) then {
        memattrs.shareability = walkstate.memattrs.shareability
    } else {
        memattrs.shareability = EffectiveShareability(memattrs)
    };
    let oa : FullAddress = StageOA(ZeroExtend(va), walkparams.tgx, walkstate);
    let ipa : AddressDescriptor = CreateAddressDescriptor(ZeroExtend(va), oa, memattrs);
    return((fault, ipa))
}

val DACR_NS_read : unit -> bits(32)

function DACR_NS_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(DACR32_EL2, 0, 32));
    return(r)
}

register DACR_S : bits(32)

val DACR_read : unit -> bits(32)

function DACR_read () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = DACR_S
    } else {
        r = DACR_NS_read()
    };
    return(r)
}

val AArch32_OutputDomain : (Regime, bits(4)) -> bits(2)

function AArch32_OutputDomain (regime, domain) = {
    Dn : bits(2) = undefined;
    let 'index = 2 * UInt(domain);
    if regime == Regime_EL30 then {
        Dn = DACR_S[index + 1 .. index]
    } else if HaveAArch32EL(EL3) then {
        Dn = DACR_NS_read()[index + 1 .. index]
    } else {
        Dn = DACR_read()[index + 1 .. index]
    };
    if Dn == 0b10 then {
        let (_, __tup_1 : bits(2)) = ConstrainUnpredictableBits(2, Unpredictable_RESDACR);
        Dn = __tup_1
    };
    return(Dn)
}

val AArch32_S1SDHasPermissionsFault : forall ('ispriv : Bool) ('iswrite : Bool).
  (Regime, SecurityState, Permissions, MemType, PASpace, bool('ispriv), AccType, bool('iswrite)) -> bool

function AArch32_S1SDHasPermissionsFault (regime, ss, perms_in, memtype, paspace, ispriv, acctype, iswrite) = {
    constraint_name : Constraint = undefined;
    pan : bits(1) = undefined;
    r : bits(1) = undefined;
    w : bits(1) = undefined;
    x : bits(1) = undefined;
    perms : Permissions = perms_in;
    pr : bits(1) = undefined;
    pw : bits(1) = undefined;
    ur : bits(1) = undefined;
    uw : bits(1) = undefined;
    sctlr : bits(32) = undefined;
    if regime == Regime_EL30 then {
        sctlr = SCTLR_S
    } else if HaveAArch32EL(EL3) then {
        sctlr = SCTLR_NS_read()
    } else {
        sctlr = SCTLR_read__2()
    };
    if Slice(sctlr, 29, 1) == 0b0 then {
        if perms.ap == 0b100 then {
            perms.ap = __IMPDEF_bits(3, "Reserved short descriptor AP encoding")
        };
        match perms.ap {
          0b000 => {
              (pr, pw, ur, uw) = (0b0, 0b0, 0b0, 0b0)
          },
          0b001 => {
              (pr, pw, ur, uw) = (0b1, 0b1, 0b0, 0b0)
          },
          0b010 => {
              (pr, pw, ur, uw) = (0b1, 0b1, 0b1, 0b0)
          },
          0b011 => {
              (pr, pw, ur, uw) = (0b1, 0b1, 0b1, 0b1)
          },
          0b101 => {
              (pr, pw, ur, uw) = (0b1, 0b0, 0b0, 0b0)
          },
          0b110 => {
              (pr, pw, ur, uw) = (0b1, 0b0, 0b1, 0b0)
          },
          0b111 => {
              (pr, pw, ur, uw) = (0b1, 0b0, 0b1, 0b0)
          },
          _ => ()
        }
    } else {
        match perms.ap[2 .. 1] {
          0b00 => {
              (pr, pw, ur, uw) = (0b1, 0b1, 0b0, 0b0)
          },
          0b01 => {
              (pr, pw, ur, uw) = (0b1, 0b1, 0b1, 0b1)
          },
          0b10 => {
              (pr, pw, ur, uw) = (0b1, 0b0, 0b0, 0b0)
          },
          0b11 => {
              (pr, pw, ur, uw) = (0b1, 0b0, 0b1, 0b0)
          },
          _ => ()
        }
    };
    let ux : bits(1) = ur & not_vec(perms.xn | uw & Slice(sctlr, 19, 1));
    let px : bits(1) = pr & not_vec(((perms.xn | perms.pxn) | pw & Slice(sctlr, 19, 1)) | uw & Slice(sctlr, 20, 1));
    let pan_access : bool = not_bool(acctype == AccType_DC | acctype == AccType_IFETCH | acctype == AccType_AT);
    if HavePANExt() & pan_access then {
        let pan : bits(1) = PSTATE.PAN & (ur | uw);
        pr = pr & not_vec(pan);
        pw = pw & not_vec(pan)
    };
    (r, w, x) = if ispriv then (pr, pw, px) else (ur, uw, ux);
    if ss == SS_Secure & paspace == PAS_NonSecure then {
        x = x & not_vec(if ELUsingAArch32(EL3) then Slice(SCR, 9, 1) else
          Slice(SCR_EL3, 9, 1))
    };
    let x = x;
    if acctype == AccType_IFETCH then {
        let constraint_name : Constraint = ConstrainUnpredictable(Unpredictable_INSTRDEVICE);
        if constraint_name == Constraint_FAULT & memtype == MemType_Device then {
            return(true)
        } else {
            return(x == 0b0)
        }
    } else if acctype == AccType_IC | acctype == AccType_DC then {
        return(false)
    } else if iswrite then {
        return(w == 0b0)
    } else {
        return(r == 0b0)
    }
}

val AArch32_DecodeDescriptorTypeSD : forall 'level.
  (bits(32), int('level)) -> SDFType

function AArch32_DecodeDescriptorTypeSD (descriptor, level) = {
    if level == 1 & descriptor[1 .. 0] == 0b01 then {
        return(SDFType_Table)
    } else if level == 1 & (descriptor[18 .. 18] @ [descriptor[1]]) == 0b01 then {
        return(SDFType_Section)
    } else if level == 1 & (descriptor[18 .. 18] @ [descriptor[1]]) == 0b11 then {
        return(SDFType_Supersection)
    } else if level == 2 & descriptor[1 .. 0] == 0b01 then {
        return(SDFType_LargePage)
    } else if level == 2 & (match descriptor[1 .. 0] {
      [bitone, _] => true,
      _ => false
    }) : bool then {
        return(SDFType_SmallPage)
    } else {
        return(SDFType_Invalid)
    }
}

val __IMPDEF_MemoryAttributes : string -> MemoryAttributes

function __IMPDEF_MemoryAttributes x = {
    return(__UNKNOWN_MemoryAttributes())
}

val AArch32_DefaultTEXDecode : (bits(3), bits(1), bits(1), bits(1)) -> MemoryAttributes

function AArch32_DefaultTEXDecode (TEX_in, C_in, B_in, S) = {
    memattrs : MemoryAttributes = undefined;
    TEX : bits(3) = TEX_in;
    C : bits(1) = C_in;
    B : bits(1) = B_in;
    if (TEX == 0b001 & (C @ B) == 0b01 | TEX == 0b010 & (C @ B) != 0b00) | TEX == 0b011 then {
        texcb : bits(5) = undefined;
        let (_, __tup_1 : bits(5)) =
          ConstrainUnpredictableBits(5, Unpredictable_RESTEXCB)
        in
          {
              texcb = __tup_1
          };
        TEX = texcb[4 .. 2];
        C = [texcb[1]];
        B = [texcb[0]]
    };
    match (TEX @ C) @ B {
      0b00000 => {
          memattrs.memtype = MemType_Device;
          memattrs.device = DeviceType_nGnRnE;
          memattrs.shareability = Shareability_OSH
      },
      0b00001 => {
          memattrs.memtype = MemType_Device;
          memattrs.device = DeviceType_nGnRE;
          memattrs.shareability = Shareability_OSH
      },
      0b01000 => {
          memattrs.memtype = MemType_Device;
          memattrs.device = DeviceType_nGnRE;
          memattrs.shareability = Shareability_OSH
      },
      0b00010 => {
          memattrs.memtype = MemType_Normal;
          memattrs.inner.attrs = MemAttr_WT;
          memattrs.inner.hints = MemHint_RA;
          memattrs.outer.attrs = MemAttr_WT;
          memattrs.outer.hints = MemHint_RA;
          memattrs.shareability = if S == 0b1 then Shareability_OSH else
            Shareability_NSH
      },
      0b00011 => {
          memattrs.memtype = MemType_Normal;
          memattrs.inner.attrs = MemAttr_WB;
          memattrs.inner.hints = MemHint_RA;
          memattrs.outer.attrs = MemAttr_WB;
          memattrs.outer.hints = MemHint_RA;
          memattrs.shareability = if S == 0b1 then Shareability_OSH else
            Shareability_NSH
      },
      0b00100 => {
          memattrs.memtype = MemType_Normal;
          memattrs.inner.attrs = MemAttr_NC;
          memattrs.outer.attrs = MemAttr_NC;
          memattrs.shareability = Shareability_OSH
      },
      0b00110 => {
          memattrs = __IMPDEF_MemoryAttributes("")
      },
      0b00111 => {
          memattrs.memtype = MemType_Normal;
          memattrs.inner.attrs = MemAttr_WB;
          memattrs.inner.hints = MemHint_RWA;
          memattrs.outer.attrs = MemAttr_WB;
          memattrs.outer.hints = MemHint_RWA;
          memattrs.shareability = if S == 0b1 then Shareability_OSH else
            Shareability_NSH
      },
      [bitone, _, _, _, _] => {
          memattrs.memtype = MemType_Normal;
          memattrs.inner = DecodeSDFAttr(C @ B);
          memattrs.outer = DecodeSDFAttr(TEX[1 .. 0]);
          if memattrs.inner.attrs == MemAttr_NC & memattrs.outer.attrs == MemAttr_NC then {
              memattrs.shareability = Shareability_OSH
          } else {
              memattrs.shareability = if S == 0b1 then Shareability_OSH else
                Shareability_NSH
          }
      },
      _ => {
          Unreachable()
      }
    };
    memattrs.inner.transient = false;
    memattrs.outer.transient = false;
    memattrs.tagged = false;
    if memattrs.inner.attrs == MemAttr_WB & memattrs.outer.attrs == MemAttr_WB then {
        memattrs.xs = 0b0
    } else {
        memattrs.xs = 0b1
    };
    return(memattrs)
}

val PRRR_NS_read : unit -> bits(32)

function PRRR_NS_read () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) then {
        r = SetSlice(32, r, 0, Slice(MAIR0_NS_read(), 0, 32))
    } else {
        if not_bool(HaveEL(EL3)) | not_bool(ELUsingAArch32(EL3)) then {
            r = SetSlice(32, r, 0, Slice(MAIR_EL1, 0, 32))
        } else {
            r = SetSlice(32, r, 0, Slice(MAIR0_read(), 0, 32))
        }
    };
    return(r)
}

val PRRR_S_read : unit -> bits(32)

function PRRR_S_read () = {
    r : bits(32) = undefined;
    r = SetSlice(32, r, 0, Slice(MAIR0_S, 0, 32));
    return(r)
}

val PRRR_read : unit -> bits(32)

function PRRR_read () = {
    r : bits(32) = undefined;
    if ELUsingAArch32(EL3) & IsSecure() then {
        r = PRRR_S_read()
    } else {
        r = PRRR_NS_read()
    };
    return(r)
}

val AArch32_RemappedTEXDecode : (Regime, bits(3), bits(1), bits(1), bits(1)) -> MemoryAttributes

function AArch32_RemappedTEXDecode (regime, TEX, C, B, S) = {
    NOSm : bits(1) = undefined;
    NSn : bits(1) = undefined;
    memattrs : MemoryAttributes = undefined;
    prrr : bits(32) = undefined;
    nmrr : bits(32) = undefined;
    let 'region = UInt(([TEX[0]] @ C) @ B);
    if region == 6 then {
        return(__IMPDEF_MemoryAttributes(""))
    };
    if regime == Regime_EL30 then {
        prrr = PRRR_S_read();
        nmrr = NMRR_S
    } else if HaveAArch32EL(EL3) then {
        prrr = PRRR_NS_read();
        nmrr = NMRR_NS_read()
    } else {
        prrr = PRRR_read();
        nmrr = NMRR_read()
    };
    let 'base = 2 * region;
    attrfield : bits(0 + ('base + 1 - 'base + 1)) = prrr[base + 1 .. base];
    if attrfield == 0b11 then {
        let (_, __tup_1 : bits(0 + ('base + 1 - 'base + 1))) = ConstrainUnpredictableBits(0 + (base + 1 - base + 1), Unpredictable_RESPRRR);
        attrfield = __tup_1
    };
    IRn : bits(0 + ('base + 1 - 'base + 1)) = undefined;
    ORn : bits(0 + ('base + 17 - ('base + 16) + 1)) = undefined;
    match attrfield {
      0b00 => {
          memattrs.memtype = MemType_Device;
          memattrs.device = DeviceType_nGnRnE;
          memattrs.shareability = Shareability_OSH
      },
      0b01 => {
          memattrs.memtype = MemType_Device;
          memattrs.device = DeviceType_nGnRE;
          memattrs.shareability = Shareability_OSH
      },
      0b10 => {
          let NSn : bits(1) = if S == 0b0 then Slice(prrr, 18, 1) else
            Slice(prrr, 19, 1);
          let NOSm : bits(1) = [prrr[region + 24]] & NSn;
          let IRn : bits(0 + ('base + 1 - 'base + 1)) = nmrr[base + 1 .. base];
          let ORn : bits(0 + ('base + 17 - ('base + 16) + 1)) = nmrr[base + 17 .. base + 16];
          memattrs.memtype = MemType_Normal;
          memattrs.inner = DecodeSDFAttr(IRn);
          memattrs.outer = DecodeSDFAttr(ORn);
          if memattrs.inner.attrs == MemAttr_NC & memattrs.outer.attrs == MemAttr_NC then {
              memattrs.shareability = Shareability_OSH
          } else {
              let sh : bits(2) = NSn @ NOSm;
              memattrs.shareability = DecodeShareability(sh)
          }
      },
      0b11 => {
          Unreachable()
      },
      _ => ()
    };
    memattrs.inner.transient = false;
    memattrs.outer.transient = false;
    memattrs.tagged = false;
    if memattrs.inner.attrs == MemAttr_WB & memattrs.outer.attrs == MemAttr_WB then {
        memattrs.xs = 0b0
    } else {
        memattrs.xs = 0b1
    };
    return(memattrs)
}

val AArch32_TranslationSizeSD : SDFType -> int

function AArch32_TranslationSizeSD sdftype = {
    tsize : {|12, 16, 20, 24|} = 12;
    match sdftype {
      SDFType_SmallPage => {
          tsize = 12
      },
      SDFType_LargePage => {
          tsize = 16
      },
      SDFType_Section => {
          tsize = 20
      },
      SDFType_Supersection => {
          tsize = 24
      },
      _ => ()
    };
    let 'tsize = tsize;
    return(tsize)
}

val RemapRegsHaveResetValues : unit -> bool

val AArch32_S1WalkSD : forall ('ispriv : Bool).
  (FaultRecord, Regime, SecurityState, bits(32), bool('ispriv)) -> (FaultRecord, TTWState)

function AArch32_S1WalkSD (fault_in, regime, ss, va, ispriv) = {
    finalwalkstate : TTWState = undefined;
    s2acctype : AccType = undefined;
    s2aligned : bool = undefined;
    s2fault : FaultRecord = undefined;
    s2fs1walk : bool = undefined;
    s2walkaddress : AddressDescriptor = undefined;
    s2write : bool = undefined;
    fault : FaultRecord = fault_in;
    tlbcontext : TLBContext = undefined;
    if __tlb_enabled then {
        tlbcontext = AArch32_GetS1TLBContext(regime, ss, va);
        let tlbentry : TLBLine = S1TLBLookup(tlbcontext);
        if tlbentry.valid_name then {
            let finalwalkstate : TTWState = tlbentry.tlbrecord.walkstate;
            fault.level = finalwalkstate.level;
            return((fault, finalwalkstate))
        };
        ()
    };
    sctlr : bits(32) = undefined;
    ttbcr : bits(32) = undefined;
    ttbr0 : bits(64) = undefined;
    ttbr1 : bits(64) = undefined;
    if regime == Regime_EL30 then {
        sctlr = SCTLR_S;
        ttbcr = TTBCR_S;
        ttbr0 = TTBR0_S;
        ttbr1 = TTBR1_S
    } else if HaveAArch32EL(EL3) then {
        sctlr = SCTLR_NS_read();
        ttbcr = TTBCR_NS_read();
        ttbr0 = TTBR0_NS_read();
        ttbr1 = TTBR1_NS_read()
    } else {
        sctlr = SCTLR_read__2();
        ttbcr = TTBCR_read();
        ttbr0 = TTBR0_read();
        ttbr1 = TTBR1_read()
    };
    assert(Slice(ttbcr, 31, 1) == 0b0);
    let ee : bits(1) = Slice(sctlr, 25, 1);
    let afe : bits(1) = Slice(sctlr, 29, 1);
    let tre : bits(1) = Slice(sctlr, 28, 1);
    n : range(0, 7) = UInt(Slice(ttbcr, 0, 3));
    ttb : bits(32) = undefined;
    pd : bits(1) = undefined;
    irgn : bits(2) = undefined;
    rgn : bits(2) = undefined;
    s : bits(1) = undefined;
    nos : bits(1) = undefined;
    if n == 0 | is_zero_subrange(va, 31, 32 - n) then {
        ttb = Slice(ttbr0, 7, 25) @ Zeros(7);
        pd = Slice(ttbcr, 4, 1);
        irgn = Slice(ttbr0, 0, 1) @ Slice(ttbr0, 6, 1);
        rgn = Slice(ttbr0, 3, 2);
        s = Slice(ttbr0, 1, 1);
        nos = Slice(ttbr0, 5, 1)
    } else {
        n = 0;
        ttb = Slice(ttbr1, 7, 25) @ Zeros(7);
        pd = Slice(ttbcr, 5, 1);
        irgn = Slice(ttbr1, 6, 1) @ Slice(ttbr1, 0, 1);
        rgn = Slice(ttbr1, 3, 2);
        s = Slice(ttbr1, 1, 1);
        nos = Slice(ttbr1, 5, 1)
    };
    let 'n = n;
    if pd == 0b1 then {
        fault.level = 1;
        fault.statuscode = Fault_Translation;
        return((fault, __UNKNOWN_TTWState()))
    };
    baseaddress : FullAddress = undefined;
    baseaddress.paspace = if ss == SS_Secure then PAS_Secure else PAS_NonSecure;
    baseaddress.address = ZeroExtend(ttb[31 .. 14 - n] @ Zeros(14 - n));
    walkstate : TTWState = undefined;
    walkstate.baseaddress = baseaddress;
    walkstate.nG = 0b1;
    walkstate.memattrs = WalkMemAttrs(s @ nos, irgn, rgn);
    walkstate.level = 1;
    walkstate.istable = true;
    domain : bits(4) = undefined;
    descriptor : bits(32) = undefined;
    walkaddress : AddressDescriptor = undefined;
    walkaddress.vaddress = ZeroExtend(va);
    if not_bool(AArch32_S1DCacheEnabled(regime)) then {
        walkaddress.memattrs = NormalNCMemAttr();
        walkaddress.memattrs.xs = walkstate.memattrs.xs
    } else {
        walkaddress.memattrs = walkstate.memattrs
    };
    if ((regime == Regime_EL10 & AArch32_EL2Enabled(ss)) & (if ELStateUsingAArch32(EL2, ss == SS_Secure) then
      Slice(HCR_read(), 0, 1)
    else
      Slice(HCR_EL2, 0, 1)) == 0b1) & not_bool(__IMPDEF_boolean("Apply effective shareability at stage 1")) then {
        walkaddress.memattrs.shareability = walkstate.memattrs.shareability
    } else {
        walkaddress.memattrs.shareability = EffectiveShareability(walkaddress.memattrs)
    };
    nG : bits(1) = undefined;
    ns : bits(1) = undefined;
    pxn : bits(1) = undefined;
    ap : bits(3) = undefined;
    tex : bits(3) = undefined;
    c : bits(1) = undefined;
    b : bits(1) = undefined;
    xn : bits(1) = undefined;
    repeat {
        fault.level = walkstate.level;
        index : bits(32) = undefined;
        if walkstate.level == 1 then {
            index = ZeroExtend(va[31 - n .. 20] @ 0b00)
        } else {
            index = ZeroExtend(va[19 .. 12] @ 0b00)
        };
        walkaddress.paddress.address = walkstate.baseaddress.address | ZeroExtend(index);
        walkaddress.paddress.paspace = walkstate.baseaddress.paspace;
        if regime == Regime_EL10 & AArch32_EL2Enabled(ss) then {
            s2fs1walk = true;
            s2acctype = AccType_TTW;
            s2aligned = true;
            s2write = false;
            (s2fault, s2walkaddress) = AArch32_S2Translate(fault, walkaddress, ss, s2fs1walk, s2acctype, s2aligned, s2write, ispriv);
            if s2fault.statuscode != Fault_None then {
                return((s2fault, __UNKNOWN_TTWState()))
            };
            (fault, descriptor) = FetchDescriptor(32, ee, s2walkaddress, fault)
        } else {
            (fault, descriptor) = FetchDescriptor(32, ee, walkaddress, fault)
        };
        if fault.statuscode != Fault_None then {
            return((fault, __UNKNOWN_TTWState()))
        };
        walkstate.sdftype = AArch32_DecodeDescriptorTypeSD(descriptor, walkstate.level);
        match walkstate.sdftype {
          SDFType_Invalid => {
              fault.domain = domain;
              fault.statuscode = Fault_Translation;
              return((fault, __UNKNOWN_TTWState()))
          },
          SDFType_Table => {
              domain = descriptor[8 .. 5];
              ns = [descriptor[3]];
              pxn = [descriptor[2]];
              walkstate.baseaddress.address = ZeroExtend(descriptor[31 .. 10] @ Zeros(10));
              walkstate.level = 2
          },
          SDFType_SmallPage => {
              nG = [descriptor[11]];
              s = [descriptor[10]];
              ap = descriptor[9 .. 9] @ descriptor[5 .. 4];
              tex = descriptor[8 .. 6];
              c = [descriptor[3]];
              b = [descriptor[2]];
              xn = [descriptor[0]];
              walkstate.baseaddress.address = ZeroExtend(descriptor[31 .. 12] @ Zeros(12));
              walkstate.istable = false
          },
          SDFType_LargePage => {
              xn = [descriptor[15]];
              tex = descriptor[14 .. 12];
              nG = [descriptor[11]];
              s = [descriptor[10]];
              ap = descriptor[9 .. 9] @ descriptor[5 .. 4];
              c = [descriptor[3]];
              b = [descriptor[2]];
              walkstate.baseaddress.address = ZeroExtend(descriptor[31 .. 16] @ Zeros(16));
              walkstate.istable = false
          },
          SDFType_Section => {
              ns = [descriptor[19]];
              nG = [descriptor[17]];
              s = [descriptor[16]];
              ap = descriptor[15 .. 15] @ descriptor[11 .. 10];
              tex = descriptor[14 .. 12];
              domain = descriptor[8 .. 5];
              xn = [descriptor[4]];
              c = [descriptor[3]];
              b = [descriptor[2]];
              pxn = [descriptor[0]];
              walkstate.baseaddress.address = ZeroExtend(descriptor[31 .. 20] @ Zeros(20));
              walkstate.istable = false
          },
          SDFType_Supersection => {
              ns = [descriptor[19]];
              nG = [descriptor[17]];
              s = [descriptor[16]];
              ap = descriptor[15 .. 15] @ descriptor[11 .. 10];
              tex = descriptor[14 .. 12];
              xn = [descriptor[4]];
              c = [descriptor[3]];
              b = [descriptor[2]];
              pxn = [descriptor[0]];
              domain = 0b0000;
              walkstate.baseaddress.address = ZeroExtend((descriptor[8 .. 5] @ (descriptor[23 .. 20] @ descriptor[31 .. 24])) @ Zeros(24));
              walkstate.istable = false
          },
          _ => ()
        }
    } until walkstate.sdftype != SDFType_Table;
    if afe == 0b1 & [ap[0]] == 0b0 then {
        fault.domain = domain;
        fault.statuscode = Fault_AccessFlag;
        return((fault, __UNKNOWN_TTWState()))
    };
    if tre == 0b1 then {
        walkstate.memattrs = AArch32_RemappedTEXDecode(regime, tex, c, b, s)
    } else if RemapRegsHaveResetValues() then {
        walkstate.memattrs = AArch32_DefaultTEXDecode(tex, c, b, s)
    } else {
        walkstate.memattrs = __IMPDEF_MemoryAttributes("")
    };
    walkstate.permissions.ap = ap;
    walkstate.permissions.xn = xn;
    walkstate.permissions.pxn = pxn;
    walkstate.domain = domain;
    walkstate.nG = nG;
    if ss == SS_Secure & ns == 0b0 then {
        walkstate.baseaddress.paspace = PAS_Secure
    } else {
        walkstate.baseaddress.paspace = PAS_NonSecure
    };
    if __tlb_enabled then {
        tlbcontext.xs = walkstate.memattrs.xs;
        tlbcontext.nG = walkstate.nG;
        tlbrecord : TLBRecord = undefined;
        tlbrecord.context = tlbcontext;
        tlbrecord.walkstate = walkstate;
        tlbrecord.blocksize = AArch32_TranslationSizeSD(walkstate.sdftype);
        tlbrecord.contigsize = 0;
        S1TLBCache(tlbrecord)
    };
    return((fault, walkstate))
}

val AArch32_SDStageOA : (FullAddress, bits(32), SDFType) -> FullAddress

function AArch32_SDStageOA (baseaddress, va, sdftype) = {
    tsize : {|12, 16, 20, 24|} = 12;
    match sdftype {
      SDFType_SmallPage => {
          tsize = 12
      },
      SDFType_LargePage => {
          tsize = 16
      },
      SDFType_Section => {
          tsize = 20
      },
      SDFType_Supersection => {
          tsize = 24
      },
      _ => ()
    };
    let 'tsize = tsize;
    oa : FullAddress = undefined;
    oa.address = baseaddress.address[51 .. tsize] @ va[tsize - 1 .. 0];
    oa.paspace = baseaddress.paspace;
    return(oa)
}

let Domain_Client : bits(2) = 0b01

let Domain_NoAccess : bits(2) = 0b00

val AArch32_S1TranslateSD : forall ('aligned : Bool) ('ispriv : Bool) ('iswrite : Bool).
  (FaultRecord, Regime, SecurityState, bits(32), AccType, bool('aligned), bool('iswrite), bool('ispriv)) -> (FaultRecord, AddressDescriptor, SDFType)

function AArch32_S1TranslateSD (fault_in, regime, ss, va, acctype, aligned, iswrite, ispriv) = {
    ipa : AddressDescriptor = undefined;
    fault : FaultRecord = fault_in;
    fault.secondstage = false;
    fault.s2fs1walk = false;
    if not_bool(AArch32_S1Enabled(regime, ss)) then {
        ipa : AddressDescriptor = undefined;
        (fault, ipa) = AArch32_S1DisabledOutput(fault, regime, ss, va, acctype, aligned);
        return((fault, ipa, __UNKNOWN_SDFType()))
    };
    walkstate : TTWState = undefined;
    (fault, walkstate) = AArch32_S1WalkSD(fault, regime, ss, va, ispriv);
    if fault.statuscode != Fault_None then {
        return((fault, __UNKNOWN_AddressDescriptor(), __UNKNOWN_SDFType()))
    };
    let domain : bits(2) = AArch32_OutputDomain(regime, walkstate.domain);
    SetInGuardedPage(false);
    ntlsmd : bits(1) = undefined;
    if HaveTrapLoadStoreMultipleDeviceExt() then {
        match regime {
          Regime_EL30 => {
              ntlsmd = Slice(SCTLR_S, 3, 1)
          },
          Regime_EL10 => {
              ntlsmd = if HaveAArch32EL(EL3) then Slice(SCTLR_NS_read(), 3, 1)
              else
                Slice(SCTLR_read__2(), 3, 1)
          },
          _ => ()
        }
    } else {
        ntlsmd = 0b1
    };
    if AArch32_S1HasAlignmentFault(acctype, aligned, ntlsmd, walkstate.memattrs) then {
        fault.statuscode = Fault_Alignment
    } else if not_bool(acctype == AccType_IC | acctype == AccType_DC) & domain == Domain_NoAccess then {
        fault.statuscode = Fault_Domain
    } else if domain == Domain_Client then {
        if IsAtomicRW(acctype) then {
            if AArch32_S1SDHasPermissionsFault(regime, ss, walkstate.permissions, walkstate.memattrs.memtype, walkstate.baseaddress.paspace, ispriv, acctype, false) then {
                fault.statuscode = Fault_Permission;
                fault.write = false
            } else if AArch32_S1SDHasPermissionsFault(regime, ss, walkstate.permissions, walkstate.memattrs.memtype, walkstate.baseaddress.paspace, ispriv, acctype, true) then {
                fault.statuscode = Fault_Permission;
                fault.write = true
            } else ()
        } else if AArch32_S1SDHasPermissionsFault(regime, ss, walkstate.permissions, walkstate.memattrs.memtype, walkstate.baseaddress.paspace, ispriv, acctype, iswrite) then {
            fault.statuscode = Fault_Permission
        } else ()
    } else ();
    if fault.statuscode != Fault_None then {
        fault.domain = walkstate.domain;
        return((fault, __UNKNOWN_AddressDescriptor(), walkstate.sdftype))
    };
    memattrs : MemoryAttributes = undefined;
    if acctype == AccType_IFETCH & (walkstate.memattrs.memtype == MemType_Device | not_bool(AArch32_S1ICacheEnabled(regime))) | (acctype != AccType_IFETCH & walkstate.memattrs.memtype == MemType_Normal) & not_bool(AArch32_S1DCacheEnabled(regime)) then {
        memattrs = NormalNCMemAttr();
        memattrs.xs = walkstate.memattrs.xs
    } else {
        memattrs = walkstate.memattrs
    };
    if ((regime == Regime_EL10 & AArch32_EL2Enabled(ss)) & (if ELStateUsingAArch32(EL2, ss == SS_Secure) then
      Slice(HCR_read(), 0, 1)
    else
      Slice(HCR_EL2, 0, 1)) == 0b1) & not_bool(__IMPDEF_boolean("Apply effective shareability at stage 1")) then {
        memattrs.shareability = walkstate.memattrs.shareability
    } else {
        memattrs.shareability = EffectiveShareability(memattrs)
    };
    let oa : FullAddress = AArch32_SDStageOA(walkstate.baseaddress, va, walkstate.sdftype);
    let ipa : AddressDescriptor = CreateAddressDescriptor(ZeroExtend(va), oa, memattrs);
    return((fault, ipa, walkstate.sdftype))
}

val AArch64_PARFaultStatus : FaultRecord -> bits(6)

function AArch64_PARFaultStatus fault = {
    fst : bits(6) = undefined;
    if fault.statuscode == Fault_Domain then {
        assert(fault.level == 1 | fault.level == 2);
        fst[1 .. 0] = if fault.level == 1 then 0b01 else 0b10;
        fst[5 .. 2] = 0b1111
    } else {
        fst = EncodeLDFSC(fault.statuscode, fault.level)
    };
    return(fst)
}

val EncodePARAttrs : MemoryAttributes -> bits(8)

function EncodePARAttrs memattrs = {
    result : bits(8) = undefined;
    if HaveMTEExt() & memattrs.tagged then {
        result[7 .. 0] = 0b11110000;
        return(result)
    };
    if memattrs.memtype == MemType_Device then {
        result[7 .. 4] = 0b0000;
        if memattrs.device == DeviceType_nGnRnE then {
            result[3 .. 0] = 0b0000
        } else if memattrs.device == DeviceType_nGnRE then {
            result[3 .. 0] = 0b0100
        } else if memattrs.device == DeviceType_nGRE then {
            result[3 .. 0] = 0b1000
        } else {
            result[3 .. 0] = 0b1100
        }
    } else {
        if memattrs.outer.attrs == MemAttr_WT then {
            result[7 .. 6] = if memattrs.outer.transient then 0b00 else 0b10;
            result[5 .. 4] = memattrs.outer.hints
        } else if memattrs.outer.attrs == MemAttr_WB then {
            result[7 .. 6] = if memattrs.outer.transient then 0b01 else 0b11;
            result[5 .. 4] = memattrs.outer.hints
        } else {
            result[7 .. 4] = 0b0100
        };
        if memattrs.inner.attrs == MemAttr_WT then {
            result[3 .. 2] = if memattrs.inner.transient then 0b00 else 0b10;
            result[1 .. 0] = memattrs.inner.hints
        } else if memattrs.inner.attrs == MemAttr_WB then {
            result[3 .. 2] = if memattrs.inner.transient then 0b01 else 0b11;
            result[1 .. 0] = memattrs.inner.hints
        } else {
            result[3 .. 0] = 0b0100
        }
    };
    return(result)
}

val PAREncodeShareability : MemoryAttributes -> bits(2)

function PAREncodeShareability memattrs = {
    if memattrs.memtype == MemType_Device | memattrs.inner.attrs == MemAttr_NC & memattrs.outer.attrs == MemAttr_NC then {
        return(0b10)
    };
    match memattrs.shareability {
      Shareability_NSH => {
          return(0b00)
      },
      Shareability_ISH => {
          return(0b11)
      },
      Shareability_OSH => {
          return(0b10)
      },
      _ => {
          return(undefined : bits(2))
      }
    }
}

val ReportedPARAttrs : bits(8) -> bits(8)

val ReportedPARShareability : bits(2) -> bits(2)

val SecurityStateForRegime : Regime -> SecurityState

function SecurityStateForRegime regime = {
    match regime {
      Regime_EL3 => {
          return(SecurityStateAtEL(EL3))
      },
      Regime_EL30 => {
          return(SS_Secure)
      },
      Regime_EL2 => {
          return(SecurityStateAtEL(EL2))
      },
      Regime_EL20 => {
          return(SecurityStateAtEL(EL2))
      },
      Regime_EL10 => {
          return(SecurityStateAtEL(EL1))
      },
      _ => {
          return(undefined : SecurityState)
      }
    }
}

val AArch64_EncodePAR : forall ('is_ATS1Ex : Bool).
  (Regime, bool('is_ATS1Ex), AddressDescriptor) -> unit

function AArch64_EncodePAR (regime, is_ATS1Ex, addrdesc) = {
    PAR_EL1 = Zeros();
    let paspace : PASpace = addrdesc.paddress.paspace;
    if not_bool(IsFault(addrdesc)) then {
        PAR_EL1 = SetSlice(1, PAR_EL1, 0, 0b0);
        if HaveRME() then {
            if regime == Regime_EL3 then {
                match paspace {
                  PAS_Secure => {
                      (PAR_EL1[11 .. 11] @ PAR_EL1[9 .. 9]) = 0b00
                  },
                  PAS_NonSecure => {
                      (PAR_EL1[11 .. 11] @ PAR_EL1[9 .. 9]) = 0b01
                  },
                  PAS_Root => {
                      (PAR_EL1[11 .. 11] @ PAR_EL1[9 .. 9]) = 0b10
                  },
                  PAS_Realm => {
                      (PAR_EL1[11 .. 11] @ PAR_EL1[9 .. 9]) = 0b11
                  }
                }
            } else if SecurityStateForRegime(regime) == SS_Secure then {
                PAR_EL1 = SetSlice(1, PAR_EL1, 11, __UNKNOWN_bits(1));
                PAR_EL1 = SetSlice(1, PAR_EL1, 9, if paspace == PAS_Secure then
                  0b0
                else
                  0b1)
            } else if SecurityStateForRegime(regime) == SS_Realm then {
                if regime == Regime_EL10 & is_ATS1Ex then {
                    PAR_EL1 = SetSlice(1, PAR_EL1, 11, __UNKNOWN_bits(1));
                    PAR_EL1 = SetSlice(1, PAR_EL1, 9, __UNKNOWN_bits(1))
                } else {
                    PAR_EL1 = SetSlice(1, PAR_EL1, 11, __UNKNOWN_bits(1));
                    PAR_EL1 = SetSlice(1, PAR_EL1, 9, if paspace == PAS_Realm then
                      0b0
                    else
                      0b1)
                }
            } else {
                PAR_EL1 = SetSlice(1, PAR_EL1, 11, __UNKNOWN_bits(1));
                PAR_EL1 = SetSlice(1, PAR_EL1, 9, __UNKNOWN_bits(1))
            }
        } else {
            PAR_EL1[11 .. 11] = 0b1;
            if SecurityStateForRegime(regime) == SS_Secure then {
                PAR_EL1 = SetSlice(1, PAR_EL1, 9, if paspace == PAS_Secure then
                  0b0
                else
                  0b1)
            } else {
                PAR_EL1 = SetSlice(1, PAR_EL1, 9, __UNKNOWN_bits(1))
            }
        };
        PAR_EL1 = SetSlice(2, PAR_EL1, 7, ReportedPARShareability(PAREncodeShareability(addrdesc.memattrs)));
        (PAR_EL1[51 .. 48] @ PAR_EL1[47 .. 12]) = addrdesc.paddress.address[52 - 1 .. 12];
        PAR_EL1 = SetSlice(8, PAR_EL1, 56, ReportedPARAttrs(EncodePARAttrs(addrdesc.memattrs)));
        PAR_EL1[10 .. 10] = __IMPDEF_bits(1, "Non-Faulting PAR")
    } else {
        PAR_EL1 = SetSlice(1, PAR_EL1, 0, 0b1);
        PAR_EL1 = SetSlice(6, PAR_EL1, 1, AArch64_PARFaultStatus(addrdesc.fault));
        PAR_EL1 = SetSlice(1, PAR_EL1, 8, if addrdesc.fault.s2fs1walk then 0b1
        else
          0b0);
        PAR_EL1 = SetSlice(1, PAR_EL1, 9, if addrdesc.fault.secondstage then 0b1
        else
          0b0);
        PAR_EL1[11 .. 11] = 0b1;
        PAR_EL1[63 .. 48] = __IMPDEF_bits(16, "Faulting PAR")
    };
    return()
}

enum ATAccess = {
  ATAccess_Read,
  ATAccess_Write,
  ATAccess_ReadPAN,
  ATAccess_WritePAN
}

enum TranslationStage = {TranslationStage_1, TranslationStage_12}

val AArch64_AT : (bits(64), TranslationStage, bits(2), ATAccess) -> unit

function AArch64_AT (address, stage_in, el_in, ataccess) = {
    s1aarch64 : bool = undefined;
    s2fs1walk : bool = undefined;
    stage : TranslationStage = stage_in;
    el : bits(2) = el_in;
    if ((HaveRME() & PSTATE.EL == EL3) & (Slice(SCR_EL3, 62, 1) @ Slice(SCR_EL3, 0, 1)) == 0b10) & el != EL3 then {
        throw(Error_Undefined())
    };
    if ((Slice(HCR_EL2, 34, 1) @ Slice(HCR_EL2, 27, 1)) == 0b11 & el == EL1) & stage == TranslationStage_1 then {
        el = EL2
    };
    if (HaveEL(EL3) & stage == TranslationStage_12) & not_bool(EL2Enabled()) then {
        stage = TranslationStage_1
    };
    let acctype : AccType = if ataccess == ATAccess_Read | ataccess == ATAccess_Write then
      AccType_AT
    else
      AccType_ATPAN;
    let iswrite : bool = ataccess == ATAccess_WritePAN | ataccess == ATAccess_Write;
    let aligned : bool = true;
    let ispriv : bool = el != EL0;
    fault : FaultRecord = NoFault();
    fault.acctype = acctype;
    fault.write = iswrite;
    regime : Regime = undefined;
    if stage == TranslationStage_12 then {
        regime = Regime_EL10
    } else {
        regime = TranslationRegime(el, acctype)
    };
    addrdesc : AddressDescriptor = undefined;
    let ss : SecurityState = SecurityStateAtEL(el);
    if el == EL0 & ELUsingAArch32(EL1) | el != EL0 & ELUsingAArch32(el) then {
        if regime == Regime_EL2 | Slice(TTBCR_read(), 31, 1) == 0b1 then {
            (fault, addrdesc) = AArch32_S1TranslateLD(fault, regime, ss, address[31 .. 0], acctype, aligned, iswrite, ispriv)
        } else {
            let (__tup_0 : FaultRecord, __tup_1 : AddressDescriptor, _) = AArch32_S1TranslateSD(fault, regime, ss, address[31 .. 0], acctype, aligned, iswrite, ispriv);
            fault = __tup_0;
            addrdesc = __tup_1
        }
    } else {
        (fault, addrdesc) = AArch64_S1Translate(fault, regime, ss, address, acctype, aligned, iswrite, ispriv)
    };
    if stage == TranslationStage_12 & fault.statuscode == Fault_None then {
        if (ELUsingAArch32(EL1) & regime == Regime_EL10) & EL2Enabled() then {
            addrdesc.vaddress = ZeroExtend(address);
            let s2fs1walk : bool = false;
            (fault, addrdesc) = AArch32_S2Translate(fault, addrdesc, ss, s2fs1walk, acctype, aligned, iswrite, ispriv)
        } else if regime == Regime_EL10 & EL2Enabled() then {
            let s1aarch64 : bool = true;
            let s2fs1walk : bool = false;
            (fault, addrdesc) = AArch64_S2Translate(fault, addrdesc, s1aarch64, ss, s2fs1walk, acctype, aligned, iswrite, ispriv)
        } else ()
    };
    let is_ATS1Ex : bool = stage != TranslationStage_12;
    if fault.statuscode != Fault_None then {
        addrdesc = CreateFaultyAddressDescriptor(address, fault);
        if (IsExternalAbort__1(fault) | PSTATE.EL == EL1 & fault.s2fs1walk) | (HaveRME() & fault.gpcf.gpf != GPCF_None) & (ReportAsGPCException(fault) | ((Slice(HCR_EL2, 48, 1) == 0b1 & PSTATE.EL == EL1) & (el == EL1 | el == EL0)) & is_ATS1Ex) then {
            PAR_EL1 = __UNKNOWN_bits(64);
            AArch64_Abort(address, addrdesc.fault)
        };
        ()
    };
    let addrdesc = addrdesc;
    AArch64_EncodePAR(regime, is_ATS1Ex, addrdesc);
    return()
}

val AT_S12E0R_SysOpsWrite_0c5b1bd4a1d08392 : forall 't.
  (bits(2), bits(2), bits(3), bits(4), bits(3), bits(4), int('t)) -> unit

function AT_S12E0R_SysOpsWrite_0c5b1bd4a1d08392 (el, op0, op1, CRn, op2, CRm, t) = {
    let __PSTATE_EL : bits(2) = PSTATE.EL;
    let __HCR_EL2_NV : bits(1) = Slice(HCR_EL2, 42, 1);
    if __PSTATE_EL == EL0 then {
        throw(Error_Undefined())
    } else if __PSTATE_EL == EL1 then {
        if EL2Enabled() & __HCR_EL2_NV == 0b1 then {
            AArch64_SystemAccessTrap(EL2, UInt(0x18))
        } else {
            throw(Error_Undefined())
        }
    } else if __PSTATE_EL == EL2 then {
        if (Slice(HCR_EL2, 34, 1) @ Slice(HCR_EL2, 27, 1)) == 0b11 | (Slice(HCR_EL2, 12, 1) @ Slice(HCR_EL2, 0, 1)) == 0b00 then {
            AArch64_AT(X_read__1(t, 64), TranslationStage_1, EL0, ATAccess_Read)
        } else {
            AArch64_AT(X_read__1(t, 64), TranslationStage_12, EL0, ATAccess_Read)
        }
    } else if __PSTATE_EL == EL3 then {
        if not_bool(EL2Enabled()) then {
            AArch64_AT(X_read__1(t, 64), TranslationStage_1, EL0, ATAccess_Read)
        } else if EL2Enabled() & ((Slice(HCR_EL2, 34, 1) @ Slice(HCR_EL2, 27, 1)) == 0b11 | (Slice(HCR_EL2, 12, 1) @ Slice(HCR_EL2, 0, 1)) == 0b00) then {
            AArch64_AT(X_read__1(t, 64), TranslationStage_1, EL0, ATAccess_Read)
        } else {
            AArch64_AT(X_read__1(t, 64), TranslationStage_12, EL0, ATAccess_Read)
        }
    } else ()
}

