val SP_read : forall 'width,
  'width in {8, 16, 32, 64}.
  implicit('width) -> bits('width)

val SP_read__1 : unit -> bits(32)

function SP_read width = {
    assert(width == 8 | width == 16 | width == 32 | width == 64);
    if PSTATE.SP == 0b0 then {
        return(SP_EL0[width - 1 .. 0])
    } else {
        match PSTATE.EL {
          ? if ? == EL0 => {
              return(SP_EL0[width - 1 .. 0])
          },
          ? if ? == EL1 => {
              return(SP_EL1[width - 1 .. 0])
          },
          ? if ? == EL2 => {
              return(SP_EL2[width - 1 .. 0])
          },
          ? if ? == EL3 => {
              return(SP_EL3[width - 1 .. 0])
          },
          _ => {
              return(undefined : bits('width))
          }
        }
    }
}

function SP_read__1 () = {
    return(R_read(13))
}

val V_read : forall 'n 'width,
  'width in {8, 16, 32, 64, 128}.
  (implicit('width), int('n)) -> bits('width)

function V_read (width, n) = {
    assert(n >= 0 & n <= 31);
    assert(width == 8 | width == 16 | width == 32 | width == 64 | width == 128);
    return(_Z[n][width - 1 .. 0])
}

val Vpart_read : forall 'n 'part 'width,
  ('width == 8 | 'width == 16 | 'width == 32 | 'width == 64 | 'width == 128 | not('width < 128) | not('part == 0) | not('part in {0, 1}) | not(('n >= 0 & 'n <= 31))).
  (implicit('width), int('n), int('part)) -> bits('width)

function Vpart_read (width, n, part) = {
    assert(n >= 0 & n <= 31);
    assert(part == 0 | part == 1);
    if part == 0 then {
        assert(width < 128);
        return(V_read(width, n))
    } else {
        assert(width == 32 | width == 64);
        let vreg : bits(128) = V_read(128, n);
        return(vreg[width * 2 - 1 .. width])
    }
}

val Vpart_set : forall 'n 'part 'width,
  ('width == 8 | 'width == 16 | 'width == 32 | 'width == 64 | 'width == 128 | not('width < 128) | not('part == 0) | not('part in {0, 1}) | not(('n >= 0 & 'n <= 31))).
  (implicit('width), int('n), int('part), bits('width)) -> unit

function Vpart_set (width, n, part, value_name) = {
    assert(n >= 0 & n <= 31);
    assert(part == 0 | part == 1);
    if part == 0 then {
        assert(width < 128);
        V_set(width, n) = value_name
    } else {
        assert(width == 64);
        let vreg : bits(64) = V_read(64, n);
        V_set(0 + (63 - 0 + 1) + 64, n) = value_name[63 .. 0] @ vreg
    }
}

val AArch64_ResetGeneralRegisters : unit -> unit

function AArch64_ResetGeneralRegisters () = {
    foreach (i from 0 to 30 by 1 in inc) {
        X_set(64, i) = __UNKNOWN_bits(64)
    };
    return()
}

val AArch64_ResetSIMDFPRegisters : unit -> unit

function AArch64_ResetSIMDFPRegisters () = {
    foreach (i from 0 to 31 by 1 in inc) {
        V_set(128, i) = __UNKNOWN_bits(128)
    };
    return()
}

val AArch64_ResetSpecialRegisters : unit -> unit

function AArch64_ResetSpecialRegisters () = {
    SP_EL0 = __UNKNOWN_bits(64);
    SP_EL1 = __UNKNOWN_bits(64);
    SPSR_EL1 = __UNKNOWN_bits(64);
    ELR_EL1 = __UNKNOWN_bits(64);
    if HaveEL(EL2) then {
        SP_EL2 = __UNKNOWN_bits(64);
        SPSR_EL2 = __UNKNOWN_bits(64);
        ELR_EL2 = __UNKNOWN_bits(64)
    };
    if HaveEL(EL3) then {
        SP_EL3 = __UNKNOWN_bits(64);
        SPSR_EL3 = __UNKNOWN_bits(64);
        ELR_EL3 = __UNKNOWN_bits(64)
    };
    if HaveAArch32EL(EL1) then {
        SPSR_fiq[31 .. 0] = __UNKNOWN_bits(32);
        SPSR_irq[31 .. 0] = __UNKNOWN_bits(32);
        SPSR_abt[31 .. 0] = __UNKNOWN_bits(32);
        SPSR_und[31 .. 0] = __UNKNOWN_bits(32)
    };
    DLR_EL0 = __UNKNOWN_bits(64);
    DSPSR_EL0 = __UNKNOWN_bits(64);
    return()
}

val FAR_read : bits(2) -> bits(64)

val FAR_read__1 : unit -> bits(64)

function FAR_read regime = {
    r : bits(64) = undefined;
    match regime {
      ? if ? == EL1 => {
          r = FAR_EL1
      },
      ? if ? == EL2 => {
          r = FAR_EL2
      },
      ? if ? == EL3 => {
          r = FAR_EL3
      },
      _ => {
          Unreachable()
      }
    };
    return(r)
}

function FAR_read__1 () = {
    return(FAR_read(S1TranslationRegime__1()))
}

val ELR_read : bits(2) -> bits(64)

val ELR_read__1 : unit -> bits(64)

function ELR_read el = {
    r : bits(64) = undefined;
    match el {
      ? if ? == EL1 => {
          r = ELR_EL1
      },
      ? if ? == EL2 => {
          r = ELR_EL2
      },
      ? if ? == EL3 => {
          r = ELR_EL3
      },
      _ => {
          Unreachable()
      }
    };
    return(r)
}

function ELR_read__1 () = {
    assert(PSTATE.EL != EL0);
    return(ELR_read(PSTATE.EL))
}

val ESR_read : bits(2) -> bits(64)

val ESR_read__1 : unit -> bits(64)

function ESR_read regime = {
    r : bits(64) = undefined;
    match regime {
      ? if ? == EL1 => {
          r = ESR_EL1
      },
      ? if ? == EL2 => {
          r = ESR_EL2
      },
      ? if ? == EL3 => {
          r = ESR_EL3
      },
      _ => {
          Unreachable()
      }
    };
    return(r)
}

function ESR_read__1 () = {
    return(ESR_read(S1TranslationRegime__1()))
}

val CheckTransactionalSystemAccess : (bits(2), bits(3), bits(4), bits(4), bits(3), bits(1)) -> bool

function CheckTransactionalSystemAccess (op0, op1, crn, crm, op2, read) = {
    match ((((read @ op0) @ op1) @ crn) @ crm) @ op2 {
      [bitzero, bitzero, bitzero, bitzero, bitone, bitone, bitzero, bitone, bitzero, bitzero, _, _, _, _, bitone, bitone, _] => {
          return(true)
      },
      0b00101101110100001 => {
          return(true)
      },
      [bitzero, bitone, bitone, bitzero, bitone, bitone, bitzero, bitone, bitzero, bitzero, bitzero, bitzero, bitone, bitzero, bitzero, bitzero, _] => {
          return(true)
      },
      [bitzero, bitone, bitone, bitzero, bitone, bitone, bitzero, bitone, bitzero, bitzero, bitzero, bitone, bitzero, bitzero, bitzero, bitzero, _] => {
          return(true)
      },
      0b01100001000110000 => {
          return(true)
      },
      0b01101110011100100 => {
          return(true)
      },
      [bitone, bitone, bitone, _, _, _, bitzero, _, _, _, _, _, _, _, _, _, _] => {
          return(true)
      },
      [bitone, bitone, bitone, _, _, _, bitone, bitzero, bitzero, _, _, _, _, _, _, _, _] => {
          return(true)
      },
      [bitone, bitone, bitone, _, _, _, bitone, bitzero, bitone, bitzero, _, _, _, _, _, _, _] => {
          return(true)
      },
      [bitone, bitone, bitone, bitzero, bitzero, bitzero, bitone, bitone, bitzero, bitzero, bitone, _, bitzero, bitzero, bitzero, bitone, bitzero] => {
          return(true)
      },
      0b11100011001011011 => {
          return(true)
      },
      [bitone, bitone, bitone, _, _, _, bitone, bitone, bitzero, bitone, _, _, _, _, _, _, _] => {
          return(true)
      },
      [bitone, bitone, bitone, _, _, _, bitone, bitone, bitone, bitzero, _, _, _, _, _, _, _] => {
          return(true)
      },
      0b00101101110011111 => {
          return(true)
      },
      [bitzero, bitzero, bitone, bitzero, bitone, bitone, bitzero, bitone, bitone, bitone, bitzero, bitzero, bitone, bitone, bitone, bitzero, _] => {
          return(true)
      },
      [_, bitone, bitone, _, _, _, bitone, _, bitone, bitone, _, _, _, _, _, _, _] => {
          return(__IMPDEF_boolean(""))
      },
      _ => {
          return(false)
      }
    }
}

val AArch64_CheckSystemAccess : (bits(2), bits(3), bits(4), bits(4), bits(3), bits(5), bits(1)) -> unit

function AArch64_CheckSystemAccess (op0, op1, crn, crm, op2, rt, read) = {
    if HaveBTIExt() then {
        BranchTargetCheck()
    };
    if TSTATE.depth > 0 & not_bool(CheckTransactionalSystemAccess(op0, op1, crn, crm, op2, read)) then {
        FailTransaction(TMFailure_ERR, false)
    };
    return()
}

val BTypeCompatible_BTI : bits(2) -> bool

function BTypeCompatible_BTI hintcode = {
    match hintcode {
      0b00 => {
          return(false)
      },
      0b01 => {
          return(PSTATE.BTYPE != 0b11)
      },
      0b10 => {
          return(PSTATE.BTYPE != 0b10)
      },
      0b11 => {
          return(true)
      },
      _ => {
          return(undefined : bool)
      }
    }
}

val BTypeCompatible_PACIXSP : unit -> bool

function BTypeCompatible_PACIXSP () = {
    index : int = undefined;
    if PSTATE.BTYPE == 0b01 | PSTATE.BTYPE == 0b10 then {
        return(true)
    } else if PSTATE.BTYPE == 0b11 then {
        let 'index = if PSTATE.EL == EL0 then 35 else 36;
        return([SCTLR_read__1()[index]] == 0b0)
    } else {
        return(false)
    }
}

val SetBTypeCompatible : forall ('x : Bool). bool('x) -> unit

function SetBTypeCompatible x = {
    BTypeCompatible = x
}

val SetBTypeNext : bits(2) -> unit

function SetBTypeNext x = {
    BTypeNext = x
}

val AArch64_NextRandomTagBit : unit -> bits(1)

function AArch64_NextRandomTagBit () = {
    let lfsr : bits(16) = Slice(RGSR_EL1, 8, 16);
    let top : bits(1) = EOR(EOR(EOR([lfsr[5]], [lfsr[3]]), [lfsr[2]]), [lfsr[0]]);
    RGSR_EL1 = SetSlice(16, RGSR_EL1, 8, top @ lfsr[15 .. 1]);
    return(top)
}

val AArch64_RandomTag : unit -> bits(4)

function AArch64_RandomTag () = {
    tag : bits(4) = undefined;
    foreach (i from 0 to 3 by 1 in inc) {
        tag[i] = Bit(AArch64_NextRandomTagBit())
    };
    return(tag)
}

val AArch64_ChooseNonExcludedTag : (bits(4), bits(4), bits(16)) -> bits(4)

function AArch64_ChooseNonExcludedTag (tag_in, offset_in, exclude) = {
    tag : bits(4) = tag_in;
    offset : bits(4) = offset_in;
    if IsOnes(exclude) then {
        return(0b0000)
    };
    if offset == 0b0000 then {
        while [exclude[UInt(tag)]] == 0b1 do {
            tag = tag + 0b0001
        }
    };
    while offset != 0b0000 do {
        offset = offset - 0b0001;
        tag = tag + 0b0001;
        while [exclude[UInt(tag)]] == 0b1 do {
            tag = tag + 0b0001
        }
    };
    return(tag)
}

val ChooseRandomNonExcludedTag : bits(16) -> bits(4)

val AArch64_SPAlignmentFault : unit -> unit

function AArch64_SPAlignmentFault () = {
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    let exception : ExceptionRecord = ExceptionSyndrome(Exception_SPAlignment);
    target_el : bits(2) = EL1;
    if UInt(PSTATE.EL) > UInt(EL1) then {
        target_el = PSTATE.EL
    } else if EL2Enabled() & Slice(HCR_EL2, 27, 1) == 0b1 then {
        target_el = EL2
    } else ();
    AArch64_TakeException(target_el, exception, preferred_exception_return, vect_offset)
}

val CheckSPAlignment : unit -> unit

function CheckSPAlignment () = {
    let sp : bits(64) = SP_read(64);
    stack_align_check : bool = undefined;
    if PSTATE.EL == EL0 then {
        stack_align_check = [SCTLR_read__1()[4]] != 0b0
    } else {
        stack_align_check = [SCTLR_read__1()[3]] != 0b0
    };
    if stack_align_check & sp != Align(sp, 16) then {
        AArch64_SPAlignmentFault()
    };
    return()
}

val AArch64_TranslateAddressForAtomicAccess : forall 'sizeinbits.
  (bits(64), int('sizeinbits)) -> AddressDescriptor

function AArch64_TranslateAddressForAtomicAccess (address, sizeinbits) = {
    accdesc : AccessDescriptor = undefined;
    let iswrite : bool = false;
    let 'size = DIV(sizeinbits, 8);
    assert(size == 1 | size == 2 | size == 4 | size == 8 | size == 16);
    let aligned : bool = AArch64_CheckAlignment(address, size, AccType_ATOMICRW, iswrite);
    let memaddrdesc : AddressDescriptor = AArch64_TranslateAddress(address, AccType_ATOMICRW, iswrite, aligned, size);
    if IsFault(memaddrdesc) then {
        AArch64_Abort(address, memaddrdesc.fault)
    };
    if memaddrdesc.memattrs.shareability != Shareability_NSH then {
        ClearExclusiveByAddress(memaddrdesc.paddress, ProcessorID(), size)
    };
    if HaveMTE2Ext() & AArch64_AccessIsTagChecked(address, AccType_ATOMICRW) then {
        let ptag : bits(4) = AArch64_PhysicalTag(address);
        let accdesc : AccessDescriptor = CreateAccessDescriptor(AccType_ATOMICRW);
        if not_bool(AArch64_CheckTag(memaddrdesc, accdesc, ptag, iswrite)) then {
            AArch64_TagCheckFault(address, AccType_ATOMICRW, iswrite)
        };
        ()
    };
    return(memaddrdesc)
}

val MemAtomicCompareAndSwap : forall 'size, 'size in {8, 16, 32, 64, 128}.
  (bits(64), bits('size), bits('size), AccType, AccType) -> bits('size)

function MemAtomicCompareAndSwap (address, expectedvalue, newvalue_in, ldacctype, stacctype) = {
    fault : FaultRecord = undefined;
    memstatus : PhysMemRetStatus = undefined;
    oldvalue : bits(8 * div('size, 8)) = undefined;
    newvalue : bits('size) = newvalue_in;
    let memaddrdesc : AddressDescriptor = AArch64_TranslateAddressForAtomicAccess(address, 'size);
    let ldaccdesc : AccessDescriptor = CreateAccessDescriptor(ldacctype);
    let staccdesc : AccessDescriptor = CreateAccessDescriptor(stacctype);
    if HaveRME() then {
        fault : FaultRecord = NoFault();
        fault.gpcf = GranuleProtectionCheck(memaddrdesc, ldaccdesc);
        if fault.gpcf.gpf != GPCF_None then {
            fault.statuscode = Fault_GPCFOnOutput;
            fault.paddress = memaddrdesc.paddress;
            fault.acctype = ldacctype;
            fault.write = __UNKNOWN_boolean();
            AArch64_Abort(address, fault)
        };
        ()
    };
    let fault = fault;
    (memstatus, oldvalue) = PhysMemRead(memaddrdesc, DIV('size, 8), ldaccdesc);
    if IsFault__2(memstatus) then {
        HandleExternalReadAbort(memstatus, memaddrdesc, DIV('size, 8), ldaccdesc)
    };
    if BigEndian(ldacctype) then {
        oldvalue = BigEndianReverse(oldvalue)
    };
    let oldvalue = oldvalue;
    if oldvalue == expectedvalue then {
        if BigEndian(stacctype) then {
            newvalue = BigEndianReverse(newvalue)
        };
        let memstatus : PhysMemRetStatus = PhysMemWrite(memaddrdesc, DIV('size, 8), staccdesc, newvalue);
        if IsFault__2(memstatus) then {
            HandleExternalWriteAbort(memstatus, memaddrdesc, DIV('size, 8), staccdesc)
        };
        ()
    };
    return(oldvalue)
}

val MemAtomic : forall 'size, 'size in {8, 16, 32, 64, 128}.
  (bits(64), MemAtomicOp, bits('size), AccType, AccType) -> bits('size)

function MemAtomic (address, op, value_name, ldacctype, stacctype) = {
    fault : FaultRecord = undefined;
    memstatus : PhysMemRetStatus = undefined;
    oldvalue : bits(8 * div('size, 8)) = undefined;
    newvalue : bits('size) = undefined;
    let memaddrdesc : AddressDescriptor = AArch64_TranslateAddressForAtomicAccess(address, 'size);
    let ldaccdesc : AccessDescriptor = CreateAccessDescriptor(ldacctype);
    let staccdesc : AccessDescriptor = CreateAccessDescriptor(stacctype);
    if HaveRME() then {
        fault : FaultRecord = NoFault();
        fault.gpcf = GranuleProtectionCheck(memaddrdesc, ldaccdesc);
        if fault.gpcf.gpf != GPCF_None then {
            fault.statuscode = Fault_GPCFOnOutput;
            fault.paddress = memaddrdesc.paddress;
            fault.acctype = ldacctype;
            fault.write = __UNKNOWN_boolean();
            AArch64_Abort(address, fault)
        };
        ()
    };
    let fault = fault;
    (memstatus, oldvalue) = PhysMemRead(memaddrdesc, DIV('size, 8), ldaccdesc);
    if IsFault__2(memstatus) then {
        HandleExternalReadAbort(memstatus, memaddrdesc, DIV('size, 8), ldaccdesc)
    };
    if BigEndian(ldacctype) then {
        oldvalue = BigEndianReverse(oldvalue)
    };
    let oldvalue = oldvalue;
    match op {
      MemAtomicOp_ADD => {
          newvalue = oldvalue + value_name
      },
      MemAtomicOp_BIC => {
          newvalue = oldvalue & not_vec(value_name)
      },
      MemAtomicOp_EOR => {
          newvalue = EOR(oldvalue, value_name)
      },
      MemAtomicOp_ORR => {
          newvalue = oldvalue | value_name
      },
      MemAtomicOp_SMAX => {
          newvalue = if SInt(oldvalue) > SInt(value_name) then oldvalue else
            value_name
      },
      MemAtomicOp_SMIN => {
          newvalue = if SInt(oldvalue) > SInt(value_name) then value_name else
            oldvalue
      },
      MemAtomicOp_UMAX => {
          newvalue = if UInt(oldvalue) > UInt(value_name) then oldvalue else
            value_name
      },
      MemAtomicOp_UMIN => {
          newvalue = if UInt(oldvalue) > UInt(value_name) then value_name else
            oldvalue
      },
      MemAtomicOp_SWP => {
          newvalue = value_name
      }
    };
    if BigEndian(stacctype) then {
        newvalue = BigEndianReverse(newvalue)
    };
    let memstatus : PhysMemRetStatus = PhysMemWrite(memaddrdesc, DIV('size, 8), staccdesc, newvalue);
    if IsFault__2(memstatus) then {
        HandleExternalWriteAbort(memstatus, memaddrdesc, DIV('size, 8), staccdesc)
    };
    return(oldvalue)
}

val SetTagCheckedInstruction : forall ('checked : Bool). bool('checked) -> unit

val AArch64_AddressWithAllocationTag : (bits(64), AccType, bits(4)) -> bits(64)

function AArch64_AddressWithAllocationTag (address, acctype, allocation_tag) = {
    result : bits(64) = address;
    tag : bits(4) = undefined;
    if AArch64_AllocationTagAccessIsEnabled(acctype) then {
        tag = allocation_tag
    } else {
        tag = 0b0000
    };
    result[59 .. 56] = tag;
    return(result)
}

val AArch64_MemTag_read : (bits(64), AccType) -> bits(4)

function AArch64_MemTag_read (address, acctype) = {
    fault : FaultRecord = undefined;
    memstatus : PhysMemRetStatus = undefined;
    tag : bits(4) = undefined;
    value_name : bits(4) = undefined;
    let iswrite : bool = false;
    let aligned : bool = true;
    let memaddrdesc : AddressDescriptor = AArch64_TranslateAddress(address, acctype, iswrite, aligned, TAG_GRANULE);
    accdesc : AccessDescriptor = CreateAccessDescriptor(acctype);
    if IsFault(memaddrdesc) then {
        AArch64_Abort(address, memaddrdesc.fault)
    };
    if AArch64_AllocationTagAccessIsEnabled(acctype) & memaddrdesc.memattrs.tagged then {
        if HaveRME() then {
            fault : FaultRecord = NoFault();
            accdesc = CreateAccessDescriptor(acctype);
            fault.gpcf = GranuleProtectionCheck(memaddrdesc, accdesc);
            if fault.gpcf.gpf != GPCF_None then {
                fault.statuscode = Fault_GPCFOnOutput;
                fault.paddress = memaddrdesc.paddress;
                fault.acctype = acctype;
                fault.write = false;
                AArch64_Abort(address, fault)
            };
            ()
        };
        (memstatus, tag) = PhysMemTagRead(memaddrdesc, accdesc);
        if IsFault__2(memstatus) then {
            HandleExternalReadAbort(memstatus, memaddrdesc, 1, accdesc)
        };
        return(tag)
    } else {
        return(0b0000)
    }
}

val AddressSupportsLS64 : bits(64) -> bool

val AArch64_ExclusiveFault : forall ('iswrite : Bool) ('s2fs1walk : Bool) ('secondstage : Bool).
  (AccType, bool('iswrite), bool('secondstage), bool('s2fs1walk)) -> FaultRecord

function AArch64_ExclusiveFault (acctype, iswrite, secondstage, s2fs1walk) = {
    fault : FaultRecord = undefined;
    fault.statuscode = Fault_Exclusive;
    fault.acctype = acctype;
    fault.write = iswrite;
    fault.secondstage = secondstage;
    fault.s2fs1walk = s2fs1walk;
    return(fault)
}

val MemStore64BWithRet : (bits(64), bits(512), AccType) -> bits(64)

function MemStore64BWithRet (address, value_name, acctype) = {
    fault : FaultRecord = undefined;
    let iswrite : bool = true;
    let 'size = 64;
    let aligned : bool = AArch64_CheckAlignment(address, size, acctype, iswrite);
    let memaddrdesc : AddressDescriptor = AArch64_TranslateAddress(address, acctype, iswrite, aligned, size);
    if IsFault(memaddrdesc) then {
        AArch64_Abort(address, memaddrdesc.fault);
        return(ZeroExtend(0b1))
    };
    if memaddrdesc.memattrs.shareability != Shareability_NSH then {
        ClearExclusiveByAddress(memaddrdesc.paddress, ProcessorID(), 64)
    };
    accdesc : AccessDescriptor = CreateAccessDescriptor(acctype);
    if HaveTME() then {
        accdesc.transactional = TSTATE.depth > 0
    };
    if HaveRME() then {
        fault : FaultRecord = NoFault();
        fault.gpcf = GranuleProtectionCheck(memaddrdesc, accdesc);
        if fault.gpcf.gpf != GPCF_None then {
            fault.statuscode = Fault_GPCFOnOutput;
            fault.paddress = memaddrdesc.paddress;
            fault.acctype = acctype;
            fault.write = iswrite;
            AArch64_Abort(address, fault)
        };
        ()
    };
    let fault = fault;
    if HaveMTE2Ext() then {
        if AArch64_AccessIsTagChecked(ZeroExtend(address, 64), acctype) then {
            let ptag : bits(4) = AArch64_PhysicalTag(ZeroExtend(address, 64));
            if not_bool(AArch64_CheckTag(memaddrdesc, accdesc, ptag, iswrite)) then {
                AArch64_TagCheckFault(address, acctype, iswrite);
                return(ZeroExtend(0b1))
            };
            ()
        };
        ()
    };
    let memstatus : PhysMemRetStatus = PhysMemWrite(memaddrdesc, size, accdesc, value_name);
    if IsFault__2(memstatus) then {
        HandleExternalWriteAbort(memstatus, memaddrdesc, size, accdesc)
    };
    return(memstatus.store64bstatus)
}

val MemStore64B : (bits(64), bits(512), AccType) -> unit

function MemStore64B (address, value_name, acctype) = {
    c : Constraint = undefined;
    fault : FaultRecord = undefined;
    let iswrite : bool = true;
    let 'size = 64;
    let aligned : bool = AArch64_CheckAlignment(address, size, acctype, iswrite);
    if not_bool(AddressSupportsLS64(address)) then {
        let c : Constraint = ConstrainUnpredictable(Unpredictable_LS64UNSUPPORTED);
        assert(c == Constraint_LIMITED_ATOMICITY | c == Constraint_FAULT);
        if c == Constraint_FAULT then {
            let secondstage : bool = false;
            let s2fs1walk : bool = false;
            let fault : FaultRecord = AArch64_ExclusiveFault(acctype, iswrite, secondstage, s2fs1walk);
            AArch64_Abort(address, fault)
        } else {
            foreach (i from 0 to 63 by 1 in inc) {
                AArch64_MemSingle_set(address + 8 * i, 1, acctype, aligned) = value_name[7 + 8 * i .. 8 * i]
            }
        }
    } else {
        let _ = MemStore64BWithRet(address, value_name, acctype);
        ()
    };
    return()
}

val MemLoad64B : (bits(64), AccType) -> bits(512)

function MemLoad64B (address, acctype) = {
    c : Constraint = undefined;
    fault : FaultRecord = undefined;
    data : bits(512) = undefined;
    let iswrite : bool = false;
    let 'size = 64;
    let aligned : bool = AArch64_CheckAlignment(address, size, acctype, iswrite);
    if not_bool(AddressSupportsLS64(address)) then {
        let c : Constraint = ConstrainUnpredictable(Unpredictable_LS64UNSUPPORTED);
        assert(c == Constraint_LIMITED_ATOMICITY | c == Constraint_FAULT);
        if c == Constraint_FAULT then {
            let secondstage : bool = false;
            let s2fs1walk : bool = false;
            fault = AArch64_ExclusiveFault(acctype, iswrite, secondstage, s2fs1walk);
            AArch64_Abort(address, fault)
        } else {
            foreach (i from 0 to 63 by 1 in inc) {
                data[7 + 8 * i .. 8 * i] = AArch64_MemSingle_read(address + 8 * i, 1, acctype, aligned)
            };
            return(data)
        }
    };
    let memaddrdesc : AddressDescriptor = AArch64_TranslateAddress(address, acctype, iswrite, aligned, size);
    if IsFault(memaddrdesc) then {
        AArch64_Abort(address, memaddrdesc.fault)
    };
    if memaddrdesc.memattrs.shareability != Shareability_NSH then {
        ClearExclusiveByAddress(memaddrdesc.paddress, ProcessorID(), size)
    };
    accdesc : AccessDescriptor = CreateAccessDescriptor(acctype);
    if HaveTME() then {
        accdesc.transactional = TSTATE.depth > 0
    };
    if HaveRME() then {
        fault : FaultRecord = NoFault();
        fault.gpcf = GranuleProtectionCheck(memaddrdesc, accdesc);
        if fault.gpcf.gpf != GPCF_None then {
            fault.statuscode = Fault_GPCFOnOutput;
            fault.paddress = memaddrdesc.paddress;
            fault.acctype = acctype;
            fault.write = iswrite;
            AArch64_Abort(address, fault)
        };
        ()
    };
    let fault = fault;
    if HaveMTE2Ext() then {
        if AArch64_AccessIsTagChecked(ZeroExtend(address, 64), acctype) then {
            let ptag : bits(4) = AArch64_PhysicalTag(ZeroExtend(address, 64));
            if not_bool(AArch64_CheckTag(memaddrdesc, accdesc, ptag, iswrite)) then {
                AArch64_TagCheckFault(address, acctype, iswrite)
            };
            ()
        };
        ()
    };
    memstatus : PhysMemRetStatus = undefined;
    (memstatus, data) = PhysMemRead(memaddrdesc, size, accdesc);
    if IsFault__2(memstatus) then {
        HandleExternalReadAbort(memstatus, memaddrdesc, size, accdesc)
    };
    return(data)
}

val AArch64_IsExclusiveVA : forall 'processorid 'size.
  (bits(64), int('processorid), int('size)) -> bool

val AArch64_MarkExclusiveVA : forall 'processorid 'size.
  (bits(64), int('processorid), int('size)) -> unit

val AArch64_SetExclusiveMonitors : forall 'size. (bits(64), int('size)) -> unit

function AArch64_SetExclusiveMonitors (address, size) = {
    __ExclusiveMonitorSet = true;
    let acctype : AccType = AccType_ATOMIC;
    let iswrite : bool = false;
    let aligned : bool = AArch64_CheckAlignment(address, size, acctype, iswrite);
    let memaddrdesc : AddressDescriptor = AArch64_TranslateAddress(address, acctype, iswrite, aligned, size);
    if IsFault(memaddrdesc) then {
        return()
    };
    if memaddrdesc.memattrs.shareability != Shareability_NSH then {
        MarkExclusiveGlobal(memaddrdesc.paddress, ProcessorID(), size)
    };
    MarkExclusiveLocal(memaddrdesc.paddress, ProcessorID(), size);
    AArch64_MarkExclusiveVA(address, ProcessorID(), size)
}

val AArch64_ExclusiveMonitorsPass : forall 'size. (bits(64), int('size)) -> bool

function AArch64_ExclusiveMonitorsPass (address, size) = {
    let acctype : AccType = AccType_ATOMIC;
    let iswrite : bool = true;
    let aligned : bool = AArch64_CheckAlignment(address, size, acctype, iswrite);
    passed : bool = AArch64_IsExclusiveVA(address, ProcessorID(), size);
    if not_bool(passed) then {
        return(false)
    };
    let memaddrdesc : AddressDescriptor = AArch64_TranslateAddress(address, acctype, iswrite, aligned, size);
    if IsFault(memaddrdesc) then {
        AArch64_Abort(address, memaddrdesc.fault)
    };
    passed : bool = IsExclusiveLocal(memaddrdesc.paddress, ProcessorID(), size);
    ClearExclusiveLocal(ProcessorID());
    if passed then {
        if memaddrdesc.memattrs.shareability != Shareability_NSH then {
            passed = IsExclusiveGlobal(memaddrdesc.paddress, ProcessorID(), size)
        };
        ()
    };
    return(passed)
}

val FPRecipStepFused : forall 'N, 'N in {16, 32, 64}.
  (bits('N), bits('N)) -> bits('N)

function FPRecipStepFused (op1_in, op2) = {
    inf1 : bool = undefined;
    inf2 : bool = undefined;
    result_value : real = undefined;
    sign : bits(1) = undefined;
    sign1 : bits(1) = undefined;
    sign2 : bits(1) = undefined;
    type1 : FPType = undefined;
    type2 : FPType = undefined;
    value1_name : real = undefined;
    value2_name : real = undefined;
    zero1 : bool = undefined;
    zero2 : bool = undefined;
    assert('N == 16 | 'N == 32 | 'N == 64);
    op1 : bits('N) = op1_in;
    result : bits('N) = undefined;
    done : bool = undefined;
    fpcr : bits(64) = FPCR_read();
    let op1 : bits('N) = FPNeg(op1);
    let altfp : bool = HaveAltFP() & [fpcr[1]] == 0b1;
    let fpexc : bool = not_bool(altfp);
    if altfp then {
        (fpcr[0 .. 0] @ fpcr[24 .. 24]) = 0b11
    };
    if altfp then {
        fpcr = SetSlice(2, fpcr, 22, 0b00)
    };
    (type1, sign1, value1_name) = FPUnpack__1(op1, fpcr, fpexc);
    (type2, sign2, value2_name) = FPUnpack__1(op2, fpcr, fpexc);
    (done, result) = FPProcessNaNs__1(type1, type2, op1, op2, fpcr, false, fpexc);
    let rounding : FPRounding = FPRoundingMode(fpcr);
    if not_bool(done) then {
        let inf1 : bool = type1 == FPType_Infinity;
        let inf2 : bool = type2 == FPType_Infinity;
        let zero1 : bool = type1 == FPType_Zero;
        let zero2 : bool = type2 == FPType_Zero;
        if inf1 & zero2 | zero1 & inf2 then {
            result = FPTwo('N, 0b0)
        } else if inf1 | inf2 then {
            result = FPInfinity('N, EOR(sign1, sign2))
        } else {
            let result_value : real = 2.0 + value1_name * value2_name;
            if result_value == 0.0 then {
                let sign : bits(1) = if rounding == FPRounding_NEGINF then 0b1
                else
                  0b0;
                result = FPZero('N, sign)
            } else {
                result = FPRound__1('N, result_value, fpcr, rounding, fpexc)
            }
        }
    };
    return(result)
}

val FPRSqrtStepFused : forall 'N, 'N in {16, 32, 64}.
  (bits('N), bits('N)) -> bits('N)

function FPRSqrtStepFused (op1_in, op2) = {
    inf1 : bool = undefined;
    inf2 : bool = undefined;
    result_value : real = undefined;
    sign : bits(1) = undefined;
    sign1 : bits(1) = undefined;
    sign2 : bits(1) = undefined;
    type1 : FPType = undefined;
    type2 : FPType = undefined;
    value1_name : real = undefined;
    value2_name : real = undefined;
    zero1 : bool = undefined;
    zero2 : bool = undefined;
    assert('N == 16 | 'N == 32 | 'N == 64);
    result : bits('N) = undefined;
    op1 : bits('N) = op1_in;
    done : bool = undefined;
    fpcr : bits(64) = FPCR_read();
    let op1 : bits('N) = FPNeg(op1);
    let altfp : bool = HaveAltFP() & [fpcr[1]] == 0b1;
    let fpexc : bool = not_bool(altfp);
    if altfp then {
        (fpcr[0 .. 0] @ fpcr[24 .. 24]) = 0b11
    };
    if altfp then {
        fpcr = SetSlice(2, fpcr, 22, 0b00)
    };
    (type1, sign1, value1_name) = FPUnpack__1(op1, fpcr, fpexc);
    (type2, sign2, value2_name) = FPUnpack__1(op2, fpcr, fpexc);
    (done, result) = FPProcessNaNs__1(type1, type2, op1, op2, fpcr, false, fpexc);
    let rounding : FPRounding = FPRoundingMode(fpcr);
    if not_bool(done) then {
        let inf1 : bool = type1 == FPType_Infinity;
        let inf2 : bool = type2 == FPType_Infinity;
        let zero1 : bool = type1 == FPType_Zero;
        let zero2 : bool = type2 == FPType_Zero;
        if inf1 & zero2 | zero1 & inf2 then {
            result = FPOnePointFive('N, 0b0)
        } else if inf1 | inf2 then {
            result = FPInfinity('N, EOR(sign1, sign2))
        } else {
            let result_value : real = (3.0 + value1_name * value2_name) / 2.0;
            if result_value == 0.0 then {
                let sign : bits(1) = if rounding == FPRounding_NEGINF then 0b1
                else
                  0b0;
                result = FPZero('N, sign)
            } else {
                result = FPRound__1('N, result_value, fpcr, rounding, fpexc)
            }
        }
    };
    return(result)
}

val AArch64_AdvSIMDFPAccessTrap : bits(2) -> unit

function AArch64_AdvSIMDFPAccessTrap target_el = {
    exception : ExceptionRecord = undefined;
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    let route_to_el2 : bool = (target_el == EL1 & EL2Enabled()) & Slice(HCR_EL2, 27, 1) == 0b1;
    if route_to_el2 then {
        let exception : ExceptionRecord = ExceptionSyndrome(Exception_Uncategorized);
        AArch64_TakeException(EL2, exception, preferred_exception_return, vect_offset)
    } else {
        exception : ExceptionRecord = ExceptionSyndrome(Exception_AdvSIMDFPAccessTrap);
        exception.syndrome[24 .. 20] = ConditionSyndrome();
        AArch64_TakeException(target_el, exception, preferred_exception_return, vect_offset)
    };
    return()
}

val SVEAccessTrap : bits(2) -> unit

function SVEAccessTrap target_el = {
    assert((UInt(target_el) >= UInt(PSTATE.EL) & target_el != EL0) & HaveEL(target_el));
    let route_to_el2 : bool = (target_el == EL1 & EL2Enabled()) & Slice(HCR_EL2, 27, 1) == 0b1;
    let exception : ExceptionRecord = ExceptionSyndrome(Exception_SVEAccessTrap);
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    if route_to_el2 then {
        AArch64_TakeException(EL2, exception, preferred_exception_return, vect_offset)
    } else {
        AArch64_TakeException(target_el, exception, preferred_exception_return, vect_offset)
    }
}

val CheckNormalSVEEnabled : unit -> unit

function CheckNormalSVEEnabled () = {
    disabled : bool = undefined;
    if (PSTATE.EL == EL0 | PSTATE.EL == EL1) & not_bool(IsInHost()) then {
        match Slice(CPACR_EL1, 16, 2) {
          [_, bitzero] => {
              disabled = true
          },
          0b01 => {
              disabled = PSTATE.EL == EL0
          },
          0b11 => {
              disabled = false
          }
        };
        if disabled then {
            SVEAccessTrap(EL1)
        };
        match Slice(CPACR_EL1, 20, 2) {
          [_, bitzero] => {
              disabled = true
          },
          0b01 => {
              disabled = PSTATE.EL == EL0
          },
          0b11 => {
              disabled = false
          }
        };
        if disabled then {
            AArch64_AdvSIMDFPAccessTrap(EL1)
        };
        ()
    };
    if (PSTATE.EL == EL0 | PSTATE.EL == EL1 | PSTATE.EL == EL2) & EL2Enabled() then {
        if HaveVirtHostExt() & Slice(HCR_EL2, 34, 1) == 0b1 then {
            match Slice(CPTR_EL2, 16, 2) {
              [_, bitzero] => {
                  disabled = true
              },
              0b01 => {
                  disabled = PSTATE.EL == EL0 & Slice(HCR_EL2, 27, 1) == 0b1
              },
              0b11 => {
                  disabled = false
              }
            };
            if disabled then {
                SVEAccessTrap(EL2)
            };
            match Slice(CPTR_EL2, 20, 2) {
              [_, bitzero] => {
                  disabled = true
              },
              0b01 => {
                  disabled = PSTATE.EL == EL0 & Slice(HCR_EL2, 27, 1) == 0b1
              },
              0b11 => {
                  disabled = false
              }
            };
            if disabled then {
                AArch64_AdvSIMDFPAccessTrap(EL2)
            };
            ()
        } else {
            if Slice(CPTR_EL2, 8, 1) == 0b1 then {
                SVEAccessTrap(EL2)
            };
            if Slice(CPTR_EL2, 10, 1) == 0b1 then {
                AArch64_AdvSIMDFPAccessTrap(EL2)
            };
            ()
        }
    };
    if HaveEL(EL3) then {
        if Slice(CPTR_EL3, 8, 1) == 0b0 then {
            SVEAccessTrap(EL3)
        };
        if Slice(CPTR_EL3, 10, 1) == 0b1 then {
            AArch64_AdvSIMDFPAccessTrap(EL3)
        };
        ()
    };
    ()
}

val SMEAccessTrap : (SMEExceptionType, bits(2)) -> unit

function SMEAccessTrap (etype, target_el_in) = {
    target_el : bits(2) = target_el_in;
    assert(UInt(target_el) >= UInt(PSTATE.EL));
    if target_el == EL0 then {
        target_el = EL1
    };
    let route_to_el2 : bool = ((PSTATE.EL == EL0 & target_el == EL1) & EL2Enabled()) & Slice(HCR_EL2, 27, 1) == 0b1;
    exception : ExceptionRecord = ExceptionSyndrome(Exception_SMEAccessTrap);
    let preferred_exception_return : bits(64) = ThisInstrAddr(64);
    let 'vect_offset = UInt(0x0);
    match etype {
      SMEExceptionType_AccessTrap => {
          exception.syndrome[1 .. 0] = 0b00
      },
      SMEExceptionType_Streaming => {
          exception.syndrome[1 .. 0] = 0b01
      },
      SMEExceptionType_NotStreaming => {
          exception.syndrome[1 .. 0] = 0b10
      },
      SMEExceptionType_InactiveZA => {
          exception.syndrome[1 .. 0] = 0b11
      }
    };
    if route_to_el2 then {
        AArch64_TakeException(EL2, exception, preferred_exception_return, vect_offset)
    } else {
        AArch64_TakeException(target_el, exception, preferred_exception_return, vect_offset)
    }
}

val CheckSMEEnabled : unit -> unit

function CheckSMEEnabled () = {
    disabled : bool = undefined;
    if (PSTATE.EL == EL0 | PSTATE.EL == EL1) & not_bool(IsInHost()) then {
        match Slice(CPACR_EL1, 24, 2) {
          [_, bitzero] => {
              disabled = true
          },
          0b01 => {
              disabled = PSTATE.EL == EL0
          },
          0b11 => {
              disabled = false
          }
        };
        if disabled then {
            SMEAccessTrap(SMEExceptionType_AccessTrap, EL1)
        };
        match Slice(CPACR_EL1, 20, 2) {
          [_, bitzero] => {
              disabled = true
          },
          0b01 => {
              disabled = PSTATE.EL == EL0
          },
          0b11 => {
              disabled = false
          }
        };
        if disabled then {
            AArch64_AdvSIMDFPAccessTrap(EL1)
        };
        ()
    };
    if (PSTATE.EL == EL0 | PSTATE.EL == EL1 | PSTATE.EL == EL2) & EL2Enabled() then {
        if HaveVirtHostExt() & Slice(HCR_EL2, 34, 1) == 0b1 then {
            match Slice(CPTR_EL2, 24, 2) {
              [_, bitzero] => {
                  disabled = true
              },
              0b01 => {
                  disabled = PSTATE.EL == EL0 & Slice(HCR_EL2, 27, 1) == 0b1
              },
              0b11 => {
                  disabled = false
              }
            };
            if disabled then {
                SMEAccessTrap(SMEExceptionType_AccessTrap, EL2)
            };
            match Slice(CPTR_EL2, 20, 2) {
              [_, bitzero] => {
                  disabled = true
              },
              0b01 => {
                  disabled = PSTATE.EL == EL0 & Slice(HCR_EL2, 27, 1) == 0b1
              },
              0b11 => {
                  disabled = false
              }
            };
            if disabled then {
                AArch64_AdvSIMDFPAccessTrap(EL2)
            };
            ()
        } else {
            if Slice(CPTR_EL2, 12, 1) == 0b1 then {
                SMEAccessTrap(SMEExceptionType_AccessTrap, EL2)
            };
            if Slice(CPTR_EL2, 10, 1) == 0b1 then {
                AArch64_AdvSIMDFPAccessTrap(EL2)
            };
            ()
        }
    };
    if HaveEL(EL3) then {
        if Slice(CPTR_EL3, 12, 1) == 0b0 then {
            SMEAccessTrap(SMEExceptionType_AccessTrap, EL3)
        };
        if Slice(CPTR_EL3, 10, 1) == 0b1 then {
            AArch64_AdvSIMDFPAccessTrap(EL3)
        };
        ()
    };
    ()
}

val CheckStreamingSVEEnabled : unit -> unit

function CheckStreamingSVEEnabled () = {
    CheckSMEEnabled();
    if PSTATE.SM == 0b0 then {
        SMEAccessTrap(SMEExceptionType_NotStreaming, PSTATE.EL)
    };
    ()
}

val CheckSVEEnabled : unit -> unit

function CheckSVEEnabled () = {
    if HaveSME() & (PSTATE.SM == 0b1 | not_bool(HaveSVE())) then {
        CheckStreamingSVEEnabled()
    } else {
        CheckNormalSVEEnabled()
    }
}

val CheckSMEAndZAEnabled : unit -> unit

function CheckSMEAndZAEnabled () = {
    CheckSMEEnabled();
    if PSTATE.ZA == 0b0 then {
        SMEAccessTrap(SMEExceptionType_InactiveZA, PSTATE.EL)
    };
    ()
}

val CheckNonStreamingSVEEnabled : unit -> unit

function CheckNonStreamingSVEEnabled () = {
    CheckSVEEnabled();
    if HaveSME() & PSTATE.SM == 0b1 then {
        SMEAccessTrap(SMEExceptionType_Streaming, PSTATE.EL)
    };
    ()
}

val CheckStreamingSVEAndZAEnabled : unit -> unit

function CheckStreamingSVEAndZAEnabled () = {
    CheckStreamingSVEEnabled();
    if PSTATE.ZA == 0b0 then {
        SMEAccessTrap(SMEExceptionType_InactiveZA, PSTATE.EL)
    };
    ()
}

val CheckSMEAccess : unit -> unit

function CheckSMEAccess () = {
    disabled : bool = undefined;
    if (PSTATE.EL == EL0 | PSTATE.EL == EL1) & not_bool(IsInHost()) then {
        match Slice(CPACR_EL1, 24, 2) {
          [_, bitzero] => {
              disabled = true
          },
          0b01 => {
              disabled = PSTATE.EL == EL0
          },
          0b11 => {
              disabled = false
          }
        };
        if disabled then {
            SMEAccessTrap(SMEExceptionType_AccessTrap, EL1)
        };
        ()
    };
    if (PSTATE.EL == EL0 | PSTATE.EL == EL1 | PSTATE.EL == EL2) & EL2Enabled() then {
        if HaveVirtHostExt() & Slice(HCR_EL2, 34, 1) == 0b1 then {
            match Slice(CPTR_EL2, 24, 2) {
              [_, bitzero] => {
                  disabled = true
              },
              0b01 => {
                  disabled = PSTATE.EL == EL0 & Slice(HCR_EL2, 27, 1) == 0b1
              },
              0b11 => {
                  disabled = false
              }
            };
            if disabled then {
                SMEAccessTrap(SMEExceptionType_AccessTrap, EL2)
            };
            ()
        } else {
            if Slice(CPTR_EL2, 12, 1) == 0b1 then {
                SMEAccessTrap(SMEExceptionType_AccessTrap, EL2)
            };
            ()
        }
    };
    if HaveEL(EL3) then {
        if Slice(CPTR_EL3, 12, 1) == 0b0 then {
            SMEAccessTrap(SMEExceptionType_AccessTrap, EL3)
        };
        ()
    };
    ()
}

val Z_read : forall 'n 'width,
  (0 <= 'width - 1 & 'width - 1 < 2048 | not(('n >= 0 & 'n <= 31))).
  (implicit('width), int('n)) -> bits('width)

function Z_read (width, n) = {
    let 'VL = VL_read();
    assert(n >= 0 & n <= 31);
    assert(width == VL);
    return(_Z[n][width - 1 .. 0])
}

val P_read : forall 'n 'width,
  ('n < 16 | not(('n >= 0 & 'n <= 31))) & (0 <= 'width - 1 & 'width - 1 < 256 | not(('n >= 0 & 'n <= 31))).
  (implicit('width), int('n)) -> bits('width)

function P_read (width, n) = {
    let 'VL = VL_read();
    let 'PL = PL_of_VL(VL_read());
    assert(n >= 0 & n <= 31);
    assert(width == PL);
    return(_P[n][width - 1 .. 0])
}

val FFR_read : forall 'width,
  (0 <= 'width - 1 & 'width - 1 < 256).
  implicit('width) -> bits('width)

function FFR_read width = {
    let 'VL = VL_read();
    let 'PL = PL_of_VL(VL_read());
    assert(width == PL);
    return(_FFR[width - 1 .. 0])
}

val MemSingleNF_read : forall ('aligned : Bool) 'size,
  8 * 'size >= 0 & 'size > 0.
  (bits(64), int('size), AccType, bool('aligned)) -> (bits(8 * 'size), bool)

function MemSingleNF_read (address, size, acctype, aligned) = {
    fault : FaultRecord = undefined;
    memstatus : PhysMemRetStatus = undefined;
    assert(acctype == AccType_CNOTFIRST | acctype == AccType_NONFAULT);
    value_name : bits(8 * 'size) = undefined;
    let iswrite : bool = false;
    if ConstrainUnpredictableBool(Unpredictable_NONFAULT) then {
        return((__UNKNOWN_bits(8 * size), true))
    };
    let memaddrdesc : AddressDescriptor = AArch64_TranslateAddress(address, acctype, iswrite, aligned, size);
    if memaddrdesc.memattrs.memtype == MemType_Device then {
        return((__UNKNOWN_bits(8 * size), true))
    };
    if IsFault(memaddrdesc) then {
        return((__UNKNOWN_bits(8 * size), true))
    };
    accdesc : AccessDescriptor = CreateAccessDescriptor(acctype);
    if HaveTME() then {
        accdesc.transactional = TSTATE.depth > 0
    };
    if HaveRME() then {
        fault = NoFault();
        fault.gpcf = GranuleProtectionCheck(memaddrdesc, accdesc);
        if fault.gpcf.gpf != GPCF_None then {
            return((__UNKNOWN_bits(8 * size), true))
        };
        ()
    };
    if HaveMTE2Ext() then {
        if AArch64_AccessIsTagChecked(address, acctype) then {
            let ptag : bits(4) = AArch64_PhysicalTag(address);
            if not_bool(AArch64_CheckTag(memaddrdesc, accdesc, ptag, iswrite)) then {
                return((__UNKNOWN_bits(8 * size), true))
            };
            ()
        };
        ()
    };
    (memstatus, value_name) = PhysMemRead(memaddrdesc, size, accdesc);
    if IsFault__2(memstatus) then {
        if IsExternalAbortTakenSynchronously(memstatus, iswrite, memaddrdesc, size, accdesc) then {
            return((__UNKNOWN_bits(8 * size), true))
        };
        fault : FaultRecord = NoFault();
        fault.errortype = memstatus.errortype;
        fault.acctype = memstatus.acctype;
        fault.extflag = memstatus.extflag;
        fault.statuscode = memstatus.statuscode;
        PendSErrorInterrupt(fault)
    };
    return((value_name, false))
}

val MemNF_read : forall 'size,
  'size in {1, 2, 4, 8, 16}.
  (bits(64), int('size), AccType) -> (bits(8 * 'size), bool)

function MemNF_read (address, size, acctype) = {
    bad : bool = undefined;
    c : Constraint = undefined;
    assert(size == 1 | size == 2 | size == 4 | size == 8 | size == 16);
    value_name : bits(8 * 'size) = undefined;
    aligned : bool = address == Align(address, size);
    let A : bits(1) = [SCTLR_read__1()[1]];
    if not_bool(aligned) & A == 0b1 then {
        return((__UNKNOWN_bits(8 * size), true))
    };
    let atomic : bool = aligned | size == 1;
    if not_bool(atomic) then {
        (value_name[7 .. 0], bad) = MemSingleNF_read(address, 1, acctype, aligned);
        if bad then {
            return((__UNKNOWN_bits(8 * size), true))
        };
        if not_bool(aligned) then {
            let c : Constraint = ConstrainUnpredictable(Unpredictable_DEVPAGE2);
            assert(c == Constraint_FAULT | c == Constraint_NONE);
            if c == Constraint_NONE then {
                aligned = true
            };
            ()
        };
        foreach (i from 1 to (size - 1) by 1 in inc) {
            (value_name[8 * i + 7 .. 8 * i], bad) = MemSingleNF_read(address + i, 1, acctype, aligned);
            if bad then {
                return((__UNKNOWN_bits(8 * size), true))
            };
            ()
        }
    } else {
        (value_name, bad) = MemSingleNF_read(address, size, acctype, aligned);
        if bad then {
            return((__UNKNOWN_bits(8 * size), true))
        };
        ()
    };
    if BigEndian(acctype) then {
        value_name = BigEndianReverse(value_name)
    };
    let value_name = value_name;
    return((value_name, false))
}

val ElemP_read : forall 'N 'e 'esize.
  (bits('N), int('e), int('esize)) -> bits(1)

function ElemP_read (pred, e, esize) = {
    assert(esize == 8 | esize == 16 | esize == 32 | esize == 64 | esize == 128);
    let 'n = e * DIV(esize, 8);
    assert(n >= 0 & n < 'N);
    return([pred[n]])
}

val FirstActive : forall 'N 'esize. (bits('N), bits('N), int('esize)) -> bits(1)

function FirstActive (mask, x, esize) = {
    let 'elements = DIV('N, DIV(esize, 8));
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        if ElemP_read(mask, e, esize) == 0b1 then {
            return(ElemP_read(x, e, esize))
        };
        ()
    };
    return(0b0)
}

val LastActive : forall 'N 'esize. (bits('N), bits('N), int('esize)) -> bits(1)

function LastActive (mask, x, esize) = {
    let 'elements = DIV('N, DIV(esize, 8));
    foreach (e from (elements - 1) to 0 by 1 in dec) {
        if ElemP_read(mask, e, esize) == 0b1 then {
            return(ElemP_read(x, e, esize))
        };
        ()
    };
    return(0b0)
}

val NoneActive : forall 'N 'esize. (bits('N), bits('N), int('esize)) -> bits(1)

function NoneActive (mask, x, esize) = {
    let 'elements = DIV('N, DIV(esize, 8));
    foreach (e from 0 to (elements - 1) by 1 in inc) {
        if ElemP_read(mask, e, esize) == 0b1 & ElemP_read(x, e, esize) == 0b1 then {
            return(0b0)
        };
        ()
    };
    return(0b1)
}

val ElemP_set : forall 'N 'e 'esize.
  (bits('N), int('e), int('esize), bits(1)) -> bits('N)

function ElemP_set (pred__arg, e, esize, value_name) = {
    pred : bits('N) = pred__arg;
    assert(esize == 8 | esize == 16 | esize == 32 | esize == 64 | esize == 128);
    let 'psize = DIV(esize, 8);
    let 'n = e * psize;
    assert(n >= 0 & n + psize <= 'N);
    pred[n + psize - 1 .. n] = ZeroExtend(value_name, psize);
    return(pred)
}

val ElemFFR_read : forall 'e 'esize. (int('e), int('esize)) -> bits(1)

function ElemFFR_read (e, esize) = {
    return(ElemP_read(_FFR, e, esize))
}

val ElemFFR_set : forall 'e 'esize. (int('e), int('esize), bits(1)) -> unit

function ElemFFR_set (e, esize, value_name) = {
    let 'VL = VL_read();
    let 'PL = PL_of_VL(VL_read());
    let 'psize = DIV(esize, 8);
    let 'n = e * psize;
    assert(n >= 0 & n + psize <= PL);
    assert(constraint(('n <= 'n + 'psize - 1 & 'n + 'psize - 1 < 256)));
    _FFR[n + psize - 1 .. n] = ZeroExtend(value_name, psize);
    return()
}

val LastActiveElement : forall 'N 'esize. (bits('N), int('esize)) -> int

function LastActiveElement (mask, esize) = {
    let 'elements = DIV('N, DIV(esize, 8));
    foreach (e from (elements - 1) to 0 by 1 in dec) {
        if ElemP_read(mask, e, esize) == 0b1 then {
            return(e)
        };
        ()
    };
    return(negate(1))
}

val AnyActiveElement : forall 'N 'esize. (bits('N), int('esize)) -> bool

function AnyActiveElement (mask, esize) = {
    return(LastActiveElement(mask, esize) >= 0)
}

val FPCompareUN : forall 'N, 'N in {16, 32, 64}.
  (bits('N), bits('N), bits(64)) -> bool

function FPCompareUN (op1, op2, fpcr) = {
    sign1 : bits(1) = undefined;
    sign2 : bits(1) = undefined;
    type1 : FPType = undefined;
    type2 : FPType = undefined;
    value1_name : real = undefined;
    value2_name : real = undefined;
    assert('N == 16 | 'N == 32 | 'N == 64);
    (type1, sign1, value1_name) = FPUnpack(op1, fpcr);
    (type2, sign2, value2_name) = FPUnpack(op2, fpcr);
    if type1 == FPType_SNaN | type2 == FPType_SNaN then {
        FPProcessException(FPExc_InvalidOp, fpcr)
    };
    let result : bool = (type1 == FPType_SNaN | type1 == FPType_QNaN) | type2 == FPType_SNaN | type2 == FPType_QNaN;
    if not_bool(result) then {
        FPProcessDenorms(type1, type2, 'N, fpcr)
    };
    return(result)
}

val FPCompareNE : forall 'N, 'N in {16, 32, 64}.
  (bits('N), bits('N), bits(64)) -> bool

function FPCompareNE (op1, op2, fpcr) = {
    sign1 : bits(1) = undefined;
    sign2 : bits(1) = undefined;
    type1 : FPType = undefined;
    type2 : FPType = undefined;
    value1_name : real = undefined;
    value2_name : real = undefined;
    assert('N == 16 | 'N == 32 | 'N == 64);
    result : bool = undefined;
    (type1, sign1, value1_name) = FPUnpack(op1, fpcr);
    (type2, sign2, value2_name) = FPUnpack(op2, fpcr);
    let op1_nan : bool = type1 == FPType_SNaN | type1 == FPType_QNaN;
    let op2_nan : bool = type2 == FPType_SNaN | type2 == FPType_QNaN;
    if op1_nan | op2_nan then {
        result = true;
        if type1 == FPType_SNaN | type2 == FPType_SNaN then {
            FPProcessException(FPExc_InvalidOp, fpcr)
        };
        ()
    } else {
        result = value1_name != value2_name;
        FPProcessDenorms(type1, type2, 'N, fpcr)
    };
    return(result)
}

val FPOne : forall 'N, 'N in {16, 32, 64}. (implicit('N), bits(1)) -> bits('N)

function FPOne (N, sign) = {
    assert(N == 16 | N == 32 | N == 64);
    let 'E = if N == 16 then 5 else if N == 32 then 8 else 11;
    let 'F = N - (E + 1);
    let exp : bits(1 + ('E - 1)) = 0b0 @ Ones(E - 1);
    let frac : bits('F) = Zeros(F);
    return((sign @ exp) @ frac)
}

val FPPointFive : forall 'N, 'N in {16, 32, 64}.
  (implicit('N), bits(1)) -> bits('N)

function FPPointFive (N, sign) = {
    assert(N == 16 | N == 32 | N == 64);
    let 'E = if N == 16 then 5 else if N == 32 then 8 else 11;
    let 'F = N - (E + 1);
    let exp : bits(1 + ('E - 2) + 1) = (0b0 @ Ones(E - 2)) @ 0b0;
    let frac : bits('F) = Zeros(F);
    return((sign @ exp) @ frac)
}

val GetOptimizedScale : forall 'N 'scale_in.
  (bits('N), int('scale_in), int('N)) -> int

function GetOptimizedScale (op, scale_in, N) = {
    scale : int = scale_in;
    if N == 16 then {
        let 'exp16 = UInt(op[14 .. 10]);
        scale = if scale + exp16 < negate(11) then negate(11) - exp16 else scale;
        scale = if scale + exp16 > 43 then 43 - exp16 else scale
    } else if N == 32 then {
        let 'exp32 = UInt(op[30 .. 23]);
        scale = if scale + exp32 < negate(24) then negate(24) - exp32 else scale;
        scale = if scale + exp32 > 280 then 280 - exp32 else scale
    } else if N == 64 then {
        let 'exp64 = UInt(op[62 .. 52]);
        scale = if scale + exp64 < negate(53) then negate(53) - exp64 else scale;
        scale = if scale + exp64 > 2101 then 2101 - exp64 else scale
    } else ();
    let 'scale = scale;
    return(scale)
}

val FPScale : forall 'N 'scale,
  'N in {16, 32, 64}.
  (bits('N), int('scale), bits(64)) -> bits('N)

function FPScale (op, scale, fpcr) = {
    fptype : FPType = undefined;
    sign : bits(1) = undefined;
    value_name : real = undefined;
    assert('N == 16 | 'N == 32 | 'N == 64);
    result : bits('N) = undefined;
    (fptype, sign, value_name) = FPUnpack(op, fpcr);
    if fptype == FPType_SNaN | fptype == FPType_QNaN then {
        result = FPProcessNaN(fptype, op, fpcr)
    } else if fptype == FPType_Zero then {
        result = FPZero('N, sign)
    } else if fptype == FPType_Infinity then {
        result = FPInfinity('N, sign)
    } else {
        let 'scale_opt = GetOptimizedScale(op, scale, 'N);
        result = FPRound__2('N, value_name * 2.0 ^ scale_opt, fpcr);
        FPProcessDenorm(fptype, 'N, fpcr)
    };
    return(result)
}

val Reverse : forall 'M 'N. (bits('N), int('M)) -> bits('N)

function Reverse (word, M) = {
    result : bits('N) = undefined;
    let 'sw = DIV('N, M);
    assert('N == sw * M);
    foreach (s from 0 to (sw - 1) by 1 in inc) {
        assert(constraint((0 <= 'loop_s * 'M & 'loop_s * 'M <= 'loop_s * 'M + 'M - 1 | not(('loop_s >= 0 & ('loop_s + 1) * 'M <= 'N)))));
        assert(constraint((0 <= ('sw - 1 - 'loop_s) * 'M & ('sw - 1 - 'loop_s) * 'M <= ('sw - 1 - 'loop_s + 1) * 'M - 1 | not(('sw - 1 - 'loop_s >= 0 & ('sw - 1 - 'loop_s + 1) * 'M <= 'N)))));
        result = Elem_set(result, sw - 1 - s, M, Elem_read(word, s, M))
    };
    return(result)
}

val FPTrigSMul : forall 'N, 'N in {16, 32, 64}.
  (bits('N), bits('N), bits(64)) -> bits('N)

function FPTrigSMul (op1, op2, fpcr) = {
    fptype : FPType = undefined;
    sign : bits(1) = undefined;
    value_name : real = undefined;
    assert('N == 16 | 'N == 32 | 'N == 64);
    result : bits('N) = FPMul(op1, op1, fpcr);
    let fpexc : bool = false;
    (fptype, sign, value_name) = FPUnpack__1(result, fpcr, fpexc);
    if not_bool(fptype == FPType_QNaN | fptype == FPType_SNaN) then {
        result['N - 1] = Bit([op2[0]])
    };
    return(result)
}

val FPTrigSSel : forall 'N, 'N in {16, 32, 64}. (bits('N), bits('N)) -> bits('N)

function FPTrigSSel (op1, op2) = {
    assert('N == 16 | 'N == 32 | 'N == 64);
    result : bits('N) = undefined;
    if [op2[0]] == 0b1 then {
        result = FPOne('N, [op2[1]])
    } else if [op2[1]] == 0b1 then {
        result = FPNeg(op1)
    } else {
        result = op1
    };
    return(result)
}

val FPTrigMAddCoefficient_read : forall 'N 'index,
  'N in {16, 32, 64}.
  (implicit('N), int('index)) -> bits('N)

function FPTrigMAddCoefficient_read (N, index) = {
    assert(N == 16 | N == 32 | N == 64);
    result : int = undefined;
    if N == 16 then {
        match index {
          0 => {
              result = UInt(0x3c00)
          },
          1 => {
              result = UInt(0xb155)
          },
          2 => {
              result = UInt(0x2030)
          },
          3 => {
              result = UInt(0x0000)
          },
          4 => {
              result = UInt(0x0000)
          },
          5 => {
              result = UInt(0x0000)
          },
          6 => {
              result = UInt(0x0000)
          },
          7 => {
              result = UInt(0x0000)
          },
          8 => {
              result = UInt(0x3c00)
          },
          9 => {
              result = UInt(0xb800)
          },
          10 => {
              result = UInt(0x293a)
          },
          11 => {
              result = UInt(0x0000)
          },
          12 => {
              result = UInt(0x0000)
          },
          13 => {
              result = UInt(0x0000)
          },
          14 => {
              result = UInt(0x0000)
          },
          15 => {
              result = UInt(0x0000)
          },
          _ => ()
        }
    } else if N == 32 then {
        match index {
          0 => {
              result = UInt(0x3f800000)
          },
          1 => {
              result = UInt(0xbe2aaaab)
          },
          2 => {
              result = UInt(0x3c088886)
          },
          3 => {
              result = UInt(0xb95008b9)
          },
          4 => {
              result = UInt(0x36369d6d)
          },
          5 => {
              result = UInt(0x00000000)
          },
          6 => {
              result = UInt(0x00000000)
          },
          7 => {
              result = UInt(0x00000000)
          },
          8 => {
              result = UInt(0x3f800000)
          },
          9 => {
              result = UInt(0xbf000000)
          },
          10 => {
              result = UInt(0x3d2aaaa6)
          },
          11 => {
              result = UInt(0xbab60705)
          },
          12 => {
              result = UInt(0x37cd37cc)
          },
          13 => {
              result = UInt(0x00000000)
          },
          14 => {
              result = UInt(0x00000000)
          },
          15 => {
              result = UInt(0x00000000)
          },
          _ => ()
        }
    } else {
        match index {
          0 => {
              result = UInt(0x3ff0000000000000)
          },
          1 => {
              result = UInt(0xbfc5555555555543)
          },
          2 => {
              result = UInt(0x3f8111111110f30c)
          },
          3 => {
              result = UInt(0xbf2a01a019b92fc6)
          },
          4 => {
              result = UInt(0x3ec71de351f3d22b)
          },
          5 => {
              result = UInt(0xbe5ae5e2b60f7b91)
          },
          6 => {
              result = UInt(0x3de5d8408868552f)
          },
          7 => {
              result = UInt(0x0000000000000000)
          },
          8 => {
              result = UInt(0x3ff0000000000000)
          },
          9 => {
              result = UInt(0xbfe0000000000000)
          },
          10 => {
              result = UInt(0x3fa5555555555536)
          },
          11 => {
              result = UInt(0xbf56c16c16c13a0b)
          },
          12 => {
